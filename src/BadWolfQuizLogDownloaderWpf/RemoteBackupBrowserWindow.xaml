<Window x:Class="BadWolfQuizLogDownloaderWpf.RemoteBackupBrowserWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Remote backups"
        Width="980"
        Height="620"
        MinWidth="760"
        MinHeight="460"
        Background="{DynamicResource AppBackgroundBrush}"
        WindowStartupLocation="CenterOwner">
    <Grid Background="{DynamicResource AppBackgroundBrush}" Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Padding="12"
                Margin="0,0,0,10"
                Background="{DynamicResource PanelBrush}"
                CornerRadius="10"
                materialDesign:ElevationAssist.Elevation="Dp1">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                    <TextBlock Text="Filter:"
                               Foreground="{DynamicResource AppForegroundBrush}"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0"/>
                    <ComboBox x:Name="FilterCombo"
                              Width="150"
                              Foreground="{DynamicResource AppForegroundBrush}"
                              SelectionChanged="FilterCombo_SelectionChanged">
                        <ComboBoxItem Content="All" IsSelected="True"/>
                        <ComboBoxItem Content="App_Data"/>
                        <ComboBoxItem Content="Full site"/>
                    </ComboBox>
                </StackPanel>

                <Button x:Name="RefreshButton"
                        DockPanel.Dock="Right"
                        Content="Refresh"
                        Click="RefreshButton_Click"
                        Foreground="{DynamicResource AppForegroundBrush}"
                        Style="{StaticResource MaterialDesignOutlinedButton}"/>
            </DockPanel>
        </Border>

        <Border Grid.Row="1"
                Background="{DynamicResource ViewerBrush}"
                CornerRadius="10"
                materialDesign:ElevationAssist.Elevation="Dp2">
            <DataGrid x:Name="BackupGrid"
                      ItemsSource="{Binding Backups}"
                      SelectionMode="Single"
                      SelectionChanged="BackupGrid_SelectionChanged"
                      AutoGenerateColumns="False"
                      IsReadOnly="True"
                      CanUserAddRows="False"
                      CanUserDeleteRows="False"
                      HeadersVisibility="Column"
                      GridLinesVisibility="Horizontal"
                      Background="Transparent"
                      Foreground="{DynamicResource AppForegroundBrush}"
                      BorderThickness="0">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Type" Binding="{Binding TypeDisplay}" Width="120"/>
                    <DataGridTextColumn Header="Backup time" Binding="{Binding BackupTimeDisplay}" Width="165"/>
                    <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="100"/>
                    <DataGridTextColumn Header="Archive" Binding="{Binding FileName}" Width="*"/>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="2" Margin="0,10,0,8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>

            <TextBlock x:Name="StatusText"
                       Grid.Column="0"
                       Text="Ready."
                       Foreground="{DynamicResource AppForegroundBrush}"
                       VerticalAlignment="Center"
                       TextTrimming="CharacterEllipsis"/>

            <ProgressBar x:Name="BusyProgress"
                         Grid.Column="1"
                         Width="150"
                         Height="6"
                         IsIndeterminate="True"
                         Visibility="Collapsed"
                         VerticalAlignment="Center"/>
        </Grid>

        <WrapPanel Grid.Row="3" HorizontalAlignment="Right">
            <Button x:Name="DownloadButton"
                    Content="Download"
                    Click="DownloadButton_Click"
                    IsEnabled="False"
                    Margin="0,0,8,0"
                    Foreground="{DynamicResource AccentForegroundBrush}"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button x:Name="RestoreButton"
                    Content="Restore"
                    Click="RestoreButton_Click"
                    IsEnabled="False"
                    Margin="0,0,8,0"
                    Foreground="{DynamicResource AccentForegroundBrush}"
                    Style="{StaticResource MaterialDesignRaisedButton}"/>
            <Button x:Name="DeleteButton"
                    Content="Delete"
                    Click="DeleteButton_Click"
                    IsEnabled="False"
                    Margin="0,0,8,0"
                    Foreground="{DynamicResource AppForegroundBrush}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button x:Name="CancelButton"
                    Content="Cancel operation"
                    Click="CancelButton_Click"
                    IsEnabled="False"
                    Margin="0,0,8,0"
                    Foreground="{DynamicResource AppForegroundBrush}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
            <Button Content="Close"
                    Click="CloseButton_Click"
                    Foreground="{DynamicResource AppForegroundBrush}"
                    Style="{StaticResource MaterialDesignOutlinedButton}"/>
        </WrapPanel>
    </Grid>
</Window>
