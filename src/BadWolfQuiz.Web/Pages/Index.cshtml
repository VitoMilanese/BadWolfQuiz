@page
@model IndexModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = Localizer["Menu_Home"];
    var discordInviteUrl = Configuration["Discord:InviteUrl"];
    var hasSearchContent = HomeSeoContentCatalog.TryGet(
        CultureInfo.CurrentUICulture.Name,
        out var searchContent);
}

@section Styles {
    <link rel="stylesheet" href="~/css/home.css" asp-append-version="true" />
}

<div class="home-page">
    <section class="home-hero" aria-labelledby="home-title">
        <div class="home-hero-copy">
            <p class="home-kicker">@Localizer["Home_Eyebrow"]</p>

            <h1 id="home-title" class="home-display-title" aria-label="BAD WOLF QUIZ">
                <span aria-hidden="true">BAD</span>
                <span class="home-display-wolf" aria-hidden="true">WOLF</span>
                <strong aria-hidden="true">QUIZ</strong>
            </h1>

            <p class="home-manifesto">
                @Localizer["Home_TitleLine1"]
                <span>@Localizer["Home_TitleLine2"]</span>
            </p>
            <p class="home-description">@Localizer["Home_Description"]</p>

            <div class="home-actions">
                <a class="home-action home-action-primary" asp-page="/Admin/Quizzes/Index">
                    <span>@Localizer["Button_OpenEditor"]</span>
                </a>
                <a class="home-action home-action-secondary" asp-page="/Join/Index">
                    <span>@Localizer["Button_JoinGame"]</span>
                    <span class="home-action-arrow" aria-hidden="true">→</span>
                </a>
                @if (!string.IsNullOrWhiteSpace(discordInviteUrl))
                {
                    <a class="home-action home-action-secondary home-discord-action"
                       href="@discordInviteUrl"
                       target="_blank"
                       rel="noopener noreferrer">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path fill="currentColor" d="M20.32 4.37A19.8 19.8 0 0 0 15.44 2.9a13.8 13.8 0 0 0-.62 1.27 18.3 18.3 0 0 0-5.63 0 12.6 12.6 0 0 0-.63-1.27 19.7 19.7 0 0 0-4.89 1.48C.58 9.05-.37 13.61.06 18.1a19.9 19.9 0 0 0 6 3.02 14.6 14.6 0 0 0 1.29-2.1 13 13 0 0 1-2.03-.98l.5-.39c3.91 1.8 8.15 1.8 12.02 0l.51.39c-.65.38-1.33.71-2.03.98.37.73.8 1.43 1.29 2.1a19.9 19.9 0 0 0 6-3.02c.5-5.2-.85-9.72-3.29-13.73ZM8.02 15.33c-1.17 0-2.13-1.08-2.13-2.4 0-1.33.94-2.41 2.13-2.41 1.2 0 2.15 1.09 2.13 2.4 0 1.33-.94 2.41-2.13 2.41Zm7.97 0c-1.18 0-2.13-1.08-2.13-2.4 0-1.33.93-2.41 2.13-2.41 1.19 0 2.14 1.09 2.12 2.4 0 1.33-.93 2.41-2.12 2.41Z" />
                        </svg>
                        <span>Discord</span>
                    </a>
                }
            </div>
        </div>

        <div class="home-visual" aria-hidden="true">
            <div class="home-wolf-frame">
                <img src="~/images/youtube-placeholder-alt-wolf.svg" alt="" />
            </div>
            <div class="home-wolf-mark">LIVE<br />QUIZ</div>
            <div class="home-side-note">QUESTIONS AFTER DARK</div>
        </div>
    </section>

    <nav class="home-rail" aria-label="@Localizer["Menu_Title"]">
        <a href="/public-quizzes">
            <span class="home-rail-index" aria-hidden="true">01</span>
            <span class="home-rail-title">@Localizer["Menu_PublicQuizzes"]</span>
            <span class="home-rail-arrow" aria-hidden="true">→</span>
        </a>
        <a asp-page="/Minigames">
            <span class="home-rail-index" aria-hidden="true">02</span>
            <span class="home-rail-title">@Localizer["Menu_Minigames"]</span>
            <span class="home-rail-arrow" aria-hidden="true">→</span>
        </a>
        <a asp-page="/Join/Index">
            <span class="home-rail-index" aria-hidden="true">03</span>
            <span class="home-rail-title">@Localizer["Menu_Join"]</span>
            <span class="home-rail-arrow" aria-hidden="true">→</span>
        </a>
    </nav>

    @if (hasSearchContent)
    {
        <section class="home-story" aria-labelledby="home-search-title">
            <div class="home-story-heading">
                <p class="home-story-mark" aria-hidden="true">BAD WOLF / 02</p>
                <h2 id="home-search-title">@searchContent.Title</h2>
                <p class="home-story-intro">@searchContent.Introduction</p>
            </div>

            <div class="home-story-copy">
                <article>
                    <span class="home-story-index" aria-hidden="true">01</span>
                    <h3>@searchContent.CreateTitle</h3>
                    <p>@searchContent.CreateText</p>
                </article>
                <article>
                    <span class="home-story-index" aria-hidden="true">02</span>
                    <h3>@searchContent.PlayTitle</h3>
                    <p>@searchContent.PlayText</p>
                </article>
            </div>
        </section>
    }
</div>
