@page "/minigames/guess-what-i-play"
@model BadWolfQuiz.Web.Pages.GuessWhatIPlayModel
@inject IStringLocalizer<MinigameCatalogResource> MinigameCatalogLocalizer
@{
    var requestedRoomCode = Request.Query["room"].ToString().Trim().ToUpperInvariant();
    var socialRoomCode = requestedRoomCode.Length == 6 && requestedRoomCode.All(char.IsLetterOrDigit)
        ? requestedRoomCode
        : null;

    ViewData["Title"] = MinigameCatalogLocalizer["GuessWhatIPlay_Title"];
    ViewData["HidePortalFooter"] = true;
    ViewData["SocialTitle"] = socialRoomCode is null
        ? MinigameCatalogLocalizer["GuessWhatIPlay_SocialTitle"].Value
        : MinigameCatalogLocalizer["GuessWhatIPlay_RoomSocialTitle", socialRoomCode].Value;
    ViewData["SocialDescription"] = MinigameCatalogLocalizer["GuessWhatIPlay_SocialDescription"].Value;
    ViewData["SocialImageVariant"] = "site";
}

@section Styles {
    <link rel="stylesheet" href="~/css/minigames.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/minigames-hints.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/minigames-history-filter.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/minigames-sharing.css" asp-append-version="true" />
}

<div class="minigames-page"
     data-minigames-root
     data-hub-url="@Url.Content("~/hubs/minigames")"
     data-card-url="@Url.Page("/GuessWhatIPlay", "Card")"
     data-min-card-count="@BadWolfQuiz.Web.Services.MinigameRoomStore.MinimumGameCardCount"
     data-max-card-count="@Model.AvailableCardCount"
     data-default-card-count="@Model.DefaultCardCount"
     data-player-one="@Localizer["Minigames_PlayerOne"]"
     data-player-two="@Localizer["Minigames_PlayerTwo"]"
     data-waiting-opponent="@Localizer["Minigames_WaitingForOpponent"]"
     data-waiting-game="@Localizer["Minigames_WaitingForGame"]"
     data-choose-exclusions="@Localizer["Minigames_ChooseExclusions"]"
     data-exclusion-progress="@Localizer["Minigames_ExclusionProgress"]"
     data-game-ready="@Localizer["Minigames_GameReady"]"
     data-turn="@Localizer["Minigames_Turn"]"
     data-answer-prompt="@Localizer["Minigames_ChooseAnswer"]"
     data-winner="@Localizer["Minigames_Winner"]"
     data-not-your-turn="@Localizer["Minigames_NotYourTurn"]"
     data-question-history-entry="@Localizer["Minigames_QuestionHistoryEntry"]"
     data-history-guess-correct="@Localizer["Minigames_HistoryGuessCorrect"]"
     data-history-guess-incorrect="@Localizer["Minigames_HistoryGuessIncorrect"]"
     data-history-turn-ended="@Localizer["Minigames_HistoryTurnEnded"]"
     data-history-turn-timed-out="@Localizer["Minigames_HistoryTurnTimedOut"]"
     data-history-question-answer="@Localizer["Minigames_HistoryQuestionAnswer"]"
     data-question-response-prompt="@Localizer["Minigames_QuestionResponsePrompt"]"
     data-yes="@Localizer["Minigames_Yes"]"
     data-no="@Localizer["Minigames_No"]"
     data-question-awaiting-response="@Localizer["Minigames_QuestionAwaitingResponse"]"
     data-question-history-empty="@Localizer["Minigames_QuestionHistoryEmpty"]"
     data-question-not-selected="@Localizer["Minigames_QuestionNotSelected"]"
     data-question-choose="@Localizer["Minigames_QuestionChoose"]"
     data-question-selected="@Localizer["Minigames_QuestionSelected"]"
     data-question-wait="@Localizer["Minigames_QuestionWait"]"
     data-question-required="@Localizer["Minigames_QuestionRequired"]"
     data-question-already-selected="@Localizer["Minigames_QuestionAlreadySelected"]"
     data-invalid-question="@Localizer["Minigames_InvalidQuestion"]"
     data-questions-unavailable="@Localizer["Minigames_QuestionsUnavailable"]"
     data-room-not-found="@Localizer["Minigames_RoomNotFound"]"
     data-room-expired="@Localizer["Minigames_RoomExpired"]"
     data-room-full="@Localizer["Minigames_RoomFull"]"
     data-invalid-player="@Localizer["Minigames_InvalidPlayer"]"
     data-invalid-card-count="@Localizer["Minigames_InvalidCardCount"]"
     data-card-already-excluded="@Localizer["Minigames_CardAlreadyExcluded"]"
     data-exclusion-limit="@Localizer["Minigames_ExclusionLimit"]"
     data-generic-error="@Localizer["Minigames_GenericError"]"
     data-solo-ai-player="@MinigameCatalogLocalizer["SoloAiPlayer"]"
     data-solo-ai-unknown="@MinigameCatalogLocalizer["SoloAiUnknownAnswer"]"
     data-solo-ai-card-range="@MinigameCatalogLocalizer["SoloAiCardRange"]"
     data-hints-icon-label="@MinigameCatalogLocalizer["Hints_IconLabel"]"
     data-hints-title="@MinigameCatalogLocalizer["Hints_Title"]"
     data-hints-current-questions="@MinigameCatalogLocalizer["Hints_CurrentQuestions"]"
     data-hints-previous-questions="@MinigameCatalogLocalizer["Hints_PreviousQuestions"]"
     data-hints-no-current-questions="@MinigameCatalogLocalizer["Hints_NoCurrentQuestions"]"
     data-hints-no-previous-questions="@MinigameCatalogLocalizer["Hints_NoPreviousQuestions"]"
     data-hints-unavailable="@MinigameCatalogLocalizer["Hints_InformationUnavailable"]"
     data-hints-response-label="@MinigameCatalogLocalizer["Hints_ResponseLabel"]"
     data-hints-loading="@MinigameCatalogLocalizer["Hints_Loading"]"
     data-hints-close="@MinigameCatalogLocalizer["Hints_Close"]">

    <section class="minigames-entry" data-room-entry>
        <div class="minigames-entry-card">
            <h1>@MinigameCatalogLocalizer["GuessWhatIPlay_Title"]</h1>
            <p>@Localizer["Minigames_RoomIntro"]</p>

            <button class="button button-primary"
                    type="button"
                    data-create-room>
                @Localizer["Minigames_CreateRoom"]
            </button>

            <div class="minigames-entry-separator">
                <span>@Localizer["Minigames_Or"]</span>
            </div>

            <form class="minigames-join-form" data-join-room-form>
                <label for="minigames-room-code">@Localizer["Minigames_RoomCode"]</label>
                <div class="minigames-join-row">
                    <input id="minigames-room-code"
                           type="text"
                           maxlength="6"
                           autocomplete="off"
                           spellcheck="false"
                           data-join-room-code
                           placeholder="ABC123" />
                    <button class="button" type="submit">
                        @Localizer["Minigames_JoinRoom"]
                    </button>
                </div>
            </form>

            <p class="minigames-error is-hidden"
               data-minigames-entry-error
               role="alert"></p>
        </div>
    </section>

    <section class="minigames-room is-hidden" data-room-shell>
        <header class="minigames-toolbar">
            <div class="minigames-toolbar-title">
                <h1>@MinigameCatalogLocalizer["GuessWhatIPlay_Title"]</h1>
                <span class="minigames-room-share">
                    <span class="minigames-room-code">
                        @Localizer["Minigames_Room"]:
                        <strong data-room-code></strong>
                    </span>
                    <button class="button minigames-copy-room-link"
                            type="button"
                            data-copy-room-link
                            data-copy-label="@MinigameCatalogLocalizer["CopyRoomLink"]"
                            data-copied-label="@MinigameCatalogLocalizer["RoomLinkCopied"]"
                            data-copy-failed-label="@MinigameCatalogLocalizer["RoomLinkCopyFailed"]"
                            title="@MinigameCatalogLocalizer["CopyRoomLink"]"
                            aria-label="@MinigameCatalogLocalizer["CopyRoomLink"]"
                            disabled>
                        <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                            <path d="M10.6 13.4a1 1 0 0 1 0-1.4l3.4-3.4a4 4 0 1 1 5.7 5.7l-4.2 4.2a4 4 0 0 1-5.7 0 1 1 0 0 1 1.4-1.4 2 2 0 0 0 2.9 0l4.2-4.2a2 2 0 1 0-2.9-2.9L12 13.4a1 1 0 0 1-1.4 0Zm2.8-2.8a1 1 0 0 1 0 1.4L10 15.4a4 4 0 1 1-5.7-5.7l4.2-4.2a4 4 0 0 1 5.7 0 1 1 0 1 1-1.4 1.4 2 2 0 0 0-2.9 0L5.7 11a2 2 0 1 0 2.9 2.9l3.4-3.4a1 1 0 0 1 1.4 0Z" />
                        </svg>
                    </button>
                    <span class="minigames-copy-room-status"
                          data-copy-room-status
                          aria-live="polite"></span>
                </span>
            </div>
            <div class="minigames-toolbar-actions">
                <span class="minigames-error is-hidden"
                      data-minigames-room-error
                      role="alert"></span>
                <button class="button"
                        type="button"
                        data-answer
                        disabled>
                    @Localizer["Minigames_Answer"]
                </button>
                <button class="button"
                        type="button"
                        data-end-turn
                        disabled>
                    @Localizer["Minigames_EndTurn"]
                </button>
                <button class="button minigames-refresh-button"
                        type="button"
                        data-restart-game
                        title="@Localizer["Minigames_RestartGame"]"
                        aria-label="@Localizer["Minigames_RestartGame"]"
                        disabled>
                    <span aria-hidden="true">↻</span>
                </button>
                <button class="button button-primary"
                        type="button"
                        data-new-game>
                    @Localizer["Minigames_NewGame"]
                </button>
            </div>
        </header>

        <div class="minigames-room-status">
            <strong data-player-label></strong>
            <span data-room-message></span>
            <div class="minigames-turn-panel is-hidden" data-turn-panel>
                <span data-turn-label></span>
                <strong class="minigames-turn-timer" data-turn-timer>00:00</strong>
            </div>
            <span class="minigames-opponent-status" data-opponent-status></span>
        </div>

        <div class="minigames-game-layout" data-game-layout>
            <div class="minigames-stage">
                <div class="minigames-grid is-hidden" data-minigames-grid></div>
                <div class="minigames-empty" data-minigames-empty>
                    <h2>@Localizer["Minigames_WaitingTitle"]</h2>
                    <p>@Localizer["Minigames_WaitingForGame"]</p>
                </div>
            </div>

            <aside class="minigames-question-panel is-hidden" data-question-panel>
                <section class="minigames-question-history-section">
                    <h2>@Localizer["Minigames_QuestionHistoryTitle"]</h2>
                    <div class="minigames-question-history-filters"
                         data-question-history-filters
                         role="group"
                         aria-label="@Localizer["Minigames_QuestionHistoryTitle"]">
                        <button class="minigames-question-history-filter"
                                type="button"
                                data-history-filter="1-to-2"
                                aria-pressed="false"
                                title="@Localizer["Minigames_PlayerOne"] → @Localizer["Minigames_PlayerTwo"]">
                            1 → 2
                        </button>
                        <button class="minigames-question-history-filter"
                                type="button"
                                data-history-filter="2-to-1"
                                aria-pressed="false"
                                title="@Localizer["Minigames_PlayerTwo"] → @Localizer["Minigames_PlayerOne"]">
                            2 → 1
                        </button>
                        <button class="minigames-question-history-filter is-active"
                                type="button"
                                data-history-filter="all"
                                aria-pressed="true">
                            @Localizer["Minigames_QuestionHistoryTitle"]
                        </button>
                    </div>
                    <div class="minigames-question-history" data-question-history></div>
                </section>
                <section class="minigames-question-options-section">
                    <h3>@Localizer["Minigames_QuestionChoicesTitle"]</h3>
                    <p class="minigames-question-status" data-question-status></p>
                    <div class="minigames-question-options" data-question-options></div>
                </section>
            </aside>
        </div>
    </section>

    <dialog class="minigames-dialog" data-new-game-dialog>
        <form data-new-game-form>
            <h2>@Localizer["Minigames_NewGameTitle"]</h2>
            <p>@Localizer["Minigames_NewGameDescription"]</p>
            <label for="minigames-card-count">@Localizer["Minigames_CardCount"]</label>
            <input id="minigames-card-count"
                   type="number"
                   min="@BadWolfQuiz.Web.Services.MinigameRoomStore.MinimumGameCardCount"
                   max="@Model.AvailableCardCount"
                   value="@Model.DefaultCardCount"
                   data-new-game-count />
            <small data-card-count-range>
                @Localizer["Minigames_CardCountRange",
                    BadWolfQuiz.Web.Services.MinigameRoomStore.MinimumGameCardCount,
                    Model.AvailableCardCount]
            </small>
            <label class="minigames-checkbox-row">
                <input type="checkbox" data-new-game-question-cards />
                <span>
                    <strong>@Localizer["Minigames_QuestionCards"]</strong>
                    <small>@Localizer["Minigames_QuestionCardsDescription"]</small>
                </span>
            </label>
            <label class="minigames-checkbox-row">
                <input type="checkbox" data-new-game-solo-ai />
                <span>
                    <strong>@MinigameCatalogLocalizer["SoloAi"]</strong>
                    <small>@MinigameCatalogLocalizer["SoloAiDescription"]</small>
                </span>
            </label>
            <label class="minigames-checkbox-row">
                <input type="checkbox" data-new-game-allow-hints disabled />
                <span>
                    <strong>@MinigameCatalogLocalizer["AllowHints"]</strong>
                    <small>@MinigameCatalogLocalizer["AllowHintsDescription"]</small>
                </span>
            </label>
            <p class="minigames-error is-hidden"
               data-new-game-error
               role="alert"></p>
            <div class="minigames-dialog-actions">
                <button class="button" type="button" data-new-game-cancel>
                    @Localizer["Minigames_Cancel"]
                </button>
                <button class="button button-primary" type="submit" data-new-game-submit>
                    @Localizer["Minigames_StartGame"]
                </button>
            </div>
        </form>
    </dialog>

    <dialog class="minigames-dialog" data-question-response-dialog>
        <form data-question-response-form>
            <h2>@Localizer["Minigames_QuestionResponseTitle"]</h2>
            <p data-question-response-text></p>
            <p class="minigames-question-response-hint is-hidden"
               data-question-response-hint
               aria-live="polite"></p>
            <div class="minigames-dialog-actions">
                <button class="button" type="button" data-question-response-no>
                    @Localizer["Minigames_No"]
                </button>
                <button class="button button-primary" type="button" data-question-response-yes>
                    @Localizer["Minigames_Yes"]
                </button>
            </div>
        </form>
    </dialog>

    <dialog class="minigames-dialog minigames-hint-dialog" data-card-hint-dialog>
        <div class="minigames-hint-dialog-body">
            <header class="minigames-hint-dialog-header">
                <h2 data-card-hint-title>@MinigameCatalogLocalizer["Hints_Title"]</h2>
                <button class="button minigames-hint-close"
                        type="button"
                        data-card-hint-close
                        title="@MinigameCatalogLocalizer["Hints_Close"]"
                        aria-label="@MinigameCatalogLocalizer["Hints_Close"]">×</button>
            </header>
            <section class="minigames-hint-section">
                <h3>@MinigameCatalogLocalizer["Hints_CurrentQuestions"]</h3>
                <div data-card-hint-current></div>
            </section>
            <section class="minigames-hint-section minigames-hint-history-section">
                <h3>@MinigameCatalogLocalizer["Hints_PreviousQuestions"]</h3>
                <div data-card-hint-history></div>
            </section>
        </div>
    </dialog>
</div>

@section Scripts {
    <script src="~/js/minigames.js" asp-append-version="true"></script>
    <script src="~/js/minigames-solo-ai.js" asp-append-version="true"></script>
    <script src="~/js/minigames-hints.js" asp-append-version="true"></script>
    <script src="~/js/minigames-history-filter.js" asp-append-version="true"></script>
    <script src="~/js/minigames-sharing.js" asp-append-version="true"></script>
}
