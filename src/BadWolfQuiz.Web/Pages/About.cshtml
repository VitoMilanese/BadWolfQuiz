@page
@model AboutModel
@using BadWolfQuiz.Web.Localization
@using BadWolfQuiz.Web.Services
@inject IStringLocalizer<ProductVersionResource> ProductVersionLocalizer
@{
    var productVersion = ProductVersionInfo.Current;
    ViewData["Title"] = ProductVersionLocalizer["AboutTitle"];
}

<div class="page-heading">
    <div>
        <p class="eyebrow">@ProductVersionLocalizer["AboutEyebrow"]</p>
        <h1>@ProductVersionLocalizer["AboutTitle"]</h1>
    </div>
</div>

<section class="form-card narrow stack-form">
    <p class="settings-description">@ProductVersionLocalizer["AboutDescription"]</p>

    <div class="field-group">
        <label>@ProductVersionLocalizer["VersionLabel"]</label>
        <code class="host-id-value">@productVersion.Version</code>
    </div>

    @if (!string.IsNullOrWhiteSpace(productVersion.Commit))
    {
        <div class="field-group">
            <label>@ProductVersionLocalizer["BuildLabel"]</label>
            <code class="host-id-value">@productVersion.Commit</code>
        </div>
    }

    <div class="field-group">
        <label>License / Ліцензія</label>
        <p class="settings-description">
            BadWolfQuiz is source-available. Monetizing BadWolfQuiz itself is restricted, while monetized streams, videos, events, and similar activities may use it as a tool under the license terms.
        </p>
        <p class="settings-description">
            Вихідний код BadWolfQuiz доступний. Монетизація самого BadWolfQuiz обмежена, але монетизовані стріми, відео, події та подібна діяльність можуть використовувати його як інструмент відповідно до умов ліцензії.
        </p>
    </div>

    <div class="form-actions">
        @if (Model.GitHubUrl is not null)
        {
            <a class="button button-secondary about-social-link"
               href="@Model.GitHubUrl"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="GitHub"
               title="GitHub">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M12 .7a11.3 11.3 0 0 0-3.57 22c.57.1.78-.25.78-.55v-2.17c-3.18.69-3.85-1.35-3.85-1.35-.52-1.32-1.27-1.67-1.27-1.67-1.04-.71.08-.7.08-.7 1.15.08 1.75 1.18 1.75 1.18 1.02 1.75 2.68 1.24 3.33.95.1-.74.4-1.24.73-1.52-2.54-.29-5.21-1.27-5.21-5.65 0-1.25.45-2.27 1.18-3.07-.12-.29-.51-1.45.11-3.02 0 0 .96-.31 3.12 1.17a10.8 10.8 0 0 1 5.68 0c2.16-1.48 3.12-1.17 3.12-1.17.62 1.57.23 2.73.11 3.02.73.8 1.18 1.82 1.18 3.07 0 4.39-2.68 5.35-5.23 5.64.41.35.78 1.05.78 2.12v3.16c0 .3.2.66.79.55A11.3 11.3 0 0 0 12 .7Z" />
                </svg>
            </a>
        }

        @if (Model.DiscordInviteUrl is not null)
        {
            <a class="button button-secondary about-social-link"
               href="@Model.DiscordInviteUrl"
               target="_blank"
               rel="noopener noreferrer"
               aria-label="Discord"
               title="Discord">
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                    <path fill="currentColor" d="M20.32 4.37A19.8 19.8 0 0 0 15.44 2.9a13.8 13.8 0 0 0-.62 1.27 18.3 18.3 0 0 0-5.63 0 12.6 12.6 0 0 0-.63-1.27 19.7 19.7 0 0 0-4.89 1.48C.58 9.05-.37 13.61.06 18.1a19.9 19.9 0 0 0 6 3.02 14.6 14.6 0 0 0 1.29-2.1 13 13 0 0 1-2.03-.98l.5-.39c3.91 1.8 8.15 1.8 12.02 0l.51.39c-.65.38-1.33.71-2.03.98.37.73.8 1.43 1.29 2.1a19.9 19.9 0 0 0 6-3.02c.5-5.2-.85-9.72-3.29-13.73ZM8.02 15.33c-1.17 0-2.13-1.08-2.13-2.4 0-1.33.94-2.41 2.13-2.41 1.2 0 2.15 1.09 2.13 2.4 0 1.33-.94 2.41-2.13 2.41Zm7.97 0c-1.18 0-2.13-1.08-2.13-2.4 0-1.33.93-2.41 2.13-2.41 1.19 0 2.14 1.09 2.12 2.4 0 1.33-.93 2.41-2.12 2.41Z" />
                </svg>
            </a>
        }

        <a class="button button-secondary" asp-page="/License">
            License / Ліцензія
        </a>
    </div>
</section>

<style>
    .about-social-link {
        width: 44px;
        min-width: 44px;
        height: 44px;
        padding: 0;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

    .about-social-link svg {
        width: 22px;
        height: 22px;
        display: block;
    }
</style>