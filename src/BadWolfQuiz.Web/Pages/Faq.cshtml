@page
@{
    ViewData["Title"] = Localizer["Faq_Title"];
}

<section class="faq-page">
    <header class="page-heading faq-heading">
        <div>
            <p class="eyebrow">@Localizer["Faq_Eyebrow"]</p>
            <h1>@Localizer["Faq_Title"]</h1>
            <p>@Localizer["Faq_Description"]</p>
        </div>
    </header>

    <div class="faq-list">
        @for (var index = 1; index <= 12; index++)
        {
            <details class="faq-item">
                <summary>@Localizer[$"Faq_Q{index}"]</summary>
                <div class="faq-answer">
                    <p>@Localizer[$"Faq_A{index}"]</p>
                </div>
            </details>
        }
    </div>

    <aside class="content-panel faq-contact">
        <div>
            <h2>@Localizer["Faq_ContactTitle"]</h2>
            <p>@Localizer["Faq_ContactDescription"]</p>
        </div>
        <a class="button button-primary" asp-page="/AskQuestion">
            @Localizer["Menu_AskQuestion"]
        </a>
    </aside>
</section>
