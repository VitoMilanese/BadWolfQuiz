@page
@model BadWolfQuiz.Web.Pages.MyQuestionsModel
@{
    ViewData["Title"] = Localizer["MyQuestions_Title"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/questions.css" asp-append-version="true" />
}

<div class="support-page support-archive-page">
    <section class="support-hero support-hero-archive" aria-labelledby="support-archive-title">
        <div class="support-hero-copy">
            <p class="support-kicker">
                <span>BAD WOLF</span>
                <span aria-hidden="true">/ SIGNAL ARCHIVE</span>
            </p>
            <h1 id="support-archive-title">@Localizer["MyQuestions_Title"]</h1>

            <div class="support-hero-actions">
                <a class="button button-primary" asp-page="/AskQuestion">
                    @Localizer["AskQuestion_Title"]
                </a>
            </div>
        </div>

        <div class="support-archive-counter" aria-hidden="true">
            <span>ACTIVE THREADS</span>
            <strong>@Model.Questions.Count.ToString("00")</strong>
            <small>QUESTION LOG</small>
        </div>
    </section>

    <main class="support-content support-archive-content">
        <header class="support-section-heading">
            <div>
                <span aria-hidden="true">BAD WOLF / LOG</span>
                <h2>@Localizer["MyQuestions_Title"]</h2>
            </div>
            <strong aria-hidden="true">@Model.Questions.Count.ToString("00")</strong>
        </header>

        @if (Model.Questions.Count == 0)
        {
            <section class="support-empty-state">
                <div class="support-empty-mark" aria-hidden="true">
                    <strong>00</strong>
                    <span>NO SIGNALS</span>
                </div>
                <div class="support-empty-copy">
                    <h2>@Localizer["MyQuestions_Title"]</h2>
                    <p>@Localizer["MyQuestions_Empty"]</p>
                    <a class="button button-primary" asp-page="/AskQuestion">
                        @Localizer["AskQuestion_Title"]
                    </a>
                </div>
            </section>
        }
        else
        {
            <div class="support-thread-list">
                @for (var index = 0; index < Model.Questions.Count; index++)
                {
                    var question = Model.Questions[index];
                    var threadNumber = (index + 1).ToString("00");

                    <article class="support-thread-card @(question.AwaitingDeveloper ? "is-waiting" : "is-replyable")">
                        <div class="support-thread-index" aria-hidden="true">
                            <span>THREAD</span>
                            <strong>@threadNumber</strong>
                            <i></i>
                        </div>

                        <div class="support-thread-main">
                            <div class="support-thread-topline">
                                <span class="support-thread-status @(question.AwaitingDeveloper ? "is-waiting" : "is-replyable")">
                                    @(question.AwaitingDeveloper
                                        ? Localizer["Question_AwaitingAnswer"]
                                        : Localizer["Question_ContinueConversation"])
                                </span>

                                <span class="support-thread-updated">
                                    @Localizer["MyQuestions_Updated"]
                                    <strong>@question.UpdatedAtUtc.ToLocalTime().ToString("g")</strong>
                                </span>
                            </div>

                            <div class="support-thread-preview">@question.Preview</div>
                        </div>

                        <div class="support-thread-actions">
                            <a class="button button-primary"
                               asp-page="/Question"
                               asp-route-token="@question.Token">
                                @Localizer["MyQuestions_Open"]
                            </a>

                            <button type="button"
                                    class="button button-danger-outline"
                                    data-delete-question
                                    data-question-token="@question.Token">
                                @Localizer["Button_Delete"]
                            </button>
                        </div>
                    </article>
                }
            </div>
        }
    </main>
</div>

<dialog id="delete-question-dialog" class="app-dialog support-dialog">
    <form method="post"
          asp-page-handler="Delete"
          class="dialog-card dialog-card-danger support-dialog-card">
        <input type="hidden" id="delete-question-token" name="token" />

        <div class="dialog-heading support-dialog-heading">
            <div>
                <span class="support-dialog-kicker" aria-hidden="true">DELETE / SIGNAL</span>
                <h2>@Localizer["QuestionInbox_DeleteConfirmTitle"]</h2>
                <p class="dialog-warning">
                    @Localizer["QuestionInbox_DeleteConfirmText"]
                </p>
            </div>
        </div>

        <div class="form-actions dialog-actions">
            <button type="button"
                    id="cancel-delete-question"
                    class="button button-secondary">
                @Localizer["Button_Cancel"]
            </button>

            <button type="submit" class="button button-danger">
                @Localizer["Button_Delete"]
            </button>
        </div>
    </form>
</dialog>

<script>
    (() => {
        const dialog = document.getElementById("delete-question-dialog");
        const tokenInput = document.getElementById("delete-question-token");
        const cancelButton = document.getElementById("cancel-delete-question");

        if (!dialog || !tokenInput || !cancelButton) {
            return;
        }

        document.querySelectorAll("[data-delete-question]").forEach(button => {
            button.addEventListener("click", () => {
                tokenInput.value = button.dataset.questionToken;
                dialog.showModal();
            });
        });

        cancelButton.addEventListener("click", () => dialog.close());
    })();
</script>
