@page "{id:guid}"
@model BadWolfQuiz.Web.Pages.Admin.Games.FinalQuestionTransitionModel
@using BadWolfQuiz.Game.Definitions
@{
    ViewData["Title"] = Model.Heading;
    ViewData["HidePortalFooter"] = true;
}

<div class="final-question-transition" data-final-question-transition>
    <div class="final-question-transition-ambient" aria-hidden="true"></div>

    <div class="final-question-transition-content">
        <div class="final-question-transition-heading">
            <span class="final-question-transition-kicker">BAD WOLF QUIZ</span>
            <h1>@Model.Heading</h1>
        </div>

        @if (Model.Blocks.Count > 0)
        {
            <div class="final-question-transition-card">
                <div class="final-question-transition-blocks">
                    @foreach (var block in Model.Blocks)
                    {
                        if (block.Kind == ContentBlockKind.Text && !string.IsNullOrWhiteSpace(block.TextContent))
                        {
                            <div class="game-content-block game-content-text final-question-transition-text">@block.TextContent</div>
                        }
                        else if (block.Kind == ContentBlockKind.Image &&
                                 (block.FileData is { Length: > 0 } || !string.IsNullOrWhiteSpace(block.MediaPath)))
                        {
                            <figure class="game-content-block final-question-transition-image-block">
                                @if (!string.IsNullOrWhiteSpace(block.TopCaption))
                                {
                                    <figcaption class="final-question-transition-caption">@block.TopCaption</figcaption>
                                }
                                <img class="final-question-transition-image"
                                     src="@(block.FileData is { Length: > 0 }
                                         ? Url.Page("FinalQuestionTransition", "ContentBlock", new { id = Model.GameId, sourceContentBlockId = block.SourceContentBlockId })
                                         : block.MediaPath)"
                                     alt="@(block.FileName ?? Model.Heading)" />
                                @if (!string.IsNullOrWhiteSpace(block.BottomCaption))
                                {
                                    <figcaption class="final-question-transition-caption">@block.BottomCaption</figcaption>
                                }
                            </figure>
                        }
                    }
                </div>
            </div>
        }
    </div>

    <form class="final-question-transition-actions"
          method="post"
          asp-page="Lobby"
          asp-route-id="@Model.GameId"
          asp-page-handler="@(Model.Force ? "ForceAdvanceToFinalQuestion" : "StartFinalQuestion")"
          data-final-question-transition-form>
        <button type="submit" class="button button-primary final-question-transition-primary">
            <span>@Model.ProceedToWagersLabel</span>
            <span class="final-question-transition-arrow" aria-hidden="true">→</span>
        </button>
    </form>
</div>

@* Keep the transition CSS inline so host soft navigation inserts the stage and
   its styling atomically. An external @@import produces a visible unstyled frame. *@
<style data-final-question-stage-styles>
body.gameplay-layout:has(.final-question-transition) {
    overflow: hidden;
}

body.gameplay-layout:has(.final-question-transition) > .page-shell {
    box-sizing: border-box;
    width: 100%;
    max-width: none;
    height: calc(100dvh - var(--topbar-height, 60px));
    min-height: 0;
    margin: 0;
    padding: 0;
    overflow: hidden;
}

.final-question-transition {
    position: fixed;
    inset: var(--topbar-height, 60px) 0 0;
    z-index: 900;
    isolation: isolate;
    box-sizing: border-box;
    width: auto;
    max-width: none;
    height: auto;
    min-height: 0;
    margin: 0;
    display: grid;
    grid-template-rows: minmax(0, 1fr) auto;
    gap: clamp(24px, 4vh, 48px);
    padding: clamp(24px, 4vw, 64px);
    overflow: hidden;
    background:
        radial-gradient(circle at 50% 34%, color-mix(in srgb, var(--red-bright) 18%, transparent), transparent 34%),
        linear-gradient(180deg, color-mix(in srgb, var(--panel-2) 76%, #050506), color-mix(in srgb, var(--bg) 90%, #000));
}

.final-question-transition::before,
.final-question-transition::after {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -2;
    pointer-events: none;
}

.final-question-transition::before {
    background: repeating-linear-gradient(
        135deg,
        color-mix(in srgb, var(--text) 2.5%, transparent) 0 1px,
        transparent 1px 18px);
    opacity: .75;
}

.final-question-transition::after {
    background: linear-gradient(180deg, transparent 58%, rgba(0, 0, 0, .42));
}

.final-question-transition-ambient {
    position: absolute;
    inset: auto 50% 5vh auto;
    width: min(70vw, 1100px);
    aspect-ratio: 2.5 / 1;
    transform: translateX(50%);
    border-radius: 50%;
    background: radial-gradient(ellipse, color-mix(in srgb, var(--red) 24%, transparent), transparent 68%);
    filter: blur(28px);
    opacity: .7;
    z-index: -1;
    pointer-events: none;
}

.final-question-transition-content {
    align-self: center;
    justify-self: stretch;
    display: grid;
    justify-items: center;
    gap: clamp(20px, 3vh, 34px);
    width: min(1160px, 100%);
    margin-inline: auto;
    min-height: 0;
}

.final-question-transition-heading {
    display: grid;
    justify-items: center;
    gap: 10px;
    text-align: center;
}

.final-question-transition-kicker {
    color: var(--gold);
    font-size: clamp(.72rem, 1vw, .9rem);
    font-weight: 800;
    letter-spacing: .28em;
    text-transform: uppercase;
    text-shadow: 0 0 18px color-mix(in srgb, var(--gold) 35%, transparent);
}

.final-question-transition h1 {
    margin: 0;
    max-width: 1000px;
    text-align: center;
    font-size: clamp(2.5rem, 6vw, 5.8rem);
    line-height: .94;
    letter-spacing: .045em;
    font-weight: 950;
    text-transform: uppercase;
    text-wrap: balance;
    text-shadow:
        0 3px 0 color-mix(in srgb, var(--red) 48%, transparent),
        0 16px 34px rgba(0, 0, 0, .38);
    animation: final-question-enter 420ms cubic-bezier(.2,.85,.3,1) both;
}

.final-question-transition-card {
    width: min(980px, 100%);
    max-height: min(48vh, 560px);
    overflow: auto;
    box-sizing: border-box;
    padding: clamp(18px, 2.5vw, 30px);
    border: 1px solid color-mix(in srgb, var(--gold) 26%, var(--line));
    border-radius: clamp(18px, 2vw, 28px);
    background:
        linear-gradient(180deg, color-mix(in srgb, var(--panel) 92%, transparent), color-mix(in srgb, var(--panel-2) 94%, transparent));
    box-shadow:
        inset 0 1px 0 color-mix(in srgb, var(--text) 9%, transparent),
        0 24px 64px rgba(0, 0, 0, .34),
        0 0 0 1px color-mix(in srgb, var(--red) 10%, transparent);
    backdrop-filter: blur(12px);
}

.final-question-transition-blocks {
    width: 100%;
    display: grid;
    justify-items: center;
    gap: clamp(16px, 2vh, 26px);
}

.final-question-transition-text {
    width: 100%;
    max-width: none;
    margin: 0;
    text-align: center;
    white-space: pre-wrap;
    font-size: clamp(1.15rem, 2vw, 1.65rem);
    line-height: 1.45;
}

.final-question-transition-image-block {
    margin: 0;
    display: grid;
    justify-items: center;
    gap: 10px;
    max-width: 100%;
}

.final-question-transition-image {
    display: block;
    max-width: min(900px, 100%);
    max-height: 36vh;
    object-fit: contain;
    border-radius: 14px;
    box-shadow: 0 14px 40px rgba(0, 0, 0, .34);
}

.final-question-transition-caption {
    text-align: center;
    font-size: clamp(1rem, 1.6vw, 1.35rem);
    color: var(--muted);
}

.final-question-transition-actions {
    display: flex;
    justify-content: center;
    align-items: center;
    margin: 0;
}

.final-question-transition-primary {
    min-width: min(420px, 100%);
    min-height: 54px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    padding-inline: 28px;
    font-weight: 850;
    letter-spacing: .025em;
    box-shadow: 0 14px 34px color-mix(in srgb, var(--red) 26%, transparent);
}

.final-question-transition-arrow {
    display: inline-block;
    font-size: 1.25em;
    transition: transform 160ms ease;
}

.final-question-transition-primary:hover .final-question-transition-arrow,
.final-question-transition-primary:focus-visible .final-question-transition-arrow {
    transform: translateX(4px);
}

@@keyframes final-question-enter {
    from {
        opacity: 0;
        transform: scale(.9) translateY(10px);
        filter: blur(12px);
    }
    to {
        opacity: 1;
        transform: scale(1) translateY(0);
        filter: blur(0);
    }
}

@@media (max-width: 720px) {
    .final-question-transition {
        gap: 20px;
        padding: 20px 16px 22px;
    }

    .final-question-transition h1 {
        font-size: clamp(2.1rem, 12vw, 4rem);
    }

    .final-question-transition-card {
        max-height: 50vh;
        padding: 16px;
        border-radius: 18px;
    }

    .final-question-transition-primary {
        width: 100%;
        min-width: 0;
    }
}

@@media (max-height: 700px) and (min-width: 721px) {
    .final-question-transition {
        gap: 18px;
        padding-block: 18px;
    }

    .final-question-transition-content {
        gap: 16px;
    }

    .final-question-transition h1 {
        font-size: clamp(2.2rem, 5vw, 4.4rem);
    }

    .final-question-transition-card {
        max-height: 40vh;
    }
}

@@media (prefers-reduced-motion: reduce) {
    .final-question-transition h1 {
        animation: none;
    }

    .final-question-transition-arrow {
        transition: none;
    }
}
</style>
