@page "{id:guid}"
@model BadWolfQuiz.Web.Pages.Admin.Games.FinalQuestionTransitionModel
@{
    ViewData["Title"] = Model.Heading;
    ViewData["HidePortalFooter"] = true;
}

<div class="final-question-transition" data-final-question-transition>
    <h1>@Model.Heading</h1>

    <form method="post"
          asp-page="Lobby"
          asp-route-id="@Model.GameId"
          asp-page-handler="@(Model.Force ? "ForceAdvanceToFinalQuestion" : "StartFinalQuestion")"
          data-final-question-transition-form>
    </form>
</div>

<style>
    .final-question-transition {
        min-height: calc(100vh - var(--topbar-height, 0px));
        display: grid;
        place-items: center;
        padding: clamp(24px, 5vw, 72px);
        overflow: hidden;
    }

    .final-question-transition h1 {
        margin: 0;
        text-align: center;
        font-size: clamp(3rem, 9vw, 8rem);
        line-height: .92;
        letter-spacing: .06em;
        font-weight: 950;
        animation: final-question-enter 320ms cubic-bezier(.2,.85,.3,1) both;
        will-change: transform, opacity, filter;
    }

    @@keyframes final-question-enter {
        from {
            opacity: 0;
            transform: scale(.88);
            filter: blur(10px);
        }
        to {
            opacity: 1;
            transform: scale(1);
            filter: blur(0);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .final-question-transition h1 {
            animation: none;
        }
    }
</style>

<script>
    (() => {
        const form = document.querySelector("[data-final-question-transition-form]");
        if (!(form instanceof HTMLFormElement)) {
            return;
        }

        window.setTimeout(() => form.requestSubmit(), 3000);
    })();
</script>
