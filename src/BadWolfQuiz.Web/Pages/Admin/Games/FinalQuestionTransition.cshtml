@page "{id:guid}"
@model BadWolfQuiz.Web.Pages.Admin.Games.FinalQuestionTransitionModel
@using BadWolfQuiz.Game.Definitions
@{
    ViewData["Title"] = Model.Heading;
    ViewData["HidePortalFooter"] = true;
}

<div class="final-question-transition" data-final-question-transition>
    <div class="final-question-transition-ambient" aria-hidden="true"></div>

    <div class="final-question-transition-content">
        <div class="final-question-transition-heading">
            <span class="final-question-transition-kicker">BAD WOLF QUIZ</span>
            <h1>@Model.Heading</h1>
        </div>

        @if (Model.Blocks.Count > 0)
        {
            <div class="final-question-transition-card">
                <div class="final-question-transition-blocks">
                    @foreach (var block in Model.Blocks)
                    {
                        if (block.Kind == ContentBlockKind.Text && !string.IsNullOrWhiteSpace(block.TextContent))
                        {
                            <div class="game-content-block game-content-text final-question-transition-text">@block.TextContent</div>
                        }
                        else if (block.Kind == ContentBlockKind.Image &&
                                 (block.FileData is { Length: > 0 } || !string.IsNullOrWhiteSpace(block.MediaPath)))
                        {
                            <figure class="game-content-block final-question-transition-image-block">
                                @if (!string.IsNullOrWhiteSpace(block.TopCaption))
                                {
                                    <figcaption class="final-question-transition-caption">@block.TopCaption</figcaption>
                                }
                                <img class="final-question-transition-image"
                                     src="@(block.FileData is { Length: > 0 }
                                         ? Url.Page("FinalQuestionTransition", "ContentBlock", new { id = Model.GameId, sourceContentBlockId = block.SourceContentBlockId })
                                         : block.MediaPath)"
                                     alt="@(block.FileName ?? Model.Heading)" />
                                @if (!string.IsNullOrWhiteSpace(block.BottomCaption))
                                {
                                    <figcaption class="final-question-transition-caption">@block.BottomCaption</figcaption>
                                }
                            </figure>
                        }
                    }
                </div>
            </div>
        }
    </div>

    <form class="final-question-transition-actions"
          method="post"
          asp-page="Lobby"
          asp-route-id="@Model.GameId"
          asp-page-handler="@(Model.Force ? "ForceAdvanceToFinalQuestion" : "StartFinalQuestion")"
          data-final-question-transition-form>
        <button type="submit" class="button button-primary final-question-transition-primary">
            <span>@Model.ProceedToWagersLabel</span>
            <span class="final-question-transition-arrow" aria-hidden="true">→</span>
        </button>
    </form>
</div>

<style data-final-question-stage-styles>
    @@import url("/css/final-question-stage.css");
</style>
