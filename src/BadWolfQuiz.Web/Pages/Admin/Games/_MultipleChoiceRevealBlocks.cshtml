@model BadWolfQuiz.Web.Pages.Admin.Games.MultipleChoiceRevealBlocksViewModel
@{
    var isAllPlayerMultipleChoice =
        Model.PresentationType ==
            BadWolfQuiz.Game.Definitions.QuestionPresentationType.AllPlayerMultipleChoice;
}

<style>
    /* Keep reveal blocks as direct children of the shared runtime block list.
       content-block-containers.js relies on that structure to consume
       __badwolf_container:N__ markers and group their following blocks. */
    .game-content-blocks.multiple-choice-answer-reveal-grid,
    html.all-player-multiple-choice-answer-layout
        .host-game-board .answer-presentation
        > .game-content-blocks.multiple-choice-answer-reveal-grid,
    .host-game-board.all-player-multiple-choice-answer
        .answer-presentation
        > .game-content-blocks.multiple-choice-answer-reveal-grid {
        display: flex !important;
        flex-direction: column !important;
        align-items: center !important;
        align-content: safe center !important;
        grid-template-columns: none !important;
        grid-auto-rows: auto !important;
        width: 100% !important;
        min-width: 0 !important;
        gap: clamp(9px, 1.5vw, 18px) !important;
        overflow-x: hidden !important;
        overflow-y: auto !important;
    }

    /* A host-selected multiple-choice reveal with no additional answer content
       should use the free middle row instead of sitting at its top edge. The
       class is added only by the live host gameplay tag helper and only when
       every rendered block is a correct option, so normal stacked reveals stay
       top-to-bottom and all-player multiple-choice remains unchanged. */
    .game-content-blocks.multiple-choice-answer-reveal-grid.host-multiple-choice-answer-only {
        align-self: stretch !important;
        justify-content: safe center !important;
    }

    /* Legacy all-player answer styles treat every descendant block as an answer
       option. Reset them across the whole shared reveal, including blocks moved
       inside a runtime content container. */
    .game-content-blocks.multiple-choice-answer-reveal-grid
        .game-content-block,
    html.all-player-multiple-choice-answer-layout
        .host-game-board .answer-presentation
        > .game-content-blocks.multiple-choice-answer-reveal-grid
        .game-content-block,
    .host-game-board.all-player-multiple-choice-answer
        .answer-presentation
        > .game-content-blocks.multiple-choice-answer-reveal-grid
        .game-content-block {
        display: block !important;
        width: min(100%, 1100px) !important;
        min-width: 0 !important;
        min-height: 0 !important;
        height: auto !important;
        margin: 0 auto !important;
        padding: 0 !important;
        overflow: visible !important;
        border: 0 !important;
        border-radius: 0 !important;
        text-align: inherit !important;
    }

    .game-content-blocks.multiple-choice-answer-reveal-grid
        > .all-player-answer-option-correct {
        padding: clamp(.55rem, 1vw, .9rem) !important;
        border: 3px solid #2e7d32 !important;
        border-radius: .8rem !important;
        text-align: center !important;
    }

    .game-content-blocks.multiple-choice-answer-reveal-grid
        .game-content-image,
    html.all-player-multiple-choice-answer-layout
        .host-game-board .answer-presentation
        > .game-content-blocks.multiple-choice-answer-reveal-grid
        .game-content-image,
    .host-game-board.all-player-multiple-choice-answer
        .answer-presentation
        > .game-content-blocks.multiple-choice-answer-reveal-grid
        .game-content-image {
        width: auto !important;
        height: auto !important;
        max-width: 100% !important;
        max-height: min(62vh, 720px) !important;
        object-fit: contain !important;
    }

    /* Host gameplay disables the submitted button before replacing the gameplay
       view. Hide the outgoing reveal during that short transition so neither the
       correct-answer border nor stale answer content can flash before the board. */
    .answer-presentation:has(
        form[action*="handler=CloseAnswer"] button:disabled)
    .multiple-choice-answer-reveal-grid {
        visibility: hidden !important;
    }
</style>

@foreach (var block in Model.Blocks)
{
    var isCorrectOption =
        Model.CorrectOptionIds.Contains(block.SourceContentBlockId);
    var correctOptionClass = isAllPlayerMultipleChoice && isCorrectOption
        ? "all-player-answer-option all-player-answer-option-correct"
        : null;
    var additionalClass = !isCorrectOption
        ? "multiple-choice-additional-answer-block"
        : null;

    <article class="game-content-block @correctOptionClass @additionalClass">
        @if (!string.IsNullOrWhiteSpace(block.TopCaption))
        {
            <p class="game-content-caption">@block.TopCaption</p>
        }

        @switch (block.Kind)
        {
            case BadWolfQuiz.Game.Definitions.ContentBlockKind.Text:
                <p class="game-content-text">@block.TextContent</p>
                break;
            case BadWolfQuiz.Game.Definitions.ContentBlockKind.Image:
                <img class="game-content-image"
                     src="@Url.Page(
                         "/Admin/Games/MultipleChoiceAnswerMedia",
                         "ContentBlock",
                         new
                         {
                             id = Model.GameSessionId,
                             sourceQuestionId = Model.SourceQuestionId,
                             sourceContentBlockId = block.SourceContentBlockId
                         })"
                     alt="@block.FileName" />
                break;
            case BadWolfQuiz.Game.Definitions.ContentBlockKind.Audio:
                <div class="game-content-audio-shell">
                    <audio class="game-content-audio"
                           controls
                           preload="metadata"
                           data-autoplay-media="@block.Autoplay.ToString().ToLowerInvariant()"
                           src="@Url.Page(
                               "/Admin/Games/MultipleChoiceAnswerMedia",
                               "ContentBlock",
                               new
                               {
                                   id = Model.GameSessionId,
                                   sourceQuestionId = Model.SourceQuestionId,
                                   sourceContentBlockId = block.SourceContentBlockId
                               })">
                        @Localizer["GameBoard_AudioUnsupported"]
                    </audio>
                </div>
                break;
            case BadWolfQuiz.Game.Definitions.ContentBlockKind.Video:
                <video class="game-content-video"
                       controls
                       data-autoplay-media="@block.Autoplay.ToString().ToLowerInvariant()"
                       src="@block.ExternalUrl">
                </video>
                break;
            case BadWolfQuiz.Game.Definitions.ContentBlockKind.YouTube:
                <button class="youtube-placeholder"
                        type="button"
                        data-youtube-placeholder
                        data-youtube-autoplay="@block.Autoplay.ToString().ToLowerInvariant()"
                        data-youtube-embed-url="@(YouTubeEmbedUrlBuilder.GetYouTubeEmbedUrl(block.ExternalUrl) + "&fs=0")"
                        data-youtube-frame-class="game-content-video youtube-auto-expand"
                        data-youtube-title="@Localizer["GameBoard_MediaContent"]"
                        data-youtube-close-label="@Localizer["GameBoard_CloseVideo"]"
                        data-youtube-allow-fullscreen="false"
                        aria-label="@Localizer["GameBoard_MediaContent"]">
                    <img class="youtube-placeholder-image"
                         src="~/images/youtube-placeholder.svg"
                         alt=""
                         aria-hidden="true" />
                    <span class="youtube-placeholder-play" aria-hidden="true"></span>
                </button>
                break;
        }

        @if (!string.IsNullOrWhiteSpace(block.BottomCaption))
        {
            <p class="game-content-caption">@block.BottomCaption</p>
        }
    </article>
}