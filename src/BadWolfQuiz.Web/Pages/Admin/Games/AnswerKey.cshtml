@page "{id:guid}"
@model BadWolfQuiz.Web.Pages.Admin.Games.AnswerKeyModel
@{
    ViewData["Title"] = Localizer["AnswerKey_Title"];
    ViewData["HidePortalFooter"] = true;
}

@section HeaderContext {
    <div class="game-header-context answer-key-header-context">
        <h2>@Localizer["Label_CorrectAnswer"]</h2>
        <button class="button button-secondary icon-button answer-key-visibility-toggle"
                type="button"
                data-answer-key-visibility-toggle
                data-answer-visible="false"
                aria-pressed="false"
                aria-label="@Localizer["Label_CorrectAnswer"]">
            <svg class="answer-key-visibility-icon answer-key-show-icon"
                 viewBox="0 0 24 24"
                 aria-hidden="true">
                <path d="M2.5 12s3.5-6 9.5-6 9.5 6 9.5 6-3.5 6-9.5 6-9.5-6-9.5-6Z"></path>
                <circle cx="12" cy="12" r="3"></circle>
            </svg>
            <svg class="answer-key-visibility-icon answer-key-hide-icon"
                 viewBox="0 0 24 24"
                 aria-hidden="true">
                <path d="M3 3l18 18"></path>
                <path d="M10.6 6.2A10.7 10.7 0 0 1 12 6c6 0 9.5 6 9.5 6a14.7 14.7 0 0 1-2.1 3"></path>
                <path d="M6.2 6.2C3.8 8 2.5 12 2.5 12s3.5 6 9.5 6c1.4 0 2.7-.3 3.8-.8"></path>
                <path d="M9.9 9.9A3 3 0 0 0 14.1 14.1"></path>
            </svg>
        </button>
    </div>
}

<link rel="stylesheet" href="~/css/youtube-placeholder.css" asp-append-version="true" />
<link rel="stylesheet" href="~/css/answer-key.css" asp-append-version="true" />

<section class="answer-key-page"
         data-game-code="@Model.Game.PublicCode"
         data-game-status="@Model.Game.Session.Status.ToString().ToLowerInvariant()"
         data-source-question-id="@Model.CurrentSourceQuestionId">
    @if (Model.AnswerBlocks.Count == 0)
    {
        <div class="content-panel answer-key-waiting">
            <p>@Localizer["AnswerKey_Waiting"]</p>
        </div>
    }
    else
    {
        <div class="answer-key-hidden-placeholder"
             data-answer-key-hidden-placeholder>
            <svg class="answer-key-hidden-icon"
                 viewBox="0 0 24 24"
                 aria-hidden="true">
                <path d="M3 3l18 18"></path>
                <path d="M10.6 6.2A10.7 10.7 0 0 1 12 6c6 0 9.5 6 9.5 6a14.7 14.7 0 0 1-2.1 3"></path>
                <path d="M6.2 6.2C3.8 8 2.5 12 2.5 12s3.5 6 9.5 6c1.4 0 2.7-.3 3.8-.8"></path>
                <path d="M9.9 9.9A3 3 0 0 0 14.1 14.1"></path>
            </svg>
            <strong>@Localizer["Label_CorrectAnswer"]</strong>
            <span>@Localizer["Button_ShowAnswer"]</span>
        </div>

        <section id="answer-key-content"
                 class="content-panel game-content-presentation answer-presentation answer-key-content"
                 data-answer-key-content
                 hidden>
            <div class="game-content-blocks">
                @foreach (var block in Model.AnswerBlocks)
                {
                    <article class="game-content-block">
                        @if (!string.IsNullOrWhiteSpace(block.TopCaption))
                        {
                            <p class="game-content-caption">@block.TopCaption</p>
                        }

                        @switch (block.Kind)
                        {
                            case BadWolfQuiz.Game.Definitions.ContentBlockKind.Text:
                                <p class="game-content-text">@block.TextContent</p>
                                break;
                            case BadWolfQuiz.Game.Definitions.ContentBlockKind.Image:
                                <img class="game-content-image"
                                     src="@Url.Page(
                                         "/Admin/Games/AnswerKey",
                                         "ContentBlock",
                                         new
                                         {
                                             id = Model.Game.Session.Id.Value,
                                             sourceContentBlockId = block.SourceContentBlockId,
                                             final = Model.IsFinalQuestion
                                         })"
                                     alt="@block.FileName" />
                                break;
                            case BadWolfQuiz.Game.Definitions.ContentBlockKind.Audio:
                                <div class="game-content-audio-shell">
                                    <audio class="game-content-audio"
                                           controls
                                           preload="metadata"
                                           src="@Url.Page(
                                               "/Admin/Games/AnswerKey",
                                               "ContentBlock",
                                               new
                                               {
                                                   id = Model.Game.Session.Id.Value,
                                                   sourceContentBlockId = block.SourceContentBlockId,
                                                   final = Model.IsFinalQuestion
                                               })">
                                        @Localizer["GameBoard_AudioUnsupported"]
                                    </audio>
                                </div>
                                break;
                            case BadWolfQuiz.Game.Definitions.ContentBlockKind.Video:
                                <video class="game-content-video"
                                       controls
                                       src="@block.ExternalUrl">
                                </video>
                                break;
                            case BadWolfQuiz.Game.Definitions.ContentBlockKind.YouTube:
                                <button class="youtube-placeholder"
                                        type="button"
                                        data-youtube-placeholder
                                        data-youtube-embed-url="@YouTubeEmbedUrlBuilder.GetYouTubeEmbedUrl(block.ExternalUrl)"
                                        data-youtube-frame-class="game-content-video"
                                        data-youtube-title="@Localizer["GameBoard_MediaContent"]"
                                        aria-label="@Localizer["GameBoard_MediaContent"]">
                                    <img class="youtube-placeholder-image"
                                         src="~/images/youtube-placeholder.svg"
                                         alt=""
                                         aria-hidden="true" />
                                    <span class="youtube-placeholder-play" aria-hidden="true"></span>
                                </button>
                                break;
                        }

                        @if (!string.IsNullOrWhiteSpace(block.BottomCaption))
                        {
                            <p class="game-content-caption">@block.BottomCaption</p>
                        }
                    </article>
                }
            </div>
        </section>
    }
</section>

@section Scripts {
    <script>
        (() => {
            const page = document.querySelector(".answer-key-page");
            const toggle = document.querySelector("[data-answer-key-visibility-toggle]");
            const content = document.querySelector("[data-answer-key-content]");
            const placeholder = document.querySelector("[data-answer-key-hidden-placeholder]");

            if (!page || !toggle) {
                return;
            }

            const storageKey = `badwolf-answer-key-visible:${page.dataset.gameCode ?? ""}`;

            const readStoredVisibility = () => {
                try {
                    return window.sessionStorage.getItem(storageKey) === "true";
                } catch {
                    return false;
                }
            };

            const storeVisibility = isVisible => {
                try {
                    window.sessionStorage.setItem(storageKey, isVisible.toString());
                } catch {
                    // Storage can be unavailable in restricted browser contexts.
                }
            };

            const setAnswerVisibility = isVisible => {
                toggle.dataset.answerVisible = isVisible ? "true" : "false";
                toggle.setAttribute("aria-pressed", isVisible.toString());

                if (content) {
                    content.hidden = !isVisible;
                }

                if (placeholder) {
                    placeholder.hidden = isVisible;
                }
            };

            setAnswerVisibility(readStoredVisibility());

            toggle.addEventListener("click", () => {
                const isVisible = toggle.dataset.answerVisible !== "true";
                storeVisibility(isVisible);
                setAnswerVisibility(isVisible);
            });
        })();
    </script>

    <script>
        (() => {
            const page = document.querySelector(".answer-key-page");

            if (!page || typeof signalR === "undefined") {
                return;
            }

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/game")
                .withAutomaticReconnect()
                .build();
            const finalQuestionStatuses = new Set([
                "finalwagering",
                "finalanswering",
                "finaljudging"
            ]);
            const renderedQuestionId = Number.parseInt(
                page.dataset.sourceQuestionId ?? "",
                10);
            let currentStatus = (page.dataset.gameStatus ?? "").toLowerCase();
            let currentQuestionId = Number.isInteger(renderedQuestionId)
                ? renderedQuestionId
                : null;
            let reloadRequested = false;

            const requestReload = () => {
                if (reloadRequested) {
                    return;
                }

                reloadRequested = true;
                window.location.reload();
            };

            connection.on("GameStatusChanged", update => {
                const nextStatus = typeof update?.status === "string"
                    ? update.status.toLowerCase()
                    : null;

                if (!nextStatus) {
                    return;
                }

                const enteredFinalQuestion =
                    currentStatus === "running" &&
                    finalQuestionStatuses.has(nextStatus);
                currentStatus = nextStatus;

                if (enteredFinalQuestion) {
                    requestReload();
                }
            });

            connection.on("BuzzerStateChanged", update => {
                const nextQuestionId = Number.isInteger(update?.sourceQuestionId)
                    ? update.sourceQuestionId
                    : null;

                if (nextQuestionId === null ||
                    nextQuestionId === currentQuestionId) {
                    return;
                }

                currentQuestionId = nextQuestionId;
                requestReload();
            });

            const joinSession = () => connection.invoke(
                "JoinSession",
                page.dataset.gameCode);

            connection.onreconnected(joinSession);
            connection.start()
                .then(joinSession)
                .catch(console.error);
        })();
    </script>
}
