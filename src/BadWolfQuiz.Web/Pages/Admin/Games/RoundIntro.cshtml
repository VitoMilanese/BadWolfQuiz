@page "{id:guid}"
@model BadWolfQuiz.Web.Pages.Admin.Games.RoundIntroModel
@using BadWolfQuiz.Game.Definitions
@{
    ViewData["Title"] = Model.Heading;
    ViewData["HidePortalFooter"] = true;
}

<div class="game-intro-page" data-game-intro-page>
    <div class="game-intro-group @(Model.Blocks.Count == 0 ? "game-intro-group-empty" : null)" data-game-intro-group>
        <h1 class="game-intro-heading">@Model.Heading</h1>

        @if (Model.Blocks.Count > 0)
        {
            <div class="game-intro-blocks">
                @foreach (var block in Model.Blocks)
                {
                    if (block.Kind == ContentBlockKind.Text && !string.IsNullOrWhiteSpace(block.TextContent))
                    {
                        <div class="game-content-block game-content-text game-intro-text">@block.TextContent</div>
                    }
                    else if (block.Kind == ContentBlockKind.Image &&
                             (block.FileData is { Length: > 0 } || !string.IsNullOrWhiteSpace(block.MediaPath)))
                    {
                        <figure class="game-content-block game-intro-image-block">
                            @if (!string.IsNullOrWhiteSpace(block.TopCaption))
                            {
                                <figcaption class="game-intro-caption">@block.TopCaption</figcaption>
                            }
                            <img class="game-intro-image"
                                 src="@(block.FileData is { Length: > 0 }
                                     ? Url.Page("RoundIntro", "ContentBlock", new { id = Model.GameId, sourceContentBlockId = block.SourceContentBlockId })
                                     : block.MediaPath)"
                                 alt="@(block.FileName ?? Model.Heading)" />
                            @if (!string.IsNullOrWhiteSpace(block.BottomCaption))
                            {
                                <figcaption class="game-intro-caption">@block.BottomCaption</figcaption>
                            }
                        </figure>
                    }
                }
            </div>
        }
    </div>

    <div class="game-intro-actions" data-game-intro-actions>
        @if (Model.IsFinalCategory || Model.CategoryCount == 0)
        {
            <form method="post"
                  asp-page-handler="Start"
                  asp-route-id="@Model.GameId"
                  data-game-intro-start>
                <button type="submit" class="button button-primary">@Model.StartGameLabel</button>
            </form>
        }
        else
        {
            <form method="post"
                  asp-page-handler="Start"
                  asp-route-id="@Model.GameId"
                  data-game-intro-start>
                <button type="submit" class="button button-secondary">@Model.SkipLabel</button>
            </form>

            <a class="button button-primary"
               data-game-intro-next
               asp-page="RoundIntro"
               asp-route-id="@Model.GameId"
               asp-route-category="@Model.NextCategoryIndex">
                @Model.NextLabel
            </a>
        }
    </div>
</div>

<style>
    main.page-shell:has(> .game-intro-page) {
        height: calc(100dvh - var(--topbar-height, 0px));
        min-height: 0;
        overflow: hidden;
    }

    main.page-shell:has(> .game-intro-page) > .game-intro-page {
        height: 100%;
        min-height: 0;
    }

    .game-intro-page {
        min-height: calc(100vh - var(--topbar-height, 0px));
        display: grid;
        grid-template-rows: minmax(0, 1fr) auto;
        gap: clamp(24px, 4vh, 48px);
        padding: clamp(24px, 5vw, 72px);
        overflow: hidden;
    }

    .game-intro-group {
        align-self: center;
        justify-self: stretch;
        display: grid;
        justify-items: center;
        gap: clamp(20px, 3vh, 36px);
        width: min(1100px, 100%);
        margin-inline: auto;
        animation: game-intro-enter 260ms cubic-bezier(.2,.85,.3,1) both;
        will-change: transform, opacity, filter;
    }

    .game-intro-group-empty {
        align-self: center;
    }

    .game-intro-heading {
        margin: 0;
        text-align: center;
        font-size: clamp(2.8rem, 7vw, 7rem);
        line-height: 0.95;
        letter-spacing: 0.04em;
        font-weight: 950;
    }

    .game-intro-blocks {
        width: min(980px, 100%);
        display: grid;
        justify-items: center;
        gap: clamp(18px, 2.5vh, 30px);
    }

    .game-intro-text {
        width: 100%;
        text-align: center;
        white-space: pre-wrap;
        font-size: clamp(1.2rem, 2.2vw, 2rem);
    }

    .game-intro-image-block {
        margin: 0;
        display: grid;
        justify-items: center;
        gap: 10px;
        max-width: 100%;
    }

    .game-intro-image {
        display: block;
        max-width: min(900px, 100%);
        max-height: 52vh;
        object-fit: contain;
        border-radius: 12px;
    }

    .game-intro-caption {
        text-align: center;
        font-size: clamp(1rem, 1.6vw, 1.35rem);
    }

    .game-intro-actions {
        display: flex;
        justify-content: center;
        align-items: center;
        gap: 12px;
        flex-wrap: wrap;
        animation: game-intro-actions-enter 220ms 70ms ease-out both;
    }

    .game-intro-actions form {
        margin: 0;
    }

    .game-intro-page.is-leaving .game-intro-group {
        animation: game-intro-leave 170ms cubic-bezier(.55,.05,.85,.45) both;
    }

    .game-intro-page.is-leaving .game-intro-actions {
        animation: game-intro-actions-leave 130ms ease-in both;
    }

    @@keyframes game-intro-enter {
        from {
            opacity: 0;
            transform: translate3d(7vw, 0, 0) scale(.965);
            filter: blur(8px);
        }
        to {
            opacity: 1;
            transform: translate3d(0, 0, 0) scale(1);
            filter: blur(0);
        }
    }

    @@keyframes game-intro-leave {
        from {
            opacity: 1;
            transform: translate3d(0, 0, 0) scale(1);
            filter: blur(0);
        }
        to {
            opacity: 0;
            transform: translate3d(-7vw, 0, 0) scale(.965);
            filter: blur(7px);
        }
    }

    @@keyframes game-intro-actions-enter {
        from { opacity: 0; transform: translateY(8px); }
        to { opacity: 1; transform: translateY(0); }
    }

    @@keyframes game-intro-actions-leave {
        from { opacity: 1; }
        to { opacity: 0; }
    }

    @@media (prefers-reduced-motion: reduce) {
        .game-intro-group,
        .game-intro-actions,
        .game-intro-page.is-leaving .game-intro-group,
        .game-intro-page.is-leaving .game-intro-actions {
            animation: none;
        }
    }
</style>

<script>
    (() => {
        if (window.badWolfInitialRoundIntroNavigationInitialized) {
            return;
        }

        window.badWolfInitialRoundIntroNavigationInitialized = true;
        const introSelector = "[data-game-intro-page]";
        const nextSelector = "[data-game-intro-next]";
        const startFormSelector = "form[data-game-intro-start]";
        let navigationInProgress = false;

        const loadFrame = async targetUrl => {
            const response = await fetch(targetUrl.href, {
                method: "GET",
                credentials: "same-origin",
                headers: {
                    Accept: "text/html",
                    "X-Requested-With": "XMLHttpRequest"
                },
                cache: "no-store"
            });
            if (!response.ok) {
                throw new Error(response.statusText);
            }

            const parsed = new DOMParser().parseFromString(
                await response.text(),
                "text/html");
            const currentPage = document.querySelector(introSelector);
            const nextPage = parsed.querySelector(introSelector);
            if (!currentPage || !nextPage) {
                throw new Error("The next first-round intro frame is unavailable.");
            }

            currentPage.replaceWith(document.importNode(nextPage, true));
            const nextTitle = parsed.querySelector("title")?.textContent;
            if (nextTitle) {
                document.title = nextTitle;
            }

            history.replaceState(
                { badWolfInitialRoundIntro: true },
                "",
                response.url || targetUrl.href);
        };

        const hostShellMountedEventName = "badwolf:host-shell-mounted";
        const rerunnableScriptPaths = new Set([
            "/js/player-admission-menu.js"
        ]);

        const executePageScript = async (source, baseUrl, loadedScriptUrls) => {
            const sourcePath = source.getAttribute("src");
            if (sourcePath) {
                const sourceUrl = new URL(sourcePath, baseUrl).href;
                const pathname = new URL(sourceUrl).pathname.toLowerCase();
                const canRerun = rerunnableScriptPaths.has(pathname);
                if (loadedScriptUrls.has(sourceUrl) && !canRerun) {
                    return;
                }

                await new Promise((resolve, reject) => {
                    const script = document.createElement("script");
                    for (const attribute of source.attributes) {
                        if (attribute.name.toLowerCase() !== "src") {
                            script.setAttribute(attribute.name, attribute.value);
                        }
                    }
                    script.src = sourceUrl;
                    script.async = false;
                    script.addEventListener("load", resolve, { once: true });
                    script.addEventListener("error", () =>
                        reject(new Error(`Could not load ${sourceUrl}.`)),
                    { once: true });
                    document.body.append(script);
                });
                loadedScriptUrls.add(sourceUrl);
                return;
            }

            if (!source.textContent?.trim()) {
                return;
            }

            const script = document.createElement("script");
            for (const attribute of source.attributes) {
                script.setAttribute(attribute.name, attribute.value);
            }
            script.textContent = source.textContent;
            document.body.append(script);
            script.remove();
        };

        const importWithoutScripts = element => {
            const clone = document.importNode(element, true);
            clone.querySelectorAll("script").forEach(script => script.remove());
            return clone;
        };

        const installLobby = async (markup, targetUrl) => {
            const parsed = new DOMParser().parseFromString(markup, "text/html");
            const currentMain = document.querySelector("main.page-shell");
            const nextMain = parsed.querySelector("main.page-shell");
            const currentHeaderContext = document.querySelector(".topbar-page-context");
            const nextHeaderContext = parsed.querySelector(".topbar-page-context");
            if (!currentMain || !nextMain || !currentHeaderContext || !nextHeaderContext) {
                throw new Error("The running game shell is unavailable.");
            }

            const pageScripts = Array.from(parsed.body.querySelectorAll("script"));
            const loadedScriptUrls = new Set(
                Array.from(document.scripts, script => script.src)
                    .filter(Boolean));

            const nextMainClone = importWithoutScripts(nextMain);
            currentMain.replaceChildren(...Array.from(nextMainClone.childNodes));

            const nextHeaderContextClone = importWithoutScripts(nextHeaderContext);
            currentHeaderContext.replaceChildren(
                ...Array.from(nextHeaderContextClone.childNodes));

            document.body.className = parsed.body.className;
            const nextTheme = parsed.documentElement.getAttribute("data-theme");
            if (nextTheme === null) {
                document.documentElement.removeAttribute("data-theme");
            } else {
                document.documentElement.setAttribute("data-theme", nextTheme);
            }
            const nextRootStyle = parsed.documentElement.getAttribute("style");
            if (nextRootStyle === null) {
                document.documentElement.removeAttribute("style");
            } else {
                document.documentElement.setAttribute("style", nextRootStyle);
            }

            const nextTitle = parsed.querySelector("title")?.textContent;
            if (nextTitle) {
                document.title = nextTitle;
            }
            history.replaceState(
                { badWolfInitialRoundStarted: true },
                "",
                targetUrl.href);

            for (const source of pageScripts) {
                await executePageScript(source, targetUrl.href, loadedScriptUrls);
            }

            document.dispatchEvent(new CustomEvent(hostShellMountedEventName));
        };

        const startGame = async form => {
            const response = await fetch(form.action, {
                method: "POST",
                credentials: "same-origin",
                body: new FormData(form),
                headers: {
                    Accept: "text/html",
                    "X-Requested-With": "XMLHttpRequest"
                },
                cache: "no-store"
            });
            if (!response.ok) {
                throw new Error(response.statusText);
            }

            const targetUrl = new URL(response.url || form.action, window.location.href);
            const currentUrl = new URL(window.location.href);
            if (targetUrl.origin !== currentUrl.origin ||
                !targetUrl.pathname.toLowerCase().includes("/admin/games/lobby/")) {
                throw new Error("The first-round intro did not finish in the game lobby.");
            }

            await installLobby(await response.text(), targetUrl);
        };

        document.addEventListener("click", event => {
            if (navigationInProgress ||
                event.defaultPrevented ||
                event.button !== 0 ||
                event.metaKey ||
                event.ctrlKey ||
                event.shiftKey ||
                event.altKey) {
                return;
            }

            const target = event.target instanceof Element ? event.target : null;
            const next = target?.closest(nextSelector);
            if (!(next instanceof HTMLAnchorElement)) {
                return;
            }

            const targetUrl = new URL(next.href, window.location.href);
            const currentUrl = new URL(window.location.href);
            if (targetUrl.origin !== currentUrl.origin ||
                targetUrl.pathname.toLowerCase() !== currentUrl.pathname.toLowerCase()) {
                return;
            }

            event.preventDefault();
            event.stopImmediatePropagation();
            navigationInProgress = true;
            const page = next.closest(introSelector);
            const navigate = () => loadFrame(targetUrl)
                .catch(error => {
                    console.error("Initial round intro frame navigation failed.", error);
                    window.location.assign(targetUrl.href);
                })
                .finally(() => {
                    navigationInProgress = false;
                });

            if (page &&
                !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                page.classList.add("is-leaving");
                window.setTimeout(() => void navigate(), 165);
            } else {
                void navigate();
            }
        }, true);

        document.addEventListener("submit", event => {
            const form = event.target instanceof HTMLFormElement
                ? event.target
                : null;
            if (!form?.matches(startFormSelector) || navigationInProgress) {
                return;
            }

            event.preventDefault();
            event.stopImmediatePropagation();
            navigationInProgress = true;
            const submitter = event.submitter instanceof HTMLElement
                ? event.submitter
                : null;
            submitter?.setAttribute("disabled", "disabled");
            const page = form.closest(introSelector);
            const navigate = () => startGame(form)
                .catch(error => {
                    console.error("Initial round intro start failed.", error);
                    page?.classList.remove("is-leaving");
                    submitter?.removeAttribute("disabled");
                    navigationInProgress = false;
                    form.submit();
                });

            if (page &&
                !window.matchMedia("(prefers-reduced-motion: reduce)").matches) {
                page.classList.add("is-leaving");
                window.setTimeout(() => void navigate(), 165);
            } else {
                void navigate();
            }
        }, true);
    })();
</script>
