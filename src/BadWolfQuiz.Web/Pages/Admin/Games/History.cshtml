@page
@model BadWolfQuiz.Web.Pages.Admin.Games.HistoryModel
@{
    ViewData["Title"] = Localizer["GameHistory_Title"];
}

<div class="page-heading">
    <div>
        <p class="eyebrow">@Localizer["Admin_Eyebrow"]</p>
        <h1>@Localizer["GameHistory_Title"]</h1>
        <p>@Localizer["GameHistory_Description"]</p>
    </div>
</div>

@if (Model.Games.Count == 0)
{
    <section class="content-panel empty-state">
        <p>@Localizer["GameHistory_Empty"]</p>
    </section>
}
else
{
    <div class="game-history-list">
        @foreach (var game in Model.Games)
        {
            <article class="content-panel game-history-card">
                <div>
                    <p class="eyebrow">@game.PublicCode</p>
                    <h2>@game.QuizTitle</h2>
                    <p>
                        @Localizer["GameHistory_FinishedAt"]:
                        <time datetime="@game.FinishedAtUtc.ToString("O")">
                            @game.FinishedAtUtc.ToLocalTime().ToString("g")
                        </time>
                    </p>
                    <small>@Localizer["GameHistory_PlayerCount", game.PlayerCount]</small>
                    @if (game.Winners.Count > 0)
                    {
                        <p class="game-history-winner">
                            <strong>
                                @(game.Winners.Count == 1
                                    ? Localizer["GameHistory_Winner"]
                                    : Localizer["GameHistory_Winners"]):
                            </strong>
                            @string.Join(", ", game.Winners)
                            <span class="@(game.WinningScore < 0 ? "score-negative" : null)">
                                (@game.WinningScore)
                            </span>
                        </p>
                    }
                </div>

                <a class="button button-secondary"
                   asp-page="HistoryDetails"
                   asp-route-id="@game.Id">
                    @Localizer["GameHistory_View"]
                </a>
            </article>
        }
    </div>
}
