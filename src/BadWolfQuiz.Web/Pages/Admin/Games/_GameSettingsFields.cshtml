@using BadWolfQuiz.Web.Data
@using BadWolfQuiz.Web.Services
@using Microsoft.EntityFrameworkCore
@model BadWolfQuiz.Web.Pages.Admin.Games.LobbyModel
@inject CurrentHost CurrentHost
@inject PremiumHostAccess PremiumHostAccess
@inject QuizDbContext Db
@inject Microsoft.Extensions.Options.IOptions<FooterOptions> FooterOptions
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment FrameEnvironment
@inject IStringLocalizer<ContributorResource> ContributorLocalizer
@{
    var currentHostId = CurrentHost.RequiredId;
    var canUseAvatarFrame = PremiumHostAccess.IsPremium(currentHostId);
    if (!canUseAvatarFrame)
    {
        var currentHostDisplayName = await Db.Hosts
            .AsNoTracking()
            .Where(host => host.Id == currentHostId)
            .Select(host => host.DisplayName)
            .SingleOrDefaultAsync();
        canUseAvatarFrame = ContributorRecognition.IsContributor(
            FooterOptions.Value,
            currentHostDisplayName);
    }

    var gameFrameId = ContributorAvatarFrameCatalog.Normalize(
        FrameEnvironment,
        Model.SettingsInput.HostAvatarFrameId);
    var gameFrameUrl = ContributorAvatarFrameCatalog.GetUrl(
        FrameEnvironment,
        gameFrameId);
    var showAvatarFrameSettings = canUseAvatarFrame &&
        !string.IsNullOrWhiteSpace(gameFrameId) &&
        !string.IsNullOrWhiteSpace(gameFrameUrl);
}

<p class="settings-description">
    @Localizer["GameSettings_LobbyDescription"]
</p>
<div class="settings-grid">
    <label>
        <span>@Localizer["GameSettings_BuzzerDuration"]</span>
        <input asp-for="SettingsInput.BuzzerDurationSeconds"
               type="number" min="1" max="3600" required />
    </label>
    <label>
        <span>@Localizer["GameSettings_AnswerDuration"]</span>
        <input asp-for="SettingsInput.AnswerDurationSeconds"
               type="number" min="1" max="3600" required />
    </label>

    <label>
        <span>@Localizer["GameSettings_RegularStartMode"]</span>
        <select asp-for="SettingsInput.RegularQuestionBuzzerStartMode">
            <option value="1">@Localizer["GameSettings_Automatic"]</option>
            <option value="2">@Localizer["GameSettings_Manual"]</option>
        </select>
    </label>
    <label>
        <span>@Localizer["GameSettings_WagerStartMode"]</span>
        <select asp-for="SettingsInput.WagerQuestionAnswerTimerStartMode">
            <option value="1">@Localizer["GameSettings_Automatic"]</option>
            <option value="2">@Localizer["GameSettings_Manual"]</option>
        </select>
    </label>

    <label class="settings-checkbox">
        <input asp-for="SettingsInput.AnswerRewardDecayEnabled"
               type="checkbox"
               data-answer-reward-decay-toggle />
        <span>@Localizer["GameSettings_AnswerRewardDecayEnabled"]</span>
    </label>

    <label data-answer-reward-decay-setting>
        <span>@Localizer["GameSettings_AnswerRewardDecayStartAfter"]</span>
        <input asp-for="SettingsInput.AnswerRewardDecayStartAfterSeconds"
               type="number"
               min="5"
               max="45"
               required />
        <small>@Localizer["GameSettings_AnswerRewardDecayStartAfterHint"]</small>
    </label>

    <label data-answer-reward-decay-setting>
        <span>@Localizer["GameSettings_AnswerRewardDecayMinimum"]</span>
        <input asp-for="SettingsInput.AnswerRewardDecayMinimumPercent"
               type="number"
               min="10"
               max="90"
               required />
        <small>@Localizer["GameSettings_AnswerRewardDecayMinimumHint"]</small>
    </label>
    <label class="settings-checkbox">
        <input asp-for="SettingsInput.AllowNegativeScoreFinalPlayers" type="checkbox" />
        <span>@Localizer["GameSettings_AllowNegativeFinalPlayers"]</span>
    </label>
    <label>
        <span>@Localizer["HostCard_Name"]</span>
        <input asp-for="SettingsInput.HostName" maxlength="80" />
    </label>
    <label>
        <span>@Localizer["HostCard_Source"]</span>
        <select asp-for="SettingsInput.HostVisualSource">
            <option value="0">@Localizer["HostCard_SourceNone"]</option>
            <option value="3">@Localizer["HostCard_SourceAvatar"]</option>
            <option value="1">@Localizer["HostCard_SourceImage"]</option>
            <option value="2">@Localizer["HostCard_SourceWebcam"]</option>
            <option value="4">@Localizer["HostCard_SourceWebcamUrl"]</option>
        </select>
    </label>
    <label class="host-webcam-url-field">
        <span>@Localizer["HostCard_WebcamUrl"]</span>
        <input asp-for="SettingsInput.HostWebcamUrl"
               type="url"
               maxlength="2048"
               placeholder="https://vdo.ninja/?view=..." />
        <small class="form-hint">
            @Localizer["HostCard_WebcamUrlHintPrefix"]
            <a href="https://vdo.ninja/" target="_blank" rel="noopener noreferrer">vdo.ninja</a>.
        </small>
    </label>
    <label class="host-avatar-field">
        <span>@Localizer["HostCard_Avatar"]</span>
        <span class="host-avatar-input-row">
            <input asp-for="SettingsInput.HostAvatarId" type="hidden" data-host-avatar-id />
            <button class="button button-secondary" type="button" data-open-avatar-picker>@Localizer["AvatarPicker_Choose"]</button>
            <img class="host-avatar-preview" data-host-avatar-preview
                 src="@(!string.IsNullOrWhiteSpace(Model.SettingsInput.HostAvatarId) ? $"/avatars/{Model.SettingsInput.HostAvatarId}" : null)"
                 alt="" hidden="@(string.IsNullOrWhiteSpace(Model.SettingsInput.HostAvatarId) ? "hidden" : null)" />
        </span>
    </label>
    <label class="host-image-field">
        <span>@Localizer["HostCard_Image", Model.MaximumImageUploadMegabytes]</span>
        <span class="host-image-input-row">
            <input asp-for="HostImage" type="file" accept="image/*" data-host-image-input />
            <img class="host-image-preview" data-host-image-preview
                 src="@(Model.Game.Session.Settings.HostImageData is not null
                     ? Url.Page("/Admin/Games/Lobby", "HostCardImage", new { id = Model.Game.Session.Id.Value })
                     : null)"
                 alt=""
                 hidden="@(Model.Game.Session.Settings.HostImageData is not null ? null : "hidden")" />
        </span>
    </label>
    @if (showAvatarFrameSettings)
    {
        <div class="contributor-frame-settings" data-contributor-host-frame>
            <strong>@ContributorLocalizer["ContributorFrame_Title"]</strong>
            <label class="settings-checkbox">
                <input type="checkbox"
                       name="SettingsInput.HostAvatarFrameEnabled"
                       value="true"
                       checked="@(Model.SettingsInput.HostAvatarFrameEnabled ? "checked" : null)" />
                <input type="hidden"
                       name="SettingsInput.HostAvatarFrameEnabled"
                       value="false" />
                <span>@ContributorLocalizer["ContributorFrame_Enable"]</span>
            </label>
            <div class="contributor-frame-choice">
                <div class="contributor-frame-choice-row">
                    <img class="contributor-frame-choice-preview"
                         data-contributor-frame-preview
                         src="@gameFrameUrl"
                         alt="" />
                    <button class="button button-secondary"
                            type="button"
                            data-open-contributor-frame-picker>
                        @ContributorLocalizer["ContributorFrame_Label"]
                    </button>
                </div>
                <input type="hidden"
                       name="SettingsInput.HostAvatarFrameId"
                       value="@gameFrameId"
                       data-contributor-frame-id />
            </div>
            <small>@ContributorLocalizer["ContributorFrame_Hint"]</small>
        </div>
    }
</div>

<script>
    (() => {
        const toggle = document.querySelector("[data-answer-reward-decay-toggle]");
        const settings = document.querySelectorAll("[data-answer-reward-decay-setting]");

        const updateRewardDecaySettings = () => {
            const enabled = toggle?.checked ?? false;

            settings.forEach(setting => {
                setting.style.opacity = enabled ? "" : "0.55";

                const input = setting.querySelector("input");
                if (input) {
                    input.readOnly = !enabled;
                    input.style.cursor = enabled ? "" : "not-allowed";
                }
            });
        };

        toggle?.addEventListener("change", updateRewardDecaySettings);
        updateRewardDecaySettings();
    })();
</script>
