@page "{id:guid}"
@model BadWolfQuiz.Web.Pages.Admin.Games.LobbyModel
@{
    ViewData["Title"] = Model.Game.Session.Quiz.Title;
}

@if (Model.Game.Session.Status == BadWolfQuiz.Game.Runtime.GameSessionStatus.Lobby)
{
    <div class="page-heading">
    <div>
        <p class="eyebrow">@Localizer["GameLobby_Eyebrow"]</p>
        <h1>@Model.Game.Session.Quiz.Title</h1>
    </div>

    <a class="button button-secondary" asp-page="/Admin/Quizzes/Index">
        @Localizer["Button_BackToQuizzes"]
    </a>
</div>
}

@if (Model.Game.Session.Status == BadWolfQuiz.Game.Runtime.GameSessionStatus.Lobby)
{
    <section class="content-panel narrow"
             data-game-code="@Model.Game.PublicCode"
             data-status-active="@Localizer["PlayerPresence_Active"]"
             data-status-inactive="@Localizer["PlayerPresence_Inactive"]"
             data-status-disconnected="@Localizer["PlayerPresence_Disconnected"]"
             data-status-rejoinpending="@Localizer["PlayerPresence_RejoinPending"]"
             data-approve-label="@Localizer["GameLobby_ApproveRejoin"]"
             data-remove-player-label="@Localizer["GameBoard_RemovePlayer"]"
             data-remove-player-confirm="@Localizer["GameBoard_RemovePlayerConfirm"]"
             data-active-player-label="@Localizer["GameBoard_ActivePlayer"]"
             data-make-active-label="@Localizer["GameBoard_MakeActivePlayer"]"
             data-active-player-locked="@Model.Game.Session.IsActivePlayerChangeLocked.ToString().ToLowerInvariant()"
             data-game-status="@Model.Game.Session.Status.ToString().ToLowerInvariant()"
             data-lobby-label="@Localizer["GameLobby_StatusLobby"]"
             data-running-label="@Localizer["GameLobby_StatusRunning"]">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="message message-success" role="status" data-auto-dismiss>@successMessage</div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="message message-error">@errorMessage</div>
        }

        <div class="stack-form">
            <div class="game-code-panel">
                <span>@Localizer["Label_GameCode"]</span>
                <img class="join-qr-code lobby-join-qr"
                     src="@Url.Page("/Admin/Games/Lobby", "JoinQrCode", new { id = Model.Game.Session.Id.Value })"
                     width="280"
                     height="280"
                     alt="@Localizer["GameBoard_JoinQrAlt"]" />
                <strong>@Model.Game.PublicCode</strong>
                <small>@Localizer["Message_WaitingPlayers"]</small>
            </div>

            <p>
                <strong>@Localizer["GameLobby_StatusLabel"]:</strong>
                <span id="game-status">@Localizer["GameLobby_StatusLobby"]</span>
            </p>

            <details class="lobby-settings-panel">
                <summary>@Localizer["GameSettings_LobbyTitle"]</summary>
                <form id="start-game-form"
                      method="post"
                      enctype="multipart/form-data"
                      asp-page-handler="UpdateSettings"
                      class="stack-form">
                    <p class="settings-description">
                        @Localizer["GameSettings_LobbyDescription"]
                    </p>
                    <div class="settings-grid">
                        <label>
                            <span>@Localizer["GameSettings_BuzzerDuration"]</span>
                            <input asp-for="SettingsInput.BuzzerDurationSeconds"
                                   type="number"
                                   min="1"
                                   max="3600"
                                   required />
                        </label>
                        <label>
                            <span>@Localizer["GameSettings_AnswerDuration"]</span>
                            <input asp-for="SettingsInput.AnswerDurationSeconds"
                                   type="number"
                                   min="1"
                                   max="3600"
                                   required />
                        </label>
                        <label>
                            <span>@Localizer["GameSettings_RegularStartMode"]</span>
                            <select asp-for="SettingsInput.RegularQuestionBuzzerStartMode">
                                <option value="1">@Localizer["GameSettings_Automatic"]</option>
                                <option value="2">@Localizer["GameSettings_Manual"]</option>
                            </select>
                        </label>
                        <label>
                            <span>@Localizer["GameSettings_WagerStartMode"]</span>
                            <select asp-for="SettingsInput.WagerQuestionAnswerTimerStartMode">
                                <option value="1">@Localizer["GameSettings_Automatic"]</option>
                                <option value="2">@Localizer["GameSettings_Manual"]</option>
                            </select>
                        </label>
                        <label class="settings-checkbox">
                            <input asp-for="SettingsInput.AllowNegativeScoreFinalPlayers"
                                   type="checkbox" />
                            <span>@Localizer["GameSettings_AllowNegativeFinalPlayers"]</span>
                        </label>
                        <label>
                            <span>@Localizer["HostCard_Name"]</span>
                            <input asp-for="SettingsInput.HostName" maxlength="80" />
                        </label>
                        <label>
                            <span>@Localizer["HostCard_Source"]</span>
                            <select asp-for="SettingsInput.HostVisualSource">
                                <option value="0">@Localizer["HostCard_SourceNone"]</option>
                                <option value="1">@Localizer["HostCard_SourceImage"]</option>
                                <option value="2">@Localizer["HostCard_SourceWebcam"]</option>
                                <option value="3">@Localizer["HostCard_SourceAvatar"]</option>
                            </select>
                        </label>
                        <label class="host-avatar-field">
                            <span>@Localizer["HostCard_Avatar"]</span>
                            <span class="host-avatar-input-row">
                                <input asp-for="SettingsInput.HostAvatarId" type="hidden" data-host-avatar-id />
                                <button class="button button-secondary" type="button" data-open-avatar-picker>@Localizer["AvatarPicker_Choose"]</button>
                                <img class="host-avatar-preview" data-host-avatar-preview
                                     src="@(!string.IsNullOrWhiteSpace(Model.SettingsInput.HostAvatarId) ? $"/avatars/{Model.SettingsInput.HostAvatarId}" : null)"
                                     alt="" hidden="@(string.IsNullOrWhiteSpace(Model.SettingsInput.HostAvatarId) ? "hidden" : null)" />
                            </span>
                        </label>
                        <label class="host-image-field">
                            <span>@Localizer["HostCard_Image"]</span>
                            <span class="host-image-input-row">
                                <input asp-for="HostImage" type="file" accept="image/*" data-host-image-input />
                                <img class="host-image-preview"
                                     data-host-image-preview
                                     src="@(Model.Game.Session.Settings.HostImageData is not null
                                         ? Url.Page("/Admin/Games/Lobby", "HostCardImage", new { id = Model.Game.Session.Id.Value })
                                         : null)"
                                     alt=""
                                     hidden="@(Model.Game.Session.Settings.HostImageData is not null ? null : "hidden")" />
                            </span>
                        </label>
                    </div>
                    <div class="form-actions">
                        <button class="button button-secondary" type="submit">
                            @Localizer["GameSettings_SaveForGame"]
                        </button>
                    </div>
                </form>
            </details>
            <partial name="_AvatarPicker" />

            <div class="form-actions">
                <button class="button button-primary"
                        type="submit"
                        form="start-game-form"
                        formaction="@Url.Page(
                            "/Admin/Games/Lobby",
                            "Start",
                            new { id = Model.Game.Session.Id.Value })">
                    @Localizer["GameLobby_StartGame"]
                </button>

                <form method="post" asp-page-handler="RandomActivePlayer">
                    <button class="button button-secondary" type="submit">
                        @Localizer["GameBoard_RandomActivePlayer"]
                    </button>
                </form>
            </div>

            <p>
                <strong>@Localizer["GameLobby_PlayerCount"]:</strong>
                <span id="player-count">@Model.Players.Count</span>
            </p>

            <p>
                <strong>@Localizer["GameLobby_QuestionCount"]:</strong>
                @Model.Game.Session.Board.Questions.Count
            </p>

            <ul id="player-list" class="player-list">
                @foreach (var player in Model.Players)
                {
                    <li class="@(Model.Game.Session.ActivePlayerId == player.Id ? "active-player" : null)"
                        data-player-id="@player.Id.Value">
                        @if (Model.ActivePlayerIds.Contains(player.Id) &&
                             !string.IsNullOrWhiteSpace(player.AvatarId))
                        {
                            <img class="player-list-avatar" src="/avatars/@player.AvatarId" alt="" />
                        }
                        <strong>@player.Name</strong>
                        <span class="player-management">
                            @if (Model.Game.Session.ActivePlayerId == player.Id)
                            {
                                <span class="active-player-badge">
                                    @Localizer["GameBoard_ActivePlayer"]
                                </span>
                            }
                            <span class="player-card-actions">
                                <button class="button button-danger icon-button player-action-button"
                                        type="button"
                                        data-remove-player="@player.Id.Value"
                                        title="@Localizer["GameBoard_RemovePlayer"]"
                                        aria-label="@Localizer["GameBoard_RemovePlayer"]">
                                    <span aria-hidden="true">✕</span>
                                </button>
                                @if (Model.Game.Session.ActivePlayerId != player.Id)
                                {
                                    <button class="button button-secondary icon-button player-action-button"
                                            type="button"
                                            data-make-active-player="@player.Id.Value"
                                            title="@Localizer["GameBoard_MakeActivePlayer"]"
                                            aria-label="@Localizer["GameBoard_MakeActivePlayer"]"
                                            disabled="@(Model.Game.Session.IsActivePlayerChangeLocked ? "disabled" : null)">
                                        <span aria-hidden="true">★</span>
                                    </button>
                                }
                            </span>
                        </span>
                    </li>
                }
            </ul>

            <p class="dialog-warning">@Localizer["GameLobby_TransientNotice"]</p>
        </div>
    </section>
}


@if (Model.Game.Session.Status == BadWolfQuiz.Game.Runtime.GameSessionStatus.Running)
{
    <section class="host-game-board"
             data-game-code="@Model.Game.PublicCode"
             data-status-active="@Localizer["PlayerPresence_Active"]"
             data-status-inactive="@Localizer["PlayerPresence_Inactive"]"
             data-status-disconnected="@Localizer["PlayerPresence_Disconnected"]"
             data-status-rejoinpending="@Localizer["PlayerPresence_RejoinPending"]"
             data-approve-label="@Localizer["GameLobby_ApproveRejoin"]"
             data-remove-player-label="@Localizer["GameBoard_RemovePlayer"]"
             data-remove-player-confirm="@Localizer["GameBoard_RemovePlayerConfirm"]"
             data-active-player-label="@Localizer["GameBoard_ActivePlayer"]"
             data-make-active-label="@Localizer["GameBoard_MakeActivePlayer"]"
             data-active-player-locked="@Model.Game.Session.IsActivePlayerChangeLocked.ToString().ToLowerInvariant()"
             data-game-status="@Model.Game.Session.Status.ToString().ToLowerInvariant()"
             data-lobby-label="@Localizer["GameLobby_StatusLobby"]"
             data-running-label="@Localizer["GameLobby_StatusRunning"]">
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="message message-error">@errorMessage</div>
        }

        @if (Model.CurrentQuestion is null && !Model.IsRoundSummaryVisible)
        {
        <div class="page-heading host-game-heading">
            <div>
                <h2>@Model.Game.Session.CurrentRound.Title</h2>
            </div>

            <div class="form-actions host-game-actions">
                <a class="button button-secondary"
                   asp-page="/Admin/Games/AnswerHistory"
                   asp-route-id="@Model.Game.Session.Id.Value">
                    @Localizer["AnswerHistory_Open"]
                </a>

                <form method="post" asp-page-handler="RandomActivePlayer">
                    <button class="button button-secondary"
                            type="submit"
                            disabled="@(Model.Game.Session.IsActivePlayerChangeLocked ? "disabled" : null)">
                        @Localizer["GameBoard_RandomActivePlayer"]
                    </button>
                </form>

                <a class="button button-secondary"
                   asp-page="/Admin/Games/AnswerKey"
                   asp-route-id="@Model.Game.Session.Id.Value"
                   target="_blank"
                   rel="noopener">
                    @Localizer["AnswerKey_Open"]
                </a>

                <button class="button button-secondary"
                        type="button"
                        data-open-join-code>
                    @Localizer["GameBoard_ShowJoinCode"]
                </button>
            </div>
        </div>
        }

        @if (Model.PreviewQuestion is { } previewQuestion)
        {
            <section class="content-panel question-review-preview">
                <header class="question-review-heading">
                    <div>
                        <p class="eyebrow">@Localizer["GameBoard_QuestionPreview"]</p>
                        <h2>@previewQuestion.CategoryTitle — @previewQuestion.Points</h2>
                    </div>
                    <div class="form-actions question-review-actions">
                        @if (Model.IsPreviewingAnswer)
                        {
                            <a class="button button-secondary"
                               asp-page="/Admin/Games/Lobby"
                               asp-route-id="@Model.Game.Session.Id.Value"
                               asp-route-previewQuestionId="@previewQuestion.SourceQuestionId">
                                @Localizer["GameBoard_ShowQuestion"]
                            </a>
                        }
                        else
                        {
                            <a class="button button-primary"
                               asp-page="/Admin/Games/Lobby"
                               asp-route-id="@Model.Game.Session.Id.Value"
                               asp-route-previewQuestionId="@previewQuestion.SourceQuestionId"
                               asp-route-previewAnswer="true">
                                @Localizer["GameBoard_ShowAnswer"]
                            </a>
                        }
                        <a class="button button-secondary"
                           asp-page="/Admin/Games/Lobby"
                           asp-route-id="@Model.Game.Session.Id.Value">
                            @Localizer["GameBoard_ReturnToBoard"]
                        </a>
                    </div>
                </header>

                <div class="question-review-content">
                    <partial name="_GameContentPreview"
                             model="@(new GameContentPreviewModel(
                                 Model.Game.Session.Id.Value,
                                 previewQuestion.SourceQuestionId,
                                 Model.IsPreviewingAnswer,
                                 Model.IsPreviewingAnswer
                                     ? previewQuestion.AnswerBlocks
                                     : previewQuestion.QuestionBlocks))" />
                </div>
            </section>
        }

        @if (Model.CurrentQuestion is not null)
        {
            <div class="content-panel current-question-summary @(Model.CurrentQuestion.Status == BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.AwaitingWager ? "wager-mode" : null)">
                <div id="game-timer" class="game-timer host-game-timer" hidden>
                    <strong id="game-timer-value">0.0</strong>
                    <form class="game-timer-control game-timer-pause"
                          method="post"
                          asp-page-handler="PauseQuestionTimer">
                        <button type="submit"
                                title="@Localizer["GameTimer_Pause"]"
                                aria-label="@Localizer["GameTimer_Pause"]">⏸</button>
                    </form>
                    <form class="game-timer-control game-timer-resume"
                          method="post"
                          asp-page-handler="ResumeQuestionTimer">
                        <button type="submit"
                                title="@Localizer["GameTimer_Resume"]"
                                aria-label="@Localizer["GameTimer_Resume"]">▶</button>
                    </form>
                </div>
                @if (Model.CurrentQuestion.Status == BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.AwaitingWager)
                {
                <div class="current-question-heading">
                    <strong>@Model.CurrentQuestion.CategoryTitle — @Model.CurrentQuestion.Points</strong>
                    <span>
                        @(Model.CurrentQuestion.Status == BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.AwaitingWager
                            ? Localizer["GameBoard_AwaitingWager"]
                            : Model.CurrentQuestion.Status == BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.Active
                                ? Localizer["GameBoard_WagerAccepted"]
                                : Localizer["GameBoard_QuestionSelected"])
                    </span>
                </div>
                }

                @if (Model.CurrentQuestion.Status == BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.AwaitingWager)
                {
                    var wagerPlayer = Model.Players.First(
                        player => player.Id == Model.CurrentQuestion.SelectedByPlayerId);
                    var wagerLimits = Model.QuestionWagerLimits!.Value;

                    <div class="wager-entry-panel">
                        <div class="wager-player-summary">
                            <span>@Localizer["GameBoard_WagerPlayer"]</span>
                            <strong>@wagerPlayer.Name</strong>
                            <small>
                                @Localizer[
                                    "GameBoard_WagerLimits",
                                    wagerLimits.Minimum,
                                    wagerLimits.Maximum]
                            </small>
                        </div>

                        <form class="question-wager-form"
                              method="post"
                              asp-page-handler="SubmitQuestionWager"
                              data-wager-form
                              data-minimum="@wagerLimits.Minimum"
                              data-maximum="@wagerLimits.Maximum">
                            <input name="sourceQuestionId"
                                   type="hidden"
                                   value="@Model.CurrentQuestion.SourceQuestionId" />

                            <label class="wager-display-label">
                                <span>@Localizer["GameBoard_WagerAmount"]</span>
                                <input class="wager-display"
                                       name="amount"
                                       type="text"
                                       inputmode="none"
                                       readonly
                                       required
                                       aria-live="polite" />
                            </label>

                            <div class="wager-keypad" aria-label="@Localizer["GameBoard_WagerKeypad"]">
                                @foreach (var digit in new[] { 1, 2, 3, 4, 5, 6, 7, 8, 9 })
                                {
                                    <button type="button" data-wager-digit="@digit">@digit</button>
                                }
                                <button type="button"
                                        data-wager-clear
                                        aria-label="@Localizer["GameBoard_ClearWager"]">
                                    C
                                </button>
                                <button type="button" data-wager-digit="0">0</button>
                                <button type="button"
                                        data-wager-backspace
                                        aria-label="@Localizer["GameBoard_DeleteWagerDigit"]">
                                    ⌫
                                </button>
                                <button class="wager-keypad-max"
                                        type="button"
                                        data-wager-max
                                        aria-label="@Localizer["GameBoard_MaximumWager"]">
                                    MAX
                                </button>
                            </div>

                            <p class="wager-validation"
                               data-wager-validation
                               data-valid-label="@Localizer["GameBoard_WagerValid"]"
                               data-invalid-label="@Localizer[
                                   "GameBoard_WagerOutsideLimits",
                                   wagerLimits.Minimum,
                                   wagerLimits.Maximum]">
                                @Localizer[
                                    "GameBoard_WagerOutsideLimits",
                                    wagerLimits.Minimum,
                                    wagerLimits.Maximum]
                            </p>

                            <button class="button button-primary"
                                    type="submit"
                                    data-wager-submit
                                    disabled>
                                @Localizer["GameBoard_AcceptWager"]
                            </button>
                        </form>
                    </div>
                }
                else if (Model.CurrentQuestion.Wager is not null)
                {
                    var wagerPlayer = Model.Players.First(
                        player => player.Id == Model.CurrentQuestion.Wager.PlayerId);

                    <p class="accepted-wager answering-player-header">
                        @Localizer[
                            "GameBoard_AcceptedWagerSummary",
                            wagerPlayer.Name,
                            Model.CurrentQuestion.Wager.Amount]
                    </p>
                }

                @if (Model.CurrentQuestion.Status != BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.AwaitingWager)
                {
                    var isShowingAnswer =
                        Model.CurrentQuestion.Status == BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.ShowingAnswer;
                    var contentBlocks = isShowingAnswer
                        ? Model.CurrentQuestion.AnswerBlocks
                        : Model.CurrentQuestion.QuestionBlocks;

                    <section class="game-content-presentation @(isShowingAnswer ? "answer-presentation" : "question-presentation")">
                        <p class="eyebrow">
                            @(isShowingAnswer
                                ? Localizer["GameBoard_Answer"]
                                : Localizer["GameBoard_Question"])
                        </p>

                        <div class="game-content-blocks">
                            @foreach (var block in contentBlocks)
                            {
                                <article class="game-content-block">
                                    @if (!string.IsNullOrWhiteSpace(block.TopCaption))
                                    {
                                        <p class="game-content-caption">@block.TopCaption</p>
                                    }

                                    @switch (block.Kind)
                                    {
                                        case BadWolfQuiz.Game.Definitions.ContentBlockKind.Text:
                                            <p class="game-content-text">@block.TextContent</p>
                                            break;
                                        case BadWolfQuiz.Game.Definitions.ContentBlockKind.Image:
                                            <img class="game-content-image"
                                                 src="@Url.Page(
                                                     "/Admin/Games/Lobby",
                                                     "ContentBlock",
                                                     new
                                                     {
                                                         id = Model.Game.Session.Id.Value,
                                                         sourceQuestionId = Model.CurrentQuestion.SourceQuestionId,
                                                         sourceContentBlockId = block.SourceContentBlockId,
                                                         answer = isShowingAnswer
                                                     })"
                                                 alt="@block.FileName" />
                                            break;
                                        case BadWolfQuiz.Game.Definitions.ContentBlockKind.Audio:
                                            <audio class="game-content-audio"
                                                   controls
                                                   src="@Url.Page(
                                                       "/Admin/Games/Lobby",
                                                       "ContentBlock",
                                                       new
                                                       {
                                                           id = Model.Game.Session.Id.Value,
                                                           sourceQuestionId = Model.CurrentQuestion.SourceQuestionId,
                                                           sourceContentBlockId = block.SourceContentBlockId,
                                                           answer = isShowingAnswer
                                                       })">
                                            </audio>
                                            break;
                                        case BadWolfQuiz.Game.Definitions.ContentBlockKind.Video:
                                            <video class="game-content-video"
                                                   controls
                                                   src="@block.ExternalUrl">
                                            </video>
                                            break;
                                        case BadWolfQuiz.Game.Definitions.ContentBlockKind.YouTube:
                                            <iframe class="game-content-video"
                                                    src="@LobbyModel.GetYouTubeEmbedUrl(block.ExternalUrl)"
                                                    title="@Localizer["GameBoard_MediaContent"]"
                                                    allowfullscreen>
                                            </iframe>
                                            break;
                                    }

                                    @if (!string.IsNullOrWhiteSpace(block.BottomCaption))
                                    {
                                        <p class="game-content-caption">@block.BottomCaption</p>
                                    }
                                </article>
                            }
                        </div>

                        @if (isShowingAnswer)
                        {
                            <form method="post" asp-page-handler="CloseAnswer">
                                <input name="sourceQuestionId"
                                       type="hidden"
                                       value="@Model.CurrentQuestion.SourceQuestionId" />
                                <button class="button button-primary" type="submit">
                                    @Localizer["GameBoard_ReturnToBoard"]
                                </button>
                            </form>
                        }
                    </section>
                }

            @if (Model.CurrentQuestion.Status is BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.Selected or
                BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.Active)
            {
                var eligiblePlayers = Model.CurrentQuestion.IsSpecial
                    ? Model.Game.Session.AnswerTimer.Status ==
                            BadWolfQuiz.Game.Runtime.GameTimerStatus.Stopped
                        ? Enumerable.Empty<BadWolfQuiz.Game.Runtime.GamePlayer>()
                        : Model.Players.Where(player =>
                            player.Id == Model.CurrentQuestion.Wager!.PlayerId)
                    : Model.CurrentQuestion.AnsweringPlayerId is { } answeringPlayerId
                        ? Model.Players.Where(player => player.Id == answeringPlayerId)
                        : Enumerable.Empty<BadWolfQuiz.Game.Runtime.GamePlayer>();

                @if (!Model.CurrentQuestion.IsSpecial &&
                    Model.Game.BuzzerRace is { } buzzerRace &&
                    buzzerRace.SourceQuestionId == Model.CurrentQuestion.SourceQuestionId)
                {
                    <aside class="buzzer-race-overlay" role="status" aria-live="polite">
                        <div class="buzzer-race-card">
                            <p>@Localizer["GameBoard_BuzzerRaceWinner", buzzerRace.WinnerPlayerName]</p>
                            <ul>
                                @foreach (var latePlayer in buzzerRace.LatePlayers)
                                {
                                    <li>
                                        @Localizer[
                                            "GameBoard_BuzzerRaceLatePlayer",
                                            latePlayer.PlayerName,
                                            latePlayer.DelayMilliseconds]
                                    </li>
                                }
                            </ul>
                        </div>
                    </aside>
                }

                <section class="question-controls">
                    @if (!Model.CurrentQuestion.IsSpecial &&
                        Model.CurrentQuestion.BuzzerStatus ==
                            BadWolfQuiz.Game.Runtime.QuestionBuzzerStatus.Inactive)
                    {
                        <form method="post" asp-page-handler="ActivateBuzzer">
                            <input name="sourceQuestionId"
                                   type="hidden"
                                   value="@Model.CurrentQuestion.SourceQuestionId" />
                            <button class="button button-primary" type="submit">
                                @Localizer["GameBoard_ActivateBuzzer"]
                            </button>
                        </form>
                    }
                    else if (!Model.CurrentQuestion.IsSpecial &&
                        Model.CurrentQuestion.BuzzerStatus ==
                            BadWolfQuiz.Game.Runtime.QuestionBuzzerStatus.Open)
                    {
                        <p class="buzzer-status">@Localizer["GameBoard_WaitingForBuzz"]</p>
                    }

                    @if (Model.CurrentQuestion.IsSpecial &&
                        Model.Game.Session.Settings.WagerQuestionAnswerTimerStartMode ==
                            BadWolfQuiz.Game.Runtime.GamePhaseStartMode.Manual &&
                        Model.Game.Session.AnswerTimer.Status ==
                            BadWolfQuiz.Game.Runtime.GameTimerStatus.Stopped)
                    {
                        <form method="post" asp-page-handler="StartWagerAnswerTimer">
                            <input name="sourceQuestionId"
                                   type="hidden"
                                   value="@Model.CurrentQuestion.SourceQuestionId" />
                            <button class="button button-primary" type="submit">
                                @Localizer["GameBoard_StartAnswerTimer"]
                            </button>
                        </form>
                    }

                    @foreach (var player in eligiblePlayers)
                    {
                        <form class="question-judge-actions"
                              method="post"
                              asp-page-handler="JudgeQuestionAnswer">
                            <input name="sourceQuestionId"
                                   type="hidden"
                                   value="@Model.CurrentQuestion.SourceQuestionId" />
                            <input name="playerId"
                                   type="hidden"
                                   value="@player.Id.Value" />
                            <button class="button judgment-correct-button"
                                    name="isCorrect"
                                    type="submit"
                                    value="true">
                                @Localizer["Message_Correct"]
                            </button>
                            <button class="button judgment-incorrect-button"
                                    name="isCorrect"
                                    type="submit"
                                    value="false">
                                @Localizer["Message_Wrong"]
                            </button>
                        </form>
                    }

                    @if (!Model.CurrentQuestion.IsSpecial)
                    {
                        <form method="post" asp-page-handler="ResolveQuestion">
                            <input name="sourceQuestionId"
                                   type="hidden"
                                   value="@Model.CurrentQuestion.SourceQuestionId" />
                            <button class="button button-secondary" type="submit">
                                @Localizer["GameBoard_NoCorrectAnswer"]
                            </button>
                        </form>
                    }
                </section>
            }
            </div>
        }

        @if (Model.IsRoundSummaryVisible)
        {
            <section class="round-summary" aria-labelledby="round-summary-title">
                <p class="eyebrow">@Localizer["GameBoard_RoundComplete"]</p>
                <h2 id="round-summary-title">@Model.Game.Session.CurrentRound.Title</h2>
                <ol class="round-podium">
                    @foreach (var leader in Model.RoundLeaders)
                    {
                        <li class="round-podium-player @(leader.Position == 1 ? "round-winner" : null)">
                            <span class="round-podium-position">@leader.Position</span>
                            <strong>@leader.PlayerName</strong>
                            <span class="round-podium-score">@leader.Score</span>
                        </li>
                    }
                </ol>
                @if (Model.Game.Session.HasNextRound)
                {
                    <form method="post" asp-page-handler="AdvanceRound">
                        <button class="button button-primary" type="submit">
                            @Localizer["GameBoard_StartNextRound"]
                        </button>
                    </form>
                }
                else
                {
                    @if (Model.Game.Session.Quiz.FinalQuestion is not null)
                    {
                        <form method="post" asp-page-handler="StartFinalQuestion">
                            <button class="button button-primary" type="submit">
                                @Localizer["FinalQuestion_Start"]
                            </button>
                        </form>
                    }
                    else
                    {
                        <p class="round-summary-finished">@Localizer["GameBoard_AllRoundsComplete"]</p>
                    }
                }
            </section>
        }

        @if (Model.CurrentQuestion is null &&
            Model.PreviewQuestion is null &&
            !Model.IsRoundSummaryVisible)
        {
            <div class="host-board-layout">
            @if (Model.Game.Session.Settings.HasHostCard)
            {
                <aside class="board-host-sidebar"
                       data-board-host-slot
                       aria-label="@Model.Game.Session.Settings.HostName">
                    <ul class="board-host-card-list" data-board-host-card-list></ul>
                    <div class="board-host-card-resizer"
                         data-board-host-card-resizer
                         role="separator"
                         aria-label="@Localizer["GameBoard_ResizeHostCard"]"
                         tabindex="0"></div>
                </aside>
            }
            <div class="host-board-grid"
                 style="--board-columns: @Model.BoardCategories.Count">
            @foreach (var category in Model.BoardCategories)
            {
                <section class="host-board-column">
                    <h3>@category.Title</h3>

                    @foreach (var question in category.Questions)
                    {
                        @if (question.Status == BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.Available)
                        {
                            <form method="post" asp-page-handler="SelectQuestion">
                                <input name="sourceQuestionId"
                                       type="hidden"
                                       value="@question.SourceQuestionId" />
                                <button class="host-board-question status-available"
                                        type="submit">
                                    @question.Points
                                </button>
                            </form>
                        }
                        else if (question.Status == BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.Resolved)
                        {
                            <a class="host-board-question status-resolved"
                               asp-page="/Admin/Games/Lobby"
                               asp-route-id="@Model.Game.Session.Id.Value"
                               asp-route-previewQuestionId="@question.SourceQuestionId"
                               aria-label="@Localizer["GameBoard_PreviewResolvedQuestion", question.Points]">
                                @question.Points
                            </a>
                        }
                    }
                </section>
            }
            </div>

            <aside class="board-player-sidebar" aria-label="@Localizer["Label_Players"]">
                <ul id="board-player-list" class="board-player-list">
                    @foreach (var player in Model.Players)
                    {
                        <li data-sidebar-player-id="@player.Id.Value">
                            <span class="board-player-name" title="@player.Name">
                                <span>@player.Name</span>
                            </span>
                            <strong class="board-player-score @(player.Score < 0 ? "score-negative" : null)">
                                @player.Score
                            </strong>
                        </li>
                    }
                </ul>
            </aside>
            </div>
        }

        <form class="player-join-lock-form"
              method="post"
              asp-page-handler="TogglePlayerJoining">
            <button class="player-join-lock @(Model.Game.AllowsNewPlayers ? "is-open" : "is-closed")"
                    type="submit"
                    title="@(Model.Game.AllowsNewPlayers
                        ? Localizer["GameBoard_ClosePlayerJoining"]
                        : Localizer["GameBoard_OpenPlayerJoining"])"
                    aria-label="@(Model.Game.AllowsNewPlayers
                        ? Localizer["GameBoard_ClosePlayerJoining"]
                        : Localizer["GameBoard_OpenPlayerJoining"])">
                <span aria-hidden="true">@(Model.Game.AllowsNewPlayers ? "🔓" : "🔒")</span>
            </button>
        </form>

        <div class="game-scoreboard-resizer"
             data-scoreboard-resizer
             role="separator"
             aria-orientation="horizontal"
             aria-label="@Localizer["GameBoard_ResizePlayerPanel"]"
             aria-valuemin="130"
             aria-valuenow="230"
             tabindex="0"><span></span></div>
        <ul id="player-list" class="game-scoreboard" aria-label="@Localizer["Label_Players"]">
            @if (Model.Game.Session.Settings.HasHostCard)
            {
                <li class="scoreboard-player host-card" data-host-card>
                    <strong>@Model.Game.Session.Settings.HostName</strong>
                    @if (Model.Game.Session.Settings.HostVisualSource == BadWolfQuiz.Game.Runtime.HostVisualSource.Image &&
                         Model.Game.Session.Settings.HostImageData is not null)
                    {
                        <img class="host-card-media"
                             src="@Url.Page("/Admin/Games/Lobby", "HostCardImage", new { id = Model.Game.Session.Id.Value })"
                             alt="@Model.Game.Session.Settings.HostName" />
                    }
                    else if (Model.Game.Session.Settings.HostVisualSource == BadWolfQuiz.Game.Runtime.HostVisualSource.Avatar &&
                             !string.IsNullOrWhiteSpace(Model.Game.Session.Settings.HostAvatarId))
                    {
                        <img class="host-card-media" src="/avatars/@Model.Game.Session.Settings.HostAvatarId" alt="" />
                    }
                    else if (Model.Game.Session.Settings.HostVisualSource == BadWolfQuiz.Game.Runtime.HostVisualSource.Webcam)
                    {
                        @if (!string.IsNullOrWhiteSpace(Model.Game.Session.Settings.HostAvatarId))
                        {
                            <img class="host-card-media" data-host-webcam-fallback src="/avatars/@Model.Game.Session.Settings.HostAvatarId" alt="" />
                        }
                        else if (Model.Game.Session.Settings.HostImageData is not null)
                        {
                            <img class="host-card-media"
                                 data-host-webcam-fallback
                                 src="@Url.Page("/Admin/Games/Lobby", "HostCardImage", new { id = Model.Game.Session.Id.Value })"
                                 alt="@Model.Game.Session.Settings.HostName" />
                        }
                        <video class="host-card-media" data-host-webcam autoplay muted playsinline hidden></video>
                    }
                </li>
            }
            @foreach (var player in Model.Players)
            {
                var questionIsActive = Model.CurrentQuestion?.Status is
                    BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.Selected or
                    BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.Active;
                var isAnswering = questionIsActive &&
                    Model.CurrentQuestion?.AnsweringPlayerId == player.Id;
                var hasAttempted = questionIsActive &&
                    Model.CurrentQuestion?.AnswerAttempts.Any(
                        attempt => attempt.PlayerId == player.Id) == true;

                <li class="scoreboard-player
                           @(Model.Game.Session.ActivePlayerId == player.Id ? "active-player" : null)
                           @(isAnswering ? "question-answering-player" : null)
                           @(hasAttempted ? "question-attempted-player" : null)"
                    data-player-id="@player.Id.Value">
                    @if (Model.ActivePlayerIds.Contains(player.Id) &&
                         !string.IsNullOrWhiteSpace(player.AvatarId))
                    {
                        <img class="player-card-avatar" src="/avatars/@player.AvatarId" alt="" />
                    }
                    <strong>@player.Name</strong>
                    <span class="scoreboard-score @(player.Score < 0 ? "score-negative" : null)">
                        @player.Score
                    </span>
                    <span class="player-card-actions">
                        <button class="button button-danger icon-button player-action-button scoreboard-remove-player"
                                type="button"
                                data-remove-player="@player.Id.Value"
                                title="@Localizer["GameBoard_RemovePlayer"]"
                                aria-label="@Localizer["GameBoard_RemovePlayer"]">
                            <span aria-hidden="true">✕</span>
                        </button>
                        @if (Model.Game.Session.ActivePlayerId != player.Id)
                        {
                            <button class="button button-secondary icon-button player-action-button"
                                    type="button"
                                    data-make-active-player="@player.Id.Value"
                                    title="@Localizer["GameBoard_MakeActivePlayer"]"
                                    aria-label="@Localizer["GameBoard_MakeActivePlayer"]"
                                    disabled="@(Model.Game.Session.IsActivePlayerChangeLocked ? "disabled" : null)">
                                <span aria-hidden="true">★</span>
                            </button>
                        }
                    </span>
                </li>
            }
        </ul>

        <dialog id="join-code-dialog"
                class="join-code-dialog"
                aria-labelledby="join-code-title">
            <div class="join-code-card">
                <button class="join-code-close"
                        type="button"
                        data-close-join-code
                        aria-label="@Localizer["Button_Close"]">
                    ×
                </button>

                <p class="eyebrow">@Localizer["GameBoard_JoinOverlayHint"]</p>
                <h2 id="join-code-title">@Localizer["GameBoard_JoinOverlayTitle"]</h2>
                <img class="join-qr-code"
                     src="@Url.Page("/Admin/Games/Lobby", "JoinQrCode", new { id = Model.Game.Session.Id.Value })"
                     width="320"
                     height="320"
                     alt="@Localizer["GameBoard_JoinQrAlt"]" />
                <strong class="join-code-value">@Model.Game.PublicCode</strong>
            </div>
        </dialog>
    </section>
}

@if (Model.Game.Session.Status is
    BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalWagering or
    BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalAnswering or
    BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalJudging or
    BadWolfQuiz.Game.Runtime.GameSessionStatus.Completed)
{
    var final = Model.Game.Session.FinalQuestion!;
    var showQuestion = Model.Game.Session.Status is
        BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalAnswering or
        BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalJudging;
    var showAnswer =
        Model.Game.Session.Status == BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalJudging;

    <section class="host-game-board final-question-host"
             data-game-code="@Model.Game.PublicCode"
             data-game-status="@Model.Game.Session.Status.ToString().ToLowerInvariant()"
             data-status-active="@Localizer["PlayerPresence_Active"]"
             data-status-inactive="@Localizer["PlayerPresence_Inactive"]"
             data-status-disconnected="@Localizer["PlayerPresence_Disconnected"]"
             data-status-rejoinpending="@Localizer["PlayerPresence_RejoinPending"]"
             data-approve-label="@Localizer["GameLobby_ApproveRejoin"]">
        <div class="form-actions host-game-actions final-game-actions">
            <a class="button button-secondary"
               asp-page="/Admin/Games/AnswerHistory"
               asp-route-id="@Model.Game.Session.Id.Value">
                @Localizer["AnswerHistory_Open"]
            </a>
            <a class="button button-secondary"
               asp-page="/Admin/Games/AnswerKey"
               asp-route-id="@Model.Game.Session.Id.Value"
               target="_blank"
               rel="noopener">
                @Localizer["AnswerKey_Open"]
            </a>
        </div>
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="message message-error">@errorMessage</div>
        }

        <div class="content-panel final-question-panel @(showAnswer ? "final-judging-mode" : null)">
            <p class="eyebrow">@Localizer["FinalQuestion_Title"]</p>

            @if (Model.Game.Session.Status == BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalWagering)
            {
                <h2>@Localizer["FinalQuestion_WaitingForWagers"]</h2>
                <ul class="final-submission-list">
                    @foreach (var submission in final.Submissions)
                    {
                        <li>
                            <strong>@submission.PlayerName</strong>
                            <span>
                                @(submission.Wager is null
                                    ? Localizer["FinalQuestion_NotSubmitted"]
                                    : Localizer["FinalQuestion_Submitted"])
                            </span>
                        </li>
                    }
                </ul>
                <form method="post" asp-page-handler="LockFinalWagers">
                    <button class="button button-primary"
                            type="submit"
                            disabled="@(final.Submissions.Any(item => item.Wager is null) ? "disabled" : null)">
                        @Localizer["FinalQuestion_ShowQuestion"]
                    </button>
                </form>
            }
            else if (showQuestion)
            {
                var blocks = final.Definition.QuestionBlocks;

                @if (!showAnswer)
                {
                    <section class="game-content-presentation question-presentation">
                        <p class="eyebrow">
                            @Localizer["GameBoard_Question"]
                        </p>
                        <div class="game-content-blocks">
                            @foreach (var block in blocks)
                            {
                                <article class="game-content-block">
                                    @if (!string.IsNullOrWhiteSpace(block.TopCaption))
                                    {
                                        <p class="game-content-caption">@block.TopCaption</p>
                                    }
                                    @switch (block.Kind)
                                    {
                                        case BadWolfQuiz.Game.Definitions.ContentBlockKind.Text:
                                            <p class="game-content-text">@block.TextContent</p>
                                            break;
                                        case BadWolfQuiz.Game.Definitions.ContentBlockKind.Image:
                                            <img class="game-content-image"
                                                 src="@Url.Page("/Admin/Games/Lobby", "FinalContentBlock", new { id = Model.Game.Session.Id.Value, sourceContentBlockId = block.SourceContentBlockId, answer = false })"
                                                 alt="@block.FileName" />
                                            break;
                                        case BadWolfQuiz.Game.Definitions.ContentBlockKind.Audio:
                                            <audio class="game-content-audio"
                                                   controls
                                                   src="@Url.Page("/Admin/Games/Lobby", "FinalContentBlock", new { id = Model.Game.Session.Id.Value, sourceContentBlockId = block.SourceContentBlockId, answer = false })">
                                            </audio>
                                            break;
                                        case BadWolfQuiz.Game.Definitions.ContentBlockKind.Video:
                                            <video class="game-content-video" controls src="@block.ExternalUrl"></video>
                                            break;
                                        case BadWolfQuiz.Game.Definitions.ContentBlockKind.YouTube:
                                            <iframe class="game-content-video"
                                                    src="@LobbyModel.GetYouTubeEmbedUrl(block.ExternalUrl)"
                                                    title="@Localizer["GameBoard_MediaContent"]"
                                                    allowfullscreen>
                                            </iframe>
                                            break;
                                    }
                                    @if (!string.IsNullOrWhiteSpace(block.BottomCaption))
                                    {
                                        <p class="game-content-caption">@block.BottomCaption</p>
                                    }
                                </article>
                            }
                        </div>
                    </section>
                }

                @if (Model.Game.Session.Status == BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalAnswering)
                {
                    <ul class="final-submission-list">
                        @foreach (var submission in final.Submissions)
                        {
                            <li>
                                <strong>@submission.PlayerName</strong>
                                <span>
                                    @(submission.Answer is null
                                        ? Localizer["FinalQuestion_NotSubmitted"]
                                        : Localizer["FinalQuestion_Submitted"])
                                </span>
                            </li>
                        }
                    </ul>
                    <form method="post" asp-page-handler="LockFinalAnswers">
                        <button class="button button-primary"
                                type="submit"
                                disabled="@(final.Submissions.Any(item => item.Answer is null) ? "disabled" : null)">
                            @Localizer["FinalQuestion_StartJudging"]
                        </button>
                    </form>
                }
                else
                {
                    var currentSubmission = final.Submissions
                        .First(item => !item.IsCorrect.HasValue);
                    var judgedCount = final.Submissions.Count(item =>
                        item.IsCorrect.HasValue);

                    <div class="final-judging-list">
                        <p class="dialog-warning">
                            @Localizer[
                                "FinalQuestion_JudgingProgress",
                                judgedCount + 1,
                                final.Submissions.Count]
                        </p>
                        <section class="game-content-presentation final-player-answer-presentation">
                            <h2>@currentSubmission.PlayerName</h2>
                            <p class="game-content-text">@currentSubmission.Answer!.Text</p>
                        </section>
                        <form class="question-judge-actions final-judging-actions"
                              method="post"
                              asp-page-handler="JudgeFinalAnswer">
                            <input name="playerId"
                                   type="hidden"
                                   value="@currentSubmission.PlayerId.Value" />
                            <button class="button judgment-correct-button"
                                    name="isCorrect"
                                    type="submit"
                                    value="true">
                                @Localizer["Message_Correct"]
                            </button>
                            <button class="button judgment-incorrect-button"
                                    name="isCorrect"
                                    type="submit"
                                    value="false">
                                @Localizer["Message_Wrong"]
                            </button>
                        </form>
                    </div>
                }
            }
            else
            {
                <h2>@Localizer["FinalQuestion_Results"]</h2>
                <ol class="round-podium">
                    @foreach (var standing in Model.FinalStandings.Take(3))
                    {
                        <li class="round-podium-player @(standing.Position == 1 ? "round-winner" : null)">
                            <span class="round-podium-position">@standing.Position</span>
                            <strong>@standing.PlayerName</strong>
                            <span class="round-podium-score">@standing.Score</span>
                        </li>
                    }
                </ol>
            }
        </div>

        <div class="game-scoreboard-resizer"
             data-scoreboard-resizer
             role="separator"
             aria-orientation="horizontal"
             aria-label="@Localizer["GameBoard_ResizePlayerPanel"]"
             aria-valuemin="130"
             aria-valuenow="230"
             tabindex="0"><span></span></div>
        <ul id="player-list" class="game-scoreboard" aria-label="@Localizer["Label_Players"]">
            @if (Model.Game.Session.Settings.HasHostCard)
            {
                <li class="scoreboard-player host-card" data-host-card>
                    <strong>@Model.Game.Session.Settings.HostName</strong>
                    @if (Model.Game.Session.Settings.HostVisualSource == BadWolfQuiz.Game.Runtime.HostVisualSource.Image &&
                         Model.Game.Session.Settings.HostImageData is not null)
                    {
                        <img class="host-card-media"
                             src="@Url.Page("/Admin/Games/Lobby", "HostCardImage", new { id = Model.Game.Session.Id.Value })"
                             alt="@Model.Game.Session.Settings.HostName" />
                    }
                    else if (Model.Game.Session.Settings.HostVisualSource == BadWolfQuiz.Game.Runtime.HostVisualSource.Avatar &&
                             !string.IsNullOrWhiteSpace(Model.Game.Session.Settings.HostAvatarId))
                    {
                        <img class="host-card-media" src="/avatars/@Model.Game.Session.Settings.HostAvatarId" alt="" />
                    }
                    else if (Model.Game.Session.Settings.HostVisualSource == BadWolfQuiz.Game.Runtime.HostVisualSource.Webcam)
                    {
                        @if (!string.IsNullOrWhiteSpace(Model.Game.Session.Settings.HostAvatarId))
                        {
                            <img class="host-card-media" data-host-webcam-fallback src="/avatars/@Model.Game.Session.Settings.HostAvatarId" alt="" />
                        }
                        else if (Model.Game.Session.Settings.HostImageData is not null)
                        {
                            <img class="host-card-media"
                                 data-host-webcam-fallback
                                 src="@Url.Page("/Admin/Games/Lobby", "HostCardImage", new { id = Model.Game.Session.Id.Value })"
                                 alt="@Model.Game.Session.Settings.HostName" />
                        }
                        <video class="host-card-media" data-host-webcam autoplay muted playsinline hidden></video>
                    }
                </li>
            }
            @foreach (var player in Model.Players)
            {
                <li class="scoreboard-player" data-player-id="@player.Id.Value">
                    @if (Model.ActivePlayerIds.Contains(player.Id) &&
                         !string.IsNullOrWhiteSpace(player.AvatarId))
                    {
                        <img class="player-card-avatar" src="/avatars/@player.AvatarId" alt="" />
                    }
                    <strong>@player.Name</strong>
                    <span class="scoreboard-score @(player.Score < 0 ? "score-negative" : null)">
                        @player.Score
                    </span>
                </li>
            }
        </ul>
    </section>
}

