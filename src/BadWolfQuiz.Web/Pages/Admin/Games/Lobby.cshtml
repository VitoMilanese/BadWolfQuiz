            aria-label="@Localizer["GameBoard_QuickScoreSubtract"]">−</button>
</div>

<dialog id="quick-score-dialog"
        class="app-dialog"
        aria-labelledby="quick-score-dialog-title"
        data-add-title="@Localizer["GameBoard_QuickScoreAdd"]"
        data-subtract-title="@Localizer["GameBoard_QuickScoreSubtract"]"
        data-add-value-label="@Localizer["GameBoard_QuickScoreRewardAmount"]"
        data-subtract-value-label="@Localizer["GameBoard_QuickScorePenaltyAmount"]">
    <form method="post"
          asp-page-handler="QuickScoreAdjustment"
          class="dialog-card stack-form quick-score-dialog-card"
          novalidate
          data-quick-score-form>
        <input name="playerId" type="hidden" data-quick-score-player-id />
        <input name="isCorrect" type="hidden" data-quick-score-is-correct />
        <input name="resolveQuestionIfAvailable"
               type="hidden"
               value="true"
               data-quick-score-resolve-question />

        <div class="dialog-heading quick-score-dialog-heading">
            <div class="quick-score-dialog-title-row">
                <span class="quick-score-mode-badge" data-quick-score-mode-badge aria-hidden="true">+</span>
                <h2 id="quick-score-dialog-title" data-quick-score-title>@Localizer["GameBoard_QuickScoreAdd"]</h2>
            </div>
            <button class="dialog-close"
                    type="button"
                    data-close-quick-score-dialog
                    aria-label="@Localizer["Button_Close"]">×</button>
        </div>

        <p class="dialog-target" data-quick-score-player-name></p>

        @{
            var quickScoreAvailableRoundIds = Model.Game.Session.Quiz.Rounds
                .OrderBy(round => round.SortOrder)
                .Take(Model.Game.Session.CurrentRoundIndex + 1)
                .Select(round => round.SourceRoundId)
                .ToHashSet();

            var quickScoreQuestions = Model.Game.Session.Board.Questions
                .Where(question => quickScoreAvailableRoundIds.Contains(question.SourceRoundId))
                .OrderBy(question => Model.Game.Session.Quiz.Rounds
                    .Single(round => round.SourceRoundId == question.SourceRoundId).SortOrder)
                .ThenBy(question => question.RowIndex)
                .ThenBy(question => question.SourceCategoryId)
                .ToArray();
        }

        <label>
            <span>@Localizer["AnswerHistory_Question"]</span>
            <select name="sourceQuestionId" data-quick-score-question required>
                @foreach (var question in quickScoreQuestions)
                {
                    var roundTitle = Model.Game.Session.Quiz.Rounds
                        .Single(round => round.SourceRoundId == question.SourceRoundId).Title;
                    <option value="@question.SourceQuestionId"
                            data-points="@question.Points"
                            data-status="@question.Status.ToString().ToLowerInvariant()"
                            data-attempted-player-ids="@string.Join(',', question.AnswerAttempts.Select(attempt => attempt.PlayerId.Value))">
                        @roundTitle — @question.CategoryTitle — @question.Points
                    </option>
                }
            </select>
        </label>

        <label>
            <span data-quick-score-value-label>@Localizer["GameBoard_QuickScoreRewardAmount"]</span>
            <input name="value"
                   type="number"
                   min="100"
                   step="100"
                   value="100"
                   required
                   data-quick-score-value />
        </label>

        <p class="message message-error quick-score-warning"
           data-quick-score-warning
           hidden></p>

        <div class="form-actions dialog-actions">
            <button class="button button-secondary"
                    type="button"
                    data-close-quick-score-dialog>
                @Localizer["Button_Cancel"]
            </button>
            <button class="button button-primary"
                    type="submit"
                    data-quick-score-submit>
                @Localizer["GameBoard_QuickScoreApply"]
            </button>
        </div>
    </form>
</dialog>

