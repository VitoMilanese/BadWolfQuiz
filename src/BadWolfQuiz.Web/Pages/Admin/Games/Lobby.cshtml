            aria-label="@Localizer["GameBoard_QuestionClose"]">
        <span aria-hidden="true">✕</span>
    </button>
</div>

<dialog id="category-close-dialog"
        class="app-dialog"
        aria-labelledby="category-close-dialog-title">
    <form method="post"
          asp-page-handler="CloseAvailableCategoryQuestions"
          class="dialog-card dialog-card-danger"
          data-category-close-form>
        <input name="sourceCategoryId" type="hidden" data-category-close-id />

        <div class="dialog-heading">
            <h2 id="category-close-dialog-title">@Localizer["GameBoard_CategoryCloseTitle"]</h2>
            <button class="dialog-close"
                    type="button"
                    data-close-category-close-dialog
                    aria-label="@Localizer["Button_Close"]">×</button>
        </div>

        <p class="dialog-target" data-category-close-label></p>
        <p class="dialog-warning">@Localizer["GameBoard_CategoryCloseConfirmation"]</p>

        <div class="form-actions dialog-actions">
            <button class="button button-secondary"
                    type="button"
                    data-close-category-close-dialog>
                @Localizer["Button_Cancel"]
            </button>
            <button class="button button-danger" type="submit">
                @Localizer["GameBoard_QuestionClose"]
            </button>
        </div>
    </form>
</dialog>

<script>
    (() => {
        const menu = document.getElementById("category-context-menu");
        const dialog = document.getElementById("category-close-dialog");
        const categoryId = dialog?.querySelector("[data-category-close-id]");
        const categoryLabel = dialog?.querySelector("[data-category-close-label]");
        const form = dialog?.querySelector("[data-category-close-form]");
        let selectedCategory = null;

        const hide = () => {
            if (menu) menu.hidden = true;
        };

        const position = event => {
            if (!menu) return;
            menu.hidden = false;
            const rect = menu.getBoundingClientRect();
            const left = Math.min(event.clientX, Math.max(8, window.innerWidth - rect.width - 8));
            const top = Math.min(event.clientY, Math.max(8, window.innerHeight - rect.height - 8));
            menu.style.left = `${Math.max(8, left)}px`;
            menu.style.top = `${Math.max(8, top)}px`;
        };

        document.addEventListener("contextmenu", event => {
            const target = event.target instanceof Element ? event.target : null;
            const category = target?.closest("[data-category-context]");
            if (!category) return;

            event.preventDefault();
            event.stopPropagation();
            hide();

            if (category.dataset.hasAvailableQuestions !== "true") {
                selectedCategory = null;
                return;
            }

            selectedCategory = category;
            position(event);
        }, true);

        menu?.querySelector("[data-category-close]")?.addEventListener("click", () => {
            hide();
            if (!selectedCategory || !dialog || !categoryId || !categoryLabel) return;
            categoryId.value = selectedCategory.dataset.sourceCategoryId || "";
            categoryLabel.textContent = selectedCategory.dataset.categoryLabel || "";
            dialog.showModal();
        });

        form?.addEventListener("submit", async event => {
            event.preventDefault();
            try {
                const result = await window.BadWolfContextActions.submit(form);
                dialog?.close();
                for (const questionId of result.resolvedQuestionIds ?? []) {
                    window.BadWolfContextActions.markQuestionResolved(questionId);
                }
                await window.BadWolfContextActions.showRoundSummaryIfComplete(result);
                selectedCategory = null;
            } catch (error) {
                console.error(error);
                window.alert(error.message);
            }
        });

        for (const button of dialog?.querySelectorAll("[data-close-category-close-dialog]") || []) {
            button.addEventListener("click", () => dialog.close());
        }
        dialog?.addEventListener("click", event => {
            if (event.target === dialog) dialog.close();
        });

        document.addEventListener("pointerdown", event => {
            if (menu && !menu.hidden && !menu.contains(event.target)) hide();
        }, true);
        document.addEventListener("keydown", event => {
            if (event.key === "Escape") hide();
        });
        window.addEventListener("resize", hide);
    })();
</script>

