@section Scripts {
    <script src="~/js/webcam-streams.js" asp-append-version="true"></script>
    <script>
        (() => {
            const videos = document.querySelectorAll("[data-host-webcam]");
            if (videos.length === 0 || !navigator.mediaDevices?.getUserMedia) {
                return;
            }

            navigator.mediaDevices.getUserMedia({ video: true, audio: false })
                .then(stream => videos.forEach(video => {
                    video.srcObject = stream;
                    video.hidden = false;
                    const fallback = video.closest("[data-host-card]")
                        ?.querySelector("[data-host-webcam-fallback]");
                    if (fallback) {
                        fallback.hidden = true;
                    }
                }))
                .catch(console.error);
        })();

        (() => {
            const dialog = document.querySelector("[data-avatar-picker]");
            const value = document.querySelector("[data-host-avatar-id]");
            const preview = document.querySelector("[data-host-avatar-preview]");
            const source = document.getElementById("SettingsInput_HostVisualSource");
            dialog?.addEventListener("avatarselected", event => {
                value.value = event.detail.avatarId;
                preview.src = `/avatars/${event.detail.avatarId}`;
                preview.hidden = false;
                source.value = "3";
            });
        })();

        (() => {
            const dialog = document.getElementById("join-code-dialog");
            const openButton = document.querySelector("[data-open-join-code]");
            const closeButton = document.querySelector("[data-close-join-code]");

            openButton?.addEventListener("click", () => dialog?.showModal());
            closeButton?.addEventListener("click", () => dialog?.close());

            dialog?.addEventListener("click", event => {
                if (event.target === dialog) {
                    dialog.close();
                }
            });
        })();

        (() => {
            const form = document.querySelector("[data-wager-form]");

            if (!form) {
                return;
            }

            const display = form.querySelector(".wager-display");
            const validation = form.querySelector("[data-wager-validation]");
            const submit = form.querySelector("[data-wager-submit]");
            const minimum = Number(form.dataset.minimum);
            const maximum = Number(form.dataset.maximum);

            const refresh = () => {
                const amount = Number(display.value);
                const isValid = display.value !== "" &&
                    amount >= minimum &&
                    amount <= maximum;

                submit.disabled = !isValid;
                validation.textContent = isValid
                    ? validation.dataset.validLabel
                    : validation.dataset.invalidLabel;
                validation.classList.toggle("wager-valid", isValid);
            };

            form.querySelectorAll("[data-wager-digit]").forEach(button => {
                button.addEventListener("click", () => {
                    const nextValue = (display.value + button.dataset.wagerDigit)
                        .replace(/^0+(?=\d)/, "");

                    display.value = Math.min(
                        Number(nextValue),
                        maximum).toString();

                    refresh();
                });
            });

            form.querySelector("[data-wager-max]")
                ?.addEventListener("click", () => {
                    display.value = maximum.toString();
                    refresh();
                });

            form.querySelector("[data-wager-clear]")
                ?.addEventListener("click", () => {
                    display.value = "";
                    refresh();
                });

            form.querySelector("[data-wager-backspace]")
                ?.addEventListener("click", () => {
                    display.value = display.value.slice(0, -1);
                    refresh();
                });

            refresh();
        })();

        (() => {
            const input = document.querySelector("[data-host-image-input]");
            const preview = document.querySelector("[data-host-image-preview]");
            let previewUrl;

            input?.addEventListener("change", () => {
                const file = input.files?.[0];
                if (!file || !preview) {
                    return;
                }

                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                }

                previewUrl = URL.createObjectURL(file);
                preview.src = previewUrl;
                preview.hidden = false;
            });
        })();

        (() => {
            const board = document.querySelector(".host-game-board");
            const resizer = document.querySelector("[data-scoreboard-resizer]");
            const storageKey = "badwolfquiz:player-panel-height";

            if (!board || !resizer) {
                return;
            }

            const limits = () => ({
                minimum: 130,
                maximum: Math.max(130, Math.floor(window.innerHeight * 0.65))
            });
            const applyHeight = value => {
                const { minimum, maximum } = limits();
                const height = Math.min(maximum, Math.max(minimum, Math.round(value)));
                board.style.setProperty("--game-scoreboard-space", `${height}px`);
                resizer.setAttribute("aria-valuemax", maximum.toString());
                resizer.setAttribute("aria-valuenow", height.toString());
                return height;
            };

            const savedHeight = Number.parseInt(localStorage.getItem(storageKey), 10);
            const defaultHeight = Number.parseFloat(
                getComputedStyle(board).getPropertyValue("--game-scoreboard-space"));
            applyHeight(Number.isFinite(savedHeight) ? savedHeight : defaultHeight);

            let startY = 0;
            let startHeight = 0;

            resizer.addEventListener("pointerdown", event => {
                startY = event.clientY;
                startHeight = Number.parseFloat(
                    getComputedStyle(board).getPropertyValue("--game-scoreboard-space"));
                resizer.setPointerCapture(event.pointerId);
                document.body.classList.add("is-resizing-scoreboard");
            });

            resizer.addEventListener("pointermove", event => {
                if (!resizer.hasPointerCapture(event.pointerId)) {
                    return;
                }

                applyHeight(startHeight + startY - event.clientY);
            });

            const finishResize = event => {
                if (!resizer.hasPointerCapture(event.pointerId)) {
                    return;
                }

                resizer.releasePointerCapture(event.pointerId);
                document.body.classList.remove("is-resizing-scoreboard");
                localStorage.setItem(
                    storageKey,
                    resizer.getAttribute("aria-valuenow"));
            };
            resizer.addEventListener("pointerup", finishResize);
            resizer.addEventListener("pointercancel", finishResize);

            resizer.addEventListener("keydown", event => {
                if (event.key !== "ArrowUp" && event.key !== "ArrowDown") {
                    return;
                }

                event.preventDefault();
                const current = Number.parseInt(resizer.getAttribute("aria-valuenow"), 10);
                const height = applyHeight(current + (event.key === "ArrowUp" ? 20 : -20));
                localStorage.setItem(storageKey, height.toString());
            });

            window.addEventListener("resize", () => {
                const current = Number.parseInt(resizer.getAttribute("aria-valuenow"), 10);
                applyHeight(current);
            });
        })();

        (() => {
            const lobby = document.querySelector("[data-game-code]");
            const playerCount = document.getElementById("player-count");
            const playerList = document.getElementById("player-list");
            const boardPlayerList = document.getElementById("board-player-list");
            const boardGrid = document.querySelector(".host-board-grid");
            const hostCard = playerList?.querySelector("[data-host-card]");
            const hostSlot = document.querySelector("[data-board-host-slot]");
            const hostCardList = document.querySelector(
                "[data-board-host-card-list]");
            const hostCardResizer = document.querySelector(
                "[data-board-host-card-resizer]");
            const wideHostLayout = window.matchMedia("(min-width: 1750px)");

            if (!lobby || !playerList || typeof signalR === "undefined") {
                return;
            }

            const gameCode = lobby.dataset.gameCode;
            const hostCardSizeKey = `badwolfquiz:${gameCode}:host-card-size`;

            const canPositionHostCard = () =>
                hostSlot &&
                boardGrid &&
                wideHostLayout.matches &&
                boardGrid.getBoundingClientRect().left >= 214;

            const centerHostCard = () => {
                if (!hostSlot || !boardGrid || !canPositionHostCard()) {
                    hostSlot?.classList.remove("is-positioned");
                    return;
                }

                const boardBounds = boardGrid.getBoundingClientRect();
                hostSlot.classList.add("is-positioned");
                const cardBounds = hostSlot.getBoundingClientRect();
                const left = Math.max(
                    8,
                    (boardBounds.left - cardBounds.width) / 2);
                const top = Math.max(
                    80,
                    boardBounds.top + (boardBounds.height - cardBounds.height) / 2);
                hostSlot.style.setProperty("--board-host-left", `${left}px`);
                hostSlot.style.setProperty("--board-host-top", `${top}px`);
            };

            const relocateHostCard = () => {
                if (!hostCard) {
                    return;
                }

                if (hostCardList && canPositionHostCard()) {
                    hostCardList.append(hostCard);
                } else if (!playerList.contains(hostCard)) {
                    playerList.prepend(hostCard);
                }

                centerHostCard();
            };

            const applyHostCardSize = (width, height) => {
                if (!hostSlot) {
                    return null;
                }

                const boardBounds = boardGrid?.getBoundingClientRect();
                const maxWidth = Math.max(
                    190,
                    Math.min(430, (boardBounds?.left ?? 454) - 20));
                const maxHeight = Math.max(
                    180,
                    Math.min(650, boardBounds?.height ?? 650));
                const size = {
                    width: Math.max(190, Math.min(maxWidth, Math.round(width))),
                    height: Math.max(180, Math.min(maxHeight, Math.round(height)))
                };
                hostSlot.style.setProperty("--board-host-width", `${size.width}px`);
                hostSlot.style.setProperty("--board-host-height", `${size.height}px`);
                centerHostCard();
                return size;
            };

            if (hostSlot && hostCardResizer) {
                try {
                    const storedSize = JSON.parse(localStorage.getItem(hostCardSizeKey));
                    if (storedSize?.width && storedSize?.height) {
                        applyHostCardSize(storedSize.width, storedSize.height);
                    }
                } catch {
                    localStorage.removeItem(hostCardSizeKey);
                }

                hostCardResizer.addEventListener("pointerdown", event => {
                    const startX = event.clientX;
                    const startY = event.clientY;
                    const startWidth = hostSlot.getBoundingClientRect().width;
                    const startHeight = hostSlot.getBoundingClientRect().height;
                    hostCardResizer.setPointerCapture(event.pointerId);
                    document.body.classList.add("is-resizing-host-card");

                    const move = moveEvent => {
                        applyHostCardSize(
                            startWidth + 2 * (moveEvent.clientX - startX),
                            startHeight + 2 * (moveEvent.clientY - startY));
                    };
                    const stop = stopEvent => {
                        hostCardResizer.releasePointerCapture(stopEvent.pointerId);
                        hostCardResizer.removeEventListener("pointermove", move);
                        hostCardResizer.removeEventListener("pointerup", stop);
                        hostCardResizer.removeEventListener("pointercancel", stop);
                        document.body.classList.remove("is-resizing-host-card");
                        const bounds = hostSlot.getBoundingClientRect();
                        const size = applyHostCardSize(bounds.width, bounds.height);
                        localStorage.setItem(hostCardSizeKey, JSON.stringify(size));
                    };

                    hostCardResizer.addEventListener("pointermove", move);
                    hostCardResizer.addEventListener("pointerup", stop);
                    hostCardResizer.addEventListener("pointercancel", stop);
                });

                hostCardResizer.addEventListener("keydown", event => {
                    if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"]
                        .includes(event.key)) {
                        return;
                    }

                    event.preventDefault();
                    const bounds = hostSlot.getBoundingClientRect();
                    const size = applyHostCardSize(
                        bounds.width + (event.key === "ArrowRight" ? 24 :
                            event.key === "ArrowLeft" ? -24 : 0),
                        bounds.height + (event.key === "ArrowDown" ? 24 :
                            event.key === "ArrowUp" ? -24 : 0));
                    localStorage.setItem(hostCardSizeKey, JSON.stringify(size));
                });
            }

            wideHostLayout.addEventListener("change", relocateHostCard);
            window.addEventListener("resize", relocateHostCard);
            relocateHostCard();
            const statusLabels = {
                active: lobby.dataset.statusActive,
                inactive: lobby.dataset.statusInactive,
                disconnected: lobby.dataset.statusDisconnected,
                rejoinpending: lobby.dataset.statusRejoinpending
            };
            const gameStatus = document.getElementById("game-status");
            const startGameForm = document.getElementById("start-game-form");
            const approveForm = document.getElementById("approve-rejoin-form");
            const approvePlayerId = document.getElementById("approve-player-id");
            const activePlayerForm = document.getElementById("set-active-player-form");
            const activePlayerId = document.getElementById("active-player-id");
            const removePlayerForm = document.getElementById("remove-player-form");
            const removePlayerId = document.getElementById("remove-player-id");
            const removePlayerDialog = document.getElementById("remove-player-dialog");
            const removePlayerDialogTarget = document.getElementById("remove-player-dialog-target");
            const confirmRemovePlayer = document.querySelector("[data-confirm-remove-player]");

            const removePlayer = (playerId, playerName) => {
                if (!removePlayerForm ||
                    !removePlayerId ||
                    !removePlayerDialog ||
                    !removePlayerDialogTarget) {
                    return;
                }

                removePlayerId.value = playerId;
                removePlayerDialogTarget.textContent =
                    lobby.dataset.removePlayerConfirm.replace("{0}", playerName);
                removePlayerDialog.showModal();
            };

            confirmRemovePlayer?.addEventListener("click", () => {
                removePlayerDialog?.close();
                removePlayerForm?.submit();
            });

            for (const button of document.querySelectorAll("[data-close-remove-player-dialog]")) {
                button.addEventListener("click", () => removePlayerDialog?.close());
            }

            removePlayerDialog?.addEventListener("click", event => {
                if (event.target === removePlayerDialog) {
                    removePlayerDialog.close();
                }
            });

            document.addEventListener("click", event => {
                const removeButton = event.target.closest("[data-remove-player]");

                if (removeButton) {
                    const card = removeButton.closest("[data-player-id]");
                    const playerName = card?.querySelector("strong")?.textContent?.trim() ?? "";
                    removePlayer(removeButton.dataset.removePlayer, playerName);
                    return;
                }

                const button = event.target.closest("[data-make-active-player]");

                if (!button ||
                    button.disabled ||
                    lobby?.dataset.activePlayerLocked === "true" ||
                    !activePlayerForm ||
                    !activePlayerId) {
                    return;
                }

                activePlayerId.value = button.dataset.makeActivePlayer;
                activePlayerForm.submit();
            });

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/game")
                .withAutomaticReconnect()
                .build();
            const webcam = window.BadWolfWebcam.createHost({
                connection,
                gameCode,
                playerList
            });

            let hasReceivedInitialBuzzerState = false;
            let buzzerState = null;
            const timerPanel = document.getElementById("game-timer");
            const timerValue = document.getElementById("game-timer-value");
            const timerPause = document.querySelector(".game-timer-pause");
            const timerResume = document.querySelector(".game-timer-resume");

            const refreshScrollingNames = () => {
                boardPlayerList?.querySelectorAll(".board-player-name").forEach(name => {
                    name.classList.remove("is-overflowing");
                    name.classList.toggle(
                        "is-overflowing",
                        name.scrollWidth > name.clientWidth + 1);
                });
            };

            const renderBoardPlayers = players => {
                if (!boardPlayerList) {
                    return;
                }

                boardPlayerList.replaceChildren();

                for (const player of players) {
                    const item = document.createElement("li");
                    item.dataset.sidebarPlayerId = player.id;

                    const name = document.createElement("span");
                    name.className = "board-player-name";
                    name.title = player.name;

                    const nameText = document.createElement("span");
                    nameText.textContent = player.name;
                    name.append(nameText);

                    const score = document.createElement("strong");
                    score.className = `board-player-score ${player.score < 0 ? "score-negative" : ""}`;
                    score.textContent = player.score.toString();

                    item.append(name, score);
                    boardPlayerList.append(item);
                }

                requestAnimationFrame(refreshScrollingNames);
            };

            refreshScrollingNames();
            window.addEventListener("resize", refreshScrollingNames);

            connection.on("TimerStateChanged", update => {
                if (!timerPanel || !timerValue) {
                    return;
                }

                timerPanel.hidden = !update.isVisible;
                timerPanel.classList.toggle(
                    "answer-timer",
                    update.mode === "answer");
                timerValue.textContent =
                    (update.remainingMilliseconds / 1000).toFixed(1);

                if (timerPause) {
                    timerPause.hidden = update.status !== "running";
                }

                if (timerResume) {
                    timerResume.hidden = update.status !== "paused";
                }
            });

            const applyBuzzerPlayerStates = () => {
                playerList.querySelectorAll("[data-player-id]").forEach(item => {
                    const itemPlayerId = item.dataset.playerId;
                    const isAnswering =
                        buzzerState?.answeringPlayerId === itemPlayerId;
                    const hasAttempted =
                        buzzerState?.ineligiblePlayerIds?.includes(itemPlayerId) ?? false;

                    item.classList.toggle(
                        "question-answering-player",
                        isAnswering);
                    item.classList.toggle(
                        "question-attempted-player",
                        hasAttempted && !isAnswering);
                });
            };

            connection.on("BuzzerStateChanged", update => {
                buzzerState = update;
                applyBuzzerPlayerStates();

                if (!hasReceivedInitialBuzzerState) {
                    hasReceivedInitialBuzzerState = true;
                    return;
                }

                if (lobby.classList.contains("host-game-board")) {
                    window.location.reload();
                }
            });

            connection.on("PlayersChanged", update => {
                if (playerCount) {
                    playerCount.textContent = update.playerCount.toString();
                }

                renderBoardPlayers(update.players);

                if (lobby.classList.contains("final-question-host")) {
                    playerList.replaceChildren();
                    if (hostCard) {
                        playerList.append(hostCard);
                    }

                    for (const player of update.players) {
                        const item = document.createElement("li");
                        item.dataset.playerId = player.id;
                        item.className = "scoreboard-player";

                        const name = document.createElement("strong");
                        name.textContent = player.name;

                        if (player.webcamEnabled) {
                            if (player.avatarId) {
                                const fallback = document.createElement("img");
                                fallback.className = "player-card-avatar";
                                fallback.dataset.playerWebcamFallback = "";
                                fallback.src = `/avatars/${player.avatarId}`;
                                fallback.alt = "";
                                item.append(fallback);
                            }
                            const video = document.createElement("video");
                            video.className = "player-card-avatar";
                            video.dataset.playerWebcam = "";
                            video.autoplay = true;
                            video.muted = true;
                            video.playsInline = true;
                            video.hidden = true;
                            item.append(video);
                        } else if (player.avatarId) {
                            const avatar = document.createElement("img");
                            avatar.className = "player-card-avatar";
                            avatar.src = `/avatars/${player.avatarId}`;
                            avatar.alt = "";
                            item.append(avatar);
                        }

                        const details = document.createElement("span");
                        details.className = "scoreboard-details";

                        const score = document.createElement("span");
                        score.textContent = player.score.toString();
                        score.className =
                            `scoreboard-score ${player.score < 0 ? "score-negative" : ""}`;
                        details.append(score);

                        if (player.presence !== "active") {
                            const presence = document.createElement("span");
                            presence.className =
                                `presence-badge presence-${player.presence}`;
                            presence.textContent =
                                statusLabels[player.presence] || player.presence;
                            details.append(presence);
                        }

                        if (player.presence === "rejoinpending") {
                            const approve = document.createElement("button");
                            approve.type = "button";
                            approve.className =
                                "button button-secondary icon-button player-action-button";
                            approve.title = lobby.dataset.approveLabel;
                            approve.setAttribute("aria-label", lobby.dataset.approveLabel);
                            approve.textContent = "✓";
                            approve.addEventListener("click", () => {
                                approvePlayerId.value = player.id;
                                approveForm.submit();
                            });
                            details.append(approve);
                        }

                        item.append(name, details);
                        playerList.append(item);
                    }

                    webcam.refresh(update.players);
                    relocateHostCard();

                    return;
                }

                playerList.replaceChildren();
                if (hostCard) {
                    playerList.append(hostCard);
                }
                const isRunning = lobby.dataset.gameStatus === "running";

                for (const player of update.players) {
                    const item = document.createElement("li");
                    item.dataset.playerId = player.id;
                    item.className = isRunning
                        ? `scoreboard-player ${player.isActive ? "active-player" : ""}`
                        : player.isActive ? "active-player" : "";

                    const name = document.createElement("strong");
                    name.textContent = player.name;

                    if (player.webcamEnabled) {
                        if (player.avatarId) {
                            const fallback = document.createElement("img");
                            fallback.className = isRunning
                                ? "player-card-avatar"
                                : "player-list-avatar";
                            fallback.dataset.playerWebcamFallback = "";
                            fallback.src = `/avatars/${player.avatarId}`;
                            fallback.alt = "";
                            item.append(fallback);
                        }
                        const video = document.createElement("video");
                        video.className = isRunning
                            ? "player-card-avatar"
                            : "player-list-avatar";
                        video.dataset.playerWebcam = "";
                        video.autoplay = true;
                        video.muted = true;
                        video.playsInline = true;
                        video.hidden = true;
                        item.append(video);
                    } else if (player.avatarId) {
                        const avatar = document.createElement("img");
                        avatar.className = isRunning
                            ? "player-card-avatar"
                            : "player-list-avatar";
                        avatar.src = `/avatars/${player.avatarId}`;
                        avatar.alt = "";
                        item.append(avatar);
                    }

                    const details = document.createElement("span");
                    details.className = isRunning
                        ? "scoreboard-details"
                        : "player-presence";

                    const actions = document.createElement("span");
                    actions.className = "player-card-actions";

                    const remove = document.createElement("button");
                    remove.type = "button";
                    remove.className = isRunning
                        ? "button button-danger icon-button player-action-button scoreboard-remove-player"
                        : "button button-danger icon-button player-action-button";
                    remove.dataset.removePlayer = player.id;
                    remove.title = lobby.dataset.removePlayerLabel;
                    remove.setAttribute("aria-label", lobby.dataset.removePlayerLabel);
                    remove.textContent = "✕";
                    actions.append(remove);

                    if (isRunning) {
                        const score = document.createElement("span");
                        score.textContent = player.score.toString();
                        score.className =
                            `scoreboard-score ${player.score < 0 ? "score-negative" : ""}`;
                        details.append(score);
                    }

                    if (!player.isActive) {
                        const makeActive = document.createElement("button");
                        makeActive.type = "button";
                        makeActive.className =
                            "button button-secondary icon-button player-action-button";
                        makeActive.dataset.makeActivePlayer = player.id;
                        makeActive.title = lobby.dataset.makeActiveLabel;
                        makeActive.setAttribute("aria-label", lobby.dataset.makeActiveLabel);
                        makeActive.textContent = "★";
                        makeActive.disabled =
                            lobby.dataset.activePlayerLocked === "true";
                        actions.append(makeActive);
                    }

                    if (player.presence !== "active") {
                        const presence = document.createElement("span");
                        presence.className = `presence-badge presence-${player.presence}`;
                        presence.textContent =
                            statusLabels[player.presence] || player.presence;
                        details.append(presence);
                    }

                    if (player.presence === "rejoinpending") {
                        const approve = document.createElement("button");
                        approve.type = "button";
                        approve.className =
                            "button button-secondary icon-button player-action-button";
                        approve.title = lobby.dataset.approveLabel;
                        approve.setAttribute("aria-label", lobby.dataset.approveLabel);
                        approve.textContent = "✓";
                        approve.addEventListener("click", () => {
                            approvePlayerId.value = player.id;
                            approveForm.submit();
                        });
                        actions.append(approve);
                    }

                    details.append(actions);

                    item.append(name, details);
                    playerList.append(item);
                }

                applyBuzzerPlayerStates();
                webcam.refresh(update.players);
                relocateHostCard();
            });

            connection.on("GameStatusChanged", update => {
                const previousStatus = lobby.dataset.gameStatus;
                lobby.dataset.gameStatus = update.status;
                if (gameStatus) {
                    gameStatus.textContent = update.status === "running"
                        ? lobby.dataset.runningLabel
                        : lobby.dataset.lobbyLabel;
                }

                if (startGameForm) {
                    startGameForm.hidden = update.status !== "lobby";
                }

                if (previousStatus &&
                    previousStatus !== update.status &&
                    lobby.classList.contains("host-game-board")) {
                    window.location.reload();
                }
            });

            connection.on("FinalQuestionProgressChanged", () => {
                if (lobby.classList.contains("final-question-host")) {
                    window.location.reload();
                }
            });

            const joinSession = () => connection.invoke("JoinSession", gameCode);

            let playerPollHandle = null;
            const startPlayerPolling = () => {
                if (playerPollHandle !== null) {
                    clearInterval(playerPollHandle);
                }

                playerPollHandle = window.setInterval(() => {
                    if (connection.state === signalR.HubConnectionState.Connected) {
                        connection.invoke("PollPlayers", gameCode)
                            .catch(console.error);
                    }
                }, 1000);
            };

            let timerPollHandle = null;
            const startTimerPolling = () => {
                if (timerPollHandle !== null) {
                    clearInterval(timerPollHandle);
                }

                timerPollHandle = window.setInterval(() => {
                    if (connection.state === signalR.HubConnectionState.Connected &&
                        lobby.dataset.gameStatus === "running") {
                        connection.invoke("PollQuestionTimer", gameCode)
                            .catch(console.error);
                    }
                }, 250);
            };

            connection.onreconnected(async () => {
                await joinSession();
                await webcam.register();
                startPlayerPolling();
                startTimerPolling();
            });
            connection.start()
                .then(async () => {
                    await joinSession();
                    await webcam.register();
                    startPlayerPolling();
                    startTimerPolling();
                })
                .catch(console.error);
        })();
    </script>
    <script src="~/js/avatar-picker.js" asp-append-version="true"></script>
}
