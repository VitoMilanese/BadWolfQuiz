<script>
    window.BadWolfQuickScore = (() => {
        const contextMenu = document.getElementById("player-score-context-menu");
        const dialog = document.getElementById("quick-score-dialog");
        const playerIdInput = dialog?.querySelector("[data-quick-score-player-id]");
        const isCorrectInput = dialog?.querySelector("[data-quick-score-is-correct]");
        const resolveQuestionInput = dialog?.querySelector("[data-quick-score-resolve-question]");
        const playerNameTarget = dialog?.querySelector("[data-quick-score-player-name]");
        const questionSelect = dialog?.querySelector("[data-quick-score-question]");
        const valueInput = dialog?.querySelector("[data-quick-score-value]");
        const valueLabel = dialog?.querySelector("[data-quick-score-value-label]");
        const submitButton = dialog?.querySelector("[data-quick-score-submit]");
        const warning = dialog?.querySelector("[data-quick-score-warning]");
        const titleTarget = dialog?.querySelector("[data-quick-score-title]");
        const modeBadge = dialog?.querySelector("[data-quick-score-mode-badge]");
        const resolveDialog = document.getElementById("quick-score-resolve-question-dialog");
        const resolveYesButton = resolveDialog?.querySelector("[data-quick-score-resolve-yes]");
        const resolveNoButton = resolveDialog?.querySelector("[data-quick-score-resolve-no]");
        const resolveCancelButton = resolveDialog?.querySelector("[data-quick-score-resolve-cancel]");
        const noQuestionsMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["GameBoard_QuickScoreNoQuestions"].Value));

        let selectedPlayerId = "";
        let selectedPlayerName = "";
        let resolveDecisionMade = false;

        const hide = () => {
            if (contextMenu) {
                contextMenu.hidden = true;
            }
        };

        const syncValueToQuestion = () => {
            if (!questionSelect || !valueInput) {
                return;
            }

            const selectedOption = questionSelect.selectedOptions[0];
            const points = Number.parseInt(selectedOption?.dataset.points ?? "", 10);

            if (Number.isFinite(points) && points > 0) {
                valueInput.value = points.toString();
            }
        };

        const updateQuestions = () => {
            if (!questionSelect || !submitButton || !warning) {
                return;
            }

            let firstAvailable = null;

            for (const option of questionSelect.options) {
                option.hidden = false;
                option.disabled = false;
                firstAvailable ??= option;
            }

            if (firstAvailable) {
                questionSelect.value = firstAvailable.value;
            } else {
                questionSelect.selectedIndex = -1;
            }

            const hasQuestion = firstAvailable !== null;
            submitButton.disabled = !hasQuestion;
            warning.hidden = hasQuestion;
            warning.textContent = hasQuestion ? "" : noQuestionsMessage;

            if (hasQuestion) {
                syncValueToQuestion();
            }
        };

        const openDialog = isCorrect => {
            hide();

            if (!dialog || !playerIdInput || !isCorrectInput || !resolveQuestionInput ||
                !playerNameTarget || !questionSelect || !valueInput || !valueLabel ||
                !submitButton || !warning || !titleTarget || !modeBadge) {
                return;
            }

            playerIdInput.value = selectedPlayerId;
            isCorrectInput.value = isCorrect ? "true" : "false";
            playerNameTarget.textContent = selectedPlayerName;
            titleTarget.textContent = isCorrect ? dialog.dataset.addTitle : dialog.dataset.subtractTitle;
            submitButton.textContent = titleTarget.textContent;
            valueLabel.textContent = isCorrect
                ? dialog.dataset.addValueLabel
                : dialog.dataset.subtractValueLabel;
            modeBadge.textContent = isCorrect ? "+" : "−";
            dialog.dataset.quickScoreMode = isCorrect ? "add" : "subtract";
            resolveQuestionInput.value = "true";
            resolveDecisionMade = false;
            updateQuestions();
            dialog.showModal();
            valueInput.focus();
        };

        const show = (event, card) => {
            event.preventDefault();
            event.stopPropagation();

            if (!contextMenu || !card) {
                return false;
            }

            selectedPlayerId = card.dataset.playerId ?? "";
            selectedPlayerName = card.dataset.playerName ??
                card.querySelector("strong")?.textContent?.trim() ?? "";

            contextMenu.hidden = false;
            contextMenu.style.left = "0px";
            contextMenu.style.top = "0px";

            const rect = contextMenu.getBoundingClientRect();
            const left = Math.max(8, Math.min(event.clientX, window.innerWidth - rect.width - 8));
            const top = Math.max(8, Math.min(event.clientY, window.innerHeight - rect.height - 8));

            contextMenu.style.left = `${left}px`;
            contextMenu.style.top = `${top}px`;
            contextMenu.querySelector("button")?.focus({ preventScroll: true });
            return false;
        };

        document.addEventListener("contextmenu", event => {
            const target = event.target instanceof Element ? event.target : null;
            const card = target?.closest(".scoreboard-player[data-player-id]");

            if (!card || card.hasAttribute("data-host-card")) {
                return;
            }

            show(event, card);
        }, true);

        questionSelect?.addEventListener("change", syncValueToQuestion);

        const quickScoreForm = dialog?.querySelector("[data-quick-score-form]");
        quickScoreForm?.addEventListener("submit", async event => {
            event.preventDefault();
            if (!questionSelect || !resolveQuestionInput || !resolveDialog) {
                return;
            }

            const selectedOption = questionSelect.selectedOptions[0];
            if (!selectedOption) {
                return;
            }

            if (selectedOption.dataset.status === "available" && !resolveDecisionMade) {
                resolveDialog.showModal();
                return;
            }

            try {
                const result = await window.BadWolfContextActions.submit(quickScoreForm);
                dialog?.close();
                window.BadWolfContextActions.recordAttempt(
                    result.sourceQuestionId,
                    result.playerId);
                if (result.questionResolved) {
                    window.BadWolfContextActions.markQuestionResolved(result.sourceQuestionId);
                }
                await window.BadWolfContextActions.showRoundSummaryIfComplete(result);
                resolveDecisionMade = false;
                updateQuestions();
            } catch (error) {
                console.error(error);
                if (warning) {
                    warning.hidden = false;
                    warning.textContent = error.message;
                }
                resolveDecisionMade = false;
            }
        });

        const continueQuickScoreSubmit = resolveQuestion => {
            if (!dialog || !resolveDialog || !resolveQuestionInput || !submitButton) {
                return;
            }

            resolveQuestionInput.value = resolveQuestion ? "true" : "false";
            resolveDecisionMade = true;
            resolveDialog.close();
            dialog.querySelector("[data-quick-score-form]")?.requestSubmit(submitButton);
        };

        resolveYesButton?.addEventListener("click", () => continueQuickScoreSubmit(true));
        resolveNoButton?.addEventListener("click", () => continueQuickScoreSubmit(false));
        resolveCancelButton?.addEventListener("click", () => resolveDialog?.close());
        resolveDialog?.addEventListener("click", event => {
            if (event.target === resolveDialog) {
                resolveDialog.close();
            }
        });

        contextMenu?.addEventListener("click", event => {
            const action = event.target.closest("[data-quick-score-mode]");
            if (action) {
                openDialog(action.dataset.quickScoreMode === "add");
            }
        });

        document.addEventListener("pointerdown", event => {
            if (contextMenu && !contextMenu.hidden && !contextMenu.contains(event.target)) {
                hide();
            }
        }, true);

        document.addEventListener("keydown", event => {
            if (event.key === "Escape" && contextMenu && !contextMenu.hidden) {
                hide();
            }
        });

        window.addEventListener("blur", hide);
        window.addEventListener("resize", hide);

        dialog?.querySelectorAll("[data-close-quick-score-dialog]").forEach(button => {
            button.addEventListener("click", () => dialog.close());
        });

        dialog?.addEventListener("click", event => {
            if (event.target === dialog) {
                dialog.close();
            }
        });

        return { show, hide };
    })();
</script>

