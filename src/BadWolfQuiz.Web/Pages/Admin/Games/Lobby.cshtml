            type="button"
            data-quick-score-mode="add"
            role="menuitem"
            title="@Localizer["GameBoard_QuickScoreAdd"]"
            aria-label="@Localizer["GameBoard_QuickScoreAdd"]">+</button>
    <button class="player-score-context-action player-score-context-subtract"
            type="button"
            data-quick-score-mode="subtract"
            role="menuitem"
