<script>
    (() => {
        const menu = document.getElementById("question-context-menu");
        const giftDialog = document.getElementById("question-gift-dialog");
        const giftForm = giftDialog?.querySelector("[data-question-gift-form]");
        const giftId = giftDialog?.querySelector("[data-question-gift-id]");
        const giftLabel = giftDialog?.querySelector("[data-question-gift-label]");
        const giftPlayer = giftDialog?.querySelector("[data-question-gift-player]");
        const giftValue = giftDialog?.querySelector("[data-question-gift-value]");
        const giftResolve = giftDialog?.querySelector("[data-question-gift-resolve]");
        const giftWarning = giftDialog?.querySelector("[data-question-gift-warning]");
        const giftSubmit = giftDialog?.querySelector("[data-question-gift-submit]");
        const closeDialog = document.getElementById("question-close-dialog");
        const closeForm = closeDialog?.querySelector("[data-question-close-form]");
        const closeId = closeDialog?.querySelector("[data-question-close-id]");
        const closeLabel = closeDialog?.querySelector("[data-question-close-label]");
        let selectedQuestion = null;

        const invalidValueMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["GameBoard_QuickScoreInvalidValue"].Value));
        const noPlayersMessage = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["AnswerHistory_NoEligiblePlayers"].Value));

        const hide = () => {
            if (menu) menu.hidden = true;
        };

        const position = event => {
            if (!menu) return;
            menu.hidden = false;
            const rect = menu.getBoundingClientRect();
            const left = Math.min(event.clientX, Math.max(8, window.innerWidth - rect.width - 8));
            const top = Math.min(event.clientY, Math.max(8, window.innerHeight - rect.height - 8));
            menu.style.left = `${Math.max(8, left)}px`;
            menu.style.top = `${Math.max(8, top)}px`;
        };

        const syncPlayers = () => {
            if (!selectedQuestion || !giftPlayer) return false;
            const attempted = new Set((selectedQuestion.dataset.attemptedPlayerIds || "").split(",").filter(Boolean));
            let first = null;
            for (const option of giftPlayer.options) {
                option.disabled = attempted.has(option.value);
                if (!option.disabled && !first) first = option;
            }
            if (first) giftPlayer.value = first.value;
            if (giftWarning) {
                giftWarning.hidden = !!first;
                giftWarning.textContent = first ? "" : noPlayersMessage;
            }
            if (giftSubmit) {
                giftSubmit.disabled = !first;
            }
            return !!first;
        };

        document.addEventListener("contextmenu", event => {
            const target = event.target instanceof Element ? event.target : null;
            const resolved = target?.closest(".host-board-question.status-resolved[data-question-resolved]");
            if (resolved) {
                event.preventDefault();
                hide();
                return;
            }

            const question = target?.closest(".host-board-question.status-available[data-question-context]");
            if (!question) return;

            event.preventDefault();
            event.stopPropagation();
            selectedQuestion = question;
            position(event);
        }, true);

        menu?.querySelector("[data-question-gift]")?.addEventListener("click", () => {
            hide();
            if (!selectedQuestion || !giftDialog || !giftId || !giftLabel || !giftValue || !giftResolve) return;
            giftId.value = selectedQuestion.dataset.sourceQuestionId || "";
            giftLabel.value = selectedQuestion.dataset.questionLabel || "";
            giftValue.value = selectedQuestion.dataset.questionPoints || "100";
            giftResolve.checked = false;
            syncPlayers();
            giftDialog.showModal();
        });

        menu?.querySelector("[data-question-close]")?.addEventListener("click", () => {
            hide();
            if (!selectedQuestion || !closeDialog || !closeId || !closeLabel) return;
            closeId.value = selectedQuestion.dataset.sourceQuestionId || "";
            closeLabel.textContent = selectedQuestion.dataset.questionLabel || "";
            closeDialog.showModal();
        });

        giftForm?.addEventListener("submit", async event => {
            event.preventDefault();
            const value = Number(giftValue?.value);
            if (!Number.isInteger(value) || value <= 0) {
                if (giftWarning) {
                    giftWarning.hidden = false;
                    giftWarning.textContent = invalidValueMessage;
                }
                return;
            }

            try {
                const result = await window.BadWolfContextActions.submit(giftForm);
                giftDialog?.close();
                window.BadWolfContextActions.recordAttempt(
                    result.sourceQuestionId,
                    result.playerId);
                if (result.questionResolved) {
                    window.BadWolfContextActions.markQuestionResolved(result.sourceQuestionId);
                }
                await window.BadWolfContextActions.showRoundSummaryIfComplete(result);
                selectedQuestion = null;
            } catch (error) {
                console.error(error);
                if (giftWarning) {
                    giftWarning.hidden = false;
                    giftWarning.textContent = error.message;
                }
            }
        });

        closeForm?.addEventListener("submit", async event => {
            event.preventDefault();
            try {
                const result = await window.BadWolfContextActions.submit(closeForm);
                closeDialog?.close();
                window.BadWolfContextActions.markQuestionResolved(result.sourceQuestionId);
                await window.BadWolfContextActions.showRoundSummaryIfComplete(result);
                selectedQuestion = null;
            } catch (error) {
                console.error(error);
                window.alert(error.message);
            }
        });

        for (const button of giftDialog?.querySelectorAll("[data-close-question-gift]") || []) {
            button.addEventListener("click", () => giftDialog.close());
        }
        giftDialog?.addEventListener("click", event => {
            if (event.target === giftDialog) giftDialog.close();
        });

        for (const button of closeDialog?.querySelectorAll("[data-close-question-close-dialog]") || []) {
            button.addEventListener("click", () => closeDialog.close());
        }
        closeDialog?.addEventListener("click", event => {
            if (event.target === closeDialog) closeDialog.close();
        });

        document.addEventListener("pointerdown", event => {
            if (menu && !menu.hidden && !menu.contains(event.target)) hide();
        }, true);
        document.addEventListener("keydown", event => {
            if (event.key === "Escape") hide();
        });
        window.addEventListener("resize", hide);
    })();
</script>

<div id="player-score-context-menu"
     class="player-score-context-menu"
     role="menu"
     hidden>
