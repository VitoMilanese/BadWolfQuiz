        <div class="form-actions dialog-actions">
            <button class="button button-secondary"
                    type="button"
                    data-close-force-advance-final-dialog>
                @Localizer["GameBoard_StayInCurrentRound"]
            </button>

            @if (Model.Game.Session.HasUnfinishedRegularRoundExcludingCurrent)
            {
                <form method="post" asp-page-handler="ReturnToUnfinishedRound">
                    <button class="button button-secondary" type="submit">
                        @Localizer["GameBoard_ReturnToUnfinishedRound"]
                    </button>
                </form>
            }

            <button class="button button-danger"
                    type="button"
                    data-confirm-force-advance-final>
                @Localizer["FinalQuestion_Advance"]
            </button>
        </div>
    </div>
</dialog>


<dialog id="natural-final-warning-dialog" class="app-dialog" aria-labelledby="natural-final-warning-title">
    <div class="dialog-card">
        <div class="dialog-heading">
            <h2 id="natural-final-warning-title">@Localizer["FinalQuestion_Start"]</h2>
            <button class="dialog-close" type="button" data-close-natural-final-warning aria-label="@Localizer["Button_Close"]">×</button>
        </div>
        <p>@Localizer["FinalQuestion_UnfinishedRoundsWarning"]</p>
        <div class="form-actions dialog-actions">
            <form method="post" asp-page-handler="ReturnToUnfinishedRound">
                <input type="hidden" name="skipLeaderboard" value="true" />
                <button class="button button-secondary" type="submit">@Localizer["GameBoard_ReturnToUnfinishedRound"]</button>
            </form>
            <form method="post" asp-page-handler="ForceAdvanceToFinalQuestion">
                <button class="button button-danger" type="submit">@Localizer["FinalQuestion_Advance"]</button>
            </form>
        </div>
    </div>
</dialog>

<dialog id="finish-game-warning-dialog" class="app-dialog" aria-labelledby="finish-game-warning-title">
    <div class="dialog-card">
        <div class="dialog-heading">
            <h2 id="finish-game-warning-title">@Localizer["GameBoard_FinishGame"]</h2>
            <button class="dialog-close" type="button" data-close-finish-game-warning aria-label="@Localizer["Button_Close"]">×</button>
        </div>
        <p>@Localizer["GameBoard_UnfinishedRoundsBeforeFinish"]</p>
        <div class="form-actions dialog-actions">
            <form method="post" asp-page-handler="ReturnToUnfinishedRound">
                <button class="button button-secondary" type="submit">@Localizer["GameBoard_ReturnToUnfinishedRound"]</button>
            </form>
            <a class="button button-danger" asp-page="/Admin/Quizzes/Index">@Localizer["GameBoard_FinishGame"]</a>
        </div>
    </div>
</dialog>

<script>
    (() => {
        const previousRoundDialog = document.getElementById("previous-round-dialog");
        const naturalFinalDialog = document.getElementById("natural-final-warning-dialog");
        const finishGameDialog = document.getElementById("finish-game-warning-dialog");
        document.querySelector("[data-open-previous-round-dialog]")?.addEventListener("click", () => previousRoundDialog?.showModal());
        document.querySelector("[data-open-natural-final-warning]")?.addEventListener("click", () => naturalFinalDialog?.showModal());
        document.querySelector("[data-open-finish-game-warning]")?.addEventListener("click", () => finishGameDialog?.showModal());
        document.querySelectorAll("[data-close-previous-round-dialog]").forEach(button => button.addEventListener("click", () => previousRoundDialog?.close()));
        document.querySelectorAll("[data-close-natural-final-warning]").forEach(button => button.addEventListener("click", () => naturalFinalDialog?.close()));
        document.querySelectorAll("[data-close-finish-game-warning]").forEach(button => button.addEventListener("click", () => finishGameDialog?.close()));
        previousRoundDialog?.addEventListener("click", event => { if (event.target === previousRoundDialog) previousRoundDialog.close(); });
        naturalFinalDialog?.addEventListener("click", event => { if (event.target === naturalFinalDialog) naturalFinalDialog.close(); });
        finishGameDialog?.addEventListener("click", event => { if (event.target === finishGameDialog) finishGameDialog.close(); });
    })();
</script>

@section Scripts {
    <script src="~/js/webcam-streams.js" asp-append-version="true"></script>
    <script src="~/js/discord-media-state.js" asp-append-version="true"></script>
    <script src="~/js/discord-media-mute.js" asp-append-version="true"></script>
    <script>
        (() => {
            const titles = [...document.querySelectorAll(".host-board-column h3")];
            if (titles.length === 0) {
                return;
            }

            const fitTitle = title => {
                let size = 30;
                title.style.setProperty("--category-title-size", `${size}px`);
                while (size > 12 &&
                    (title.scrollWidth > title.clientWidth ||
                     title.scrollHeight > title.clientHeight)) {
                    size -= 1;
                    title.style.setProperty("--category-title-size", `${size}px`);
                }
            };

            const fitTitles = () => titles.forEach(fitTitle);
            fitTitles();
            const grid = document.querySelector(".host-board-grid");
            if (grid && typeof ResizeObserver !== "undefined") {
                new ResizeObserver(fitTitles).observe(grid);
            } else {
                window.addEventListener("resize", fitTitles);
            }
        })();

        (() => {
            const nativeMediaSelector =
                ".game-content-audio, video.game-content-video";
            const youtubeFrameSelector = ".youtube-auto-expand";

            const pauseNativeMedia = exceptMedia => {
                for (const media of document.querySelectorAll(nativeMediaSelector)) {
                    if (media !== exceptMedia && !media.paused) {
                        media.pause();
                    }
                }
            };

            const pauseYouTubeFrames = exceptFrame => {
                for (const frame of document.querySelectorAll(youtubeFrameSelector)) {
                    if (frame === exceptFrame) {
                        continue;
                    }

                    frame.contentWindow?.postMessage(
                        JSON.stringify({
                            event: "command",
                            func: "pauseVideo",
                            args: []
                        }),
                        "*");
                }
            };

            document.addEventListener("play", event => {
                const media = event.target instanceof Element &&
                    event.target.matches(nativeMediaSelector)
                    ? event.target
                    : null;
                if (!media) {
                    return;
                }

                pauseNativeMedia(media);
                pauseYouTubeFrames(null);
            }, true);

            window.addEventListener("message", event => {
                let payload = event.data;

                if (typeof payload === "string") {
                    try {
                        payload = JSON.parse(payload);
                    } catch {
                        return;
                    }
                }

                if (payload?.event !== "onStateChange" || payload.info !== 1) {
                    return;
                }

                const playingFrame = Array.from(
                    document.querySelectorAll(youtubeFrameSelector))
                    .find(frame => frame.contentWindow === event.source);

                if (!playingFrame) {
                    return;
                }

                pauseNativeMedia(null);
                pauseYouTubeFrames(playingFrame);
            });
        })();

        (() => {
            const dialog = document.getElementById("game-settings-dialog");
            document.querySelector("[data-open-game-settings]")
                ?.addEventListener("click", () => dialog?.showModal());

            for (const button of document.querySelectorAll("[data-close-game-settings]")) {
                button.addEventListener("click", () => dialog?.close());
            }

            dialog?.addEventListener("click", event => {
                if (event.target === dialog) {
                    dialog.close();
                }
            });
        })();

        (() => {
            const videos = document.querySelectorAll("[data-host-webcam]");
            if (videos.length === 0 || !navigator.mediaDevices?.getUserMedia) {
                return;
            }

            let currentStream = null;
            let isStarting = false;
            let retryHandle = null;

            const showFallback = () => videos.forEach(video => {
                video.srcObject = null;
                video.hidden = true;
                const fallback = video.closest("[data-host-card]")
                    ?.querySelector("[data-host-webcam-fallback]");
                if (fallback) {
                    fallback.hidden = false;
                }
            });

            const startCamera = async () => {
                if (isStarting || currentStream) {
                    return;
                }

                isStarting = true;
                try {
                    const capturedStream = await navigator.mediaDevices.getUserMedia({
                        video: true,
                        audio: false
                    });
                    currentStream = capturedStream;
                    capturedStream.getTracks().forEach(track => {
                        track.addEventListener("ended", () => {
                            if (currentStream !== capturedStream) {
                                return;
                            }
                            currentStream = null;
                            showFallback();
                            clearTimeout(retryHandle);
                            retryHandle = window.setTimeout(startCamera, 1500);
                        }, { once: true });
                    });
                    videos.forEach(video => {
                        video.srcObject = capturedStream;
                        video.hidden = false;
                        const fallback = video.closest("[data-host-card]")
                            ?.querySelector("[data-host-webcam-fallback]");
                        if (fallback) {
                            fallback.hidden = true;
                        }
                    });
                } catch (exception) {
                    console.error(exception);
                    showFallback();
                } finally {
                    isStarting = false;
                }
            };

            navigator.mediaDevices.addEventListener("devicechange", () => {
                if (!currentStream) {
                    clearTimeout(retryHandle);
                    retryHandle = window.setTimeout(startCamera, 250);
                }
            });
            window.addEventListener("pagehide", () => {
                clearTimeout(retryHandle);
                currentStream?.getTracks().forEach(track => track.stop());
                currentStream = null;
            });
            startCamera();
        })();

        (() => {
            const dialog = document.querySelector("[data-avatar-picker]");
            const value = document.querySelector("[data-host-avatar-id]");
            const preview = document.querySelector("[data-host-avatar-preview]");
            const source = document.getElementById("SettingsInput_HostVisualSource");
            dialog?.addEventListener("avatarselected", event => {
                value.value = event.detail.avatarId;
                preview.src = event.detail.avatarUrl;
                preview.hidden = false;
                source.value = "3";
            });
        })();

        (() => {
            const panel = document.querySelector("[data-join-code-panel]");
            const openButtons = document.querySelectorAll("[data-open-join-code]");
            const closeButton = panel?.querySelector("[data-close-join-code]");
            const dragHandle = panel?.querySelector("[data-join-code-drag-handle]");
            const resizer = panel?.querySelector("[data-join-code-resizer]");

            if (!panel) {
                return;
            }

            const gameCode = panel.dataset.gameCode;
            const visibleKey = `badwolfquiz:${gameCode}:join-code-panel-visible`;
            const geometryKey = `badwolfquiz:${gameCode}:join-code-panel-geometry`;
            const minimumWidth = 240;
            const minimumHeight = 300;

            const isTemporarilyHidden = () => {
                const activeQuestion = document.querySelector(".current-question-summary");
                const gameplayView = document.querySelector("[data-host-gameplay-view]");
                const exclusiveGameplayView = gameplayView !== null &&
                    gameplayView.querySelector(
                        ".question-review-preview, [data-game-intro-page], [data-final-question-transition]") !== null;
                const gameStatus = document.querySelector(".host-game-board")?.dataset.gameStatus;
                const canShowInStatus =
                    gameStatus === "running" || gameStatus === "finalwagering";

                return !canShowInStatus ||
                    activeQuestion !== null ||
                    exclusiveGameplayView;
            };

            const clampGeometry = geometry => {
                const width = Math.min(
                    Math.max(geometry.width, minimumWidth),
                    Math.max(minimumWidth, window.innerWidth - 16));
                const height = Math.min(
                    Math.max(geometry.height, minimumHeight),
                    Math.max(minimumHeight, window.innerHeight - 16));
                const left = Math.min(
                    Math.max(geometry.left, 8),
                    Math.max(8, window.innerWidth - width - 8));
                const top = Math.min(
                    Math.max(geometry.top, 8),
                    Math.max(8, window.innerHeight - height - 8));

                return { left, top, width, height };
            };

            const applyGeometry = geometry => {
                const value = clampGeometry(geometry);
                panel.style.left = `${value.left}px`;
                panel.style.top = `${value.top}px`;
                panel.style.width = `${value.width}px`;
                panel.style.height = `${value.height}px`;
                return value;
            };

            const saveGeometry = () => {
                const bounds = panel.getBoundingClientRect();
                const value = applyGeometry({
                    left: bounds.left,
                    top: bounds.top,
                    width: bounds.width,
                    height: bounds.height
                });
                localStorage.setItem(geometryKey, JSON.stringify(value));
            };

            const restoreGeometry = () => {
                let geometry = {
                    left: Math.max(8, window.innerWidth - 360),
                    top: 88,
                    width: 320,
                    height: 430
                };

                try {
                    const saved = JSON.parse(localStorage.getItem(geometryKey));
                    if (saved &&
                        Number.isFinite(saved.left) &&
                        Number.isFinite(saved.top) &&
                        Number.isFinite(saved.width) &&
                        Number.isFinite(saved.height)) {
                        geometry = saved;
                    }
                } catch {
                    localStorage.removeItem(geometryKey);
                }

                applyGeometry(geometry);
            };

            const syncOpenButtonLabels = visible => {
                for (const openButton of openButtons) {
                    const label = visible
                        ? openButton.dataset.hideJoinCodeLabel
                        : openButton.dataset.showJoinCodeLabel;
                    if (!label) {
                        continue;
                    }

                    openButton.title = label;
                    openButton.setAttribute("aria-label", label);
                }
            };

            const setVisible = visible => {
                localStorage.setItem(visibleKey, visible ? "true" : "false");
                panel.hidden = !visible || isTemporarilyHidden();
                syncOpenButtonLabels(visible);
            };

            restoreGeometry();
            setVisible(localStorage.getItem(visibleKey) === "true");

            for (const openButton of openButtons) {
                openButton.addEventListener("click", () =>
                    setVisible(localStorage.getItem(visibleKey) !== "true"));
            }

            closeButton?.addEventListener("click", () => setVisible(false));

            dragHandle?.addEventListener("pointerdown", event => {
                if (event.target.closest("button")) {
                    return;
                }

                event.preventDefault();
                const startX = event.clientX;
                const startY = event.clientY;
                const startBounds = panel.getBoundingClientRect();
                dragHandle.setPointerCapture(event.pointerId);
                document.body.classList.add("is-moving-join-code-panel");

                const move = moveEvent => {
                    if (!dragHandle.hasPointerCapture(moveEvent.pointerId)) {
                        return;
                    }

                    applyGeometry({
                        left: startBounds.left + moveEvent.clientX - startX,
                        top: startBounds.top + moveEvent.clientY - startY,
                        width: startBounds.width,
                        height: startBounds.height
                    });
                };

                const stop = stopEvent => {
                    if (!dragHandle.hasPointerCapture(stopEvent.pointerId)) {
                        return;
                    }

                    dragHandle.releasePointerCapture(stopEvent.pointerId);
                    dragHandle.removeEventListener("pointermove", move);
                    dragHandle.removeEventListener("pointerup", stop);
                    dragHandle.removeEventListener("pointercancel", stop);
                    document.body.classList.remove("is-moving-join-code-panel");
                    saveGeometry();
                };

                dragHandle.addEventListener("pointermove", move);
                dragHandle.addEventListener("pointerup", stop);
                dragHandle.addEventListener("pointercancel", stop);
            });

            resizer?.addEventListener("pointerdown", event => {
                event.preventDefault();
                const startX = event.clientX;
                const startY = event.clientY;
                const startBounds = panel.getBoundingClientRect();
                resizer.setPointerCapture(event.pointerId);
                document.body.classList.add("is-resizing-join-code-panel");

                const move = moveEvent => {
                    if (!resizer.hasPointerCapture(moveEvent.pointerId)) {
                        return;
                    }

                    applyGeometry({
                        left: startBounds.left,
                        top: startBounds.top,
                        width: startBounds.width + moveEvent.clientX - startX,
                        height: startBounds.height + moveEvent.clientY - startY
                    });
                };

                const stop = stopEvent => {
                    if (!resizer.hasPointerCapture(stopEvent.pointerId)) {
                        return;
                    }

                    resizer.releasePointerCapture(stopEvent.pointerId);
                    resizer.removeEventListener("pointermove", move);
                    resizer.removeEventListener("pointerup", stop);
                    resizer.removeEventListener("pointercancel", stop);
                    document.body.classList.remove("is-resizing-join-code-panel");
                    saveGeometry();
                };

                resizer.addEventListener("pointermove", move);
                resizer.addEventListener("pointerup", stop);
                resizer.addEventListener("pointercancel", stop);
            });

            resizer?.addEventListener("keydown", event => {
                if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"].includes(event.key)) {
                    return;
                }

                event.preventDefault();
                const bounds = panel.getBoundingClientRect();
                applyGeometry({
                    left: bounds.left,
                    top: bounds.top,
                    width: bounds.width + (event.key === "ArrowRight" ? 24 : event.key === "ArrowLeft" ? -24 : 0),
                    height: bounds.height + (event.key === "ArrowDown" ? 24 : event.key === "ArrowUp" ? -24 : 0)
                });
                saveGeometry();
            });

            window.addEventListener("resize", () => saveGeometry());
            document.addEventListener("badwolf:host-gameplay-updated", () =>
                setVisible(localStorage.getItem(visibleKey) === "true"));
        })();

        (() => {
            const joinAccess = document.querySelector("[data-lobby-join-access]");

            if (!joinAccess) {
                return;
            }

            const copyCodeButton = joinAccess.querySelector("[data-copy-join-code]");
            const copyLinkButton = joinAccess.querySelector("[data-copy-join-link]");
            const copyStatus = joinAccess.querySelector("[data-join-copy-status]");
            const copiedLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Localizer["GameBoard_JoinCopied"].Value));

            const copyText = async value => {
                if (navigator.clipboard?.writeText) {
                    await navigator.clipboard.writeText(value);
                    return;
                }

                const textarea = document.createElement("textarea");
                textarea.value = value;
                textarea.setAttribute("readonly", "");
                textarea.style.position = "fixed";
                textarea.style.opacity = "0";
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand("copy");
                textarea.remove();
            };

            const showCopied = () => {
                if (!copyStatus) {
                    return;
                }

                copyStatus.textContent = copiedLabel;
                window.setTimeout(() => {
                    copyStatus.textContent = "";
                }, 1500);
            };

            copyCodeButton?.addEventListener("click", async () => {
                await copyText(joinAccess.dataset.gameCode ?? "");
                showCopied();
            });

            copyLinkButton?.addEventListener("click", async () => {
                const joinUrl = new URL(joinAccess.dataset.joinPath ?? "/Join", window.location.origin);
                await copyText(joinUrl.href);
                showCopied();
            });
        })();

        (() => {
            const initializeWagerForm = () => {
                const form = document.querySelector("[data-wager-form]");
                if (!form || form.dataset.hostGameplayInitialized === "true") {
                    return;
                }
                form.dataset.hostGameplayInitialized = "true";

                const display = form.querySelector(".wager-display");
                const validation = form.querySelector("[data-wager-validation]");
                const submit = form.querySelector("[data-wager-submit]");
                const minimum = Number(form.dataset.minimum);
                const maximum = Number(form.dataset.maximum);

                const refresh = () => {
                    const amount = Number(display.value);
                    const isValid = display.value !== "" &&
                        amount >= minimum &&
                        amount <= maximum;

                    submit.disabled = !isValid;
                    validation.textContent = isValid
                        ? validation.dataset.validLabel
                        : validation.dataset.invalidLabel;
                    validation.classList.toggle("wager-valid", isValid);
                };

                form.querySelectorAll("[data-wager-digit]").forEach(button => {
                    button.addEventListener("click", () => {
                        const nextValue =
                            (display.value + button.dataset.wagerDigit)
                                .replace(/^0+(?=\d)/, "");

                        display.value = Math.min(
                            Number(nextValue), maximum).toString();
                        refresh();
                    });
                });

                form.querySelector("[data-wager-max]")
                    ?.addEventListener("click", () => {
                        display.value = maximum.toString();
                        refresh();
                    });
                form.querySelector("[data-wager-clear]")
                    ?.addEventListener("click", () => {
                        display.value = "";
                        refresh();
                    });
                form.querySelector("[data-wager-backspace]")
                    ?.addEventListener("click", () => {
                        display.value = display.value.slice(0, -1);
                        refresh();
                    });

                refresh();
            };

            initializeWagerForm();
            document.addEventListener(
                "badwolf:host-gameplay-updated",
                initializeWagerForm);
        })();

        (() => {
            const input = document.querySelector("[data-host-image-input]");
            const preview = document.querySelector("[data-host-image-preview]");
            let previewUrl;

            input?.addEventListener("change", () => {
                const file = input.files?.[0];
                if (!file || !preview) {
                    return;
                }

                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                }

                previewUrl = URL.createObjectURL(file);
                preview.src = previewUrl;
                preview.hidden = false;
            });
        })();

        (() => {
            const cards = [...document.querySelectorAll("[data-auto-fit-overlay]")];

            if (cards.length === 0) {
                return;
            }

            const fitCard = card => {
                const elements = [...card.querySelectorAll(
                    "p, li, .answer-result-score")];

                if (elements.length === 0) {
                    return;
                }

                for (const element of elements) {
                    element.style.removeProperty("font-size");
                }

                const baseSizes = elements.map(element =>
                    Number.parseFloat(getComputedStyle(element).fontSize));

                const fits = () => {
                    if (card.scrollHeight > card.clientHeight + 1) {
                        return false;
                    }

                    return elements.every(element =>
                        element.scrollWidth <= element.clientWidth + 1);
                };

                let scale = 1;
                while (scale > 0.35 && !fits()) {
                    scale -= 0.025;
                    elements.forEach((element, index) => {
                        element.style.fontSize = `${baseSizes[index] * scale}px`;
                    });
                }
            };

            const fitCards = () => {
                for (const card of cards) {
                    fitCard(card);
                    card.classList.add("is-auto-fit-ready");
                }
            };

            fitCards();

            if (typeof ResizeObserver !== "undefined") {
                const observer = new ResizeObserver(fitCards);
                cards.forEach(card => observer.observe(card));
            } else {
                window.addEventListener("resize", fitCards);
            }
        })();

        (() => {
            const overlay = document.querySelector("[data-answer-result-overlay]");

            if (!overlay) {
                return;
            }

            window.setTimeout(() => {
                overlay.remove();
            }, 5000);
        })();

        (() => {
            const board = document.querySelector(".host-game-board");
            const resizer = document.querySelector("[data-scoreboard-resizer]");
            const storageKey = "badwolfquiz:player-panel-height";

            if (!board || !resizer) {
                return;
            }

            const limits = () => ({
                minimum: 130,
                maximum: Math.max(130, Math.floor(window.innerHeight * 0.65))
            });
            const applyHeight = value => {
                const { minimum, maximum } = limits();
                const height = Math.min(maximum, Math.max(minimum, Math.round(value)));
                board.style.setProperty("--game-scoreboard-space", `${height}px`);
                resizer.setAttribute("aria-valuemax", maximum.toString());
                resizer.setAttribute("aria-valuenow", height.toString());
                return height;
            };

            const savedHeight = Number.parseInt(localStorage.getItem(storageKey), 10);
            const defaultHeight = Number.parseFloat(
                getComputedStyle(board).getPropertyValue("--game-scoreboard-space"));
            applyHeight(Number.isFinite(savedHeight) ? savedHeight : defaultHeight);

            let startY = 0;
            let startHeight = 0;

            resizer.addEventListener("pointerdown", event => {
                startY = event.clientY;
                startHeight = Number.parseFloat(
                    getComputedStyle(board).getPropertyValue("--game-scoreboard-space"));
                resizer.setPointerCapture(event.pointerId);
                document.body.classList.add("is-resizing-scoreboard");
            });

            resizer.addEventListener("pointermove", event => {
                if (!resizer.hasPointerCapture(event.pointerId)) {
                    return;
                }

                applyHeight(startHeight + startY - event.clientY);
            });

            const finishResize = event => {
                if (!resizer.hasPointerCapture(event.pointerId)) {
                    return;
                }

                resizer.releasePointerCapture(event.pointerId);
                document.body.classList.remove("is-resizing-scoreboard");
                localStorage.setItem(
                    storageKey,
                    resizer.getAttribute("aria-valuenow"));
            };
            resizer.addEventListener("pointerup", finishResize);
            resizer.addEventListener("pointercancel", finishResize);

            resizer.addEventListener("keydown", event => {
                if (event.key !== "ArrowUp" && event.key !== "ArrowDown") {
                    return;
                }

                event.preventDefault();
                const current = Number.parseInt(resizer.getAttribute("aria-valuenow"), 10);
                const height = applyHeight(current + (event.key === "ArrowUp" ? 20 : -20));
                localStorage.setItem(storageKey, height.toString());
            });

            window.addEventListener("resize", () => {
                const current = Number.parseInt(resizer.getAttribute("aria-valuenow"), 10);
                applyHeight(current);
            });
        })();

        (() => {
            const board = document.querySelector(".host-game-board");
            const playerList = document.getElementById("player-list");
            if (!board || !playerList || !playerList.classList.contains("game-scoreboard")) {
                return;
            }

            const playerStorageKey =
                `badwolfquiz:${board.dataset.gameCode}:player-card-width`;
            const hostStorageKey =
                `badwolfquiz:${board.dataset.gameCode}:host-bottom-card-width`;
            const limits = () => ({
                minimum: 150,
                maximum: Math.max(150, Math.min(430, window.innerWidth * 0.8))
            });
            const applyWidth = (value, isHost) => {
                const { minimum, maximum } = limits();
                const width = Math.min(maximum, Math.max(minimum, Math.round(value)));
                board.style.setProperty(
                    isHost ? "--host-bottom-card-width" : "--player-card-width",
                    `${width}px`);
                return width;
            };

            const savedPlayerWidth = Number.parseInt(
                localStorage.getItem(playerStorageKey),
                10);
            const savedHostWidth = Number.parseInt(
                localStorage.getItem(hostStorageKey),
                10);
            const defaultWidth = window.innerWidth <= 700 ? 155 : 230;
            applyWidth(
                Number.isFinite(savedPlayerWidth) ? savedPlayerWidth : defaultWidth,
                false);
            applyWidth(
                Number.isFinite(savedHostWidth) ? savedHostWidth : defaultWidth,
                true);

            playerList.addEventListener("pointerdown", event => {
                const handle = event.target.closest("[data-player-card-width-resizer]");
                if (!handle) {
                    return;
                }

                event.preventDefault();
                const card = handle.closest(".scoreboard-player");
                const isHost = card.classList.contains("host-card");
                const startX = event.clientX;
                const startWidth = card.getBoundingClientRect().width;
                const pointerId = event.pointerId;
                document.body.classList.add("is-resizing-player-cards");

                const move = moveEvent => {
                    if (moveEvent.pointerId !== pointerId) {
                        return;
                    }

                    applyWidth(startWidth - (moveEvent.clientX - startX), isHost);
                };
                const stop = stopEvent => {
                    if (stopEvent.pointerId !== pointerId) {
                        return;
                    }

                    window.removeEventListener("pointermove", move);
                    window.removeEventListener("pointerup", stop);
                    window.removeEventListener("pointercancel", stop);
                    document.body.classList.remove("is-resizing-player-cards");
                    const property = isHost
                        ? "--host-bottom-card-width"
                        : "--player-card-width";
                    const width = Number.parseFloat(
                        getComputedStyle(board).getPropertyValue(property));
                    localStorage.setItem(
                        isHost ? hostStorageKey : playerStorageKey,
                        Math.round(width).toString());
                };

                window.addEventListener("pointermove", move);
                window.addEventListener("pointerup", stop);
                window.addEventListener("pointercancel", stop);
            });

            playerList.addEventListener("keydown", event => {
                if (!event.target.matches("[data-player-card-width-resizer]") ||
                    (event.key !== "ArrowLeft" && event.key !== "ArrowRight")) {
                    return;
                }

                event.preventDefault();
                const isHost = event.target
                    .closest(".scoreboard-player")
                    .classList.contains("host-card");
                const property = isHost
                    ? "--host-bottom-card-width"
                    : "--player-card-width";
                const current = Number.parseFloat(
                    getComputedStyle(board).getPropertyValue(property));
                const width = applyWidth(
                    current + (event.key === "ArrowLeft" ? 12 : -12),
                    isHost);
                localStorage.setItem(
                    isHost ? hostStorageKey : playerStorageKey,
                    width.toString());
            });

            window.addEventListener("resize", () => {
                const playerWidth = Number.parseFloat(
                    getComputedStyle(board).getPropertyValue("--player-card-width"));
                const hostWidth = Number.parseFloat(
                    getComputedStyle(board).getPropertyValue("--host-bottom-card-width"));
                applyWidth(playerWidth, false);
                applyWidth(hostWidth, true);
            });
        })();

        (() => {
            const lobby = document.querySelector("[data-game-code]");
            const playerCount = document.getElementById("player-count");
            const playerList = document.getElementById("player-list");
            const boardPlayerList = document.getElementById("board-player-list");
            const boardGrid = document.querySelector(".host-board-grid");
            const hostCard = playerList?.querySelector("[data-host-card]");
            const hostSlot = document.querySelector("[data-board-host-slot]");
            const hostCardList = document.querySelector(
                "[data-board-host-card-list]");
            const hostCardResizer = document.querySelector(
                "[data-board-host-card-resizer]");
            const hostCardDragHandle = document.querySelector(
                "[data-board-host-card-drag-handle]");
            const wideHostLayout = window.matchMedia("(min-width: 1700px)");

            if (!lobby || !playerList || typeof signalR === "undefined") {
                return;
            }

            const gameCode = lobby.dataset.gameCode;
            const hostCardSizeKey = `badwolfquiz:${gameCode}:host-card-size`;
            const hostCardPositionKey = `badwolfquiz:${gameCode}:host-card-position`;
            let hostCardVerticalPosition = .5;

            const storedHostCardPosition = Number.parseFloat(
                localStorage.getItem(hostCardPositionKey));
            if (Number.isFinite(storedHostCardPosition)) {
                hostCardVerticalPosition = Math.max(
                    0,
                    Math.min(1, storedHostCardPosition));
            }

            const canPositionHostCard = () =>
                hostSlot &&
                boardGrid &&
                document.querySelector("[data-host-gameplay-board]")?.hidden === false &&
                wideHostLayout.matches;

            const getHostCardVerticalBounds = () => {
                const boardBounds = boardGrid.getBoundingClientRect();
                const cardBounds = hostSlot.getBoundingClientRect();
                const minTop = Math.max(80, boardBounds.top);
                const maxTop = Math.max(
                    minTop,
                    Math.min(
                        window.innerHeight - cardBounds.height - 8,
                        boardBounds.bottom - cardBounds.height));

                return { minTop, maxTop };
            };

            const positionHostCard = () => {
                if (!hostSlot || !boardGrid || !canPositionHostCard()) {
                    hostSlot?.classList.remove("is-positioned");
                    return;
                }

                const boardBounds = boardGrid.getBoundingClientRect();
                hostSlot.classList.add("is-positioned");
                const cardBounds = hostSlot.getBoundingClientRect();
                const left = Math.max(
                    8,
                    (boardBounds.left - cardBounds.width) / 2);
                const verticalBounds = getHostCardVerticalBounds();
                const top = verticalBounds.minTop +
                    (verticalBounds.maxTop - verticalBounds.minTop) *
                    hostCardVerticalPosition;
                hostSlot.style.setProperty("--board-host-left", `${left}px`);
                hostSlot.style.setProperty("--board-host-top", `${top}px`);
            };

            const relocateHostCard = () => {
                if (!hostCard) {
                    return;
                }

                if (hostCardList && canPositionHostCard()) {
                    hostCardList.append(hostCard);
                } else if (!playerList.contains(hostCard)) {
                    playerList.prepend(hostCard);
                }

                positionHostCard();
            };

            const applyHostCardSize = (width, height) => {
                if (!hostSlot) {
                    return null;
                }

                const boardBounds = boardGrid?.getBoundingClientRect();
                const maxWidth = Math.max(
                    190,
                    Math.min(430, (boardBounds?.left ?? 454) - 20));
                const maxHeight = Math.max(
                    180,
                    Math.min(650, boardBounds?.height ?? 650));
                const size = {
                    width: Math.max(190, Math.min(maxWidth, Math.round(width))),
                    height: Math.max(180, Math.min(maxHeight, Math.round(height)))
                };
                hostSlot.style.setProperty("--board-host-width", `${size.width}px`);
                hostSlot.style.setProperty("--board-host-height", `${size.height}px`);
                positionHostCard();
                return size;
            };

            if (hostSlot && hostCardDragHandle) {
                hostCardDragHandle.addEventListener("pointerdown", event => {
                    if (!canPositionHostCard()) {
                        return;
                    }

                    event.preventDefault();
                    const startY = event.clientY;
                    const startTop = hostSlot.getBoundingClientRect().top;
                    hostCardDragHandle.setPointerCapture(event.pointerId);
                    document.body.classList.add("is-moving-host-card");

                    const move = moveEvent => {
                        const bounds = getHostCardVerticalBounds();
                        const top = Math.max(
                            bounds.minTop,
                            Math.min(
                                bounds.maxTop,
                                startTop + moveEvent.clientY - startY));
                        const range = bounds.maxTop - bounds.minTop;
                        hostCardVerticalPosition = range > 0
                            ? (top - bounds.minTop) / range
                            : .5;
                        hostSlot.style.setProperty(
                            "--board-host-top",
                            `${top}px`);
                    };

                    const stop = stopEvent => {
                        if (hostCardDragHandle.hasPointerCapture(stopEvent.pointerId)) {
                            hostCardDragHandle.releasePointerCapture(stopEvent.pointerId);
                        }
                        hostCardDragHandle.removeEventListener("pointermove", move);
                        hostCardDragHandle.removeEventListener("pointerup", stop);
                        hostCardDragHandle.removeEventListener("pointercancel", stop);
                        document.body.classList.remove("is-moving-host-card");
                        localStorage.setItem(
                            hostCardPositionKey,
                            hostCardVerticalPosition.toString());
                    };

                    hostCardDragHandle.addEventListener("pointermove", move);
                    hostCardDragHandle.addEventListener("pointerup", stop);
                    hostCardDragHandle.addEventListener("pointercancel", stop);
                });

                hostCardDragHandle.addEventListener("keydown", event => {
                    if (event.key !== "ArrowUp" && event.key !== "ArrowDown") {
                        return;
                    }

                    event.preventDefault();
                    const bounds = getHostCardVerticalBounds();
                    const currentTop = hostSlot.getBoundingClientRect().top;
                    const top = Math.max(
                        bounds.minTop,
                        Math.min(
                            bounds.maxTop,
                            currentTop + (event.key === "ArrowDown" ? 24 : -24)));
                    const range = bounds.maxTop - bounds.minTop;
                    hostCardVerticalPosition = range > 0
                        ? (top - bounds.minTop) / range
                        : .5;
                    positionHostCard();
                    localStorage.setItem(
                        hostCardPositionKey,
                        hostCardVerticalPosition.toString());
                });
            }

            if (hostSlot && hostCardResizer) {
                // try {
                //     const storedSize = JSON.parse(localStorage.getItem(hostCardSizeKey));
                //     if (storedSize?.width && storedSize?.height) {
                //         applyHostCardSize(storedSize.width, storedSize.height);
                //     }
                // } catch {
                //     localStorage.removeItem(hostCardSizeKey);
                // }

                hostCardResizer.addEventListener("pointerdown", event => {
                    const startX = event.clientX;
                    const startY = event.clientY;
                    const startWidth = hostSlot.getBoundingClientRect().width;
                    const startHeight = hostSlot.getBoundingClientRect().height;
                    hostCardResizer.setPointerCapture(event.pointerId);
                    document.body.classList.add("is-resizing-host-card");

                    const move = moveEvent => {
                        applyHostCardSize(
                            startWidth + 2 * (moveEvent.clientX - startX),
                            startHeight + 2 * (moveEvent.clientY - startY));
                    };
                    const stop = stopEvent => {
                        hostCardResizer.releasePointerCapture(stopEvent.pointerId);
                        hostCardResizer.removeEventListener("pointermove", move);
                        hostCardResizer.removeEventListener("pointerup", stop);
                        hostCardResizer.removeEventListener("pointercancel", stop);
                        document.body.classList.remove("is-resizing-host-card");
                        const bounds = hostSlot.getBoundingClientRect();
                        const size = applyHostCardSize(bounds.width, bounds.height);
                        localStorage.setItem(hostCardSizeKey, JSON.stringify(size));
                    };

                    hostCardResizer.addEventListener("pointermove", move);
                    hostCardResizer.addEventListener("pointerup", stop);
                    hostCardResizer.addEventListener("pointercancel", stop);
                });

                hostCardResizer.addEventListener("keydown", event => {
                    if (!["ArrowLeft", "ArrowRight", "ArrowUp", "ArrowDown"]
                        .includes(event.key)) {
                        return;
                    }

                    event.preventDefault();
                    const bounds = hostSlot.getBoundingClientRect();
                    const size = applyHostCardSize(
                        bounds.width + (event.key === "ArrowRight" ? 24 :
                            event.key === "ArrowLeft" ? -24 : 0),
                        bounds.height + (event.key === "ArrowDown" ? 24 :
                            event.key === "ArrowUp" ? -24 : 0));
                    localStorage.setItem(hostCardSizeKey, JSON.stringify(size));
                });
            }

            const restoreHostCardSize = () => {
                if (!hostSlot || !hostCardResizer) {
                    return;
                }

                try {
                    const storedSize = JSON.parse(
                        localStorage.getItem(hostCardSizeKey));

                    if (storedSize?.width && storedSize?.height) {
                        applyHostCardSize(storedSize.width, storedSize.height);
                    }
                } catch {
                    localStorage.removeItem(hostCardSizeKey);
                }
            };

            const relocateAndRestoreHostCard = () => {
                relocateHostCard();

                requestAnimationFrame(() => {
                    restoreHostCardSize();
                    positionHostCard();
                });
            };

            wideHostLayout.addEventListener(
                "change",
                relocateAndRestoreHostCard);

            window.addEventListener(
                "resize",
                relocateAndRestoreHostCard);

            relocateAndRestoreHostCard();

            const statusLabels = {
                active: lobby.dataset.statusActive,
                inactive: lobby.dataset.statusInactive,
                disconnected: lobby.dataset.statusDisconnected,
                rejoinpending: lobby.dataset.statusRejoinpending
            };

            const getPlayerImageSource = player =>
                player.imageDataUrl ||
                (player.avatarId ? `/avatars/${player.avatarId}` : "");
            const withMutedWebcamAudio = value => {
                const url = new URL(value);
                url.searchParams.set("deafen", "1");
                url.searchParams.set("noaudio", "");
                if (url.hash.length > 1) {
                    const fragment = new URLSearchParams(url.hash.slice(1));
                    fragment.set("deafen", "1");
                    fragment.set("noaudio", "");
                    url.hash = fragment.toString();
                }
                return url.toString();
            };
            const gameStatus = document.getElementById("game-status");
            const startGameForm = document.getElementById("start-game-form");
            const approveForm = document.getElementById("approve-rejoin-form");
            const approvePlayerId = document.getElementById("approve-player-id");

            const approveRejoin = async playerId => {
                if (!approveForm || !approvePlayerId) {
                    return;
                }

                approvePlayerId.value = playerId;

                const response = await fetch(approveForm.action, {
                    method: "POST",
                    body: new FormData(approveForm),
                    headers: {
                        "Accept": "application/json",
                        "X-Requested-With": "XMLHttpRequest"
                    }
                });

                if (!response.ok) {
                    throw new Error(response.statusText);
                }
            };
            const activePlayerForm = document.getElementById("set-active-player-form");
            const activePlayerId = document.getElementById("active-player-id");
            const removePlayerForm = document.getElementById("remove-player-form");
            const removePlayerId = document.getElementById("remove-player-id");
            const removePlayerBlock = document.getElementById("remove-player-block");
            const removePlayerDialog = document.getElementById("remove-player-dialog");
            const removePlayerDialogTarget = document.getElementById("remove-player-dialog-target");
            const confirmRemovePlayer = document.querySelector("[data-confirm-remove-player]");
            const confirmBlockPlayer = document.querySelector("[data-confirm-block-player]");
            const blockedPlayersDialog = document.getElementById("blocked-players-dialog");
            const forceAdvanceRoundForm = document.getElementById("force-advance-round-form");
            const forceAdvanceRoundDialog = document.getElementById("force-advance-round-dialog");
            const confirmForceAdvanceRound = document.querySelector("[data-confirm-force-advance-round]");

            const forceAdvanceFinalForm = document.getElementById("force-advance-final-form");
            const forceAdvanceFinalDialog = document.getElementById("force-advance-final-dialog");
            const confirmForceAdvanceFinal = document.querySelector("[data-confirm-force-advance-final]");

            document.querySelector("[data-open-force-advance-round-dialog]")
                ?.addEventListener("click", () => {
                    forceAdvanceRoundDialog?.showModal();
                });

            confirmForceAdvanceRound?.addEventListener("click", () => {
                forceAdvanceRoundDialog?.close();
                forceAdvanceRoundForm?.submit();
            });

            for (const button of document.querySelectorAll(
                "[data-close-force-advance-round-dialog]")) {
                button.addEventListener("click", () => {
                    forceAdvanceRoundDialog?.close();
                });
            }

            forceAdvanceRoundDialog?.addEventListener("click", event => {
                if (event.target === forceAdvanceRoundDialog) {
                    forceAdvanceRoundDialog.close();
                }
            });

            document.querySelector("[data-open-force-advance-final-dialog]")
                ?.addEventListener("click", () => {
                    forceAdvanceFinalDialog?.showModal();
                });

            confirmForceAdvanceFinal?.addEventListener("click", () => {
                forceAdvanceFinalDialog?.close();
                forceAdvanceFinalForm?.requestSubmit();
            });

            for (const button of document.querySelectorAll(
                "[data-close-force-advance-final-dialog]")) {
                button.addEventListener("click", () => {
                    forceAdvanceFinalDialog?.close();
                });
            }

            forceAdvanceFinalDialog?.addEventListener("click", event => {
                if (event.target === forceAdvanceFinalDialog) {
                    forceAdvanceFinalDialog.close();
                }
            });

            document.querySelector("[data-open-blocked-players]")
                ?.addEventListener("click", () => blockedPlayersDialog?.showModal());

            for (const button of document.querySelectorAll("[data-close-blocked-players]")) {
                button.addEventListener("click", () => blockedPlayersDialog?.close());
            }

            blockedPlayersDialog?.addEventListener("click", event => {
                if (event.target === blockedPlayersDialog) {
                    blockedPlayersDialog.close();
                }
            });

            const removePlayer = (playerId, playerName) => {
                if (!removePlayerForm ||
                    !removePlayerId ||
                    !removePlayerDialog ||
                    !removePlayerDialogTarget) {
                    return;
                }

                removePlayerId.value = playerId;
                removePlayerDialogTarget.textContent =
                    lobby.dataset.removePlayerConfirm.replace("{0}", playerName);
                removePlayerDialog.showModal();
            };

            confirmRemovePlayer?.addEventListener("click", () => {
                if (removePlayerBlock) {
                    removePlayerBlock.value = "false";
                }
                removePlayerDialog?.close();
                removePlayerForm?.submit();
            });

            confirmBlockPlayer?.addEventListener("click", () => {
                if (removePlayerBlock) {
                    removePlayerBlock.value = "true";
                }
                removePlayerDialog?.close();
                removePlayerForm?.submit();
            });

            for (const button of document.querySelectorAll("[data-close-remove-player-dialog]")) {
                button.addEventListener("click", () => removePlayerDialog?.close());
            }

            removePlayerDialog?.addEventListener("click", event => {
                if (event.target === removePlayerDialog) {
                    removePlayerDialog.close();
                }
            });

            document.addEventListener("click", event => {
                const removeButton = event.target.closest("[data-remove-player]");

                if (removeButton) {
                    const card = removeButton.closest("[data-player-id]");
                    const playerName = card?.querySelector("strong")?.textContent?.trim() ?? "";
                    removePlayer(removeButton.dataset.removePlayer, playerName);
                    return;
                }

                const button = event.target.closest("[data-make-active-player]");

                if (!button ||
                    button.disabled ||
                    lobby?.dataset.activePlayerLocked === "true" ||
                    !activePlayerForm ||
                    !activePlayerId) {
                    return;
                }

                activePlayerId.value = button.dataset.makeActivePlayer;
                activePlayerForm.submit();
            });

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/game")
                .withAutomaticReconnect()
                .build();
            const webcam = window.BadWolfWebcam.createHost({
                connection,
                gameCode,
                playerList
            });

            let hasReceivedInitialBuzzerState = false;
            let buzzerState = null;
            
            let timerPanel = document.getElementById("game-timer");
            let timerValue = document.getElementById("game-timer-value");
            let timerPause = document.querySelector(".game-timer-pause");
            let timerResume = document.querySelector(".game-timer-resume");
            const playerJoinLockForm = document.querySelector(".player-join-lock-form");
            const playerJoinLockButton = playerJoinLockForm?.querySelector(".player-join-lock");
            const questionSelectionForms = document.querySelectorAll(".question-selection-form");
            const gameBoardError = document.getElementById("game-board-error");
            let revealClueForm = document.querySelector("[data-reveal-clue-form]");
            let questionClues = document.querySelector("[data-question-clues]");
            let questionHeading = document.querySelector("[data-question-heading]");

            const initializeQuestionReward = () => {
                if (!questionHeading ||
                    !questionHeading.dataset.rewardTemplate ||
                    !questionHeading.dataset.currentReward) {
                    return;
                }

                const template = questionHeading.dataset.rewardTemplate;
                const marker = "__REWARD__";
                const markerIndex = template.indexOf(marker);

                if (markerIndex < 0) {
                    return;
                }

                const prefix = template.slice(0, markerIndex);
                const suffix = template.slice(markerIndex + marker.length);

                questionHeading.replaceChildren();

                questionHeading.append(document.createTextNode(prefix));

                const reward = document.createElement("span");
                reward.dataset.questionReward = "";
                reward.textContent = questionHeading.dataset.currentReward;
                questionHeading.append(reward);

                questionHeading.append(document.createTextNode(suffix));
            };

            const updateQuestionReward = value => {
                if (!questionHeading ||
                    value === null ||
                    value === undefined) {
                    return;
                }

                const reward =
                    questionHeading.querySelector("[data-question-reward]");

                if (!reward) {
                    return;
                }

                const nextValue = value.toString();

                if (reward.textContent === nextValue) {
                    return;
                }

                reward.textContent = nextValue;

                reward.classList.remove("question-reward-changed");

                // Restart the animation when the reward changes again.
                void reward.offsetWidth;

                reward.classList.add("question-reward-changed");
            };

            initializeQuestionReward();

            document.addEventListener("badwolf:host-gameplay-updated", () => {
                timerPanel = document.getElementById("game-timer");
                timerValue = document.getElementById("game-timer-value");
                timerPause = document.querySelector(".game-timer-pause");
                timerResume = document.querySelector(".game-timer-resume");
                revealClueForm = document.querySelector("[data-reveal-clue-form]");
                questionClues = document.querySelector("[data-question-clues]");
                questionHeading = document.querySelector("[data-question-heading]");
                initializeQuestionReward();

                requestAnimationFrame(() => {
                    relocateAndRestoreHostCard();
                    refreshScrollingNames();
                    syncBoardHeaderHeights();
                });
            });

            let gameBoardErrorDismissHandle = null;

            const showGameBoardError = message => {
                if (!gameBoardError) {
                    return;
                }

                window.clearTimeout(gameBoardErrorDismissHandle);

                gameBoardError.textContent = message;
                gameBoardError.hidden = false;
                gameBoardError.classList.remove("message-hidden");

                gameBoardErrorDismissHandle = window.setTimeout(() => {
                    gameBoardError.classList.add("message-hidden");

                    window.setTimeout(() => {
                        gameBoardError.hidden = true;
                        gameBoardError.classList.remove("message-hidden");
                    }, 300);
                }, 3000);
            };

            const isExternalHostFlowActive = () =>
                document.querySelector(
                    "[data-host-gameplay-view] [data-game-intro-page], " +
                    "[data-host-gameplay-view] [data-final-question-transition]") !== null;

            let hostCommandDepth = 0;
            let hostReloadPending = false;
            let hostGameplayRefreshPending = false;

            const requestHostReload = () => {
                if (hostCommandDepth > 0) {
                    hostReloadPending = true;
                    return;
                }

                window.location.reload();
            };

            const requestHostGameplayRefresh = () => {
                if (hostCommandDepth > 0) {
                    hostGameplayRefreshPending = true;
                    return Promise.resolve();
                }

                if (!window.BadWolfHostGameplay) {
                    window.location.reload();
                    return Promise.resolve();
                }

                return window.BadWolfHostGameplay.refresh()
                    .catch(error => {
                        console.error("Host gameplay refresh failed.", error);
                        window.location.reload();
                    });
            };

            const flushPendingHostChanges = () => {
                if (hostCommandDepth > 0) {
                    return;
                }

                if (hostReloadPending) {
                    hostReloadPending = false;
                    window.location.reload();
                    return;
                }

                if (hostGameplayRefreshPending) {
                    hostGameplayRefreshPending = false;
                    void requestHostGameplayRefresh();
                }
            };

            const submitGameControl = async (
                form,
                submitter = null,
                disableSubmitter = true,
                flushPendingHostChangesOnComplete = true) => {
                const button = submitter ?? form.querySelector("button[type='submit']");
                if (disableSubmitter) {
                    button?.setAttribute("disabled", "disabled");
                }
                hostCommandDepth += 1;

                try {
                    const formData = new FormData(form);
                    if (submitter?.name) {
                        formData.append(submitter.name, submitter.value);
                    }

                    const response = await fetch(form.action, {
                        method: "POST",
                        body: formData,
                        headers: {
                            "Accept": "application/json",
                            "X-Requested-With": "XMLHttpRequest"
                        }
                    });
                    const contentType = response.headers.get("content-type") ?? "";
                    const result = contentType.includes("application/json")
                        ? await response.json()
                        : null;

                    if (!response.ok || !result?.success) {
                        throw new Error(result?.error ?? response.statusText);
                    }

                    return result;
                } finally {
                    if (disableSubmitter) {
                        button?.removeAttribute("disabled");
                    }
                    hostCommandDepth = Math.max(0, hostCommandDepth - 1);

                    if (flushPendingHostChangesOnComplete) {
                        flushPendingHostChanges();
                    }
                }
            };

            for (const form of questionSelectionForms) {
                form.addEventListener("submit", async event => {
                    event.preventDefault();

                    try {
                        await submitGameControl(form);
                        await requestHostGameplayRefresh();
                    } catch (error) {
                        console.error(error);
                        showGameBoardError(error.message);
                    }
                });
            }

            document.addEventListener("submit", async event => {
                const form = event.target instanceof HTMLFormElement &&
                    event.target.matches(".question-judge-actions")
                    ? event.target
                    : null;
                if (!form) {
                    return;
                }

                event.preventDefault();
                try {
                    await submitGameControl(form, event.submitter);
                    const judgingButton = event.submitter instanceof HTMLButtonElement
                        ? event.submitter
                        : null;
                    if (judgingButton?.name === "isCorrect") {
                        playAnswerFeedbackSound(judgingButton.value === "true");
                    }
                    const gameplayView = document.querySelector(
                        "[data-host-gameplay-view]");
                    if (gameplayView?.contains(form)) {
                        await requestHostGameplayRefresh();
                    } else {
                        requestHostReload();
                    }
                } catch (error) {
                    console.error(error);
                    showGameBoardError(error.message);
                }
            });

            for (const form of document.querySelectorAll(
                "form[action*='handler=RandomActivePlayer']")) {
                form.addEventListener("submit", async event => {
                    event.preventDefault();

                    try {
                        await submitGameControl(form, event.submitter);
                    } catch (error) {
                        console.error(error);
                        showGameBoardError(error.message);
                    }
                });
            }

            const handleGameControlError = error => {
                console.error(error);
                window.alert(error.message);
            };

            const applyClueReveal = (update, preserveRevealControl = false) => {
                if (!questionClues ||
                    questionClues.dataset.sourceQuestionId !==
                        update.sourceQuestionId.toString()) {
                    return;
                }

                const previousRevealedClueCount = Number.parseInt(
                    questionClues.dataset.revealedClueCount ?? "",
                    10);
                const nextRevealedClueCount = Number(update.revealedClueCount);
                const clues = Array.from(questionClues.querySelectorAll(
                    "[data-question-clue]"));

                clues.forEach((clue, index) => {
                    clue.classList.toggle(
                        "question-clue-hidden",
                        index >= nextRevealedClueCount);
                });

                questionClues.dataset.revealedClueCount =
                    nextRevealedClueCount.toString();
                const presentation = questionClues.closest(
                    "[data-media-autoplay-state]");
                if (presentation) {
                    presentation.dataset.mediaAutoplayState =
                        `question:${update.sourceQuestionId}:clues:${nextRevealedClueCount}`;
                }

                if (Number.isFinite(previousRevealedClueCount) &&
                    Number.isFinite(nextRevealedClueCount) &&
                    nextRevealedClueCount > previousRevealedClueCount) {
                    clues
                        .slice(previousRevealedClueCount, nextRevealedClueCount)
                        .forEach(clue =>
                            window.BadWolfMediaAutoplay?.transition(clue));
                }

                if (questionHeading) {
                    if (nextRevealedClueCount >= 4) {
                        updateQuestionReward(
                            Number(questionHeading.dataset.rewardQuarterValue));
                    } else if (nextRevealedClueCount >= 3) {
                        updateQuestionReward(
                            Number(questionHeading.dataset.rewardHalfValue));
                    } else {
                        updateQuestionReward(
                            Number(questionHeading.dataset.rewardFullValue));
                    }
                }

                if (revealClueForm &&
                    !update.canRevealClue &&
                    !preserveRevealControl) {
                    revealClueForm.remove();
                }
            };

            const createOptimisticClueReveal = () => {
                if (!questionClues) {
                    return null;
                }

                const sourceQuestionId = Number.parseInt(
                    questionClues.dataset.sourceQuestionId ?? "",
                    10);
                const revealedClueCount = Number.parseInt(
                    questionClues.dataset.revealedClueCount ?? "",
                    10);
                if (!Number.isFinite(sourceQuestionId) ||
                    !Number.isFinite(revealedClueCount) ||
                    revealedClueCount >= 4) {
                    return null;
                }

                const nextRevealedClueCount = revealedClueCount + 1;
                return {
                    sourceQuestionId,
                    revealedClueCount: nextRevealedClueCount,
                    canRevealClue: nextRevealedClueCount < 4
                };
            };

            const completeClueRevealRequest = async (form, submitter) => {
                try {
                    const result = await submitGameControl(
                        form,
                        submitter,
                        true,
                        false);
                    applyClueReveal(result);
                    flushPendingHostChanges();
                } catch (error) {
                    hostGameplayRefreshPending = false;
                    void requestHostGameplayRefresh();
                    handleGameControlError(error);
                }
            };

            document.addEventListener("click", event => {
                const button = event.target instanceof Element
                    ? event.target.closest(
                        "[data-reveal-clue-form] button[type='submit']")
                    : null;
                const form = button?.closest("[data-reveal-clue-form]");
                if (!(button instanceof HTMLButtonElement) ||
                    !(form instanceof HTMLFormElement) ||
                    button.disabled) {
                    return;
                }

                event.preventDefault();
                const optimisticUpdate = createOptimisticClueReveal();
                if (optimisticUpdate) {
                    applyClueReveal(optimisticUpdate, true);
                }
                void completeClueRevealRequest(form, button);
            });

            document.addEventListener("submit", event => {
                const form = event.target instanceof HTMLFormElement &&
                    event.target.matches("[data-reveal-clue-form]")
                    ? event.target
                    : null;
                if (!form) {
                    return;
                }

                event.preventDefault();
                const optimisticUpdate = createOptimisticClueReveal();
                if (optimisticUpdate) {
                    applyClueReveal(optimisticUpdate, true);
                }
                void completeClueRevealRequest(form, event.submitter);
            });

            connection.on("QuestionClueRevealed", update => {
                applyClueReveal(update);
            });

            document.addEventListener("submit", async event => {
                const form = event.target instanceof HTMLFormElement &&
                    (event.target.matches(".game-timer-pause") ||
                     event.target.matches(".game-timer-resume") ||
                     event.target.matches(".game-timer-adjust"))
                    ? event.target
                    : null;
                if (!form) {
                    return;
                }

                event.preventDefault();
                const isQuickAdjustment = form.matches(".game-timer-adjust");
                const submitter = event.submitter instanceof HTMLButtonElement
                    ? event.submitter
                    : null;
                const submittedWithPointer =
                    isQuickAdjustment && submitter?.matches(":hover") === true;

                try {
                    await submitGameControl(
                        form,
                        submitter,
                        !isQuickAdjustment);
                    if (submittedWithPointer) {
                        submitter?.blur();
                    }
                } catch (error) {
                    handleGameControlError(error);
                }
            });

            playerJoinLockForm?.addEventListener("submit", async event => {
                event.preventDefault();

                try {
                    const result = await submitGameControl(playerJoinLockForm);
                    const isOpen = result.allowsNewPlayers;
                    const label = isOpen
                        ? playerJoinLockForm.dataset.closeLabel
                        : playerJoinLockForm.dataset.openLabel;

                    playerJoinLockButton.classList.toggle("is-open", isOpen);
                    playerJoinLockButton.classList.toggle("is-closed", !isOpen);
                    playerJoinLockButton.title = label;
                    playerJoinLockButton.setAttribute("aria-label", label);
                    playerJoinLockButton.querySelector("span").textContent =
                        isOpen ? "🔓" : "🔒";
                } catch (error) {
                    handleGameControlError(error);
                }
            });

            const refreshScrollingNames = () => {
                boardPlayerList?.querySelectorAll(".board-player-name").forEach(name => {
                    name.classList.remove("is-overflowing");
                    name.classList.toggle(
                        "is-overflowing",
                        name.scrollWidth > name.clientWidth + 1);
                });
            };

            const renderBoardPlayers = players => {
                if (!boardPlayerList) {
                    return;
                }

                boardPlayerList.replaceChildren();

                for (const player of players) {
                    const item = document.createElement("li");
                    item.dataset.sidebarPlayerId = player.id;

                    const name = document.createElement("span");
                    name.className = "board-player-name";
                    name.title = player.name;

                    const nameText = document.createElement("span");
                    nameText.textContent = player.name;
                    name.append(nameText);

                    const score = document.createElement("strong");
                    score.className = `board-player-score ${player.score < 0 ? "score-negative" : ""}`;
                    score.textContent = player.score.toString();

                    item.append(name, score);
                    boardPlayerList.append(item);
                }

                requestAnimationFrame(refreshScrollingNames);
            };

            const addPlayerCardWidthResizer = item => {
                const resizer = document.createElement("span");
                resizer.className = "player-card-width-resizer";
                resizer.dataset.playerCardWidthResizer = "";
                resizer.setAttribute("role", "separator");
                resizer.setAttribute("aria-orientation", "vertical");
                resizer.setAttribute(
                    "aria-label",
                    lobby.dataset.resizePlayerCardLabel);
                resizer.tabIndex = 0;
                item.append(resizer);
            };

            refreshScrollingNames();
            window.addEventListener("resize", refreshScrollingNames);

            let questionTimeoutAudioContext = null;
            let questionTimerWarningAudioContext = null;
            let answerFeedbackAudioContext = null;
            let questionTimerWarningKey = null;

            const createQuestionTimerWarningAudioContext = () => {
                const AudioContextType =
                    window.AudioContext || window.webkitAudioContext;
                if (!AudioContextType) {
                    return null;
                }

                questionTimerWarningAudioContext ??= new AudioContextType();
                if (questionTimerWarningAudioContext.state === "suspended") {
                    void questionTimerWarningAudioContext.resume();
                }
                return questionTimerWarningAudioContext;
            };

            const playQuestionTimerWarningRisingTick = remainingSeconds => {
                try {
                    const context = createQuestionTimerWarningAudioContext();
                    if (!context) {
                        return;
                    }

                    const now = context.currentTime;
                    const baseFrequency = 1180 + (5 - remainingSeconds) * 90;
                    const master = context.createGain();
                    master.gain.setValueAtTime(0.0001, now);
                    master.gain.exponentialRampToValueAtTime(0.12, now + 0.004);
                    master.gain.exponentialRampToValueAtTime(0.0001, now + 0.16);
                    master.connect(context.destination);

                    [1, 1.47, 2.11].forEach((ratio, index) => {
                        const oscillator = context.createOscillator();
                        const gain = context.createGain();
                        oscillator.type = "sine";
                        oscillator.frequency.setValueAtTime(baseFrequency * ratio, now);
                        gain.gain.setValueAtTime(0.0001, now);
                        gain.gain.exponentialRampToValueAtTime(0.7 / (index + 1), now + 0.003);
                        gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.11 + index * 0.02);
                        oscillator.connect(gain).connect(master);
                        oscillator.start(now);
                        oscillator.stop(now + 0.18);
                    });
                } catch (error) {
                    console.debug("Question timer warning audio is unavailable.", error);
                }
            };

            const playQuestionTimerWarningAlternatingTick = isHighPitch => {
                try {
                    const context = createQuestionTimerWarningAudioContext();
                    if (!context) {
                        return;
                    }

                    const now = context.currentTime;
                    const baseFrequency = isHighPitch ? 1380 : 980;
                    const master = context.createGain();
                    master.gain.setValueAtTime(0.0001, now);
                    master.gain.exponentialRampToValueAtTime(0.12, now + 0.004);
                    master.gain.exponentialRampToValueAtTime(0.0001, now + 0.14);
                    master.connect(context.destination);

                    [1, 1.43].forEach((ratio, index) => {
                        const oscillator = context.createOscillator();
                        const gain = context.createGain();
                        oscillator.type = "sine";
                        oscillator.frequency.setValueAtTime(baseFrequency * ratio, now);
                        gain.gain.setValueAtTime(0.0001, now);
                        gain.gain.exponentialRampToValueAtTime(0.72 / (index + 1), now + 0.003);
                        gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.09 + index * 0.02);
                        oscillator.connect(gain).connect(master);
                        oscillator.start(now);
                        oscillator.stop(now + 0.16);
                    });
                } catch (error) {
                    console.debug("Question timer warning audio is unavailable.", error);
                }
            };

            const playQuestionTimerWarningTick = (warningSlot, remainingMilliseconds) => {
                const soundMode = document.querySelector(
                    ".host-game-board[data-game-id]")?.dataset.questionTimerWarningSound;
                if (soundMode === "Rising") {
                    if (warningSlot % 2 === 0) {
                        playQuestionTimerWarningRisingTick(
                            Math.ceil(remainingMilliseconds / 1000));
                    }
                    return;
                }

                playQuestionTimerWarningAlternatingTick(warningSlot % 2 === 0);
            };

            const createAnswerFeedbackAudioContext = () => {
                const AudioContextType =
                    window.AudioContext || window.webkitAudioContext;
                if (!AudioContextType) {
                    return null;
                }

                answerFeedbackAudioContext ??= new AudioContextType();
                if (answerFeedbackAudioContext.state === "suspended") {
                    void answerFeedbackAudioContext.resume();
                }
                return answerFeedbackAudioContext;
            };

            const playCorrectAnswerTriumph = context => {
                const now = context.currentTime;
                const master = context.createGain();
                master.gain.setValueAtTime(0.0001, now);
                master.gain.exponentialRampToValueAtTime(0.18, now + 0.012);
                master.gain.exponentialRampToValueAtTime(0.0001, now + 0.9);
                master.connect(context.destination);

                [523.25, 659.25, 783.99, 1046.5].forEach((frequency, index) => {
                    const start = now + index * 0.105;
                    const oscillator = context.createOscillator();
                    const gain = context.createGain();
                    oscillator.type = index === 3 ? "sine" : "triangle";
                    oscillator.frequency.setValueAtTime(frequency, start);
                    gain.gain.setValueAtTime(0.0001, start);
                    gain.gain.exponentialRampToValueAtTime(0.72, start + 0.012);
                    gain.gain.exponentialRampToValueAtTime(0.0001, start + 0.42);
                    oscillator.connect(gain).connect(master);
                    oscillator.start(start);
                    oscillator.stop(start + 0.48);
                });
            };

            const playCorrectAnswerArcade = context => {
                const now = context.currentTime;
                const master = context.createGain();
                master.gain.setValueAtTime(0.0001, now);
                master.gain.exponentialRampToValueAtTime(0.12, now + 0.008);
                master.gain.exponentialRampToValueAtTime(0.0001, now + 0.62);
                master.connect(context.destination);

                [659.25, 880, 1318.51].forEach((frequency, index) => {
                    const start = now + index * 0.095;
                    const oscillator = context.createOscillator();
                    const gain = context.createGain();
                    oscillator.type = "square";
                    oscillator.frequency.setValueAtTime(frequency, start);
                    gain.gain.setValueAtTime(0.0001, start);
                    gain.gain.linearRampToValueAtTime(0.42, start + 0.006);
                    gain.gain.exponentialRampToValueAtTime(0.0001, start + 0.14);
                    oscillator.connect(gain).connect(master);
                    oscillator.start(start);
                    oscillator.stop(start + 0.17);
                });
            };

            const playCorrectAnswerChime = context => {
                const now = context.currentTime;
                const master = context.createGain();
                master.gain.setValueAtTime(0.0001, now);
                master.gain.exponentialRampToValueAtTime(0.16, now + 0.006);
                master.gain.exponentialRampToValueAtTime(0.0001, now + 1.05);
                master.connect(context.destination);

                [880, 1327, 1769, 2341].forEach((frequency, index) => {
                    const oscillator = context.createOscillator();
                    const gain = context.createGain();
                    oscillator.type = "sine";
                    oscillator.frequency.setValueAtTime(frequency, now);
                    oscillator.detune.setValueAtTime(index % 2 === 0 ? -5 : 7, now);
                    gain.gain.setValueAtTime(0.0001, now);
                    gain.gain.exponentialRampToValueAtTime(0.6 / (index + 1), now + 0.004);
                    gain.gain.exponentialRampToValueAtTime(0.0001, now + 0.58 + index * 0.1);
                    oscillator.connect(gain).connect(master);
                    oscillator.start(now);
                    oscillator.stop(now + 1.0);
                });
            };

            const playIncorrectAnswerDescent = context => {
                const now = context.currentTime;
                const master = context.createGain();
                master.gain.setValueAtTime(0.0001, now);
                master.gain.exponentialRampToValueAtTime(0.18, now + 0.012);
                master.gain.exponentialRampToValueAtTime(0.0001, now + 0.9);
                master.connect(context.destination);

                [1046.5, 783.99, 659.25, 523.25].forEach((frequency, index) => {
                    const start = now + index * 0.105;
                    const oscillator = context.createOscillator();
                    const gain = context.createGain();
                    oscillator.type = index === 3 ? "sine" : "triangle";
                    oscillator.frequency.setValueAtTime(frequency, start);
                    gain.gain.setValueAtTime(0.0001, start);
                    gain.gain.exponentialRampToValueAtTime(0.72, start + 0.012);
                    gain.gain.exponentialRampToValueAtTime(0.0001, start + 0.42);
                    oscillator.connect(gain).connect(master);
                    oscillator.start(start);
                    oscillator.stop(start + 0.48);
                });
            };

            const playIncorrectAnswerArcadeFall = context => {
                const now = context.currentTime;
                const master = context.createGain();
                master.gain.setValueAtTime(0.0001, now);
                master.gain.exponentialRampToValueAtTime(0.12, now + 0.008);
                master.gain.exponentialRampToValueAtTime(0.0001, now + 0.62);
                master.connect(context.destination);

                [1318.51, 880, 659.25].forEach((frequency, index) => {
                    const start = now + index * 0.095;
                    const oscillator = context.createOscillator();
                    const gain = context.createGain();
                    oscillator.type = "square";
                    oscillator.frequency.setValueAtTime(frequency, start);
                    gain.gain.setValueAtTime(0.0001, start);
                    gain.gain.linearRampToValueAtTime(0.42, start + 0.006);
                    gain.gain.exponentialRampToValueAtTime(0.0001, start + 0.14);
                    oscillator.connect(gain).connect(master);
                    oscillator.start(start);
                    oscillator.stop(start + 0.17);
                });
            };

            const playIncorrectAnswerChimeFall = context => {
                const now = context.currentTime;
                const master = context.createGain();
                master.gain.setValueAtTime(0.0001, now);
                master.gain.exponentialRampToValueAtTime(0.16, now + 0.006);
                master.gain.exponentialRampToValueAtTime(0.0001, now + 1.05);
                master.connect(context.destination);

                [2341, 1769, 1327, 880].forEach((frequency, index) => {
                    const start = now + index * 0.08;
                    const oscillator = context.createOscillator();
                    const gain = context.createGain();
                    oscillator.type = "sine";
                    oscillator.frequency.setValueAtTime(frequency, start);
                    oscillator.detune.setValueAtTime(index % 2 === 0 ? -5 : 7, start);
                    gain.gain.setValueAtTime(0.0001, start);
                    gain.gain.exponentialRampToValueAtTime(0.6 / (index + 1), start + 0.004);
                    gain.gain.exponentialRampToValueAtTime(0.0001, start + 0.48 + index * 0.08);
                    oscillator.connect(gain).connect(master);
                    oscillator.start(start);
                    oscillator.stop(start + 0.82);
                });
            };

            const playAnswerFeedbackSound = isCorrect => {
                try {
                    const context = createAnswerFeedbackAudioContext();
                    if (!context) {
                        return;
                    }

                    const mode = isCorrect
                        ? lobby.dataset.correctAnswerSound
                        : lobby.dataset.incorrectAnswerSound;

                    if (isCorrect) {
                        if (mode === "Arcade") {
                            playCorrectAnswerArcade(context);
                        } else if (mode === "Chime") {
                            playCorrectAnswerChime(context);
                        } else {
                            playCorrectAnswerTriumph(context);
                        }
                        return;
                    }

                    if (mode === "ArcadeFall") {
                        playIncorrectAnswerArcadeFall(context);
                    } else if (mode === "ChimeFall") {
                        playIncorrectAnswerChimeFall(context);
                    } else {
                        playIncorrectAnswerDescent(context);
                    }
                } catch (error) {
                    console.debug("Answer feedback audio is unavailable.", error);
                }
            };

            const playQuestionTimeoutSting = () => {
                const AudioContextType =
                    window.AudioContext || window.webkitAudioContext;
                if (!AudioContextType) {
                    return;
                }

                try {
                    questionTimeoutAudioContext ??= new AudioContextType();
                    const context = questionTimeoutAudioContext;
                    if (context.state === "suspended") {
                        void context.resume();
                    }

                    const now = context.currentTime;
                    const master = context.createGain();
                    master.gain.setValueAtTime(0.0001, now);
                    master.gain.exponentialRampToValueAtTime(0.34, now + 0.008);
                    master.gain.exponentialRampToValueAtTime(0.0001, now + 1.35);
                    master.connect(context.destination);

                    const ringBell = (startTime, side) => {
                        const partials = side === 0
                            ? [1020, 1540, 2230, 3070]
                            : [1080, 1620, 2350, 3210];
                        const levels = [0.55, 0.34, 0.22, 0.12];

                        partials.forEach((frequency, index) => {
                            const oscillator = context.createOscillator();
                            const gain = context.createGain();
                            oscillator.type = "sine";
                            oscillator.frequency.setValueAtTime(frequency, startTime);
                            oscillator.detune.setValueAtTime(index % 2 === 0 ? -7 : 9, startTime);

                            gain.gain.setValueAtTime(0.0001, startTime);
                            gain.gain.exponentialRampToValueAtTime(levels[index], startTime + 0.003);
                            gain.gain.exponentialRampToValueAtTime(0.0001, startTime + 0.22 + index * 0.025);

                            oscillator.connect(gain).connect(master);
                            oscillator.start(startTime);
                            oscillator.stop(startTime + 0.34);
                        });
                    };

                    for (let strike = 0; strike < 8; strike += 1) {
                        ringBell(now + strike * 0.13, strike % 2);
                    }
                } catch (error) {
                    console.debug("Question timeout audio is unavailable.", error);
                }
            };

            connection.on("QuestionTimerExpired", update => {
                const notification = document.querySelector(
                    "[data-question-timeout-notification]");
                if (!notification) {
                    return;
                }

                const message = notification.querySelector(
                    "[data-question-timeout-message]");
                if (message) {
                    message.textContent = update?.mode === "answer"
                        ? notification.dataset.answerMessage
                        : notification.dataset.buzzerMessage;
                }

                window.clearTimeout(notification._hideTimer);
                window.clearTimeout(notification._removeTimer);
                notification.hidden = false;
                notification.classList.remove("is-visible", "is-leaving");
                void notification.offsetWidth;
                notification.classList.add("is-visible");
                playQuestionTimeoutSting();
                notification._hideTimer = window.setTimeout(() => {
                    notification.classList.remove("is-visible");
                    notification.classList.add("is-leaving");
                    notification._removeTimer = window.setTimeout(() => {
                        notification.hidden = true;
                        notification.classList.remove("is-leaving");
                    }, 420);
                }, 4600);
            });

            connection.on("TimerStateChanged", update => {
                if (!timerPanel || !timerValue) {
                    return;
                }

                timerPanel.hidden = !update.isVisible;
                timerPanel.classList.toggle(
                    "answer-timer",
                    update.mode === "answer");
                const remainingSeconds =
                    Math.ceil(update.remainingMilliseconds / 1000);
                timerValue.textContent = remainingSeconds;

                const warningSlot =
                    Math.ceil(update.remainingMilliseconds / 500);
                const isWarning =
                    update.isVisible &&
                    update.status === "running" &&
                    warningSlot >= 1 &&
                    warningSlot <= 10;
                timerPanel.classList.toggle("timer-warning", isWarning);

                if (isWarning) {
                    const warningKey =
                        `${update.sourceQuestionId ?? "none"}:${update.mode}:${warningSlot}`;
                    if (questionTimerWarningKey !== warningKey) {
                        questionTimerWarningKey = warningKey;
                        timerPanel.classList.remove("timer-warning-pulse");
                        void timerPanel.offsetWidth;
                        timerPanel.classList.add("timer-warning-pulse");
                        playQuestionTimerWarningTick(warningSlot, update.remainingMilliseconds);
                    }
                } else {
                    questionTimerWarningKey = null;
                    timerPanel.classList.remove("timer-warning-pulse");
                }

                if (update.sourceQuestionId !== null &&
                    update.sourceQuestionId !== undefined &&
                    questionClues?.dataset.sourceQuestionId ===
                        update.sourceQuestionId.toString()) {
                    updateQuestionReward(update.currentCorrectAnswerValue);
                }

                if (timerPause) {
                    timerPause.hidden = update.status !== "running";
                }

                if (timerResume) {
                    timerResume.hidden = update.status !== "paused";
                }
            });

            const applyBuzzerPlayerStates = () => {
                playerList.querySelectorAll("[data-player-id]").forEach(item => {
                    const itemPlayerId = item.dataset.playerId;
                    const isAnswering =
                        buzzerState?.answeringPlayerId === itemPlayerId;
                    const hasAttempted =
                        buzzerState?.ineligiblePlayerIds?.includes(itemPlayerId) ?? false;

                    item.classList.toggle(
                        "question-answering-player",
                        isAnswering);
                    item.classList.toggle(
                        "question-attempted-player",
                        hasAttempted && !isAnswering);
                });
            };

            connection.on("BuzzerStateChanged", update => {
                buzzerState = update;
                applyBuzzerPlayerStates();

                if (revealClueForm) {
                    revealClueForm.hidden =
                        update.status !== "open" &&
                        update.status !== "inactive";
                }

                const showBuzzerRaceOverlay = () => {
                    if (!update.buzzerRace) {
                        return;
                    }

                    document.dispatchEvent(new CustomEvent(
                        "badwolf:buzzer-race",
                        {
                            detail: {
                                ...update.buzzerRace,
                                sourceQuestionId: update.sourceQuestionId
                            }
                        }));
                };

                if (!hasReceivedInitialBuzzerState) {
                    hasReceivedInitialBuzzerState = true;
                    showBuzzerRaceOverlay();
                    return;
                }

                // Every host-only collecting update renders immediately so
                // winner and late-player entries appear as each press arrives.
                if (update.buzzerRace?.isCollecting) {
                    showBuzzerRaceOverlay();
                    return;
                }

                if (lobby.classList.contains("host-game-board") &&
                    !isExternalHostFlowActive()) {
                    void requestHostGameplayRefresh()
                        .then(showBuzzerRaceOverlay);
                } else {
                    showBuzzerRaceOverlay();
                }
            });

            let renderedPlayersFingerprint = null;
            const playerFingerprint = players => JSON.stringify(players.map(player => ({
                id: player.id,
                name: player.name,
                score: player.score,
                presence: player.presence,
                isActive: player.isActive,
                webcamEnabled: player.webcamEnabled,
                webcamUrl: player.webcamUrl,
                avatarId: player.avatarId,
                usesUploadedImage: player.usesUploadedImage,
                uploadedImageVersion: player.uploadedImageDataUrl
                    ? `${player.uploadedImageDataUrl.length}:${player.uploadedImageDataUrl.slice(-32)}`
                    : null
            })));

            connection.on("PlayersChanged", update => {
                if (playerCount) {
                    playerCount.textContent = update.playerCount.toString();
                }

                if (isExternalHostFlowActive()) {
                    return;
                }

                const fingerprint = playerFingerprint(update.players);
                if (fingerprint === renderedPlayersFingerprint) {
                    webcam.refresh(update.players);
                    return;
                }
                renderedPlayersFingerprint = fingerprint;

                renderBoardPlayers(update.players);

                if (lobby.classList.contains("final-question-host")) {
                    void requestHostGameplayRefresh();
                    playerList.replaceChildren();
                    if (hostCard) {
                        playerList.append(hostCard);
                    }

                    for (const player of update.players) {
                        const item = document.createElement("li");
                        item.dataset.playerId = player.id;
                        item.className = "scoreboard-player";
                        addPlayerCardWidthResizer(item);

                        const name = document.createElement("strong");
                        name.textContent = player.name;

                        const playerImageSource = getPlayerImageSource(player);
                        if (player.webcamUrl) {
                            const frame = document.createElement("iframe");
                            frame.className = "player-card-avatar player-webcam-url-frame";
                            frame.src = withMutedWebcamAudio(player.webcamUrl);
                            frame.title = player.name;
                            frame.allow = "autoplay; fullscreen; picture-in-picture";
                            frame.setAttribute("sandbox", "allow-scripts allow-same-origin allow-forms allow-popups allow-presentation");
                            frame.referrerPolicy = "no-referrer";
                            frame.allowFullscreen = true;
                            item.append(frame);
                        } else if (player.webcamEnabled) {
                            if (playerImageSource) {
                                const fallback = document.createElement("img");
                                fallback.className = "player-card-avatar";
                                fallback.dataset.playerWebcamFallback = "";
                                fallback.src = playerImageSource;
                                fallback.alt = "";
                                item.append(fallback);
                            }
                            const video = document.createElement("video");
                            video.className = "player-card-avatar";
                            video.dataset.playerWebcam = "";
                            video.autoplay = true;
                            video.muted = true;
                            video.playsInline = true;
                            video.hidden = true;
                            item.append(video);
                        } else if (playerImageSource) {
                            const avatar = document.createElement("img");
                            avatar.className = "player-card-avatar";
                            avatar.src = playerImageSource;
                            avatar.alt = "";
                            item.append(avatar);
                        }

                        const details = document.createElement("span");
                        details.className = "scoreboard-details";

                        const score = document.createElement("span");
                        score.textContent = player.score.toString();
                        score.className =
                            `scoreboard-score ${player.score < 0 ? "score-negative" : ""}`;
                        details.append(score);

                        const actions = document.createElement("span");
                        actions.className = "player-card-actions";

                        const remove = document.createElement("button");
                        remove.type = "button";
                        remove.className =
                            "button button-danger icon-button player-action-button scoreboard-remove-player";
                        remove.dataset.removePlayer = player.id;
                        remove.title = lobby.dataset.removePlayerLabel;
                        remove.setAttribute(
                            "aria-label",
                            lobby.dataset.removePlayerLabel);
                        remove.textContent = "✕";
                        actions.append(remove);

                        if (player.presence !== "active") {
                            const presence = document.createElement("span");
                            presence.className =
                                `presence-badge presence-${player.presence}`;
                            presence.textContent =
                                statusLabels[player.presence] || player.presence;
                            details.append(presence);
                        }

                        if (player.presence === "rejoinpending") {
                            const approve = document.createElement("button");
                            approve.type = "button";
                            approve.className =
                                "button button-secondary icon-button player-action-button";
                            approve.title = lobby.dataset.approveLabel;
                            approve.setAttribute("aria-label", lobby.dataset.approveLabel);
                            approve.textContent = "✓";
                            approve.addEventListener("click", async () => {
                                try {
                                    await approveRejoin(player.id);
                                } catch (error) {
                                    console.error("Failed to approve player rejoin.", error);
                                }
                            });
                            actions.append(approve);
                        }

                        details.append(actions);
                        item.append(name, details);
                        playerList.append(item);
                    }

                    webcam.refresh(update.players);
                    relocateHostCard();

                    return;
                }

                playerList.replaceChildren();
                if (hostCard) {
                    playerList.append(hostCard);
                }
                const isRunning = lobby.dataset.gameStatus === "running";

                for (const player of update.players) {
                    const item = document.createElement("li");
                    item.dataset.playerId = player.id;
                    item.className = isRunning
                        ? `scoreboard-player ${player.isActive ? "active-player" : ""}`
                        : player.isActive ? "active-player" : "";
                    if (isRunning) {
                        addPlayerCardWidthResizer(item);
                    }

                    const name = document.createElement("strong");
                    name.textContent = player.name;

                    const playerImageSource = getPlayerImageSource(player);
                    if (player.webcamUrl) {
                        const frame = document.createElement("iframe");
                        frame.className = isRunning
                            ? "player-card-avatar player-webcam-url-frame"
                            : "player-list-avatar player-webcam-url-frame";
                        frame.src = withMutedWebcamAudio(player.webcamUrl);
                        frame.title = player.name;
                        frame.allow = "autoplay; fullscreen; picture-in-picture";
                        frame.setAttribute("sandbox", "allow-scripts allow-same-origin allow-forms allow-popups allow-presentation");
                        frame.referrerPolicy = "no-referrer";
                        frame.allowFullscreen = true;
                        item.append(frame);
                    } else if (player.webcamEnabled) {
                        if (playerImageSource) {
                            const fallback = document.createElement("img");
                            fallback.className = isRunning
                                ? "player-card-avatar"
                                : "player-list-avatar";
                            fallback.dataset.playerWebcamFallback = "";
                            fallback.src = playerImageSource;
                            fallback.alt = "";
                            item.append(fallback);
                        }
                        const video = document.createElement("video");
                        video.className = isRunning
                            ? "player-card-avatar"
                            : "player-list-avatar";
                        video.dataset.playerWebcam = "";
                        video.autoplay = true;
                        video.muted = true;
                        video.playsInline = true;
                        video.hidden = true;
                        item.append(video);
                    } else if (playerImageSource) {
                        const avatar = document.createElement("img");
                        avatar.className = isRunning
                            ? "player-card-avatar"
                            : "player-list-avatar";
                        avatar.src = playerImageSource;
                        avatar.alt = "";
                        item.append(avatar);
                    }

                    const details = document.createElement("span");
                    details.className = isRunning
                        ? "scoreboard-details"
                        : "player-presence";

                    const actions = document.createElement("span");
                    actions.className = "player-card-actions";

                    const remove = document.createElement("button");
                    remove.type = "button";
                    remove.className = isRunning
                        ? "button button-danger icon-button player-action-button scoreboard-remove-player"
                        : "button button-danger icon-button player-action-button";
                    remove.dataset.removePlayer = player.id;
                    remove.title = lobby.dataset.removePlayerLabel;
                    remove.setAttribute("aria-label", lobby.dataset.removePlayerLabel);
                    remove.textContent = "✕";
                    actions.append(remove);

                    if (isRunning) {
                        const score = document.createElement("span");
                        score.textContent = player.score.toString();
                        score.className =
                            `scoreboard-score ${player.score < 0 ? "score-negative" : ""}`;
                        details.append(score);
                    }

                    if (!player.isActive) {
                        const makeActive = document.createElement("button");
                        makeActive.type = "button";
                        makeActive.className =
                            "button button-secondary icon-button player-action-button";
                        makeActive.dataset.makeActivePlayer = player.id;
                        makeActive.title = lobby.dataset.makeActiveLabel;
                        makeActive.setAttribute("aria-label", lobby.dataset.makeActiveLabel);
                        makeActive.textContent = "★";
                        makeActive.disabled =
                            lobby.dataset.activePlayerLocked === "true";
                        actions.append(makeActive);
                    }

                    if (player.presence !== "active") {
                        const presence = document.createElement("span");
                        presence.className = `presence-badge presence-${player.presence}`;
                        presence.textContent =
                            statusLabels[player.presence] || player.presence;
                        details.append(presence);
                    }

                    if (player.presence === "rejoinpending") {
                        const approve = document.createElement("button");
                        approve.type = "button";
                        approve.className =
                            "button button-secondary icon-button player-action-button";
                        approve.title = lobby.dataset.approveLabel;
                        approve.setAttribute("aria-label", lobby.dataset.approveLabel);
                        approve.textContent = "✓";
                        approve.addEventListener("click", async () => {
                            try {
                                await approveRejoin(player.id);
                            } catch (error) {
                                console.error("Failed to approve player rejoin.", error);
                            }
                        });
                        actions.append(approve);
                    }

                    details.append(actions);

                    item.append(name, details);
                    playerList.append(item);
                }

                applyBuzzerPlayerStates();
                webcam.refresh(update.players);
                relocateHostCard();
            });

            connection.on("GameStatusChanged", update => {
                const previousStatus = lobby.dataset.gameStatus;
                lobby.dataset.gameStatus = update.status;
                if (gameStatus) {
                    gameStatus.textContent = update.status === "running"
                        ? lobby.dataset.runningLabel
                        : lobby.dataset.lobbyLabel;
                }

                if (startGameForm) {
                    startGameForm.hidden = update.status !== "lobby";
                }

                if (previousStatus &&
                    previousStatus !== update.status &&
                    lobby.classList.contains("host-game-board")) {
                    void requestHostGameplayRefresh();
                }
            });

            connection.on("FinalQuestionProgressChanged", () => {
                if (lobby.classList.contains("final-question-host")) {
                    void requestHostGameplayRefresh();
                }
            });

            const joinSession = () => connection.invoke("JoinSession", gameCode);

            let playerPollHandle = null;
            const startPlayerPolling = () => {
                if (playerPollHandle !== null) {
                    clearInterval(playerPollHandle);
                }

                playerPollHandle = window.setInterval(() => {
                    if (connection.state === signalR.HubConnectionState.Connected) {
                        connection.invoke("PollPlayers", gameCode)
                            .catch(console.error);
                    }
                }, 1000);
            };

            let timerPollHandle = null;
            const startTimerPolling = () => {
                if (timerPollHandle !== null) {
                    clearInterval(timerPollHandle);
                }

                timerPollHandle = window.setInterval(() => {
                    if (connection.state === signalR.HubConnectionState.Connected &&
                        lobby.dataset.gameStatus === "running") {
                        connection.invoke("PollQuestionTimer", gameCode)
                            .catch(console.error);
                    }
                }, 250);
            };

            connection.onreconnected(async () => {
                await joinSession();
                await webcam.register();
                startPlayerPolling();
                startTimerPolling();
            });
            connection.start()
                .then(async () => {
                    await joinSession();
                    await webcam.register();
                    startPlayerPolling();
                    startTimerPolling();
                })
                .catch(console.error);

            const syncBoardHeaderHeights = () => {
                const headers = document.querySelectorAll(
                    ".host-board-grid .host-board-column > h3");

                if (headers.length === 0) {
                    return;
                }

                headers.forEach(header => {
                    header.style.height = "";
                });

                const maximumHeight = Math.max(
                    ...Array.from(headers, header => header.offsetHeight));

                headers.forEach(header => {
                    header.style.height = `${maximumHeight}px`;
                });
            };

            syncBoardHeaderHeights();
            window.addEventListener("resize", syncBoardHeaderHeights);
        })();
    </script>
    <script src="~/js/avatar-picker.js" asp-append-version="true"></script>
}
