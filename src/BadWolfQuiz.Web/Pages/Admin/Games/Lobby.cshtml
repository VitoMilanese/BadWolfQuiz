<script>
    window.BadWolfHostGameplay = (() => {
        const viewSelector = "[data-host-gameplay-view]";
        const boardSelector = "[data-host-gameplay-board]";
        const transientSelector = "[data-host-gameplay-transient]";
        const updatedEventName = "badwolf:host-gameplay-updated";
        let requestSequence = 0;
        let refreshPromise = null;
        let buzzerOverlayDismissHandle = null;
        const buzzerWinnerTemplate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Localizer["GameBoard_BuzzerRaceWinner", "__PLAYER__"].Value));
        const buzzerLateTemplate = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            Localizer["GameBoard_BuzzerRaceLatePlayer", "__PLAYER__", "__DELAY__"].Value));

        const isSameLobbyUrl = url => {
            const current = new URL(window.location.href);
            return url.origin === current.origin && url.pathname === current.pathname;
        };

        const initializeAutoFitCard = card => {
            if (!card ||
                card.dataset.hostGameplayAutoFitInitialized === "true") {
                return;
            }

            card.dataset.hostGameplayAutoFitInitialized = "true";
            const elements = [...card.querySelectorAll(
                "p, li, .answer-result-score")];

            const fit = () => {
                if (elements.length === 0) {
                    card.classList.add("is-auto-fit-ready");
                    return;
                }

                for (const element of elements) {
                    element.style.removeProperty("font-size");
                }

                const baseSizes = elements.map(element =>
                    Number.parseFloat(getComputedStyle(element).fontSize));

                const fits = () => {
                    if (card.scrollHeight > card.clientHeight + 1) {
                        return false;
                    }

                    return elements.every(element =>
                        element.scrollWidth <= element.clientWidth + 1);
                };

                let scale = 1;
                while (scale > 0.35 && !fits()) {
                    scale -= 0.025;
                    elements.forEach((element, index) => {
                        element.style.fontSize =
                            `${baseSizes[index] * scale}px`;
                    });
                }

                card.classList.add("is-auto-fit-ready");
            };

            fit();

            if (typeof ResizeObserver !== "undefined") {
                new ResizeObserver(fit).observe(card);
            }
        };

        const initializeGameplayOverlays = () => {
            document.querySelectorAll("[data-auto-fit-overlay]").forEach(
                initializeAutoFitCard);

            const overlay = document.querySelector(
                `${transientSelector} [data-answer-result-overlay]`);
            if (!overlay ||
                overlay.dataset.hostGameplayInitialized === "true") {
                return;
            }

            overlay.dataset.hostGameplayInitialized = "true";
            window.setTimeout(() => overlay.remove(), 5000);
        };

        const buzzerOverlayLifetimeMilliseconds = 3000;

        const showBuzzerRace = race => {
            const container = document.querySelector(transientSelector);
            if (!container || !race?.winnerPlayerName) {
                return;
            }

            const sourceQuestionId = race.sourceQuestionId?.toString() ?? "";
            let overlay = container.querySelector("[data-buzzer-race-live]");
            const isSameRace = overlay?.dataset.buzzerRaceSourceQuestionId ===
                sourceQuestionId;
            const previousLatePlayers = isSameRace
                ? new Map(Array.from(
                    overlay.querySelectorAll("[data-buzzer-race-player-id]"),
                    item => [
                        item.dataset.buzzerRacePlayerId,
                        {
                            playerId: item.dataset.buzzerRacePlayerId,
                            playerName: item.dataset.buzzerRacePlayerName,
                            delayMilliseconds: Number.parseInt(
                                item.dataset.buzzerRaceDelayMilliseconds ?? "0",
                                10)
                        }
                    ]))
                : new Map();

            if (!isSameRace) {
                overlay = document.createElement("aside");
                overlay.className = "buzzer-race-overlay buzzer-race-live-overlay";
                overlay.dataset.buzzerRaceLive = "";
                overlay.dataset.buzzerRaceSourceQuestionId = sourceQuestionId;
                overlay.dataset.buzzerRaceShownAt = Date.now().toString();
                overlay.setAttribute("role", "status");
                overlay.setAttribute("aria-live", "polite");
            }

            const wasFinalized =
                overlay.dataset.buzzerRaceFinalized === "true";
            if (!race.isCollecting) {
                overlay.dataset.buzzerRaceFinalized = "true";
            }

            if (race.isCollecting && !wasFinalized) {
                overlay.dataset.buzzerRaceCollecting = "";
            } else {
                delete overlay.dataset.buzzerRaceCollecting;
            }

            const card = document.createElement("div");
            card.className = "buzzer-race-card";
            card.dataset.autoFitOverlay = "";

            const winner = document.createElement("p");
            winner.textContent = buzzerWinnerTemplate.replace(
                "__PLAYER__",
                race.winnerPlayerName);
            if (!isSameRace) {
                winner.classList.add("buzzer-race-live-winner-new");
            }
            card.append(winner);

            const latePlayerMap = new Map(previousLatePlayers);
            for (const latePlayer of race.latePlayers ?? []) {
                latePlayerMap.set(latePlayer.playerId, latePlayer);
            }

            const latePlayers = document.createElement("ul");
            const orderedLatePlayers = Array.from(latePlayerMap.values())
                .sort((left, right) =>
                    left.delayMilliseconds - right.delayMilliseconds);
            for (const latePlayer of orderedLatePlayers) {
                const item = document.createElement("li");
                item.dataset.buzzerRacePlayerId = latePlayer.playerId;
                item.dataset.buzzerRacePlayerName = latePlayer.playerName;
                item.dataset.buzzerRaceDelayMilliseconds =
                    latePlayer.delayMilliseconds.toString();
                item.textContent = buzzerLateTemplate
                    .replace("__PLAYER__", latePlayer.playerName)
                    .replace("__DELAY__", latePlayer.delayMilliseconds.toString());
                if (!previousLatePlayers.has(latePlayer.playerId)) {
                    item.classList.add("buzzer-race-live-entry-new");
                }
                latePlayers.append(item);
            }
            card.append(latePlayers);
            overlay.replaceChildren(card);

            window.clearTimeout(buzzerOverlayDismissHandle);
            if (!overlay.isConnected) {
                container.replaceChildren(overlay);
            }
            initializeAutoFitCard(card);

            const shownAt = Number.parseInt(
                overlay.dataset.buzzerRaceShownAt ?? "0",
                10);
            const elapsed = Math.max(0, Date.now() - shownAt);
            const remaining = Math.max(
                0,
                buzzerOverlayLifetimeMilliseconds - elapsed);

            if (remaining === 0) {
                overlay.remove();
                buzzerOverlayDismissHandle = null;
                return;
            }

            buzzerOverlayDismissHandle = window.setTimeout(() => {
                if (overlay.isConnected) {
                    overlay.remove();
                }
                buzzerOverlayDismissHandle = null;
            }, remaining);
        };

        document.addEventListener("badwolf:buzzer-race", event => {
            showBuzzerRace(event.detail);
        });

        const syncHeaderState = () => {
            const view = document.querySelector(viewSelector);
            if (!view) return;

            const hasActiveQuestion =
                view.querySelector(".current-question-summary") !== null;
            const isRoundSummary = view.querySelector(".round-summary") !== null;
            const menu = document.querySelector(".board-action-menu");
            if (menu) {
                menu.hidden = isRoundSummary;
            }

            for (const action of document.querySelectorAll(
                ".board-action-menu a[href*='/Admin/Games/AnswerHistory'], " +
                ".board-action-menu form[action*='handler=RandomActivePlayer']")) {
                action.hidden = hasActiveQuestion;
            }
        };

        const animatedLeaderboardSignature = view => {
            const podium = view?.querySelector(".round-podium");
            const scope = podium?.closest(
                ".round-summary, .final-question-panel");
            if (!scope) {
                return null;
            }

            return scope.textContent
                .replace(/\s+/g, " ")
                .trim();
        };

        const syncPersistentRoundBoard = (currentBoard, nextBoard) => {
            const currentGrid = currentBoard.querySelector(".host-board-grid");
            const nextGrid = nextBoard.querySelector(".host-board-grid");
            if (!currentGrid || !nextGrid) {
                return;
            }

            const currentRoundId = currentGrid.dataset.sourceRoundId;
            const nextRoundId = nextGrid.dataset.sourceRoundId;
            if (!currentRoundId ||
                !nextRoundId ||
                currentRoundId === nextRoundId) {
                return;
            }

            currentGrid.replaceChildren(
                ...Array.from(nextGrid.childNodes, node =>
                    document.importNode(node, true)));
            currentGrid.dataset.sourceRoundId = nextRoundId;

            const nextStyle = nextGrid.getAttribute("style");
            if (nextStyle === null) {
                currentGrid.removeAttribute("style");
            } else {
                currentGrid.setAttribute("style", nextStyle);
            }
        };

        const syncRoundNavigationActions = parsed => {
            for (const selector of [
                "[data-open-previous-round-dialog]",
                "#force-advance-round-form"
            ]) {
                const currentAction = document.querySelector(selector);
                const nextAction = parsed.querySelector(selector);
                if (currentAction && nextAction) {
                    currentAction.hidden = nextAction.hidden;
                }
            }
        };

        const getMediaAutoplayState = view =>
            view?.querySelector("[data-media-autoplay-state]")
                ?.dataset.mediaAutoplayState ?? null;

        const copyLiveTimerState = (currentView, nextView) => {
            if (getMediaAutoplayState(currentView) !==
                getMediaAutoplayState(nextView)) {
                return;
            }

            const currentTimer = currentView.querySelector("#game-timer");
            const nextTimer = nextView.querySelector("#game-timer");
            if (!currentTimer || !nextTimer) {
                return;
            }

            nextTimer.hidden = currentTimer.hidden;
            nextTimer.className = currentTimer.className;

            const currentValue = currentTimer.querySelector("#game-timer-value");
            const nextValue = nextTimer.querySelector("#game-timer-value");
            if (currentValue && nextValue) {
                nextValue.textContent = currentValue.textContent;
            }

            for (const selector of [".game-timer-pause", ".game-timer-resume"]) {
                const currentControl = currentTimer.querySelector(selector);
                const nextControl = nextTimer.querySelector(selector);
                if (currentControl && nextControl) {
                    nextControl.hidden = currentControl.hidden;
                }
            }
        };

        const directChildContaining = (container, descendant) => {
            let child = descendant;
            while (child && child.parentNode !== container) {
                child = child.parentNode;
            }
            return child?.parentNode === container ? child : null;
        };

        const replaceSiblingsPreserving = (
            currentContainer,
            nextContainer,
            currentPreserved,
            nextPreserved) => {
            const nextChildren = Array.from(nextContainer.childNodes);
            const preservedIndex = nextChildren.indexOf(nextPreserved);
            if (preservedIndex < 0) {
                return false;
            }

            Array.from(currentContainer.childNodes).forEach(node => {
                if (node !== currentPreserved) {
                    node.remove();
                }
            });

            for (let index = 0; index < preservedIndex; index += 1) {
                currentContainer.insertBefore(
                    document.importNode(nextChildren[index], true),
                    currentPreserved);
            }
            for (let index = preservedIndex + 1;
                index < nextChildren.length;
                index += 1) {
                currentContainer.append(
                    document.importNode(nextChildren[index], true));
            }
            return true;
        };

        const syncContainerPreservingDescendant = (
            currentContainer,
            nextContainer,
            currentDescendant,
            nextDescendant) => {
            const currentChild = directChildContaining(
                currentContainer,
                currentDescendant);
            const nextChild = directChildContaining(
                nextContainer,
                nextDescendant);
            if (!currentChild || !nextChild) {
                return false;
            }

            if (currentChild !== currentDescendant ||
                nextChild !== nextDescendant) {
                if (!syncContainerPreservingDescendant(
                    currentChild,
                    nextChild,
                    currentDescendant,
                    nextDescendant)) {
                    return false;
                }
            }

            return replaceSiblingsPreserving(
                currentContainer,
                nextContainer,
                currentChild,
                nextChild);
        };

        const syncViewPreservingMediaPresentation = (currentView, nextView) => {
            const currentPresentation = currentView.querySelector(
                "[data-media-autoplay-state]");
            const nextPresentation = nextView.querySelector(
                "[data-media-autoplay-state]");
            if (!currentPresentation || !nextPresentation ||
                currentPresentation.dataset.mediaAutoplayState !==
                    nextPresentation.dataset.mediaAutoplayState) {
                return false;
            }

            return syncContainerPreservingDescendant(
                currentView,
                nextView,
                currentPresentation,
                nextPresentation);
        };

        const activateMediaAutoplay = (request, view) => {
            if (!request || !view) {
                return;
            }

            if (request.kind === "clues") {
                const clueGrid = view.querySelector(
                    ".four-clue-grid[data-question-clues]");
                if (clueGrid?.dataset.sourceQuestionId !==
                    request.sourceQuestionId) {
                    return;
                }

                const clues = Array.from(
                    clueGrid.querySelectorAll("[data-question-clue]"));
                clues
                    .slice(request.startIndex, request.endIndex)
                    .filter(clue =>
                        !clue.classList.contains("question-clue-hidden"))
                    .forEach(clue =>
                        window.BadWolfMediaAutoplay?.transition(clue));
                return;
            }

            if (request.kind !== "presentation") {
                return;
            }

            const presentation = view.querySelector(
                "[data-media-autoplay-state]");
            if (presentation?.dataset.mediaAutoplayState === request.state) {
                window.BadWolfMediaAutoplay?.activate(presentation);
            }
        };

        const applyDocument = (parsed, targetUrl, historyMode) => {
            const currentView = document.querySelector(viewSelector);
            const currentBoard = document.querySelector(boardSelector);
            const currentTransient = document.querySelector(transientSelector);
            const nextView = parsed.querySelector(viewSelector);
            const nextBoard = parsed.querySelector(boardSelector);
            const nextTransient = parsed.querySelector(transientSelector);

            if (!currentView || !currentBoard || !nextView || !nextBoard) {
                throw new Error("The host gameplay region is unavailable.");
            }

            copyLiveTimerState(currentView, nextView);
            syncPersistentRoundBoard(currentBoard, nextBoard);

            const currentRoundHeading =
                document.querySelector(".game-header-context h2");
            const nextRoundHeading =
                parsed.querySelector(".game-header-context h2");
            if (currentRoundHeading && nextRoundHeading) {
                currentRoundHeading.textContent = nextRoundHeading.textContent;
                currentRoundHeading.title = nextRoundHeading.title;
            }
            syncRoundNavigationActions(parsed);

            const currentHostBoard = currentView.closest(
                ".host-game-board[data-game-id]");
            const nextHostBoard = nextView.closest(
                ".host-game-board[data-game-id]");
            if (currentHostBoard && nextHostBoard) {
                currentHostBoard.classList.toggle(
                    "final-question-host",
                    nextHostBoard.classList.contains("final-question-host"));
                if (nextHostBoard.dataset.gameStatus) {
                    currentHostBoard.dataset.gameStatus =
                        nextHostBoard.dataset.gameStatus;
                }
            }

            const currentMediaAutoplayState = getMediaAutoplayState(currentView);
            const nextMediaAutoplayState = getMediaAutoplayState(nextView);
            const currentClueGrid = currentView.querySelector(
                ".four-clue-grid[data-question-clues][data-revealed-clue-count]");
            const nextClueGrid = nextView.querySelector(
                ".four-clue-grid[data-question-clues][data-revealed-clue-count]");
            const sameFourClueQuestion =
                currentClueGrid !== null &&
                nextClueGrid !== null &&
                currentClueGrid.dataset.sourceQuestionId ===
                    nextClueGrid.dataset.sourceQuestionId;
            const currentRevealedClueCount = sameFourClueQuestion
                ? Number.parseInt(currentClueGrid.dataset.revealedClueCount ?? "", 10)
                : Number.NaN;
            const nextRevealedClueCount = sameFourClueQuestion
                ? Number.parseInt(nextClueGrid.dataset.revealedClueCount ?? "", 10)
                : Number.NaN;

            let mediaAutoplayRequest = null;
            if (sameFourClueQuestion &&
                Number.isFinite(currentRevealedClueCount) &&
                Number.isFinite(nextRevealedClueCount) &&
                nextRevealedClueCount > currentRevealedClueCount) {
                mediaAutoplayRequest = {
                    kind: "clues",
                    sourceQuestionId: nextClueGrid.dataset.sourceQuestionId,
                    startIndex: currentRevealedClueCount,
                    endIndex: nextRevealedClueCount
                };
            } else if (nextMediaAutoplayState !== currentMediaAutoplayState &&
                nextMediaAutoplayState) {
                mediaAutoplayRequest = {
                    kind: "presentation",
                    state: nextMediaAutoplayState
                };
            }

            const sameMediaAutoplayState =
                currentMediaAutoplayState !== null &&
                currentMediaAutoplayState === nextMediaAutoplayState;

            const currentLeaderboardSignature =
                animatedLeaderboardSignature(currentView);
            const nextLeaderboardSignature =
                animatedLeaderboardSignature(nextView);
            const preserveAnimatedLeaderboard =
                currentLeaderboardSignature !== null &&
                currentLeaderboardSignature === nextLeaderboardSignature;

            if (!preserveAnimatedLeaderboard) {
                const preservedLiveMedia = sameMediaAutoplayState &&
                    syncViewPreservingMediaPresentation(currentView, nextView);

                if (!preservedLiveMedia) {
                    currentView.replaceChildren(
                        ...Array.from(nextView.childNodes, node =>
                            document.importNode(node, true)));
                    activateMediaAutoplay(mediaAutoplayRequest, currentView);
                }
            }
            currentBoard.hidden = nextBoard.hidden;

            const preserveCollectingBuzzerOverlay =
                currentTransient?.querySelector(
                    "[data-buzzer-race-collecting]") !== null;

            if (currentTransient && !preserveCollectingBuzzerOverlay) {
                currentTransient.replaceChildren(
                    ...Array.from(nextTransient?.childNodes ?? [], node =>
                        document.importNode(node, true)));
            }

            syncHeaderState();
            initializeGameplayOverlays();

            if (historyMode === "push") {
                history.pushState({ hostGameplay: true }, "", targetUrl.href);
            } else if (historyMode === "replace") {
                history.replaceState({ hostGameplay: true }, "", targetUrl.href);
            }

            document.dispatchEvent(new CustomEvent(updatedEventName));
        };

        const load = async (url, historyMode = "none") => {
            const targetUrl = new URL(url, window.location.href);
            if (!isSameLobbyUrl(targetUrl)) {
                throw new Error(
                    "Host gameplay navigation cannot leave the current lobby.");
            }

            const requestId = ++requestSequence;
            const response = await fetch(targetUrl.href, {
                method: "GET",
                headers: {
                    "X-Requested-With": "XMLHttpRequest"
                },
                cache: "no-store"
            });
            if (!response.ok) {
                throw new Error(response.statusText);
            }

            const markup = await response.text();
            if (requestId !== requestSequence) {
                return false;
            }

            const parsed = new DOMParser().parseFromString(markup, "text/html");
            applyDocument(parsed, targetUrl, historyMode);
            return true;
        };

        const cancelPending = () => {
            requestSequence += 1;
        };

        const refresh = () => {
            if (refreshPromise) {
                return refreshPromise;
            }

            refreshPromise = load(window.location.href)
                .finally(() => {
                    refreshPromise = null;
                });
            return refreshPromise;
        };

        const navigate = (url, historyMode = "push") =>
            load(url, historyMode);

        document.addEventListener("click", event => {
            if (event.defaultPrevented ||
                event.button !== 0 ||
                event.metaKey ||
                event.ctrlKey ||
                event.shiftKey ||
                event.altKey) {
                return;
            }

            const target = event.target instanceof Element ? event.target : null;
            const link = target?.closest(
                "a.host-board-question.status-resolved, .question-review-actions a");
            if (!link || link.target || link.hasAttribute("download")) {
                return;
            }

            const targetUrl = new URL(link.href, window.location.href);
            if (!isSameLobbyUrl(targetUrl)) {
                return;
            }

            event.preventDefault();
            navigate(targetUrl, "push")
                .catch(error => {
                    console.error("Host gameplay navigation failed.", error);
                    window.location.assign(targetUrl.href);
                });
        });

        window.addEventListener("popstate", () => {
            if (!document.querySelector(viewSelector)) {
                return;
            }

            navigate(window.location.href, "none")
                .catch(error => {
                    console.error(
                        "Host gameplay history navigation failed.", error);
                    window.location.reload();
                });
        });

        syncHeaderState();
        return { cancelPending, refresh, navigate, updatedEventName };
    })();

    window.BadWolfContextActions = (() => {
        const submit = async form => {
            const submitButton = form?.querySelector("button[type='submit']");
            submitButton?.setAttribute("disabled", "disabled");

            try {
                const response = await fetch(form.action, {
                    method: "POST",
                    body: new FormData(form),
                    headers: {
                        "Accept": "application/json",
                        "X-Requested-With": "XMLHttpRequest"
                    }
                });
                const contentType = response.headers.get("content-type") ?? "";
                const result = contentType.includes("application/json")
                    ? await response.json()
                    : null;

                if (!response.ok || !result?.success) {
                    throw new Error(result?.error ?? response.statusText);
                }

                return result;
            } finally {
                submitButton?.removeAttribute("disabled");
            }
        };

        const updateCategoryAvailability = element => {
            const column = element?.closest(".host-board-column");
            const category = column?.querySelector("[data-category-context]");
            if (!category) return;
            category.dataset.hasAvailableQuestions = column.querySelector(
                ".host-board-question.status-available[data-question-context]")
                ? "true"
                : "false";
        };

        const markQuestionResolved = sourceQuestionId => {
            const button = document.querySelector(
                `.host-board-question.status-available[data-source-question-id="${sourceQuestionId}"]`);
            if (!button) return;

            const form = button.closest("form.question-selection-form");
            const link = document.createElement("a");
            link.className = "host-board-question status-resolved";
            link.dataset.questionResolved = "";
            link.textContent = button.textContent;

            const url = new URL(window.location.href);
            url.searchParams.set("previewQuestionId", sourceQuestionId.toString());
            url.searchParams.delete("previewAnswer");
            link.href = url.toString();
            link.setAttribute("aria-label", button.getAttribute("aria-label") ?? button.textContent.trim());

            const replacementTarget = form ?? button;
            replacementTarget.replaceWith(link);
            updateCategoryAvailability(link);

            for (const option of document.querySelectorAll(
                `[data-quick-score-question] option[value="${sourceQuestionId}"]`)) {
                option.dataset.status = "resolved";
            }
        };

        const showRoundSummaryIfComplete = async result => {
            if (!result?.roundComplete) {
                return false;
            }

            await window.BadWolfHostGameplay.refresh();
            return document.querySelector(
                "[data-host-gameplay-view] .round-summary") !== null;
        };

        const recordAttempt = (sourceQuestionId, playerId) => {
            const addId = current => {
                const ids = new Set((current ?? "").split(",").filter(Boolean));
                ids.add(playerId);
                return Array.from(ids).join(",");
            };

            const boardQuestion = document.querySelector(
                `.host-board-question[data-source-question-id="${sourceQuestionId}"]`);
            if (boardQuestion) {
                boardQuestion.dataset.attemptedPlayerIds = addId(
                    boardQuestion.dataset.attemptedPlayerIds);
            }

            for (const option of document.querySelectorAll(
                `[data-quick-score-question] option[value="${sourceQuestionId}"]`)) {
                option.dataset.attemptedPlayerIds = addId(option.dataset.attemptedPlayerIds);
            }
        };

        return { submit, markQuestionResolved, recordAttempt, showRoundSummaryIfComplete };
    })();
</script>


