@page "{id:guid}"
@model BadWolfQuiz.Web.Pages.Admin.Games.LobbyModel
@{
    ViewData["Title"] = Model.Game.Session.Quiz.Title;
    ViewData["HidePortalFooter"] = true;
    var isAllPlayerWagering = Model.CurrentQuestion is
    {
        Status: BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.AwaitingWager,
        IsAllPlayerQuestion: true
    };
}

@section HeaderContext {
    @if (Model.Game.Session.Status is
        BadWolfQuiz.Game.Runtime.GameSessionStatus.Running or
        BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalWagering or
        BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalAnswering or
        BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalJudging)
    {
        <div class="game-header-context">
            @if (Model.Game.Session.Status == BadWolfQuiz.Game.Runtime.GameSessionStatus.Running)
            {
            <h2 title="@Model.Game.Session.CurrentRound.Title">
                @Model.Game.Session.CurrentRound.Title
            </h2>
            @if (!Model.IsRoundSummaryVisible)
            {
                <details class="action-menu board-action-menu">
                <summary class="button button-secondary action-menu-trigger">
                    @Localizer["Menu_Tools"]
                </summary>
                <div class="action-menu-popover">
                    @if (Model.CurrentQuestion is null)
                    {
                        <a class="action-menu-item"
                            asp-page="/Admin/Games/AnswerHistory"
                            asp-route-id="@Model.Game.Session.Id.Value">
                            @Localizer["AnswerHistory_Open"]
                        </a>

                        <form method="post" asp-page-handler="RandomActivePlayer">
                            <button class="action-menu-item"
                                    type="submit"
                                    disabled="@(Model.Game.Session.IsActivePlayerChangeLocked ? "disabled" : null)">
                                @Localizer["GameBoard_RandomActivePlayer"]
                            </button>
                        </form>
                    }

                    <button class="action-menu-item"
                            type="button"
                            data-open-previous-round-dialog
                            hidden="@(!Model.Game.Session.HasPreviousUnfinishedRound ? "hidden" : null)">
                        @Localizer["GameBoard_PreviousRound"]
                    </button>

                    <form id="force-advance-round-form"
                            method="post"
                            asp-page-handler="ForceAdvanceRound"
                            hidden="@(!Model.Game.Session.HasNextUnfinishedRound ? "hidden" : null)">
                        <button class="action-menu-item"
                                type="button"
                                data-open-force-advance-round-dialog>
                            @Localizer["GameBoard_NextRound"]
                        </button>
                    </form>

                    @if (Model.Game.Session.Quiz.FinalQuestion is not null)
                    {
                        <form id="force-advance-final-form"
                              method="post"
                              asp-page-handler="PrepareFinalQuestionLeaderboard">
                            <button class="action-menu-item"
                                    type="button"
                                    data-open-force-advance-final-dialog>
                                @Localizer["FinalQuestion_Advance"]
                            </button>
                        </form>
                    }

                    <a class="action-menu-item"
                       asp-page="/Admin/Games/AnswerKey"
                       asp-route-id="@Model.Game.Session.Id.Value"
                       target="_blank"
                       rel="noopener">
                        @Localizer["AnswerKey_Open"]
                    </a>

                    <button class="action-menu-item"
                            type="button"
                            data-open-join-code>
                        @Localizer["GameBoard_ShowJoinCode"]
                    </button>

                    <button class="action-menu-item"
                            type="button"
                            data-open-blocked-players>
                        @Localizer["GameBoard_ManageBlockedPlayers"]
                    </button>

                    <button class="action-menu-item"
                            type="button"
                            data-open-game-settings>
                        @Localizer["GameSettings_LobbyTitle"]
                    </button>

                </div>
                </details>
            }
            }
            <button class="button button-secondary icon-button"
                    type="button"
                    data-open-discord-settings
                    title="@Localizer["Discord_SettingsTitle"]"
                    aria-label="@Localizer["Discord_SettingsTitle"]">
                <span aria-hidden="true">🎙️</span>
            </button>
        </div>
    }
}

@if (Model.Game.Session.Status == BadWolfQuiz.Game.Runtime.GameSessionStatus.Lobby)
{
    <div class="page-heading">
    <div>
        <p class="eyebrow">@Localizer["GameLobby_Eyebrow"]</p>
        <h1>@Model.Game.Session.Quiz.Title</h1>
    </div>

    <a class="button button-secondary" asp-page="/Admin/Quizzes/Index">
        @Localizer["Button_BackToQuizzes"]
    </a>
</div>
}

@if (Model.Game.Session.Status == BadWolfQuiz.Game.Runtime.GameSessionStatus.Lobby)
{
    <section class="content-panel narrow"
             data-game-code="@Model.Game.PublicCode"
             data-status-active="@Localizer["PlayerPresence_Active"]"
             data-status-inactive="@Localizer["PlayerPresence_Inactive"]"
             data-status-disconnected="@Localizer["PlayerPresence_Disconnected"]"
             data-status-rejoinpending="@Localizer["PlayerPresence_RejoinPending"]"
             data-approve-label="@Localizer["GameLobby_ApproveRejoin"]"
             data-remove-player-label="@Localizer["GameBoard_RemovePlayer"]"
             data-remove-player-confirm="@Localizer["GameBoard_RemovePlayerConfirm"]"
             data-active-player-label="@Localizer["GameBoard_ActivePlayer"]"
             data-make-active-label="@Localizer["GameBoard_MakeActivePlayer"]"
             data-active-player-locked="@Model.Game.Session.IsActivePlayerChangeLocked.ToString().ToLowerInvariant()"
             data-game-status="@Model.Game.Session.Status.ToString().ToLowerInvariant()"
             data-lobby-label="@Localizer["GameLobby_StatusLobby"]"
             data-running-label="@Localizer["GameLobby_StatusRunning"]">
        @if (TempData["SuccessMessage"] is string successMessage)
        {
            <div class="message message-success" role="status" data-auto-dismiss>@successMessage</div>
        }

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="message message-error">@errorMessage</div>
        }

        <div class="stack-form">
            <p>
                <strong>@Localizer["GameLobby_StatusLabel"]:</strong>
                <span id="game-status">@Localizer["GameLobby_StatusLobby"]</span>
            </p>

            <details class="lobby-settings-panel">
                <summary>@Localizer["GameSettings_LobbyTitle"]</summary>
                <form id="start-game-form"
                      method="post"
                      enctype="multipart/form-data"
                      asp-page-handler="UpdateSettings"
                      class="stack-form">
                    <partial name="_GameSettingsFields" model="Model" />
                    <div class="form-actions">
                        <button class="button button-secondary" type="submit">
                            @Localizer["GameSettings_SaveForGame"]
                        </button>
                    </div>
                </form>
            </details>
            <partial name="_AvatarPicker" />

            <div class="lobby-secondary-actions">
                <div class="lobby-join-access"
                     data-lobby-join-access
                     data-game-code="@Model.Game.PublicCode"
                     data-join-path="/Join?code=@Uri.EscapeDataString(Model.Game.PublicCode)">
                    <details class="lobby-join-details">
                        <summary class="button button-secondary lobby-join-reveal">
                            @Localizer["GameBoard_ShowJoinCode"]
                        </summary>
                        <div class="lobby-join-reveal-content">
                            <img class="join-qr-code lobby-join-qr"
                                 src="@Url.Page("/Admin/Games/Lobby", "JoinQrCode", new { id = Model.Game.Session.Id.Value })"
                                 width="280"
                                 height="280"
                                 alt="@Localizer["GameBoard_JoinQrAlt"]" />
                            <strong class="join-code-value lobby-join-code-value">@Model.Game.PublicCode</strong>
                        </div>
                    </details>

                    <div class="lobby-join-copy-actions">
                        <span class="lobby-join-copy-status"
                              role="status"
                              aria-live="polite"
                              data-join-copy-status></span>
                        <button class="button button-secondary icon-button"
                                type="button"
                                data-copy-join-code
                                title="@Localizer["GameBoard_CopyJoinCode"]"
                                aria-label="@Localizer["GameBoard_CopyJoinCode"]">
                            <span aria-hidden="true">⧉</span>
                        </button>
                        <button class="button button-secondary icon-button"
                                type="button"
                                data-copy-join-link
                                title="@Localizer["GameBoard_CopyJoinLink"]"
                                aria-label="@Localizer["GameBoard_CopyJoinLink"]">
                            <span aria-hidden="true">🔗</span>
                        </button>
                    </div>
                </div>

                <form method="post" asp-page-handler="RandomActivePlayer">
                    <button class="button button-secondary" type="submit">
                        @Localizer["GameBoard_RandomActivePlayer"]
                    </button>
                </form>

                <button class="button button-secondary"
                        type="button"
                        data-open-blocked-players>
                    @Localizer["GameBoard_ManageBlockedPlayers"]
                </button>
            </div>

            <button class="button button-primary lobby-start-button"
                    type="submit"
                    form="start-game-form"
                    formaction="@Url.Page(
                        "/Admin/Games/Lobby",
                        "Start",
                        new { id = Model.Game.Session.Id.Value })">
                @Localizer["GameLobby_StartGame"]
            </button>

            <p>
                <strong>@Localizer["GameLobby_PlayerCount"]:</strong>
                <span id="player-count">@Model.Players.Count</span>
            </p>

            <p>
                <strong>@Localizer["GameLobby_QuestionCount"]:</strong>
                @Model.Game.Session.Board.Questions.Count
            </p>

            <ul id="player-list" class="player-list">
                @foreach (var player in Model.Players)
                {
                    <li class="@(Model.Game.Session.ActivePlayerId == player.Id ? "active-player" : null)"
                        data-player-id="@player.Id.Value">
                        @if ((player.Presence is BadWolfQuiz.Web.Services.PlayerPresenceStatus.Active or
                                BadWolfQuiz.Web.Services.PlayerPresenceStatus.Inactive) &&
                             (player.UsesUploadedImage ||
                              !string.IsNullOrWhiteSpace(player.AvatarId)))
                        {
                            <img class="player-list-avatar"
                                 src="@(player.UsesUploadedImage ? player.UploadedImageDataUrl : $"/avatars/{player.AvatarId}")"
                                 alt="" />
                        }
                        <strong>@player.Name</strong>
                        @if (player.Presence != BadWolfQuiz.Web.Services.PlayerPresenceStatus.Active)
                        {
                            <span class="presence-badge presence-@player.Presence.ToString().ToLowerInvariant()">
                                @Localizer[$"PlayerPresence_{player.Presence}"]
                            </span>
                        }
                        <span class="player-management">
                            @if (Model.Game.Session.ActivePlayerId == player.Id)
                            {
                                <span class="active-player-badge">
                                    @Localizer["GameBoard_ActivePlayer"]
                                </span>
                            }
                            <span class="player-card-actions">
                                <button class="button button-danger icon-button player-action-button"
                                        type="button"
                                        data-remove-player="@player.Id.Value"
                                        title="@Localizer["GameBoard_RemovePlayer"]"
                                        aria-label="@Localizer["GameBoard_RemovePlayer"]">
                                    <span aria-hidden="true">✕</span>
                                </button>
                                @if (Model.Game.Session.ActivePlayerId != player.Id)
                                {
                                    <button class="button button-secondary icon-button player-action-button"
                                            type="button"
                                            data-make-active-player="@player.Id.Value"
                                            title="@Localizer["GameBoard_MakeActivePlayer"]"
                                            aria-label="@Localizer["GameBoard_MakeActivePlayer"]"
                                            disabled="@(Model.Game.Session.IsActivePlayerChangeLocked ? "disabled" : null)">
                                        <span aria-hidden="true">★</span>
                                    </button>
                                }
                            </span>
                        </span>
                    </li>
                }
            </ul>

            <p class="dialog-warning">@Localizer["GameLobby_TransientNotice"]</p>
        </div>
    </section>
}


<script>
    (() => {
        const storageKey = "badwolfquiz:player-panel-height";
        const savedHeight = Number.parseInt(localStorage.getItem(storageKey), 10);

        if (!Number.isFinite(savedHeight)) {
            return;
        }

        const minimum = 130;
        const maximum = Math.max(130, Math.floor(window.innerHeight * 0.65));
        const height = Math.min(maximum, Math.max(minimum, savedHeight));
        const style = document.createElement("style");

        style.textContent = `.host-game-board { --game-scoreboard-space: ${height}px; }`;
        document.head.appendChild(style);
    })();
</script>

@if (Model.Game.Session.Status == BadWolfQuiz.Game.Runtime.GameSessionStatus.Running)
{
    <section class="host-game-board @(isAllPlayerWagering ? "all-player-question-wagering" : null)"
             data-game-id="@Model.Game.Session.Id.Value"
             data-discord-auto-mute="@((Model.DiscordConnection?.AutoMuteDuringMedia ?? false).ToString().ToLowerInvariant())"
             data-game-code="@Model.Game.PublicCode"
             data-question-timer-warning-sound="@Model.QuestionTimerWarningSound"
             data-correct-answer-sound="@Model.CorrectAnswerSound"
             data-incorrect-answer-sound="@Model.IncorrectAnswerSound"
             data-resize-player-card-label="@Localizer["GameBoard_ResizePlayerCards"]"
             data-status-active="@Localizer["PlayerPresence_Active"]"
             data-status-inactive="@Localizer["PlayerPresence_Inactive"]"
             data-status-disconnected="@Localizer["PlayerPresence_Disconnected"]"
             data-status-rejoinpending="@Localizer["PlayerPresence_RejoinPending"]"
             data-approve-label="@Localizer["GameLobby_ApproveRejoin"]"
             data-remove-player-label="@Localizer["GameBoard_RemovePlayer"]"
             data-remove-player-confirm="@Localizer["GameBoard_RemovePlayerConfirm"]"
             data-active-player-label="@Localizer["GameBoard_ActivePlayer"]"
             data-make-active-label="@Localizer["GameBoard_MakeActivePlayer"]"
             data-active-player-locked="@Model.Game.Session.IsActivePlayerChangeLocked.ToString().ToLowerInvariant()"
             data-game-status="@Model.Game.Session.Status.ToString().ToLowerInvariant()"
             data-lobby-label="@Localizer["GameLobby_StatusLobby"]"
             data-running-label="@Localizer["GameLobby_StatusRunning"]">

        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="message message-error"
                 role="alert"
                 data-auto-dismiss>
                @errorMessage
            </div>
        }

        <div id="game-board-error"
             class="message message-error"
             role="alert"
             hidden></div>
        <div class="discord-operation-status form-status"
             role="status"
             data-discord-operation-status></div>

        <div class="question-timeout-notification"
             data-question-timeout-notification
             data-buzzer-message="@Localizer["GameTimer_ExpiredBuzzer"]"
             data-answer-message="@Localizer["GameTimer_ExpiredAnswer"]"
             role="status"
             aria-live="assertive"
             hidden>
            <div class="question-timeout-notification-glow" aria-hidden="true"></div>
            <div class="question-timeout-notification-icon" aria-hidden="true">⏱</div>
            <div class="question-timeout-notification-copy">
                <span class="question-timeout-notification-kicker">@Localizer["GameTimer_ExpiredKicker"]</span>
                <strong>@Localizer["GameTimer_ExpiredTitle"]</strong>
                <span data-question-timeout-message></span>
            </div>
        </div>

        <div id="host-gameplay-view" data-host-gameplay-view>
        @if (Model.PreviewQuestion is { } previewQuestion)
        {
            <section class="content-panel question-review-preview">
                <header class="question-review-heading">
                    <div>
                        <p class="eyebrow">@Localizer["GameBoard_QuestionPreview"]</p>
                        <h2>@previewQuestion.CategoryTitle — @previewQuestion.Points — @(Model.IsPreviewingAnswer
                    ? Localizer["GameBoard_Answer"]
                    : Localizer["GameBoard_Question"])</h2>
                    </div>
                    <div class="form-actions question-review-actions">
                        @if (Model.IsPreviewingAnswer)
                        {
                            <a class="button button-secondary"
                               asp-page="/Admin/Games/Lobby"
                               asp-route-id="@Model.Game.Session.Id.Value"
                               asp-route-previewQuestionId="@previewQuestion.SourceQuestionId">
                                @Localizer["GameBoard_ShowQuestion"]
                            </a>
                        }
                        else
                        {
                            <a class="button button-primary"
                               asp-page="/Admin/Games/Lobby"
                               asp-route-id="@Model.Game.Session.Id.Value"
                               asp-route-previewQuestionId="@previewQuestion.SourceQuestionId"
                               asp-route-previewAnswer="true">
                                @Localizer["GameBoard_ShowAnswer"]
                            </a>
                        }
                        <a class="button button-secondary"
                           asp-page="/Admin/Games/Lobby"
                           asp-route-id="@Model.Game.Session.Id.Value">
                            @Localizer["GameBoard_ReturnToBoard"]
                        </a>
                    </div>
                </header>

                <partial name="_GameContentPreview"
                         model="@(new GameContentPreviewModel(
                             Model.Game.Session.Id.Value,
                             previewQuestion.SourceQuestionId,
                             previewQuestion.PresentationType,
                             Model.IsPreviewingAnswer,
                             Model.IsPreviewingAnswer
                                 ? previewQuestion.AnswerBlocks
                                 : previewQuestion.QuestionBlocks))" />
            </section>
        }

        @if (Model.CurrentQuestion is not null)
        {
            <div class="content-panel current-question-summary @(Model.CurrentQuestion.Status == BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.AwaitingWager ? "wager-mode" : null)">
                <div id="game-timer" class="game-timer host-game-timer" hidden>
                    <strong id="game-timer-value">0.0</strong>
                    <div class="game-timer-actions">
                        <div class="game-timer-primary-control">
                            <form class="game-timer-control game-timer-pause"
                                  method="post"
                                  asp-page-handler="PauseQuestionTimer">
                                <button type="submit"
                                        title="@Localizer["GameTimer_Pause"]"
                                        aria-label="@Localizer["GameTimer_Pause"]">⏸</button>
                            </form>
                            <form class="game-timer-control game-timer-resume"
                                  method="post"
                                  asp-page-handler="ResumeQuestionTimer">
                                <button type="submit"
                                        title="@Localizer["GameTimer_Resume"]"
                                        aria-label="@Localizer["GameTimer_Resume"]">▶</button>
                            </form>
                        </div>
                        <div class="game-timer-quick-actions">
                            @foreach (var seconds in new[] { 10, 15, 20, 30 })
                            {
                                <form class="game-timer-control game-timer-adjust"
                                      method="post"
                                      asp-page-handler="AddQuestionTimerTime">
                                    <input type="hidden" name="seconds" value="@seconds" />
                                    <button type="submit">+@seconds</button>
                                </form>
                            }
                        </div>
                    </div>
                </div>
                @if (Model.CurrentQuestion.Status == BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.AwaitingWager)
                {
                <div class="current-question-heading">
                    <strong>@Model.CurrentQuestion.CategoryTitle — @Model.CurrentQuestion.Points</strong>
                    <span>
                        @(Model.CurrentQuestion.Status == BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.AwaitingWager
                            ? Localizer["GameBoard_AwaitingWager"]
                            : Model.CurrentQuestion.Status == BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.Active
                                ? Localizer["GameBoard_WagerAccepted"]
                                : Localizer["GameBoard_QuestionSelected"])
                    </span>
                </div>
                }

                @if (Model.CurrentQuestion.Status == BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.AwaitingWager &&
                    !Model.CurrentQuestion.IsAllPlayerQuestion)
                {
                    var wagerPlayer = Model.Players.First(
                        player => player.Id == Model.CurrentQuestion.SelectedByPlayerId);
                    var wagerLimits = Model.QuestionWagerLimits!.Value;

                    <div class="wager-entry-panel">
                        <div class="wager-player-summary">
                            <span>@Localizer["GameBoard_WagerPlayer"]</span>
                            <strong>@wagerPlayer.Name</strong>
                            <span class="wager-player-balance">@Localizer["Label_Score"]: <strong>@wagerPlayer.Score</strong></span>
                            <small>
                                @Localizer[
                                    "GameBoard_WagerLimits",
                                    wagerLimits.Minimum,
                                    wagerLimits.Maximum]
                            </small>
                        </div>

                        <form class="question-wager-form"
                              method="post"
                              asp-page-handler="SubmitQuestionWager"
                              data-wager-form
                              data-minimum="@wagerLimits.Minimum"
                              data-maximum="@wagerLimits.Maximum">
                            <input name="sourceQuestionId"
                                   type="hidden"
                                   value="@Model.CurrentQuestion.SourceQuestionId" />

                            <label class="wager-display-label">
                                <span>@Localizer["GameBoard_WagerAmount"]</span>
                                <input class="wager-display"
                                       name="amount"
                                       type="text"
                                       inputmode="none"
                                       readonly
                                       required
                                       aria-live="polite" />
                            </label>

                            <div class="wager-keypad" aria-label="@Localizer["GameBoard_WagerKeypad"]">
                                @foreach (var digit in new[] { 1, 2, 3, 4, 5, 6, 7, 8, 9 })
                                {
                                    <button type="button" data-wager-digit="@digit">@digit</button>
                                }
                                <button type="button"
                                        data-wager-clear
                                        aria-label="@Localizer["GameBoard_ClearWager"]">
                                    C
                                </button>
                                <button type="button" data-wager-digit="0">0</button>
                                <button type="button"
                                        data-wager-backspace
                                        aria-label="@Localizer["GameBoard_DeleteWagerDigit"]">
                                    ⌫
                                </button>
                                <button class="wager-keypad-max"
                                        type="button"
                                        data-wager-max
                                        aria-label="@Localizer["GameBoard_MaximumWager"]">
                                    MAX
                                </button>
                            </div>

                            <p class="wager-validation"
                               data-wager-validation
                               data-valid-label="@Localizer["GameBoard_WagerValid"]"
                               data-invalid-label="@Localizer[
                                   "GameBoard_WagerOutsideLimits",
                                   wagerLimits.Minimum,
                                   wagerLimits.Maximum]">
                                @Localizer[
                                    "GameBoard_WagerOutsideLimits",
                                    wagerLimits.Minimum,
                                    wagerLimits.Maximum]
                            </p>

                            <button class="button button-primary"
                                    type="submit"
                                    data-wager-submit
                                    disabled>
                                @Localizer["GameBoard_AcceptWager"]
                            </button>
                        </form>
                    </div>
                }
                else if (Model.CurrentQuestion.Status ==
                    BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.AwaitingWager &&
                    Model.CurrentQuestion.IsAllPlayerQuestion)
                {
                    <section class="all-player-wager-waiting">
                        <h2>@Localizer["FinalQuestion_WaitingForWagers"]</h2>
                    </section>
                    <div class="all-player-host-primary-action"
                         data-all-player-primary-action
                         aria-live="polite"></div>
                }
                else if (Model.CurrentQuestion.Wager is not null)
                {
                    var wagerPlayer = Model.Players.First(
                        player => player.Id == Model.CurrentQuestion.Wager.PlayerId);

                    <p class="accepted-wager answering-player-header">
                        @Localizer[
                            "GameBoard_AcceptedWagerSummary",
                            wagerPlayer.Name,
                            Model.CurrentQuestion.Wager.Amount]
                    </p>
                }

                @if (Model.CurrentQuestion.Status != BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.AwaitingWager)
                {
                    var isShowingAnswer =
                        Model.CurrentQuestion.Status == BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.ShowingAnswer;
                    var isAllPlayerMultipleChoiceAnswer =
                        isShowingAnswer &&
                        Model.CurrentQuestion.PresentationType ==
                            BadWolfQuiz.Game.Definitions.QuestionPresentationType.AllPlayerMultipleChoice;
                    var isAllPlayerMultipleChoiceQuestion =
                        !isShowingAnswer &&
                        Model.CurrentQuestion.PresentationType ==
                            BadWolfQuiz.Game.Definitions.QuestionPresentationType.AllPlayerMultipleChoice;
                    var contentBlocks = isShowingAnswer
                        ? Model.CurrentQuestion.AnswerBlocks
                        : Model.CurrentQuestion.QuestionBlocks;
                    var mediaAutoplayState = isShowingAnswer
                        ? $"answer:{Model.CurrentQuestion.SourceQuestionId}"
                        : Model.CurrentQuestion.PresentationType ==
                            BadWolfQuiz.Game.Definitions.QuestionPresentationType.FourClues
                            ? $"question:{Model.CurrentQuestion.SourceQuestionId}:clues:{Model.CurrentQuestion.RevealedClueCount}"
                            : $"question:{Model.CurrentQuestion.SourceQuestionId}";

                    <section class="game-content-presentation @(isShowingAnswer ? "answer-presentation" : "question-presentation") @(isAllPlayerMultipleChoiceAnswer ? "all-player-multiple-choice-answer-presentation" : null)"
                             data-media-autoplay-state="@mediaAutoplayState">
                        <p class="eyebrow"
                           data-question-heading
                           data-current-reward="@Model.CurrentQuestion.CorrectAnswerValue"
                           data-reward-full-value="@Model.CurrentQuestion.Points"
                           data-reward-half-value="@(Model.CurrentQuestion.Points / 2)"
                           data-reward-quarter-value="@(Model.CurrentQuestion.Points / 4)"
                           data-reward-template="@Localizer[
                               "GameBoard_QuestionWithCategoryAndPoints",
                               Model.CurrentQuestion.CategoryTitle,
                               "__REWARD__"]">
                            @(isShowingAnswer
                                ? Localizer[
                                    "GameBoard_AnswerWithCategory",
                                    Model.CurrentQuestion.CategoryTitle]
                                : Localizer[
                                    "GameBoard_QuestionWithCategoryAndPoints",
                                    Model.CurrentQuestion.CategoryTitle,
                                    Model.CurrentQuestion.CorrectAnswerValue])
                        </p>

                        <div class="game-content-blocks @(Model.CurrentQuestion.PresentationType == BadWolfQuiz.Game.Definitions.QuestionPresentationType.FourClues && !isShowingAnswer ? "four-clue-grid" : null) @(isAllPlayerMultipleChoiceAnswer ? "all-player-answer-grid" : null)"
                             data-question-clues
                             data-source-question-id="@Model.CurrentQuestion.SourceQuestionId"
                             data-revealed-clue-count="@(Model.CurrentQuestion.PresentationType == BadWolfQuiz.Game.Definitions.QuestionPresentationType.FourClues && !isShowingAnswer ? Model.CurrentQuestion.RevealedClueCount.ToString() : null)">
                            @{
                                var clueIndex = 0;
                            }

                            @foreach (var block in contentBlocks)
                            {
                                var isHiddenClue =
                                    Model.CurrentQuestion.PresentationType ==
                                    BadWolfQuiz.Game.Definitions.QuestionPresentationType.FourClues &&
                                    !isShowingAnswer &&
                                    clueIndex >= Model.CurrentQuestion.RevealedClueCount;
                                var allPlayerAnswerOptionClass =
                                    isAllPlayerMultipleChoiceAnswer
                                        ? clueIndex == 0
                                            ? "all-player-answer-option all-player-answer-option-correct"
                                            : "all-player-answer-option all-player-answer-option-incorrect"
                                        : null;

                                <article class="game-content-block @(isHiddenClue ? "question-clue-hidden" : null) @allPlayerAnswerOptionClass"
                                         data-question-clue>
                                    @if (!string.IsNullOrWhiteSpace(block.TopCaption))
                                    {
                                        <p class="game-content-caption">@block.TopCaption</p>
                                    }

                                    @switch (block.Kind)
                                    {
                                        case BadWolfQuiz.Game.Definitions.ContentBlockKind.Text:
                                            <p class="game-content-text">@block.TextContent</p>
                                            break;
                                        case BadWolfQuiz.Game.Definitions.ContentBlockKind.Image:
                                            <img class="game-content-image"
                                                 src="@Url.Page(
                                                     "/Admin/Games/Lobby",
                                                     "ContentBlock",
                                                     new
                                                     {
                                                         id = Model.Game.Session.Id.Value,
                                                         sourceQuestionId = Model.CurrentQuestion.SourceQuestionId,
                                                         sourceContentBlockId = block.SourceContentBlockId,
                                                         answer = isShowingAnswer
                                                     })"
                                                 alt="@block.FileName" />
                                            break;
                                        case BadWolfQuiz.Game.Definitions.ContentBlockKind.Audio:
                                            <div class="game-content-audio-shell">
                                                <audio class="game-content-audio"
                                                       controls
                                                       preload="metadata"
                                                       data-autoplay-media="@Model.ResolveContentBlockAutoplay(block, isShowingAnswer).ToString().ToLowerInvariant()"
                                                       src="@Url.Page(
                                                           "/Admin/Games/Lobby",
                                                           "ContentBlock",
                                                           new
                                                           {
                                                               id = Model.Game.Session.Id.Value,
                                                               sourceQuestionId = Model.CurrentQuestion.SourceQuestionId,
                                                               sourceContentBlockId = block.SourceContentBlockId,
                                                               answer = isShowingAnswer
                                                           })">
                                                    @Localizer["GameBoard_AudioUnsupported"]
                                                </audio>
                                            </div>
                                            break;
                                        case BadWolfQuiz.Game.Definitions.ContentBlockKind.Video:
                                            <video class="game-content-video"
                                                   data-autoplay-media="@Model.ResolveContentBlockAutoplay(block, isShowingAnswer).ToString().ToLowerInvariant()"
                                                   controls
                                                   src="@block.ExternalUrl">
                                            </video>
                                            break;
                                        case BadWolfQuiz.Game.Definitions.ContentBlockKind.YouTube:
                                            <iframe class="game-content-video youtube-auto-expand"
                                                    data-youtube-autoplay="@Model.ResolveContentBlockAutoplay(block, isShowingAnswer).ToString().ToLowerInvariant()"
                                                    src="@LobbyModel.GetYouTubeEmbedUrl(block.ExternalUrl)"
                                                    title="@Localizer["GameBoard_MediaContent"]"
                                                    data-close-label="@Localizer["GameBoard_CloseVideo"]"
                                                    allowfullscreen>
                                            </iframe>
                                            break;
                                    }

                                    @if (!string.IsNullOrWhiteSpace(block.BottomCaption))
                                    {
                                        <p class="game-content-caption">@block.BottomCaption</p>
                                    }
                                </article>

                                clueIndex++;
                            }
                        </div>

                        @if (isAllPlayerMultipleChoiceQuestion)
                        {
                            <form class="all-player-host-close-form"
                                  data-all-player-review-action
                                  method="post"
                                  asp-page-handler="CloseAllPlayerQuestion">
                                <input name="sourceQuestionId"
                                       type="hidden"
                                       value="@Model.CurrentQuestion.SourceQuestionId" />
                                <button class="button button-primary" type="submit">
                                    @Localizer["AllPlayer_ReviewAnswersNow"]
                                </button>
                            </form>
                            <section class="all-player-host-choice-preview"
                                     data-all-player-server-preview
                                     tabindex="0"
                                     aria-label="@Localizer["QuestionType_AllPlayerMultipleChoice"]">
                                <div class="all-player-host-choice-grid">
                                    @foreach (var optionBlock in
                                        Model.GetAllPlayerHostChoiceBlocks(
                                            Model.CurrentQuestion))
                                    {
                                        <article class="all-player-host-choice-option">
                                            @if (optionBlock.Kind ==
                                                BadWolfQuiz.Game.Definitions.ContentBlockKind.Image)
                                            {
                                                <img src="@Url.Page(
                                                         "/Admin/Games/Lobby",
                                                         "ContentBlock",
                                                         new
                                                         {
                                                             id = Model.Game.Session.Id.Value,
                                                             sourceQuestionId = Model.CurrentQuestion.SourceQuestionId,
                                                             sourceContentBlockId = optionBlock.SourceContentBlockId,
                                                             answer = true
                                                         })"
                                                     alt="@optionBlock.FileName" />
                                            }
                                            else
                                            {
                                                <span>@optionBlock.TextContent</span>
                                            }
                                        </article>
                                    }
                                </div>
                            </section>
                        }

                        @if (isShowingAnswer)
                        {
                            <form method="post" asp-page-handler="CloseAnswer">
                                <input name="sourceQuestionId"
                                       type="hidden"
                                       value="@Model.CurrentQuestion.SourceQuestionId" />
                                <button class="button button-primary" type="submit">
                                    @Localizer["GameBoard_ReturnToBoard"]
                                </button>
                            </form>
                        }
                    </section>
                }

            @if (Model.CurrentQuestion.Status is BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.Selected or
                BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.Active)
            {
                var eligiblePlayers = Model.CurrentQuestion.IsAllPlayerQuestion
                    ? Enumerable.Empty<BadWolfQuiz.Web.Services.PlayerLobbyEntry>()
                    : Model.CurrentQuestion.IsSpecial
                        ? Model.Game.Session.AnswerTimer.Status ==
                                BadWolfQuiz.Game.Runtime.GameTimerStatus.Stopped
                            ? Enumerable.Empty<BadWolfQuiz.Web.Services.PlayerLobbyEntry>()
                            : Model.Players.Where(player =>
                                player.Id == Model.CurrentQuestion.Wager!.PlayerId)
                        : Model.CurrentQuestion.AnsweringPlayerId is { } answeringPlayerId
                            ? Model.Players.Where(player => player.Id == answeringPlayerId)
                            : Enumerable.Empty<BadWolfQuiz.Web.Services.PlayerLobbyEntry>();

                <section class="question-controls">
                    @if (Model.CurrentQuestion.IsAllPlayerQuestion &&
                        Model.CurrentQuestion.IsSpecial &&
                        Model.Game.Session.Settings.WagerQuestionAnswerTimerStartMode ==
                            BadWolfQuiz.Game.Runtime.GamePhaseStartMode.Manual &&
                        Model.Game.Session.AnswerTimer.Status ==
                            BadWolfQuiz.Game.Runtime.GameTimerStatus.Stopped)
                    {
                        <form class="all-player-host-timer-form"
                              method="post"
                              asp-page-handler="StartWagerAnswerTimer">
                            <input name="sourceQuestionId"
                                   type="hidden"
                                   value="@Model.CurrentQuestion.SourceQuestionId" />
                            <button class="button button-primary" type="submit">
                                @Localizer["GameBoard_StartAnswerTimer"]
                            </button>
                        </form>
                    }

                    @if (Model.CurrentQuestion.IsAllPlayerQuestion)
                    {
                        if (Model.CurrentQuestion.PresentationType !=
                            BadWolfQuiz.Game.Definitions.QuestionPresentationType.AllPlayerMultipleChoice)
                        {
                            <form class="all-player-host-close-form"
                                  data-all-player-review-action
                                  method="post"
                                  asp-page-handler="CloseAllPlayerQuestion">
                                <input name="sourceQuestionId"
                                       type="hidden"
                                       value="@Model.CurrentQuestion.SourceQuestionId" />
                                <button class="button button-primary" type="submit">
                                    @Localizer["AllPlayer_ReviewAnswersNow"]
                                </button>
                            </form>
                        }
                    }
                    else
                    {
                    @if (!Model.CurrentQuestion.IsSpecial &&
                        Model.CurrentQuestion.BuzzerStatus ==
                            BadWolfQuiz.Game.Runtime.QuestionBuzzerStatus.Inactive)
                    {
                        <form method="post" asp-page-handler="ActivateBuzzer">
                            <input name="sourceQuestionId"
                                   type="hidden"
                                   value="@Model.CurrentQuestion.SourceQuestionId" />
                            <button class="button button-primary" type="submit">
                                @Localizer["GameBoard_ActivateBuzzer"]
                            </button>
                        </form>
                    }
                    else if (!Model.CurrentQuestion.IsSpecial &&
                        Model.CurrentQuestion.BuzzerStatus ==
                            BadWolfQuiz.Game.Runtime.QuestionBuzzerStatus.Open)
                    {
                        <p class="buzzer-status">@Localizer["GameBoard_WaitingForBuzz"]</p>
                    }

                    @if (Model.CurrentQuestion.IsSpecial &&
                        Model.Game.Session.Settings.WagerQuestionAnswerTimerStartMode ==
                            BadWolfQuiz.Game.Runtime.GamePhaseStartMode.Manual &&
                        Model.Game.Session.AnswerTimer.Status ==
                            BadWolfQuiz.Game.Runtime.GameTimerStatus.Stopped)
                    {
                        <form method="post" asp-page-handler="StartWagerAnswerTimer">
                            <input name="sourceQuestionId"
                                   type="hidden"
                                   value="@Model.CurrentQuestion.SourceQuestionId" />
                            <button class="button button-primary" type="submit">
                                @Localizer["GameBoard_StartAnswerTimer"]
                            </button>
                        </form>
                    }

                    @foreach (var player in eligiblePlayers)
                    {
                        <form class="question-judge-actions"
                              method="post"
                              asp-page-handler="JudgeQuestionAnswer">
                            <input name="sourceQuestionId"
                                   type="hidden"
                                   value="@Model.CurrentQuestion.SourceQuestionId" />
                            <input name="playerId"
                                   type="hidden"
                                   value="@player.Id.Value" />
                            <button class="button judgment-correct-button"
                                    name="isCorrect"
                                    type="submit"
                                    value="true">
                                @Localizer["Message_Correct"]
                            </button>
                            <button class="button judgment-incorrect-button"
                                    name="isCorrect"
                                    type="submit"
                                    value="false">
                                @Localizer["Message_Wrong"]
                            </button>
                        </form>
                    }

                    @if (!Model.CurrentQuestion.IsSpecial &&
                        Model.CurrentQuestion.AnsweringPlayerId is null)
                    {
                        <form method="post" asp-page-handler="ResolveQuestion">
                            <input name="sourceQuestionId"
                                   type="hidden"
                                   value="@Model.CurrentQuestion.SourceQuestionId" />
                            <button class="button button-secondary" type="submit">
                                @Localizer["GameBoard_NoCorrectAnswer"]
                            </button>
                        </form>
                    }

                    @if (Model.CurrentQuestion.CanRevealClue &&
                                Model.CurrentQuestion.BuzzerStatus !=
                                BadWolfQuiz.Game.Runtime.QuestionBuzzerStatus.Claimed)
                    {
                        <form method="post"
                                asp-page-handler="RevealClue"
                                data-reveal-clue-form>
                            <input name="sourceQuestionId"
                                    type="hidden"
                                    value="@Model.CurrentQuestion.SourceQuestionId" />
                            <button class="button button-secondary" type="submit">
                                @Localizer["GameBoard_RevealOneClue"]
                            </button>
                        </form>
                    }
                    }
                </section>
            }
            </div>
        }

        @if (Model.IsRoundSummaryVisible)
        {
            <section class="round-summary" aria-labelledby="round-summary-title">
                <p class="eyebrow">@Localizer["GameBoard_RoundComplete"]</p>
                <h2 id="round-summary-title">@Model.Game.Session.CurrentRound.Title</h2>
                <ol class="round-podium">
                    @foreach (var leader in Model.RoundLeaders)
                    {
                        <li class="round-podium-player @(leader.Position == 1 ? "round-winner" : null)">
                            <span class="round-podium-position">@leader.Position</span>
                            <strong>@leader.PlayerName</strong>
                            <span class="round-podium-score">@leader.Score</span>
                        </li>
                    }
                </ol>
                @if (Model.Game.Session.IsPreviousRoundReturnPending)
                {
                    <form method="post" asp-page-handler="PreviousRound">
                        <button class="button button-primary" type="submit">
                            @Localizer["GameBoard_PreviousRound"]
                        </button>
                    </form>
                }
                else if (Model.Game.Session.IsFinalQuestionAdvancePending)
                {
                    <form method="post" asp-page-handler="ForceAdvanceToFinalQuestion">
                        <button class="button button-primary" type="submit">
                            @Localizer["FinalQuestion_Start"]
                        </button>
                    </form>
                }
                else if (Model.Game.Session.IsUnfinishedRoundReturnPending)
                {
                    <form method="post" asp-page-handler="ReturnToUnfinishedRound">
                        <button class="button button-primary" type="submit">
                            @Localizer["GameBoard_ReturnToUnfinishedRound"]
                        </button>
                    </form>
                }
                else if (Model.Game.Session.HasNextUnfinishedRound)
                {
                    <form method="post" asp-page-handler="AdvanceRound">
                        <input type="hidden"
                               name="filterCompletedCategories"
                               value="@Model.Game.Session.IsForcedRoundAdvancePending.ToString().ToLowerInvariant()" />
                        <button class="button button-primary" type="submit">
                            @Localizer["GameBoard_StartNextRound"]
                        </button>
                    </form>
                }
                else if (Model.Game.Session.Quiz.FinalQuestion is not null)
                {
                    @if (Model.Game.Session.HasAnyUnfinishedRegularRound)
                    {
                        <button class="button button-primary" type="button" data-open-natural-final-warning>
                            @Localizer["FinalQuestion_Start"]
                        </button>
                    }
                    else
                    {
                        <form method="post" asp-page-handler="StartNaturalFinalTransition">
                            <button class="button button-primary" type="submit">
                                @Localizer["FinalQuestion_Start"]
                            </button>
                        </form>
                    }
                }
                else
                {
                    <p class="round-summary-finished">@Localizer["GameBoard_AllRoundsComplete"]</p>
                    <div class="form-actions final-finish-actions">
                        @if (Model.Game.Session.HasAnyUnfinishedRegularRound)
                        {
                            <button class="button button-primary" type="button" data-open-finish-game-warning>
                                @Localizer["GameBoard_FinishGame"]
                            </button>
                        }
                        else
                        {
                            <a class="button button-primary" asp-page="/Admin/Quizzes/Index">
                                @Localizer["GameBoard_FinishGame"]
                            </a>
                        }
                    </div>
                }
            </section>
        }

        </div>

        <div class="host-board-layout"
             data-host-gameplay-board
             hidden="@(Model.CurrentQuestion is not null ||
                 Model.PreviewQuestion is not null ||
                 Model.IsRoundSummaryVisible ? "hidden" : null)">
            @if (Model.Game.Session.Settings.HasHostCard)
            {
                <aside class="board-host-sidebar"
                       data-board-host-slot
                       aria-label="@Model.Game.Session.Settings.HostName">
                    <div class="board-host-card-drag-handle"
                         data-board-host-card-drag-handle
                         role="button"
                         aria-label="@Localizer["GameBoard_MoveHostCard"]"
                         title="@Localizer["GameBoard_MoveHostCard"]"
                         tabindex="0"></div>
                    <ul class="board-host-card-list" data-board-host-card-list></ul>
                    <div class="board-host-card-resizer"
                         data-board-host-card-resizer
                         role="separator"
                         aria-label="@Localizer["GameBoard_ResizeHostCard"]"
                         tabindex="0"></div>
                </aside>
            }
            <div class="host-board-grid"
                 data-source-round-id="@Model.Game.Session.CurrentRound.SourceRoundId"
                 style="--board-columns: @Model.BoardCategories.Count">
            @foreach (var category in Model.BoardCategories)
            {
                <section class="host-board-column">
                    <h3 data-category-context
                        data-source-category-id="@category.SourceCategoryId"
                        data-category-label="@category.Title"
                        data-has-available-questions="@category.Questions.Any(question => question.Status == BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.Available).ToString().ToLowerInvariant()"
                        data-category-preview-url="@Url.Page("RunningRoundIntro", new { id = Model.Game.Session.Id.Value, sourceCategoryId = category.SourceCategoryId })"
                        role="link"
                        tabindex="0">
                        @category.Title
                    </h3>

                    @foreach (var question in category.Questions)
                    {
                        @if (question.Status == BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.Available)
                        {
                            <form class="question-selection-form"
                                  method="post"
                                  asp-page-handler="SelectQuestion">
                                <input name="sourceQuestionId"
                                       type="hidden"
                                       value="@question.SourceQuestionId" />
                                <button class="host-board-question status-available"
                                        type="submit"
                                        data-question-context
                                        data-source-question-id="@question.SourceQuestionId"
                                        data-question-points="@question.Points"
                                        data-question-label="@Model.Game.Session.CurrentRound.Title — @question.CategoryTitle — @question.Points"
                                        data-attempted-player-ids="@string.Join(',', question.AnswerAttempts.Select(attempt => attempt.PlayerId.Value))">
                                    @question.Points
                                </button>
                            </form>
                        }
                        else if (question.Status == BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.Resolved)
                        {
                            <a class="host-board-question status-resolved"
                               data-question-resolved
                               asp-page="/Admin/Games/Lobby"
                               asp-route-id="@Model.Game.Session.Id.Value"
                               asp-route-previewQuestionId="@question.SourceQuestionId"
                               aria-label="@Localizer["GameBoard_PreviewResolvedQuestion", question.Points]">
                                @question.Points
                            </a>
                        }
                    }
                </section>
            }
            </div>

            <aside class="board-player-sidebar" aria-label="@Localizer["Label_Players"]">
                <ul id="board-player-list" class="board-player-list">
                    @foreach (var player in Model.Players)
                    {
                        <li data-sidebar-player-id="@player.Id.Value">
                            <span class="board-player-name" title="@player.Name">
                                <span>@player.Name</span>
                            </span>
                            <strong class="board-player-score @(player.Score < 0 ? "score-negative" : null)">
                                @player.Score
                            </strong>
                        </li>
                    }
                </ul>
            </aside>
            </div>

        <div class="game-side-controls">
            @if (Model.IsDiscordVoiceReady)
            {
                <button class="game-side-control discord-mute-control"
                        type="button"
                        data-discord-mute="true"
                        title="@Localizer["Discord_MuteParticipants"]"
                        aria-label="@Localizer["Discord_MuteParticipants"]">
                    <span aria-hidden="true">🔇</span>
                </button>
                <button class="game-side-control discord-unmute-control"
                        type="button"
                        data-discord-mute="false"
                        title="@Localizer["Discord_UnmuteParticipants"]"
                        aria-label="@Localizer["Discord_UnmuteParticipants"]">
                    <span aria-hidden="true">🔊</span>
                </button>
            }

            <form class="player-join-lock-form"
                  method="post"
                  asp-page-handler="TogglePlayerJoining"
                  data-open-label="@Localizer["GameBoard_OpenPlayerJoining"]"
                  data-close-label="@Localizer["GameBoard_ClosePlayerJoining"]">
                <button class="player-join-lock @(Model.Game.AllowsNewPlayers ? "is-open" : "is-closed")"
                        type="submit"
                        title="@(Model.Game.AllowsNewPlayers
                            ? Localizer["GameBoard_ClosePlayerJoining"]
                            : Localizer["GameBoard_OpenPlayerJoining"])"
                        aria-label="@(Model.Game.AllowsNewPlayers
                            ? Localizer["GameBoard_ClosePlayerJoining"]
                            : Localizer["GameBoard_OpenPlayerJoining"])">
                    <span aria-hidden="true">@(Model.Game.AllowsNewPlayers ? "🔓" : "🔒")</span>
                </button>
            </form>
        </div>

        <div class="game-scoreboard-resizer"
             data-scoreboard-resizer
             role="separator"
             aria-orientation="horizontal"
             aria-label="@Localizer["GameBoard_ResizePlayerPanel"]"
             aria-valuemin="130"
             aria-valuenow="230"
             tabindex="0"><span></span></div>

        <div data-host-gameplay-transient>
        @if (Model.AnswerResultOverlay is { } answerResultOverlay)
        {
            var scoreText = answerResultOverlay.ScoreDelta > 0
                ? $"+{answerResultOverlay.ScoreDelta}"
                : answerResultOverlay.ScoreDelta.ToString();

            <aside class="buzzer-race-overlay answer-result-overlay"
                   data-answer-result-overlay
                   role="status"
                   aria-live="polite">
                <div class="buzzer-race-card answer-result-card" data-auto-fit-overlay>
                    <p class="answer-result-player-name">
                        @answerResultOverlay.PlayerName
                    </p>
                    <strong class="answer-result-score @(answerResultOverlay.ScoreDelta < 0 ? "score-negative" : null)">
                        @scoreText
                    </strong>
                </div>
            </aside>
        }

        </div>

        <ul id="player-list" class="game-scoreboard" aria-label="@Localizer["Label_Players"]">
            @if (Model.Game.Session.Settings.HasHostCard)
            {
                <li class="scoreboard-player host-card" data-host-card>
                    <span class="player-card-width-resizer"
                          data-player-card-width-resizer
                          role="separator"
                          aria-orientation="vertical"
                          aria-label="@Localizer["GameBoard_ResizePlayerCards"]"
                          tabindex="0"></span>
                    <strong>@Model.Game.Session.Settings.HostName</strong>
                    @if (Model.Game.Session.Settings.HostVisualSource == BadWolfQuiz.Game.Runtime.HostVisualSource.Image &&
                         Model.Game.Session.Settings.HostImageData is not null)
                    {
                        <img class="host-card-media"
                             src="@Url.Page("/Admin/Games/Lobby", "HostCardImage", new { id = Model.Game.Session.Id.Value })"
                             alt="@Model.Game.Session.Settings.HostName" />
                    }
                    else if (Model.Game.Session.Settings.HostVisualSource == BadWolfQuiz.Game.Runtime.HostVisualSource.Avatar &&
                             !string.IsNullOrWhiteSpace(Model.Game.Session.Settings.HostAvatarId))
                    {
                        <img class="host-card-media" src="/avatars/@Model.Game.Session.Settings.HostAvatarId" alt="" />
                    }
                    else if (Model.Game.Session.Settings.HostVisualSource == BadWolfQuiz.Game.Runtime.HostVisualSource.Webcam)
                    {
                        @if (!string.IsNullOrWhiteSpace(Model.Game.Session.Settings.HostAvatarId))
                        {
                            <img class="host-card-media" data-host-webcam-fallback src="/avatars/@Model.Game.Session.Settings.HostAvatarId" alt="" />
                        }
                        else if (Model.Game.Session.Settings.HostImageData is not null)
                        {
                            <img class="host-card-media"
                                 data-host-webcam-fallback
                                 src="@Url.Page("/Admin/Games/Lobby", "HostCardImage", new { id = Model.Game.Session.Id.Value })"
                                 alt="@Model.Game.Session.Settings.HostName" />
                        }
                        <video class="host-card-media" data-host-webcam autoplay muted playsinline hidden></video>
                    }
                    else if (Model.Game.Session.Settings.HostVisualSource == BadWolfQuiz.Game.Runtime.HostVisualSource.WebcamUrl &&
                             !string.IsNullOrWhiteSpace(Model.Game.Session.Settings.HostWebcamUrl))
                    {
                        <iframe class="host-card-media"
                                src="@BadWolfQuiz.Web.Services.WebcamUrlUtility.MuteAudio(Model.Game.Session.Settings.HostWebcamUrl)"
                                title="@Model.Game.Session.Settings.HostName"
                                allow="autoplay; fullscreen; picture-in-picture"
                                sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-presentation"
                                referrerpolicy="no-referrer"
                                allowfullscreen></iframe>
                    }
                </li>
            }
            @foreach (var player in Model.Players)
            {
                var questionIsActive = Model.CurrentQuestion?.Status is
                    BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.Selected or
                    BadWolfQuiz.Game.Runtime.RuntimeQuestionStatus.Active;
                var isAnswering = questionIsActive &&
                    Model.CurrentQuestion?.AnsweringPlayerId == player.Id;
                var hasAttempted = questionIsActive &&
                    Model.CurrentQuestion?.AnswerAttempts.Any(
                        attempt => attempt.PlayerId == player.Id) == true;

                <li class="scoreboard-player
                           @(Model.Game.Session.ActivePlayerId == player.Id ? "active-player" : null)
                           @(isAnswering ? "question-answering-player" : null)
                           @(hasAttempted ? "question-attempted-player" : null)"
                    data-player-id="@player.Id.Value"
                    data-player-name="@player.Name">
                    <span class="player-card-width-resizer"
                          data-player-card-width-resizer
                          role="separator"
                          aria-orientation="vertical"
                          aria-label="@Localizer["GameBoard_ResizePlayerCards"]"
                          tabindex="0"></span>
                    @if ((player.Presence is BadWolfQuiz.Web.Services.PlayerPresenceStatus.Active or
                            BadWolfQuiz.Web.Services.PlayerPresenceStatus.Inactive) &&
                         (player.UsesUploadedImage ||
                          !string.IsNullOrWhiteSpace(player.AvatarId)))
                    {
                        <img class="player-card-avatar"
                             src="@(player.UsesUploadedImage ? player.UploadedImageDataUrl : $"/avatars/{player.AvatarId}")"
                             alt="" />
                    }
                    <strong>@player.Name</strong>
                    @if (player.Presence != BadWolfQuiz.Web.Services.PlayerPresenceStatus.Active)
                    {
                        <span class="presence-badge presence-@player.Presence.ToString().ToLowerInvariant()">
                            @Localizer[$"PlayerPresence_{player.Presence}"]
                        </span>
                    }
                    <span class="scoreboard-score @(player.Score < 0 ? "score-negative" : null)">
                        @player.Score
                    </span>
                    <span class="player-card-actions">
                        <button class="button button-danger icon-button player-action-button scoreboard-remove-player"
                                type="button"
                                data-remove-player="@player.Id.Value"
                                title="@Localizer["GameBoard_RemovePlayer"]"
                                aria-label="@Localizer["GameBoard_RemovePlayer"]">
                            <span aria-hidden="true">✕</span>
                        </button>
                        @if (Model.Game.Session.ActivePlayerId != player.Id)
                        {
                            <button class="button button-secondary icon-button player-action-button"
                                    type="button"
                                    data-make-active-player="@player.Id.Value"
                                    title="@Localizer["GameBoard_MakeActivePlayer"]"
                                    aria-label="@Localizer["GameBoard_MakeActivePlayer"]"
                                    disabled="@(Model.Game.Session.IsActivePlayerChangeLocked ? "disabled" : null)">
                                <span aria-hidden="true">★</span>
                            </button>
                        }
                    </span>
                </li>
            }
        </ul>

    </section>
}

@if (Model.Game.Session.Status is
    BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalWagering or
    BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalAnswering or
    BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalJudging or
    BadWolfQuiz.Game.Runtime.GameSessionStatus.Completed)
{
    var final = Model.Game.Session.FinalQuestion!;
    var showQuestion = Model.Game.Session.Status is
        BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalAnswering or
        BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalJudging;
    var showAnswer =
        Model.Game.Session.Status == BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalJudging;

    <section class="host-game-board final-question-host"
             data-game-id="@Model.Game.Session.Id.Value"
             data-discord-auto-mute="@((Model.DiscordConnection?.AutoMuteDuringMedia ?? false).ToString().ToLowerInvariant())"
             data-game-code="@Model.Game.PublicCode"
             data-correct-answer-sound="@Model.CorrectAnswerSound"
             data-incorrect-answer-sound="@Model.IncorrectAnswerSound"
             data-resize-player-card-label="@Localizer["GameBoard_ResizePlayerCards"]"
             data-game-status="@Model.Game.Session.Status.ToString().ToLowerInvariant()"
             data-status-active="@Localizer["PlayerPresence_Active"]"
             data-status-inactive="@Localizer["PlayerPresence_Inactive"]"
             data-status-disconnected="@Localizer["PlayerPresence_Disconnected"]"
             data-status-rejoinpending="@Localizer["PlayerPresence_RejoinPending"]"
             data-approve-label="@Localizer["GameLobby_ApproveRejoin"]"
             data-remove-player-label="@Localizer["GameBoard_RemovePlayer"]"
             data-remove-player-confirm="@Localizer["GameBoard_RemovePlayerConfirm"]">
        @if (TempData["ErrorMessage"] is string errorMessage)
        {
            <div class="message message-error">@errorMessage</div>
        }

        <div id="host-gameplay-view" data-host-gameplay-view>
        <div class="content-panel final-question-panel @(showAnswer ? "final-judging-mode" : null)">
            <p class="eyebrow">@Localizer["FinalQuestion_Title"]</p>

            @if (Model.Game.Session.Status == BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalWagering)
            {
                <h2>@Localizer["FinalQuestion_WaitingForWagers"]</h2>
                <ul class="final-submission-list">
                    @foreach (var submission in final.Submissions)
                    {
                        <li>
                            <strong>@submission.PlayerName</strong>
                            <span>
                                @(submission.Wager is null
                                    ? Localizer["FinalQuestion_NotSubmitted"]
                                    : Localizer["FinalQuestion_Submitted"])
                            </span>
                            @if (submission.Wager is null)
                            {
                                <form method="post" asp-page-handler="SubmitMinimumFinalWager">
                                    <input type="hidden" name="playerId" value="@submission.PlayerId.Value" />
                                    <button class="button button-secondary final-player-action-icon"
                                            type="submit"
                                            title="@Localizer["FinalQuestion_SubmitMinimumWager"]"
                                            aria-label="@Localizer["FinalQuestion_SubmitMinimumWager"]">
                                        <span aria-hidden="true">⇩</span>
                                    </button>
                                </form>
                            }
                        </li>
                    }
                </ul>
                <form method="post" asp-page-handler="LockFinalWagers">
                    <button class="button button-primary"
                            type="submit"
                            disabled="@(final.Submissions.Any(item => item.Wager is null) ? "disabled" : null)">
                        @Localizer["FinalQuestion_ShowQuestion"]
                    </button>
                </form>
            }
            else if (showQuestion)
            {
                var blocks = final.Definition.QuestionBlocks;

                @if (!showAnswer)
                {
                    <section class="game-content-presentation question-presentation"
                         data-media-autoplay-state="final-question">
                        <p class="eyebrow">
                            @Localizer["GameBoard_Question"]
                        </p>
                        <div class="game-content-blocks">
                            @foreach (var block in blocks)
                            {
                                <article class="game-content-block">
                                    @if (!string.IsNullOrWhiteSpace(block.TopCaption))
                                    {
                                        <p class="game-content-caption">@block.TopCaption</p>
                                    }
                                    @switch (block.Kind)
                                    {
                                        case BadWolfQuiz.Game.Definitions.ContentBlockKind.Text:
                                            <p class="game-content-text">@block.TextContent</p>
                                            break;
                                        case BadWolfQuiz.Game.Definitions.ContentBlockKind.Image:
                                            <img class="game-content-image"
                                                 src="@Url.Page("/Admin/Games/Lobby", "FinalContentBlock", new { id = Model.Game.Session.Id.Value, sourceContentBlockId = block.SourceContentBlockId, answer = false })"
                                                 alt="@block.FileName" />
                                            break;
                                        case BadWolfQuiz.Game.Definitions.ContentBlockKind.Audio:
                                            <div class="game-content-audio-shell">
                                                <audio class="game-content-audio"
                                                       controls
                                                       preload="metadata"
                                                       data-autoplay-media="@Model.ResolveContentBlockAutoplay(block, final: true).ToString().ToLowerInvariant()"
                                                       src="@Url.Page("/Admin/Games/Lobby", "FinalContentBlock", new { id = Model.Game.Session.Id.Value, sourceContentBlockId = block.SourceContentBlockId, answer = false })">
                                                    @Localizer["GameBoard_AudioUnsupported"]
                                                </audio>
                                            </div>
                                            break;
                                        case BadWolfQuiz.Game.Definitions.ContentBlockKind.Video:
                                            <video class="game-content-video"
                                                   data-autoplay-media="@Model.ResolveContentBlockAutoplay(block, final: true).ToString().ToLowerInvariant()"
                                                   controls src="@block.ExternalUrl"></video>
                                            break;
                                        case BadWolfQuiz.Game.Definitions.ContentBlockKind.YouTube:
                                            <iframe class="game-content-video youtube-auto-expand"
                                                    data-youtube-autoplay="@Model.ResolveContentBlockAutoplay(block, final: true).ToString().ToLowerInvariant()"
                                                    src="@LobbyModel.GetYouTubeEmbedUrl(block.ExternalUrl)"
                                                    title="@Localizer["GameBoard_MediaContent"]"
                                                    data-close-label="@Localizer["GameBoard_CloseVideo"]"
