@page
@model BadWolfQuiz.Web.Pages.Admin.QuestionInboxModel
@using BadWolfQuiz.Web.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["QuestionInbox_Title"];
}
@using BadWolfQuiz.Web.Models

<section class="page-section question-inbox-page">
    <h1>@Localizer["QuestionInbox_Title"]</h1>

    <div asp-validation-summary="ModelOnly"></div>

    @if (Model.Questions.Count == 0)
    {
        <p>@Localizer["QuestionInbox_Empty"]</p>
    }
    else
    {
        <div class="question-inbox-list">
            @foreach (var question in Model.Questions)
            {
                <article class="question-inbox-card">
                    <header class="question-inbox-card-header">
                        <div>
                            <span class="question-inbox-card-label">@Localizer["QuestionInbox_Question"]</span>

                            @if (!string.IsNullOrWhiteSpace(question.SenderName))
                            {
                                <p class="question-conversation-meta">
                                    <strong>@Localizer["QuestionInbox_From"]:</strong>
                                    <span>@question.SenderName</span>
                                </p>
                            }
                        </div>
                    </header>

                    <div class="question-messages">
                        @foreach (var message in question.Messages
                            .OrderBy(x => x.CreatedAtUtc)
                            .ThenBy(x => x.Id))
                        {
                            var isUserMessage = message.AuthorType == UserQuestionAuthorType.User;

                            <article class="question-message @(isUserMessage ? "question-message-user" : "question-message-developer")">
                                <div class="question-message-author">
                                    @(isUserMessage
                                        ? Localizer["QuestionInbox_User"].Value
                                        : Localizer["QuestionInbox_Developer"].Value)
                                </div>
                                <p class="question-message-body">@message.Text</p>
                            </article>
                        }
                    </div>

                    @{
                        var lastMessage = question.Messages
                            .OrderBy(x => x.CreatedAtUtc)
                            .ThenBy(x => x.Id)
                            .LastOrDefault();

                        var awaitingDeveloper = lastMessage?.AuthorType == UserQuestionAuthorType.User;
                    }

                    <div class="question-reply-panel question-inbox-actions-panel">
                        @if (awaitingDeveloper)
                        {
                            <form method="post"
                                  asp-page-handler="Answer"
                                  class="question-reply-form">

                                <input type="hidden"
                                       name="id"
                                       value="@question.Id" />

                                <label for="answer-@question.Id">
                                    @Localizer["QuestionInbox_Answer"]
                                </label>

                                <textarea id="answer-@question.Id"
                                          name="answer"
                                          rows="5"
                                          maxlength="5000"
                                          required></textarea>

                                <div class="form-actions">
                                    <button type="submit"
                                            class="button button-primary">
                                        @Localizer["QuestionInbox_Reply"]
                                    </button>

                                    <button type="button"
                                            class="button button-danger-outline"
                                            data-delete-question
                                            data-question-id="@question.Id">
                                        @Localizer["Button_Delete"]
                                    </button>
                                </div>
                            </form>
                        }
                        else
                        {
                            <div class="form-actions">
                                <button type="button"
                                        class="button button-danger-outline"
                                        data-delete-question
                                        data-question-id="@question.Id">
                                    @Localizer["Button_Delete"]
                                </button>
                            </div>
                        }
                    </div>
                </article>
            }
        </div>

        <dialog id="delete-question-dialog"
                class="app-dialog">

            <form method="post"
                  asp-page-handler="Delete"
                  class="dialog-card dialog-card-danger">

                <input type="hidden"
                       id="delete-question-id"
                       name="id" />

                <div class="dialog-heading">
                    <div>
                        <h2>@Localizer["QuestionInbox_DeleteConfirmTitle"]</h2>
                        <p class="dialog-warning">
                            @Localizer["QuestionInbox_DeleteConfirmText"]
                        </p>
                    </div>
                </div>

                <div class="form-actions dialog-actions">
                    <button type="button"
                            id="cancel-delete-question"
                            class="button button-secondary">
                        @Localizer["Button_Cancel"]
                    </button>

                    <button type="submit"
                            class="button button-danger">
                        @Localizer["Button_Delete"]
                    </button>
                </div>
            </form>
        </dialog>
    }
</section>

<script>
    (() => {
        const dialog = document.getElementById("delete-question-dialog");
        const questionIdInput = document.getElementById("delete-question-id");
        const cancelButton = document.getElementById("cancel-delete-question");

        if (!dialog || !questionIdInput || !cancelButton) {
            return;
        }

        document.querySelectorAll("[data-delete-question]").forEach(button => {
            button.addEventListener("click", () => {
                questionIdInput.value = button.dataset.questionId;
                dialog.showModal();
            });
        });

        cancelButton.addEventListener("click", () => {
            dialog.close();
        });
    })();
</script>
