@page
@model BadWolfQuiz.Web.Pages.Admin.Settings.IndexModel
@{
    ViewData["Title"] = Localizer["GameSettings_Title"];
}

<div class="page-heading">
    <div>
        <p class="eyebrow">@Localizer["GameSettings_Eyebrow"]</p>
        <h1>@Localizer["GameSettings_Title"]</h1>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="message message-success" role="status" data-auto-dismiss>@successMessage</div>
}

<form method="post" enctype="multipart/form-data" class="form-card narrow stack-form">
    <p class="settings-description">@Localizer["GameSettings_GlobalDescription"]</p>
    <div asp-validation-summary="ModelOnly" class="message message-error"></div>
    <div class="settings-grid">
    <details class="theme-picker">
        <summary>@Localizer["SiteTheme_Label"]</summary>
        <div class="theme-picker-content">
        <p>@Localizer["SiteTheme_Hint"]</p>
        <div class="theme-options">
            <label class="theme-option theme-option-classic">
                <input asp-for="Input.SiteThemeId" type="radio" value="classic-wolf" />
                <span class="theme-swatch" aria-hidden="true"><i></i><i></i><i></i></span>
                <strong>@Localizer["SiteTheme_ClassicWolf"]</strong>
            </label>
            <label class="theme-option theme-option-crimson">
                <input asp-for="Input.SiteThemeId" type="radio" value="crimson-night" />
                <span class="theme-swatch" aria-hidden="true"><i></i><i></i><i></i></span>
                <strong>@Localizer["SiteTheme_CrimsonNight"]</strong>
            </label>
            <label class="theme-option theme-option-arctic">
                <input asp-for="Input.SiteThemeId" type="radio" value="arctic-neon" />
                <span class="theme-swatch" aria-hidden="true"><i></i><i></i><i></i></span>
                <strong>@Localizer["SiteTheme_ArcticNeon"]</strong>
            </label>
            <label class="theme-option theme-option-emerald">
                <input asp-for="Input.SiteThemeId" type="radio" value="emerald-stage" />
                <span class="theme-swatch" aria-hidden="true"><i></i><i></i><i></i></span>
                <strong>@Localizer["SiteTheme_EmeraldStage"]</strong>
            </label>
            <label class="theme-option theme-option-violet">
                <input asp-for="Input.SiteThemeId" type="radio" value="royal-violet" />
                <span class="theme-swatch" aria-hidden="true"><i></i><i></i><i></i></span>
                <strong>@Localizer["SiteTheme_RoyalViolet"]</strong>
            </label>
            <label class="theme-option theme-option-orange">
                <input asp-for="Input.SiteThemeId" type="radio" value="sunset-orange" />
                <span class="theme-swatch" aria-hidden="true"><i></i><i></i><i></i></span>
                <strong>@Localizer["SiteTheme_SunsetOrange"]</strong>
            </label>
            <label class="theme-option theme-option-light">
                <input asp-for="Input.SiteThemeId" type="radio" value="daylight" />
                <span class="theme-swatch" aria-hidden="true"><i></i><i></i><i></i></span>
                <strong>@Localizer["SiteTheme_Daylight"]</strong>
            </label>
            <label class="theme-option theme-option-parchment">
                <input asp-for="Input.SiteThemeId" type="radio" value="warm-parchment" />
                <span class="theme-swatch" aria-hidden="true"><i></i><i></i><i></i></span>
                <strong>@Localizer["SiteTheme_WarmParchment"]</strong>
            </label>
            <label class="theme-option theme-option-mint">
                <input asp-for="Input.SiteThemeId" type="radio" value="mint-fog" />
                <span class="theme-swatch" aria-hidden="true"><i></i><i></i><i></i></span>
                <strong>@Localizer["SiteTheme_MintFog"]</strong>
            </label>
            <label class="theme-option theme-option-ukraine">
                <input asp-for="Input.SiteThemeId" type="radio" value="ukrainian-sky" />
                <span class="theme-swatch" aria-hidden="true"><i></i><i></i><i></i></span>
                <strong>@Localizer["SiteTheme_UkrainianSky"]</strong>
            </label>
            <label class="theme-option theme-option-italy">
                <input asp-for="Input.SiteThemeId" type="radio" value="italian-spirit" />
                <span class="theme-swatch" aria-hidden="true"><i></i><i></i><i></i></span>
                <strong>@Localizer["SiteTheme_ItalianSpirit"]</strong>
            </label>
            <label class="theme-option theme-option-pride">
                <input asp-for="Input.SiteThemeId" type="radio" value="pride-spectrum" />
                <span class="theme-swatch" aria-hidden="true"><i></i><i></i><i></i></span>
                <strong>@Localizer["SiteTheme_PrideSpectrum"]</strong>
            </label>
            <label class="theme-option theme-option-arcade">
                <input asp-for="Input.SiteThemeId" type="radio" value="retro-arcade" />
                <span class="theme-swatch" aria-hidden="true"><i></i><i></i><i></i></span>
                <strong>@Localizer["SiteTheme_RetroArcade"]</strong>
            </label>
            <label class="theme-option theme-option-custom">
                <input asp-for="Input.SiteThemeId" type="radio" value="custom" data-custom-theme-radio />
                <span class="theme-swatch" aria-hidden="true"><i></i><i></i><i></i></span>
                <strong>@Localizer["SiteTheme_Custom"]</strong>
            </label>
        </div>
        <div class="custom-theme-colors" data-custom-theme-colors>
            <label><span>@Localizer["SiteTheme_Background"]</span><input asp-for="Input.CustomThemeColors.Background" type="color" data-theme-variable="--bg" /></label>
            <label><span>@Localizer["SiteTheme_Panel"]</span><input asp-for="Input.CustomThemeColors.Panel" type="color" data-theme-variable="--panel" /></label>
            <label><span>@Localizer["SiteTheme_PanelSecondary"]</span><input asp-for="Input.CustomThemeColors.PanelSecondary" type="color" data-theme-variable="--panel-2" /></label>
            <label><span>@Localizer["SiteTheme_Text"]</span><input asp-for="Input.CustomThemeColors.Text" type="color" data-theme-variable="--text" /></label>
            <label><span>@Localizer["SiteTheme_MutedText"]</span><input asp-for="Input.CustomThemeColors.MutedText" type="color" data-theme-variable="--muted" /></label>
            <label><span>@Localizer["SiteTheme_Accent"]</span><input asp-for="Input.CustomThemeColors.Accent" type="color" data-theme-variable="--red" /></label>
            <label><span>@Localizer["SiteTheme_AccentBright"]</span><input asp-for="Input.CustomThemeColors.AccentBright" type="color" data-theme-variable="--red-bright" /></label>
            <label><span>@Localizer["SiteTheme_Highlight"]</span><input asp-for="Input.CustomThemeColors.Highlight" type="color" data-theme-variable="--gold" /></label>
        </div>
        </div>
    </details>
    <label class="brand-logo-field">
        <span>@Localizer["BrandLogo_Label"]</span>
        <span class="brand-logo-input-row">
            <input asp-for="BrandLogo" type="file" accept="image/*" data-brand-logo-input />
            <img class="brand-logo-preview"
                 data-brand-logo-preview
                 src="@(Model.HasBrandLogo ? Url.Page("/Admin/Settings/Index", "BrandLogo") : null)"
                 alt="@Localizer["BrandLogo_PreviewAlt"]"
                 hidden="@(Model.HasBrandLogo ? null : "hidden")" />
        </span>
        <small>@Localizer["BrandLogo_Hint"]</small>
    </label>
    @if (Model.HasBrandLogo)
    {
        <label class="settings-checkbox">
            <input asp-for="RemoveBrandLogo" type="checkbox" />
            <span>@Localizer["BrandLogo_Remove"]</span>
        </label>
    }
    <label>
        <span>@Localizer["GameSettings_BuzzerDuration"]</span>
        <input asp-for="Input.BuzzerDurationSeconds" type="number" min="1" max="3600" required />
        <small>@Localizer["GameSettings_SecondsHint"]</small>
    </label>
    <label>
        <span>@Localizer["GameSettings_AnswerDuration"]</span>
        <input asp-for="Input.AnswerDurationSeconds" type="number" min="1" max="3600" required />
        <small>@Localizer["GameSettings_SecondsHint"]</small>
    </label>
    <label>
        <span>@Localizer["GameSettings_RegularStartMode"]</span>
        <select asp-for="Input.RegularQuestionBuzzerStartMode">
            <option value="1">@Localizer["GameSettings_Automatic"]</option>
            <option value="2">@Localizer["GameSettings_Manual"]</option>
        </select>
    </label>
    <label>
        <span>@Localizer["GameSettings_WagerStartMode"]</span>
        <select asp-for="Input.WagerQuestionAnswerTimerStartMode">
            <option value="1">@Localizer["GameSettings_Automatic"]</option>
            <option value="2">@Localizer["GameSettings_Manual"]</option>
        </select>
    </label>
    <label class="settings-checkbox">
        <input asp-for="Input.AllowNegativeScoreFinalPlayers" type="checkbox" />
        <span>@Localizer["GameSettings_AllowNegativeFinalPlayers"]</span>
    </label>
    <label>
        <span>@Localizer["HostCard_Name"]</span>
        <input asp-for="Input.HostName" maxlength="80" />
    </label>
    <label>
        <span>@Localizer["HostCard_Source"]</span>
        <select asp-for="Input.HostVisualSource">
            <option value="0">@Localizer["HostCard_SourceNone"]</option>
            <option value="1">@Localizer["HostCard_SourceImage"]</option>
            <option value="2">@Localizer["HostCard_SourceWebcam"]</option>
            <option value="3">@Localizer["HostCard_SourceAvatar"]</option>
        </select>
    </label>
    <label class="host-avatar-field">
        <span>@Localizer["HostCard_Avatar"]</span>
        <span class="host-avatar-input-row">
            <input asp-for="Input.HostAvatarId" type="hidden" data-host-avatar-id />
            <button class="button button-secondary" type="button" data-open-avatar-picker>@Localizer["AvatarPicker_Choose"]</button>
            <img class="host-avatar-preview"
                 data-host-avatar-preview
                 src="@(!string.IsNullOrWhiteSpace(Model.Input.HostAvatarId) ? $"/avatars/{Model.Input.HostAvatarId}" : null)"
                 alt=""
                 hidden="@(string.IsNullOrWhiteSpace(Model.Input.HostAvatarId) ? "hidden" : null)" />
        </span>
    </label>
    <label class="host-image-field">
        <span>@Localizer["HostCard_Image"]</span>
        <span class="host-image-input-row">
            <input asp-for="HostImage" type="file" accept="image/*" data-host-image-input />
            <img class="host-image-preview"
                 data-host-image-preview
                 src="@(Model.HasHostImage ? Url.Page("/Admin/Settings/Index", "HostImage") : null)"
                 alt=""
                 hidden="@(Model.HasHostImage ? null : "hidden")" />
        </span>
    </label>
</div>
    <div class="form-actions">
        <button class="button button-primary" type="submit">@Localizer["Button_Save"]</button>
    </div>
</form>
<partial name="_AvatarPicker" />

@section Scripts {
    <script>
        (() => {
            const themeInputs = document.querySelectorAll('input[name="Input.SiteThemeId"]');
            const colorInputs = document.querySelectorAll("[data-theme-variable]");
            const customRadio = document.querySelector("[data-custom-theme-radio]");

            const applyCustomTheme = () => {
                document.documentElement.dataset.theme = "custom";
                colorInputs.forEach(input =>
                    document.documentElement.style.setProperty(
                        input.dataset.themeVariable,
                        input.value));
            };

            themeInputs.forEach(input => {
            input.addEventListener("change", () => {
                if (input.checked) {
                    document.documentElement.dataset.theme = input.value;
                    document.documentElement.removeAttribute("style");
                    if (input.value === "custom") {
                        applyCustomTheme();
                    }
                }
            });
            });

            colorInputs.forEach(input => {
                input.addEventListener("input", () => {
                    customRadio.checked = true;
                    applyCustomTheme();
                });
            });
        })();
    </script>
    <script>
        (() => {
            const input = document.querySelector("[data-brand-logo-input]");
            const preview = document.querySelector("[data-brand-logo-preview]");
            let previewUrl;

            input?.addEventListener("change", () => {
                const file = input.files?.[0];
                if (!file || !preview) {
                    return;
                }

                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                }

                previewUrl = URL.createObjectURL(file);
                preview.src = previewUrl;
                preview.hidden = false;
            });
        })();
    </script>
    <script>
        (() => {
            const input = document.querySelector("[data-host-image-input]");
            const preview = document.querySelector("[data-host-image-preview]");
            let previewUrl;

            input?.addEventListener("change", () => {
                const file = input.files?.[0];
                if (!file || !preview) {
                    return;
                }

                if (previewUrl) {
                    URL.revokeObjectURL(previewUrl);
                }

                previewUrl = URL.createObjectURL(file);
                preview.src = previewUrl;
                preview.hidden = false;
            });
        })();

        (() => {
            const dialog = document.querySelector("[data-avatar-picker]");
            const value = document.querySelector("[data-host-avatar-id]");
            const preview = document.querySelector("[data-host-avatar-preview]");
            const source = document.getElementById("Input_HostVisualSource");
            dialog?.addEventListener("avatarselected", event => {
                value.value = event.detail.avatarId;
                preview.src = event.detail.avatarUrl;
                preview.hidden = false;
                source.value = "3";
            });
        })();
    </script>
    <script src="~/js/avatar-picker.js" asp-append-version="true"></script>
}
