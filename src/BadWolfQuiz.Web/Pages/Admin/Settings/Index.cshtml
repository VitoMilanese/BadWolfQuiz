@page
@model BadWolfQuiz.Web.Pages.Admin.Settings.IndexModel
@{
    ViewData["Title"] = Localizer["GameSettings_Title"];
}

<div class="page-heading">
    <div>
        <p class="eyebrow">@Localizer["GameSettings_Eyebrow"]</p>
        <h1>@Localizer["GameSettings_Title"]</h1>
    </div>
</div>

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div class="message message-success" role="status">@successMessage</div>
}

<form method="post" class="form-card narrow stack-form">
    <p class="settings-description">@Localizer["GameSettings_GlobalDescription"]</p>
    <div asp-validation-summary="ModelOnly" class="message message-error"></div>
    <div class="settings-grid">
    <label>
        <span>@Localizer["GameSettings_BuzzerDuration"]</span>
        <input asp-for="Input.BuzzerDurationSeconds" type="number" min="1" max="3600" required />
        <small>@Localizer["GameSettings_SecondsHint"]</small>
    </label>
    <label>
        <span>@Localizer["GameSettings_AnswerDuration"]</span>
        <input asp-for="Input.AnswerDurationSeconds" type="number" min="1" max="3600" required />
        <small>@Localizer["GameSettings_SecondsHint"]</small>
    </label>
    <label>
        <span>@Localizer["GameSettings_RegularStartMode"]</span>
        <select asp-for="Input.RegularQuestionBuzzerStartMode"
                asp-items="Html.GetEnumSelectList<BadWolfQuiz.Game.Runtime.GamePhaseStartMode>()"></select>
    </label>
    <label>
        <span>@Localizer["GameSettings_WagerStartMode"]</span>
        <select asp-for="Input.WagerQuestionAnswerTimerStartMode"
                asp-items="Html.GetEnumSelectList<BadWolfQuiz.Game.Runtime.GamePhaseStartMode>()"></select>
    </label>
</div>
    <div class="form-actions">
        <button class="button button-primary" type="submit">@Localizer["Button_Save"]</button>
    </div>
</form>
