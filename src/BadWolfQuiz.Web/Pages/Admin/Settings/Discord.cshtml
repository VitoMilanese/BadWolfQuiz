@page
@model BadWolfQuiz.Web.Pages.Admin.Settings.DiscordModel
@{
    ViewData["Title"] = Localizer["Discord_SettingsTitle"];
    var stateClass = !Model.IsEnabled
        ? "is-disabled"
        : Model.Connection is null
            ? "is-disconnected"
            : Model.Health.IsReady
                ? "is-ready"
                : "is-warning";
    var stateLabel = !Model.IsEnabled
        ? Localizer["Discord_Unavailable"]
        : Model.Connection is null
            ? Localizer["Discord_Connect"]
            : Model.Health.IsReady
                ? Localizer["Discord_Ready"]
                : Localizer["Discord_NeedsAttention"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/discord-settings.css" asp-append-version="true" />
}

<div class="discord-settings discord-settings-page @(Model.Embedded ? "is-embedded" : null)"
     data-discord-settings>
    @if (!Model.Embedded)
    {
        <section class="discord-settings-hero" aria-labelledby="discord-settings-title">
            <div class="discord-settings-hero-copy">
                <p class="discord-settings-eyebrow" aria-hidden="true">BAD WOLF / VOICE CONTROL</p>
                <h1 id="discord-settings-title">@Localizer["Discord_SettingsTitle"]</h1>
                <div class="discord-settings-state-chip @stateClass">
                    <span aria-hidden="true"></span>
                    <strong>@stateLabel</strong>
                </div>
            </div>

            <div class="discord-settings-hero-mark" aria-hidden="true">
                <span>VOICE LINK</span>
                <strong>DC</strong>
                <i></i>
                <b>CONTROL</b>
                <small>LIVE MODERATION</small>
            </div>
        </section>
    }

    <main class="discord-settings-shell">
        @if (TempData["DiscordSuccess"] is string success)
        {
            <div class="message message-success discord-settings-message"
                 id="discordSettingsSuccess"
                 role="status"
                 data-auto-dismiss>
                @success
            </div>
        }
        @if (TempData["DiscordError"] is string error)
        {
            <div class="message message-error discord-settings-message" role="alert">@error</div>
        }

        @if (!Model.IsEnabled)
        {
            <section class="discord-settings-state-card is-disabled">
                <div class="discord-settings-state-index" aria-hidden="true">00</div>
                <div>
                    <span class="discord-settings-card-kicker" aria-hidden="true">VOICE LINK / OFFLINE</span>
                    <h2>@Localizer["Discord_SettingsTitle"]</h2>
                    <p>@Localizer["Discord_NotEnabled"]</p>
                </div>
            </section>
        }
        else if (Model.Connection is null)
        {
            <section class="discord-settings-state-card is-disconnected">
                <div class="discord-settings-state-index" aria-hidden="true">01</div>
                <div class="discord-settings-state-copy">
                    <span class="discord-settings-card-kicker" aria-hidden="true">VOICE LINK / CONNECT</span>
                    <h2>@Localizer["Discord_Connect"]</h2>
                    <p>@Localizer["Discord_ConnectDescription"]</p>
                    <form method="post" asp-page-handler="Connect">
                        <input asp-for="Embedded" type="hidden" />
                        <button class="button button-primary" type="submit" formtarget="_blank">
                            @Localizer["Discord_Connect"]
                        </button>
                    </form>
                </div>
                <div class="discord-settings-link-visual" aria-hidden="true">
                    <span></span>
                    <i></i>
                    <span></span>
                </div>
            </section>
        }
        else
        {
            <section class="discord-settings-overview @stateClass">
                <header class="discord-settings-section-header">
                    <div>
                        <span class="discord-settings-card-kicker" aria-hidden="true">VOICE LINK / STATUS</span>
                        <h2>@Localizer["Discord_Account"]</h2>
                    </div>
                    <div class="discord-settings-state-chip @stateClass">
                        <span aria-hidden="true"></span>
                        <strong>@stateLabel</strong>
                    </div>
                </header>

                <dl class="discord-settings-summary">
                    <div class="discord-settings-summary-item is-account">
                        <dt>@Localizer["Discord_Account"]</dt>
                        <dd>@Model.Connection.DiscordUserName</dd>
                    </div>
                    <div class="discord-settings-summary-item">
                        <dt>@Localizer["Discord_Server"]</dt>
                        <dd>@(Model.Connection.GuildName ?? "—")</dd>
                    </div>
                    <div class="discord-settings-summary-item">
                        <dt>@Localizer["Discord_VoiceChannel"]</dt>
                        <dd>@(Model.Connection.VoiceChannelName ?? "—")</dd>
                    </div>
                    <div class="discord-settings-summary-item">
                        <dt>@Localizer["Discord_Status"]</dt>
                        <dd class="@(Model.Health.IsReady ? "discord-health-ok" : "discord-health-error")">
                            @(Model.Health.IsReady ? Localizer["Discord_Ready"] : Localizer["Discord_NeedsAttention"])
                        </dd>
                    </div>
                    <div class="discord-settings-summary-item">
                        <dt>@Localizer["Discord_BotStatus"]</dt>
                        <dd class="@(Model.Health.BotOnline ? "discord-health-ok" : "discord-health-error")">
                            @(Model.Health.BotOnline ? Localizer["Discord_Available"] : Localizer["Discord_Unavailable"])
                        </dd>
                    </div>
                    <div class="discord-settings-summary-item">
                        <dt>@Localizer["Discord_MutePermission"]</dt>
                        <dd class="@(Model.Health.HasMutePermission ? "discord-health-ok" : "discord-health-error")">
                            @(Model.Health.HasMutePermission ? Localizer["Discord_Available"] : Localizer["Discord_Unavailable"])
                        </dd>
                    </div>
                </dl>
            </section>

            <div class="discord-settings-workspace">
                <section class="discord-settings-card discord-settings-channel-card">
                    <header class="discord-settings-card-header">
                        <span class="discord-settings-card-number" aria-hidden="true">01</span>
                        <div>
                            <span class="discord-settings-card-kicker" aria-hidden="true">ROUTING</span>
                            <h2>@Localizer["Discord_VoiceChannel"]</h2>
                        </div>
                    </header>

                    @if (Model.Guilds.Count == 0)
                    {
                        <div class="discord-settings-reauthorize">
                            <p>@Localizer["Discord_ReauthorizeHint"]</p>
                            <div class="discord-settings-button-row">
                                <form method="post" asp-page-handler="Connect">
                                    <input asp-for="Embedded" type="hidden" />
                                    <button class="button button-secondary" type="submit" formtarget="_blank">
                                        @Localizer["Discord_Reauthorize"]
                                    </button>
                                </form>
                                <a class="button button-secondary"
                                   href="@Model.BotInstallUrl"
                                   target="_blank"
                                   rel="noopener">
                                    @Localizer["Discord_InstallBot"]
                                </a>
                            </div>
                        </div>
                    }
                    else
                    {
                        <form method="post"
                              asp-page-handler="Save"
                              class="discord-settings-selection-form">
                            <input asp-for="Embedded" type="hidden" />

                            <label class="discord-settings-field">
                                <span>@Localizer["Discord_Server"]</span>
                                <select asp-for="GuildId" data-discord-guild required>
                                    <option value="">@Localizer["Discord_SelectServer"]</option>
                                    @foreach (var guild in Model.Guilds)
                                    {
                                        <option value="@guild.Id">@guild.Name</option>
                                    }
                                </select>
                            </label>

                            <label class="discord-settings-field">
                                <span>@Localizer["Discord_VoiceChannel"]</span>
                                <select asp-for="VoiceChannelId" data-discord-channel required>
                                    <option value="">@Localizer["Discord_SelectChannel"]</option>
                                    @foreach (var channel in Model.Channels)
                                    {
                                        <option value="@channel.Id">@channel.Name</option>
                                    }
                                </select>
                            </label>

                            <div class="discord-settings-form-actions">
                                <button class="button button-primary" type="submit">
                                    @Localizer["Button_Save"]
                                </button>
                            </div>
                        </form>
                    }
                </section>

                <section class="discord-settings-card discord-settings-automation-card">
                    <header class="discord-settings-card-header">
                        <span class="discord-settings-card-number" aria-hidden="true">02</span>
                        <div>
                            <span class="discord-settings-card-kicker" aria-hidden="true">AUTOMATION</span>
                            <h2>@Localizer["Discord_AutoMute"]</h2>
                        </div>
                    </header>

                    <form method="post"
                          asp-page-handler="SaveAutomaticMute"
                          id="discord-auto-mute-form"
                          class="discord-auto-mute-form discord-settings-toggle-form"
                          data-discord-auto-mute-form>
                        <input asp-for="Embedded" type="hidden" />
                        <label class="discord-settings-toggle">
                            <input asp-for="AutoMuteDuringMedia" type="checkbox" />
                            <span class="discord-settings-toggle-control" aria-hidden="true"></span>
                            <span class="discord-settings-toggle-copy">
                                <strong>@Localizer["Discord_AutoMute"]</strong>
                                <small>@Localizer["Discord_AutoMuteHint"]</small>
                            </span>
                        </label>
                    </form>

                    <div class="discord-settings-form-actions">
                        <button class="button button-primary"
                                type="submit"
                                form="discord-auto-mute-form">
                            @Localizer["Button_Save"]
                        </button>
                        <span class="form-status discord-settings-inline-status"
                              role="status"
                              data-discord-status></span>
                    </div>
                </section>
            </div>

            <section class="discord-settings-card discord-settings-control-card">
                <header class="discord-settings-card-header">
                    <span class="discord-settings-card-number" aria-hidden="true">03</span>
                    <div>
                        <span class="discord-settings-card-kicker" aria-hidden="true">DIAGNOSTICS / CONTROL</span>
                        <h2>@Localizer["Discord_Status"]</h2>
                    </div>
                </header>

                <div class="discord-settings-control-actions">
                    @if (Model.Health.IsReady)
                    {
                        <button class="button button-secondary" type="button" data-discord-test>
                            @Localizer["Discord_Test"]
                        </button>
                    }
                    <form method="post" asp-page-handler="Disconnect">
                        <input asp-for="Embedded" type="hidden" />
                        <button class="button button-danger" type="submit">
                            @Localizer["Discord_Disconnect"]
                        </button>
                    </form>
                </div>
            </section>
        }
    </main>
</div>

@section Scripts {
    <script>
        (() => {
            const root = document.querySelector("[data-discord-settings]");
            const guild = root?.querySelector("[data-discord-guild]");
            const channel = root?.querySelector("[data-discord-channel]");
            const status = root?.querySelector("[data-discord-status]");
            const token = root?.querySelector('input[name="__RequestVerificationToken"]')?.value;
            const selectChannelLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Localizer["Discord_SelectChannel"].Value));
            const testRunningLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Localizer["Discord_TestRunning"].Value));
            const testCompleteLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Localizer["Discord_TestComplete"].Value));
            const testFailedLabel = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
                Localizer["Discord_TestFailed"].Value));

            root?.querySelector("[data-discord-auto-mute-form]")
                ?.addEventListener("submit", async event => {
                    event.preventDefault();
                    const form = event.currentTarget;
                    const checkbox = form.querySelector('[name="AutoMuteDuringMedia"]');
                    const button = root.querySelector('button[type="submit"][form="discord-auto-mute-form"]');
                    const requested = checkbox.checked;
                    button.disabled = true;
                    try {
                        const response = await fetch("?handler=SaveAutomaticMute&ajax=true", {
                            method: "POST",
                            body: new FormData(form)
                        });
                        const result = await response.json();
                        if (!response.ok) {
                            throw new Error(result.error);
                        }
                        status.textContent = result.message;
                        window.parent.postMessage({
                            type: "badwolfquiz:discord-auto-mute-changed",
                            enabled: result.autoMuteDuringMedia
                        }, window.location.origin);
                    } catch (error) {
                        checkbox.checked = !requested;
                        status.textContent = error.message;
                    } finally {
                        button.disabled = false;
                    }
                });

            guild?.addEventListener("change", async () => {
                channel.disabled = true;
                try {
                    const response = await fetch(`?handler=Channels&guildId=${encodeURIComponent(guild.value)}`);
                    const channels = await response.json();
                    channel.replaceChildren(new Option(selectChannelLabel, ""));
                    channels.forEach(item => channel.add(new Option(item.name, item.id)));
                } finally {
                    channel.disabled = false;
                }
            });

            root?.querySelector("[data-discord-test]")?.addEventListener("click", async event => {
                const button = event.currentTarget;
                button.disabled = true;
                status.textContent = testRunningLabel;
                try {
                    const response = await fetch("?handler=Test", {
                        method: "POST",
                        headers: { "RequestVerificationToken": token }
                    });
                    const result = await response.json();
                    status.textContent = response.ok
                        ? `${testCompleteLabel} (${result.succeededCount}/${result.targetCount})`
                        : (result.error ?? testFailedLabel);
                } finally {
                    button.disabled = false;
                }
            });
        })();
    </script>
}
