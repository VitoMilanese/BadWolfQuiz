@page "/Admin/WordRingsEditor"
@attribute [Microsoft.AspNetCore.Authorization.Authorize]
@inject IStringLocalizer<WordRingsResource> WordRingsLocalizer
@{
    ViewData["Title"] = WordRingsLocalizer["EditorTitle"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/minigame-editor.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/word-rings-editor.css" asp-append-version="true" />
}

<div class="page-heading minigame-editor-heading word-rings-editor-heading">
    <div>
        <p class="eyebrow">BAD WOLF / MINIGAME EDITOR</p>
        <h1>@WordRingsLocalizer["EditorTitle"]</h1>
        <p class="muted">@WordRingsLocalizer["EditorPlaceholder"]</p>
    </div>

    <div class="word-rings-editor-mark" aria-hidden="true">
        <span class="word-rings-editor-ring word-rings-editor-ring-a"></span>
        <span class="word-rings-editor-ring word-rings-editor-ring-b"></span>
        <span class="word-rings-editor-ring word-rings-editor-ring-c"></span>
        <span class="word-rings-editor-mark-caption">WORD / RINGS</span>
    </div>
</div>

<section class="content-panel word-rings-editor-coming-soon">
    <div>
        <span class="word-rings-editor-panel-kicker">EDITOR / NEXT STEP</span>
        <h2>@WordRingsLocalizer["EditorTitle"]</h2>
        <p>@WordRingsLocalizer["EditorPlaceholder"]</p>
    </div>

    <div class="word-rings-editor-mini-venn" aria-hidden="true">
        <span></span>
        <span></span>
        <span></span>
    </div>
</section>
