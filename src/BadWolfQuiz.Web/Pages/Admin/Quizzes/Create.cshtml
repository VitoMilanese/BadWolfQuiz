@page
@model BadWolfQuiz.Web.Pages.Admin.Quizzes.CreateModel
@{
    ViewData["Title"] = Localizer["Title_NewQuiz"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/quiz-create.css" asp-append-version="true" />
}

<div class="quiz-create-page">
    <section class="quiz-create-hero" aria-labelledby="quiz-create-title">
        <div class="quiz-create-hero-copy">
            <p class="quiz-create-kicker">
                <span>@Localizer["CreateQuiz_Eyebrow"]</span>
                <span aria-hidden="true">/ QUIZ BUILDER</span>
            </p>
            <h1 id="quiz-create-title">@Localizer["Title_CreateQuiz"]</h1>
        </div>

        <div class="quiz-create-hero-art" aria-hidden="true">
            <span class="quiz-create-hero-word">BUILD</span>
            <span class="quiz-create-hero-slash"></span>
            <strong>01</strong>
            <small>NEW QUIZ</small>
        </div>
    </section>

    <main class="quiz-create-content">
        <form method="post" class="quiz-create-card">
            <aside class="quiz-create-card-rail" aria-hidden="true">
                <span>BAD WOLF / BUILDER</span>
                <strong>01</strong>
                <div>
                    <b>QUIZ</b>
                    <small>PROFILE</small>
                </div>
            </aside>

            <div class="quiz-create-form-panel">
                <header class="quiz-create-form-heading">
                    <div>
                        <span aria-hidden="true">01 / CORE DETAILS</span>
                        <h2>@Localizer["Title_CreateQuiz"]</h2>
                    </div>
                    <strong aria-hidden="true">CREATE / EDIT NEXT</strong>
                </header>

                <div class="quiz-create-fields">
                    <div class="quiz-create-field">
                        <label asp-for="Input.Title">@Localizer["Label_QuizName"]</label>
                        <input asp-for="Input.Title" autofocus />
                        <span asp-validation-for="Input.Title" class="quiz-create-validation"></span>
                    </div>

                    <div class="quiz-create-field quiz-create-field-description">
                        <label asp-for="Input.Description">@Localizer["Label_Description"]</label>
                        <textarea asp-for="Input.Description" rows="5"></textarea>
                    </div>
                </div>

                <div class="quiz-create-actions">
                    <a class="button button-secondary" asp-page="Index">@Localizer["Button_Cancel"]</a>
                    <button class="button button-primary quiz-create-submit" type="submit">
                        <span>@Localizer["Button_Create"]</span>
                        <span aria-hidden="true">→</span>
                    </button>
                </div>
            </div>
        </form>
    </main>
</div>
