@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> localizer

<div id="question-preview-modal"
     class="question-preview-modal"
     hidden
     aria-hidden="true">

    <div class="question-preview-dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="question-preview-title">

        <button type="button"
                class="question-preview-close-button"
                aria-label="@localizer["Button_Cancel"]">
            ×
        </button>

        <div class="question-preview-screen">
            <div id="question-preview-title"
                 class="question-preview-title">
            </div>

            <div id="question-preview-content"
                 class="question-preview-content">
            </div>
        </div>
    </div>
</div>

<style>
    body.question-preview-open {
        overflow: hidden;
    }

    .question-preview-modal {
        position: fixed;
        inset: 0;
        z-index: 1000;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 24px;
        background: rgba(0, 0, 0, 0.84);
        backdrop-filter: blur(8px);
    }

    .question-preview-modal[hidden] {
        display: none;
    }

    .question-preview-dialog {
        position: relative;
        width: min(1180px, 100%);
        max-height: calc(100vh - 48px);
        overflow: auto;
        border: 1px solid var(--line);
        border-radius: 18px;
        background:
            radial-gradient(
                circle at top right,
                color-mix(in srgb, var(--red) 24%, var(--panel-2)) 0,
                var(--panel-gradient-end) 34rem);
        box-shadow:
            0 28px 90px rgba(0, 0, 0, 0.65);
    }

    .question-preview-close-button {
        position: sticky;
        top: 14px;
        z-index: 5;
        float: right;
        width: 44px;
        height: 44px;
        margin: 14px 14px 0 0;
        padding: 0;
        border: 1px solid var(--line);
        border-radius: 50%;
        background: var(--panel-glass);
        color: var(--text);
        font-size: 30px;
        line-height: 1;
        cursor: pointer;
    }

    .question-preview-close-button:hover {
        border-color: var(--red-bright);
        color: var(--red-bright);
    }

    .question-preview-screen {
        min-height: min(720px, calc(100vh - 50px));
        padding: clamp(30px, 5vw, 70px);
        clear: both;
        display: flex;
        flex-direction: column;
        justify-content: center;
    }

    .question-preview-title {
        margin-bottom: clamp(24px, 4vw, 48px);
        color: var(--red-bright);
        font-size: clamp(0.8rem, 1.5vw, 1rem);
        font-weight: 900;
        letter-spacing: 0.2em;
        text-align: center;
        text-transform: uppercase;
    }

    .question-preview-content {
        width: 100%;
        display: grid;
        gap: clamp(22px, 4vw, 42px);
        justify-items: center;
    }

    .question-preview-text {
        width: min(980px, 100%);
        color: var(--text);
        font-size: clamp(1.8rem, 4.2vw, 4.6rem);
        font-weight: 850;
        line-height: 1.16;
        text-align: center;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .question-preview-media {
        width: min(980px, 100%);
        margin: 0;
        display: grid;
        gap: 16px;
        justify-items: center;
    }

    .question-preview-caption {
        width: 100%;
        color: var(--text);
        font-size: clamp(1.15rem, 2.2vw, 2rem);
        font-weight: 750;
        line-height: 1.3;
        text-align: center;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .question-preview-image,
    .question-preview-video {
        display: block;
        width: auto;
        max-width: 100%;
        height: auto;
        max-height: min(62vh, 680px);
        border-radius: 12px;
        object-fit: contain;
    }

    .question-preview-video {
        width: 100%;
    }

    .question-preview-video-frame {
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: 12px;
        background: #000;
    }

    .question-preview-video-frame iframe {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
    }

    .question-preview-audio {
        width: min(820px, 100%);
    }

    .question-preview-audio-player {
        display: block;
        width: 100%;
    }

    .question-preview-empty {
        color: var(--muted);
        font-size: clamp(2rem, 5vw, 5rem);
    }

    @@media (max-width: 700px) {
        .question-preview-modal {
            padding: 0;
        }

        .question-preview-dialog {
            width: 100%;
            max-height: 100vh;
            min-height: 100vh;
            border: 0;
            border-radius: 0;
        }

        .question-preview-screen {
            min-height: 100vh;
            padding: 70px 20px 32px;
        }
    }
</style>
