@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> localizer

<link rel="stylesheet" href="~/css/youtube-placeholder.css" asp-append-version="true" />

<div id="question-preview-modal"
     class="question-preview-modal"
     hidden
     aria-hidden="true">

    <div class="question-preview-dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="question-preview-title">

        <button type="button"
                class="question-preview-close-button"
                aria-label="@localizer["Button_Cancel"]">
            ×
        </button>

        <div class="question-preview-screen">
            <div id="question-preview-title"
                 class="question-preview-title">
            </div>

            <div id="question-preview-content"
                 class="question-preview-content game-content-blocks">
            </div>
        </div>
    </div>
</div>

<style>
    body.question-preview-open {
        overflow: hidden;
    }

    .question-preview-modal {
        position: fixed;
        inset: var(--topbar-height) 0 0;
        z-index: 1000;
        display: flex;
        align-items: stretch;
        padding: 0;
        background: rgba(0, 0, 0, 0.84);
        backdrop-filter: blur(8px);
    }

    .question-preview-modal[hidden] {
        display: none;
    }

    .question-preview-dialog {
        position: relative;
        width: 100%;
        height: calc(100dvh - var(--topbar-height));
        max-height: none;
        overflow: hidden;
        border: 0;
        background:
            radial-gradient(
                circle at top right,
                color-mix(in srgb, var(--red) 24%, var(--panel-2)) 0,
                var(--panel-gradient-end) 34rem);
        box-shadow:
            0 28px 90px rgba(0, 0, 0, 0.65);
    }

    .question-preview-close-button {
        position: absolute;
        top: 14px;
        right: 14px;
        z-index: 5;
        width: 44px;
        height: 44px;
        margin: 0;
        padding: 0;
        border: 1px solid var(--line);
        border-radius: 50%;
        background: var(--panel-glass);
        color: var(--text);
        font-size: 30px;
        line-height: 1;
        cursor: pointer;
    }

    .question-preview-close-button:hover {
        border-color: var(--red-bright);
        color: var(--red-bright);
    }

    .question-preview-screen {
        width: 100%;
        height: 100%;
        min-height: 0;
        padding: clamp(18px, 3vw, 40px) clamp(24px, 4vw, 56px);
        display: grid;
        grid-template-rows: auto minmax(0, 1fr);
        align-content: stretch;
        overflow: hidden;
    }

    .question-preview-title {
        margin-bottom: 8px;
        color: var(--red-bright);
        font-size: clamp(0.8rem, 1.5vw, 1rem);
        font-weight: 900;
        letter-spacing: 0.2em;
        text-align: center;
        text-transform: uppercase;
    }

    .question-preview-content {
        width: 100%;
        min-height: 0;
        align-self: stretch;
        align-content: safe center;
        display: grid;
        gap: clamp(22px, 4vw, 42px);
        justify-items: center;
        overflow: auto;
        overscroll-behavior: contain;
        padding: 12px 8px;
    }

    .question-preview-text {
        width: 100%;
        max-width: none;
        color: var(--text);
        font-size: clamp(1.8rem, 4.2vw, 4.6rem);
        font-weight: 850;
        line-height: 1.16;
        text-align: center;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .question-preview-media {
        width: 100%;
        max-width: none;
        margin: 0;
        display: grid;
        gap: 16px;
        justify-items: center;
    }

    .question-preview-caption {
        width: 100%;
        color: var(--text);
        font-size: clamp(1.15rem, 2.2vw, 2rem);
        font-weight: 750;
        line-height: 1.3;
        text-align: center;
        white-space: pre-wrap;
        overflow-wrap: anywhere;
    }

    .question-preview-image,
    .question-preview-video {
        display: block;
        width: auto;
        max-width: 100%;
        height: auto;
        max-height: min(62vh, 680px);
        border-radius: 12px;
        object-fit: contain;
    }

    .question-preview-video {
        width: 100%;
    }

    .question-preview-video-frame {
        width: 100%;
        aspect-ratio: 16 / 9;
        overflow: hidden;
        border-radius: 12px;
        background: #000;
    }

    .question-preview-video-frame iframe {
        display: block;
        width: 100%;
        height: 100%;
        border: 0;
    }

    .question-preview-audio {
        width: min(820px, 100%);
    }

    .question-preview-audio-player {
        display: block;
        width: 100%;
    }

    .question-preview-empty {
        color: var(--muted);
        font-size: clamp(2rem, 5vw, 5rem);
    }

    .question-preview-content.four-clue-grid {
        display: flex;
        justify-items: initial;
        gap: var(--four-clue-gap);
    }

    .question-preview-content.four-clue-grid .question-preview-text {
        width: auto;
        max-width: none;
        font-size: clamp(1rem, 2.2vw, 2.25rem);
    }

    .question-preview-content.four-clue-grid .question-preview-image {
        width: 100%;
        height: 100%;
        max-height: 24vh;
    }

    .question-preview-content.all-player-answer-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        grid-auto-rows: minmax(4.5rem, auto);
        align-items: stretch;
        justify-items: stretch;
        align-content: center;
        gap: clamp(0.5rem, 1vw, 0.85rem);
        overflow: hidden;
    }

    .question-preview-content.all-player-answer-grid
        .all-player-answer-option {
        width: 100%;
        min-width: 0;
        min-height: clamp(4.5rem, 13vh, 8rem);
        margin: 0;
        padding: clamp(0.45rem, 0.8vw, 0.75rem);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 0.5rem;
        overflow: hidden;
        border: 3px solid #c62828;
        border-radius: 0.8rem;
        text-align: center;
    }

    .question-preview-content.all-player-answer-grid
        .all-player-answer-option-correct {
        border-color: #2e7d32;
    }

    .question-preview-content.all-player-answer-grid
        .all-player-answer-option-incorrect {
        border-color: #c62828;
    }

    .question-preview-content.all-player-answer-grid
        .all-player-answer-option.question-preview-text {
        max-width: none;
        font-size: clamp(1.5rem, 3vw, 3.25rem);
    }

    .question-preview-content.all-player-answer-grid
        .all-player-answer-option .question-preview-image {
        display: block;
        width: 100%;
        height: min(22vh, 12rem);
        min-height: 0;
        max-height: min(22vh, 12rem);
        object-fit: contain;
    }

    .question-preview-content.all-player-answer-grid
        .all-player-answer-option .question-preview-caption {
        margin: 0;
        font-size: clamp(0.9rem, 1.5vw, 1.2rem);
    }

    @@media (max-width: 700px) {
        .question-preview-modal {
            inset: var(--topbar-height) 0 0;
        }

        .question-preview-dialog {
            width: 100%;
            height: calc(100dvh - var(--topbar-height));
            max-height: none;
            min-height: 0;
            border: 0;
            border-radius: 0;
        }

        .question-preview-screen {
            min-height: 0;
            padding: 58px 20px 20px;
        }
    }
</style>
