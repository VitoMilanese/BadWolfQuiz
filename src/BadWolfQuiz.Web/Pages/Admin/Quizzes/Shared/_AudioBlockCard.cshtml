@using Microsoft.Extensions.Localization
@using BadWolfQuiz.Web.Services
@inject IStringLocalizer<SharedResource> localizer
@inject MediaUploadProcessor mediaUploadProcessor
@inject CurrentHost currentHost
@inject PremiumHostAccess premiumHostAccess
@model BadWolfQuiz.Web.Pages.Admin.Quizzes.ContentBlockInputModel

@{
    var hasStoredFile =
        Model.Id.HasValue &&
        !string.IsNullOrWhiteSpace(Model.FileName);

    string? audioUrl = null;

    if (hasStoredFile)
    {
        var handler = Model.StoredAudioHandler ??
            (Model.IsAnswerBlock ? "AnswerBlockAudio" : "QuestionBlockAudio");
        audioUrl = Url.Page(null, handler, new { id = Model.Id!.Value });
    }
}

<div class="audio-block-editor">

    <div class="stored-file-preview stored-audio-preview unified-file-preview"
         hidden="@(!hasStoredFile)"
         data-has-original="@hasStoredFile.ToString().ToLowerInvariant()"
         data-original-src="@audioUrl"
         data-original-name="@Model.FileName"
         data-original-label="@localizer["Message_StoredFile"]"
         data-pending-label="@localizer["Label_File"]">

        <audio controls
               preload="metadata"
               src="@audioUrl"
               class="stored-audio-preview-element unified-audio-preview-element">
            Your browser does not support audio playback.
        </audio>

        <div class="stored-file-info">
            <strong class="file-preview-label">
                @(hasStoredFile
                    ? localizer["Message_StoredFile"]
                    : localizer["Label_File"])
            </strong>

            <span class="file-preview-name">
                @(hasStoredFile ? Model.FileName : string.Empty)
            </span>
        </div>

        @if (hasStoredFile)
        {
            <button type="button"
                    class="button secondary-button remove-stored-file-button">
                @localizer["Button_RemoveFile"]
            </button>
        }
        else
        {
            <button type="button"
                    class="button secondary-button remove-stored-file-button"
                    hidden>
                @localizer["Button_RemoveFile"]
            </button>
        }

    </div>

    <button type="button"
            class="button secondary-button cancel-file-change-button"
            style="display: none !important;
                   width: fit-content;
                   align-self: flex-start;">
        @localizer["Button_Cancel"]
    </button>

    <input asp-for="RemoveFile"
           type="hidden"
           value="false"
           class="remove-file-value" />

    <div class="image-block-upload-row">
        <input asp-for="UploadedFile"
               class="form-control audio-block-file uploaded-file-input"
               type="file"
               accept="audio/*" />
        <button type="button"
                class="button secondary-button audio-clipboard-button"
                data-media-clipboard-button
                data-media-kind="audio"
                data-clipboard-empty="@localizer["AudioClipboard_Empty"]"
                data-clipboard-error="@localizer["AudioClipboard_Error"]">
            @localizer["AudioClipboard_Button"]
        </button>
    </div>
    <span class="field-validation-error image-clipboard-error"
          data-media-clipboard-error
          role="alert"
          hidden></span>
    <small>@localizer["FileUploadLimit", mediaUploadProcessor.MaximumAudioUploadMegabytes(
        premiumHostAccess.IsPremium(currentHost.RequiredId))]</small>

    <label class="checkbox-row content-block-autoplay-option">
        <input asp-for="Autoplay" type="checkbox" />
        <span>
            <strong>@localizer["Label_MediaAutoplay"]</strong>
            <small>@localizer["Hint_MediaAutoplay"]</small>
        </span>
    </label>

    <input asp-for="TopCaption"
           class="form-control"
           placeholder="@localizer["Label_TopCaption"]" />

    <input asp-for="BottomCaption"
           class="form-control"
           placeholder="@localizer["Label_BottomCaption"]" />

</div>
