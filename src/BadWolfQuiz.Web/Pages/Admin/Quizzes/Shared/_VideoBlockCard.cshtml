@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> localizer
@model BadWolfQuiz.Web.Pages.Admin.Quizzes.ContentBlockInputModel

<input asp-for="ExternalUrl"
       class="form-control"
       type="url"
       placeholder="Video URL" />

<input asp-for="TopCaption"
       class="form-control"
       style="margin-top: 10px;"
       placeholder="@localizer["Label_TopCaption"]" />

<input asp-for="BottomCaption"
       class="form-control"
       style="margin-top: 10px;"
       placeholder="@localizer["Label_BottomCaption"]" />
