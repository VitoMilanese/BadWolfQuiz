@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> localizer
@model BadWolfQuiz.Web.Pages.Admin.Quizzes.ContentBlockCollectionViewModel

<section id="@Model.CollectionId"
         class="content-panel content-block-section"
         data-block-collection="@Model.FieldPrefix">

    <div class="content-block-section-header">
        <h2>@Model.Title</h2>

        <div class="content-block-add-menu">
            <button type="button"
                    class="button secondary-button content-block-add-button">
                @localizer["ContentBlock_Add"]
            </button>

            <div class="content-block-type-menu" hidden>
                <button type="button"
                        class="content-block-type-option"
                        data-block-type="Text">
                    @localizer["ContentBlockType_Text"]
                </button>

                <button type="button"
                        class="content-block-type-option"
                        data-block-type="Image">
                    @localizer["ContentBlockType_Image"]
                </button>

                <button type="button"
                        class="content-block-type-option"
                        data-block-type="Audio">
                    @localizer["ContentBlockType_Audio"]
                </button>

                <button type="button"
                        class="content-block-type-option"
                        data-block-type="YouTube">
                    @localizer["ContentBlockType_YouTube"]
                </button>
            </div>
        </div>
    </div>

    <div class="content-block-list"
         data-content-block-list>
        @for (var i = 0; i < Model.Blocks.Count; i++)
        {
            var blockViewData =
            new Microsoft.AspNetCore.Mvc.ViewFeatures.ViewDataDictionary(ViewData);

            blockViewData.TemplateInfo.HtmlFieldPrefix =
            $"{Model.FieldPrefix}[{i}]";

            <partial name="Shared/_ContentBlockCard"
                     model="Model.Blocks[i]"
                     view-data="blockViewData" />
        }
    </div>
</section>
