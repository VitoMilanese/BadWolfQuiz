@page "{id:int}"
@model BadWolfQuiz.Web.Pages.Admin.Quizzes.FinalQuestionEditorModel
@{
    ViewData["Title"] = Localizer["Title_FinalQuestionEditor"];

    var descriptionBlockCollection =
        new BadWolfQuiz.Web.Pages.Admin.Quizzes.ContentBlockCollectionViewModel
        {
            CollectionId = "description-blocks",
            Title = Localizer["Label_Description"].Value,
            FieldPrefix = "Input.DescriptionBlocks",
            Blocks = Model.Input.DescriptionBlocks,
            AllowedBlockTypes = new[]
            {
                BadWolfQuiz.Web.Models.ContentBlockType.Text,
                BadWolfQuiz.Web.Models.ContentBlockType.Image
            }
        };

    var questionBlockCollection =
        new BadWolfQuiz.Web.Pages.Admin.Quizzes.ContentBlockCollectionViewModel
        {
            CollectionId = "question-blocks",
            Title = Localizer["Label_Question"].Value,
            FieldPrefix = "Input.QuestionBlocks",
            Blocks = Model.Input.QuestionBlocks
        };

    var answerBlockCollection =
        new BadWolfQuiz.Web.Pages.Admin.Quizzes.ContentBlockCollectionViewModel
        {
            CollectionId = "answer-blocks",
            Title = Localizer["Label_CorrectAnswer"].Value,
            FieldPrefix = "Input.AnswerBlocks",
            Blocks = Model.Input.AnswerBlocks
        };
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div id="success-message" class="alert alert-success" role="status">
        @successMessage
    </div>
}

<style>
    .question-tags-setting { display: grid; gap: .65rem; }
    .question-tag-list { display: flex; flex-wrap: wrap; gap: .45rem; min-height: 1rem; }
    .question-tag-chip { display: inline-flex; align-items: center; gap: .35rem; padding: .35rem .55rem; border: 1px solid var(--border-color, #777); border-radius: 999px; }
    .question-tag-remove { border: 0; background: transparent; color: inherit; cursor: pointer; font-size: 1.15rem; line-height: 1; padding: 0; }
    .question-tag-action { flex: 0 0 2.75rem; width: 2.75rem; min-width: 2.75rem; max-width: 2.75rem; height: 2.75rem; min-height: 2.75rem; aspect-ratio: 1 / 1; padding: 0; box-sizing: border-box; display: inline-flex; align-items: center; justify-content: center; }
    .question-tag-action[hidden] { display: none; }
    .question-tag-action svg { width: 1rem; height: 1rem; fill: none; stroke: currentColor; stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
    .question-tag-entry { display: flex; gap: .5rem; align-items: flex-start; }
    .question-tag-combobox { position: relative; flex: 1 1 18rem; min-width: 0; }
    .question-tag-combobox input { width: 100%; }
    .question-tag-suggestions { position: absolute; z-index: 100; top: calc(100% + .35rem); left: 0; right: 0; max-height: 16rem; overflow-y: auto; padding: .3rem; background: var(--panel); border: 1px solid var(--line); border-radius: 10px; box-shadow: 0 12px 30px rgba(0, 0, 0, .35); }
    .question-tag-suggestion { display: block; width: 100%; border: 0; border-radius: 8px; padding: .55rem .7rem; background: transparent; color: var(--text); text-align: left; cursor: pointer; }
    .question-tag-suggestion:hover, .question-tag-suggestion.is-active { background: var(--panel-2); }
</style>

<form method="post" class="question-editor" enctype="multipart/form-data">
    <input type="hidden" asp-for="Input.Id" />
    <input type="hidden" asp-for="Input.QuizId" />

    <h1>@Localizer["Title_FinalQuestionEditor"]</h1>

    <section class="content-panel question-tags-setting" data-question-tags-editor>
    <label for="question-tag-input"><strong>@Localizer["Label_QuestionTags"]</strong></label>
    <div class="question-tag-list" data-question-tag-list>
        <button class="button button-secondary question-tag-action"
                type="button"
                data-copy-question-tags
                title="@Localizer["Button_Copy"]"
                aria-label="@Localizer["Button_Copy"]"
                hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <rect x="9" y="9" width="10" height="10" rx="2"></rect>
                <path d="M15 9V7a2 2 0 0 0-2-2H7a2 2 0 0 0-2 2v6a2 2 0 0 0 2 2h2"></path>
            </svg>
        </button>
        <button class="button button-secondary question-tag-action"
                type="button"
                data-clear-question-tags
                title="@Localizer["Button_Delete"]"
                aria-label="@Localizer["Button_Delete"]"
                hidden>
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d="M3 6h18"></path>
                <path d="M8 6V4h8v2"></path>
                <path d="M19 6l-1 14H6L5 6"></path>
                <path d="M10 11v5"></path>
                <path d="M14 11v5"></path>
            </svg>
        </button>
    </div>
    <div class="question-tag-fields" data-question-tag-fields>
        @foreach (var tag in Model.Input.Tags)
        {
            <input type="hidden" name="Input.Tags" value="@tag" />
        }
    </div>
    <div class="question-tag-entry">
        <div class="question-tag-combobox"
             data-question-tag-combobox
             data-suggestions-url="@Url.Page("FinalQuestionEditor", "TagSuggestions", new { id = Model.Input.Id })">
            <input id="question-tag-input" type="text"
         placeholder="@Localizer["Placeholder_QuestionTag"]"
         autocomplete="off"
         role="combobox"
         aria-autocomplete="list"
         aria-expanded="false"
         aria-controls="question-tag-suggestions" />
            <div id="question-tag-suggestions"
       class="question-tag-suggestions"
       data-question-tag-suggestions
       role="listbox"
       hidden></div>
        </div>
        <button class="button button-secondary" type="button" data-add-question-tag>
            @Localizer["Button_AddTag"]
        </button>
    </div>
    <small>@Localizer["Hint_QuestionTags"]</small>
    <span asp-validation-for="Input.Tags" class="text-danger"></span>
</section>

    <h2>@Localizer["Label_Description"]</h2>

    <partial name="Shared/_ContentBlockCollection"
             model="descriptionBlockCollection" />

    <h2>@Localizer["Label_Question"]</h2>

    <partial name="Shared/_ContentBlockCollection"
             model="questionBlockCollection" />

    <span asp-validation-for="Input.QuestionBlocks"
          class="text-danger"></span>

    <h2>@Localizer["Label_CorrectAnswer"]</h2>

    <partial name="Shared/_ContentBlockCollection"
             model="answerBlockCollection" />

    <span asp-validation-for="Input.AnswerBlocks"
          class="text-danger"></span>

    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>


    <div class="editor-actions">
        <a id="final-question-editor-back-link"
           class="button button-secondary"
           asp-page="Editor"
           asp-route-id="@Model.Input.QuizId">@Localizer["Button_Back"]</a>
        <button class="button button-secondary"
                type="button"
                data-open-question-preview="question">
            @Localizer["Button_Preview"] — @Localizer["Label_Question"]
        </button>

        <button class="button button-secondary"
                type="button"
                data-open-question-preview="answer">
            @Localizer["Button_Preview"] — @Localizer["Label_CorrectAnswer"]
        </button>

        <button class="button button-secondary"
                type="button"
                data-open-question-preview="description">
            @Localizer["Button_Preview"] — @Localizer["Label_Description"]
        </button>
        <button class="button button-primary" type="submit">@Localizer["Button_Save"]</button>
    </div>
</form>

<partial name="Shared/_QuestionPreviewModal" />

@section Scripts {
    <script src="~/js/image-clipboard-upload.js" asp-append-version="true"></script>
    <script>
    (() => {
        const editor = document.querySelector("[data-question-tags-editor]");
        if (!editor) {
            return;
        }

        const input = editor.querySelector("#question-tag-input");
        const list = editor.querySelector("[data-question-tag-list]");
        const fields = editor.querySelector("[data-question-tag-fields]");
        const addButton = editor.querySelector("[data-add-question-tag]");
        const copyButton = editor.querySelector("[data-copy-question-tags]");
        const clearButton = editor.querySelector("[data-clear-question-tags]");
        const combobox = editor.querySelector("[data-question-tag-combobox]");
        const suggestionBox = editor.querySelector("[data-question-tag-suggestions]");
        const suggestionsUrl = combobox?.dataset.suggestionsUrl;
        let tags = [...fields.querySelectorAll('input[name="Input.Tags"]')]
            .map(field => field.value.trim())
            .filter(Boolean);
        let suggestions = [];
        let activeSuggestion = -1;
        let requestSequence = 0;
        let suggestionTimer;

        const key = value => value.toLocaleUpperCase("uk-UA");
        const hideSuggestions = () => {
            suggestions = [];
            activeSuggestion = -1;
            suggestionBox.replaceChildren();
            suggestionBox.hidden = true;
            input.setAttribute("aria-expanded", "false");
            input.removeAttribute("aria-activedescendant");
        };

        const setActiveSuggestion = index => {
            const options = [...suggestionBox.querySelectorAll("[data-question-tag-suggestion]")];
            options.forEach(option => option.classList.remove("is-active"));
            if (!options.length) {
          activeSuggestion = -1;
          input.removeAttribute("aria-activedescendant");
          return;
            }

            activeSuggestion = (index + options.length) % options.length;
            const option = options[activeSuggestion];
            option.classList.add("is-active");
            option.scrollIntoView({ block: "nearest" });
            input.setAttribute("aria-activedescendant", option.id);
        };

        const renderSuggestions = values => {
            const selected = new Set(tags.map(key));
            suggestions = values
          .map(value => value?.trim())
          .filter(value => value && !selected.has(key(value)));
            activeSuggestion = -1;
            suggestionBox.replaceChildren();

            suggestions.forEach((suggestion, index) => {
          const option = document.createElement("button");
          option.type = "button";
          option.id = `question-tag-suggestion-${index}`;
          option.className = "question-tag-suggestion";
          option.dataset.questionTagSuggestion = "";
          option.setAttribute("role", "option");
          option.textContent = suggestion;
          option.addEventListener("mousedown", event => event.preventDefault());
          option.addEventListener("click", () => addTag(suggestion));
          suggestionBox.appendChild(option);
            });

            suggestionBox.hidden = suggestions.length === 0;
            input.setAttribute("aria-expanded", suggestions.length ? "true" : "false");
            if (!suggestions.length) {
          input.removeAttribute("aria-activedescendant");
            }
        };

        const loadSuggestions = async () => {
            if (!suggestionsUrl) {
          hideSuggestions();
          return;
            }

            const sequence = ++requestSequence;
            const url = new URL(suggestionsUrl, window.location.href);
            const searchText = input.value.trim();
            if (searchText) {
          url.searchParams.set("query", searchText);
            } else {
          url.searchParams.delete("query");
            }

            try {
          const response = await fetch(url, {
              headers: { "X-Requested-With": "XMLHttpRequest" }
          });
          if (!response.ok || sequence !== requestSequence) {
              if (sequence === requestSequence) {
                  hideSuggestions();
              }
              return;
          }

          const values = await response.json();
          if (sequence === requestSequence) {
              renderSuggestions(Array.isArray(values) ? values : []);
          }
            } catch {
          if (sequence === requestSequence) {
              hideSuggestions();
          }
            }
        };

        const scheduleSuggestions = () => {
            clearTimeout(suggestionTimer);
            suggestionTimer = setTimeout(loadSuggestions, 150);
        };

        const copyTags = async () => {
            const text = tags.join("; ");
            if (!text) {
                return;
            }

            if (navigator.clipboard?.writeText) {
                try {
                    await navigator.clipboard.writeText(text);
                    return;
                } catch {
                    // Fall through to the legacy copy path.
                }
            }

            const textarea = document.createElement("textarea");
            textarea.value = text;
            textarea.setAttribute("readonly", "");
            textarea.style.position = "fixed";
            textarea.style.opacity = "0";
            document.body.appendChild(textarea);
            textarea.select();
            try {
                document.execCommand("copy");
            } finally {
                textarea.remove();
            }
        };

        const clearTags = () => {
            if (!tags.length) {
                return;
            }
            tags = [];
            input.value = "";
            hideSuggestions();
            render();
            input.focus();
            loadSuggestions();
        };

        const render = () => {
            list.replaceChildren();
            if (copyButton) {
                copyButton.hidden = tags.length === 0;
                list.appendChild(copyButton);
            }
            if (clearButton) {
                clearButton.hidden = tags.length === 0;
                list.appendChild(clearButton);
            }
            fields.replaceChildren();
            tags.forEach(tag => {
          const chip = document.createElement("span");
          chip.className = "question-tag-chip";

          const text = document.createElement("span");
          text.textContent = tag;
          chip.appendChild(text);

          const remove = document.createElement("button");
          remove.type = "button";
          remove.className = "question-tag-remove";
          remove.setAttribute("aria-label", `Remove ${tag}`);
          remove.textContent = "×";
          remove.addEventListener("click", () => {
              const normalized = key(tag);
              tags = tags.filter(item => key(item) !== normalized);
              render();
              if (document.activeElement === input) {
                  scheduleSuggestions();
              }
          });
          chip.appendChild(remove);
          list.appendChild(chip);

          const hidden = document.createElement("input");
          hidden.type = "hidden";
          hidden.name = "Input.Tags";
          hidden.value = tag;
          fields.appendChild(hidden);
            });
        };

        const splitTagValues = value => String(value ?? input.value)
            .split(/[;,]/)
            .map(item => item.trim())
            .filter(Boolean);

        const addTag = value => {
            let changed = false;
            for (const tagValue of splitTagValues(value)) {
                if (tagValue.length > 100) {
                    continue;
                }
                if (!tags.some(tag => key(tag) === key(tagValue))) {
                    tags.push(tagValue);
                    changed = true;
                }
            }
            if (changed) {
                render();
            }
            input.value = "";
            hideSuggestions();
            input.focus();
            loadSuggestions();
        };

        copyButton?.addEventListener("click", copyTags);
        clearButton?.addEventListener("click", clearTags);
        addButton?.addEventListener("click", () => addTag());
        input?.addEventListener("focus", loadSuggestions);
        input?.addEventListener("input", scheduleSuggestions);
        input?.addEventListener("blur", () => {
            window.setTimeout(hideSuggestions, 120);
        });
        input?.addEventListener("keydown", event => {
            if (event.key === "ArrowDown") {
          event.preventDefault();
          if (suggestionBox.hidden) {
              loadSuggestions();
          } else {
              setActiveSuggestion(activeSuggestion + 1);
          }
          return;
            }
            if (event.key === "ArrowUp" && !suggestionBox.hidden) {
          event.preventDefault();
          setActiveSuggestion(activeSuggestion - 1);
          return;
            }
            if (event.key === "Escape") {
          hideSuggestions();
          return;
            }
            if (event.key === "Enter") {
          event.preventDefault();
          if (!suggestionBox.hidden && activeSuggestion >= 0) {
              addTag(suggestions[activeSuggestion]);
          } else {
              addTag();
          }
            }
        });
        render();
    })();
</script>
    <script>
        const questionPreviewModal =
            document.getElementById("question-preview-modal");

        const questionPreviewTitle =
            document.getElementById("question-preview-title");

        const questionPreviewContent =
            document.getElementById("question-preview-content");

        function getBlockInputValue(card, propertyName) {
            const input = card.querySelector(
                `[name$=".${propertyName}"]`);

            if (!input) {
                return "";
            }

            return input.value?.trim() ?? "";
        }

        function appendQuestionPreviewCaption(
            container,
            text,
            cssClass) {
            if (!text) {
                return;
            }

            const caption = document.createElement("div");
            caption.className = cssClass;
            caption.textContent = text;
            container.appendChild(caption);
        }

        function createTextBlockPreview(card) {
            const text = getBlockInputValue(
                card,
                "TextContent");

            if (!text) {
                return null;
            }

            const element = document.createElement("div");
            element.className =
                "question-preview-text game-content-block game-content-text";
            element.textContent = text;

            return element;
        }

        function createImageBlockPreview(card) {
            const preview =
                card.querySelector(".unified-file-preview");

            const sourceImage =
                card.querySelector(
                    ".unified-image-preview-element");

            if (!preview ||
                preview.hidden ||
                !sourceImage ||
                !sourceImage.getAttribute("src")) {
                return null;
            }

            const wrapper = document.createElement("figure");
            wrapper.className =
                "question-preview-media game-content-block";

            appendQuestionPreviewCaption(
                wrapper,
                getBlockInputValue(card, "TopCaption"),
                "question-preview-caption");

            const image = document.createElement("img");
            image.className = "question-preview-image";
            image.src = sourceImage.src;
            image.alt =
                sourceImage.alt ||
                getBlockInputValue(card, "FileName");

            wrapper.appendChild(image);

            appendQuestionPreviewCaption(
                wrapper,
                getBlockInputValue(card, "BottomCaption"),
                "question-preview-caption");

            return wrapper;
        }

        function createAudioBlockPreview(card) {
            const preview =
                card.querySelector(".unified-file-preview");

            const sourceAudio =
                card.querySelector(
                    ".unified-audio-preview-element");

            if (!preview ||
                preview.hidden ||
                !sourceAudio ||
                !sourceAudio.getAttribute("src")) {
                return null;
            }

            const wrapper = document.createElement("div");
            wrapper.className =
                "question-preview-media question-preview-audio game-content-block";

            appendQuestionPreviewCaption(
                wrapper,
                getBlockInputValue(card, "TopCaption"),
                "question-preview-caption");

            const audio = document.createElement("audio");
            audio.className = "question-preview-audio-player";
            audio.controls = true;
            audio.preload = "metadata";
            audio.src = sourceAudio.src;

            wrapper.appendChild(audio);

            appendQuestionPreviewCaption(
                wrapper,
                getBlockInputValue(card, "BottomCaption"),
                "question-preview-caption");

            return wrapper;
        }

        function getYouTubeVideoId(value) {
            if (!value) {
                return null;
            }

            try {
                const url = new URL(value);
                const host = url.hostname
                    .replace(/^www\./, "")
                    .toLowerCase();

                if (host === "youtu.be") {
                    return url.pathname
                        .split("/")
                        .filter(Boolean)[0] ?? null;
                }

                if (host !== "youtube.com" &&
                    host !== "m.youtube.com") {
                    return null;
                }

                if (url.pathname === "/watch") {
                    return url.searchParams.get("v");
                }

                const parts = url.pathname
                    .split("/")
                    .filter(Boolean);

                if (["embed", "shorts", "live"].includes(parts[0])) {
                    return parts[1] ?? null;
                }
            } catch {
                return null;
            }

            return null;
        }

        function createVideoBlockPreview(card) {
            const externalUrl =
                getBlockInputValue(card, "ExternalUrl");

            if (!externalUrl) {
                return null;
            }

            const wrapper = document.createElement("figure");
            wrapper.className =
                "question-preview-media game-content-block";

            appendQuestionPreviewCaption(
                wrapper,
                getBlockInputValue(card, "TopCaption"),
                "question-preview-caption");

            const youtubeVideoId =
                getYouTubeVideoId(externalUrl);

            if (youtubeVideoId) {
                const frameWrapper =
                    document.createElement("div");

                frameWrapper.className =
                    "question-preview-video-frame";

                const iframe =
                    document.createElement("iframe");

                iframe.className = "youtube-auto-expand";
                iframe.src =
                    "https://www.youtube-nocookie.com/embed/" +
                    encodeURIComponent(youtubeVideoId);

                iframe.title = "YouTube";
                iframe.allow =
                    "accelerometer; autoplay; clipboard-write; " +
                    "encrypted-media; gyroscope; " +
                    "picture-in-picture; web-share";

                iframe.allowFullscreen = true;

                frameWrapper.appendChild(iframe);
                wrapper.appendChild(frameWrapper);
            } else {
                const video =
                    document.createElement("video");

                video.className = "question-preview-video";
                video.controls = true;
                video.preload = "metadata";
                video.src = externalUrl;

                wrapper.appendChild(video);
            }

            appendQuestionPreviewCaption(
                wrapper,
                getBlockInputValue(card, "BottomCaption"),
                "question-preview-caption");

            return wrapper;
        }

        function createContentBlockPreview(card) {
            switch (card.dataset.blockType) {
                case "Text":
                    return createTextBlockPreview(card);

                case "Image":
                    return createImageBlockPreview(card);

                case "Audio":
                    return createAudioBlockPreview(card);

                case "Video":
                case "YouTube":
                    return createVideoBlockPreview(card);

                default:
                    return null;
            }
        }

        function stopQuestionPreviewMedia() {
            questionPreviewContent
                ?.querySelectorAll("audio, video")
                .forEach(media => {
                    media.pause();
                    media.removeAttribute("src");
                    media.load();
                });

            questionPreviewContent
                ?.querySelectorAll("iframe")
                .forEach(frame => {
                    frame.src = "about:blank";
                });
        }

        function closeQuestionPreview() {
            if (!questionPreviewModal ||
                !questionPreviewContent) {
                return;
            }

            stopQuestionPreviewMedia();
            questionPreviewContent.replaceChildren();

            questionPreviewModal.hidden = true;
            questionPreviewModal.setAttribute(
                "aria-hidden",
                "true");

            document.body.classList.remove(
                "question-preview-open");
        }

        function openQuestionPreview(previewType) {
            const previewConfiguration =
                previewType === "description"
                    ? {
                        collectionId: "description-blocks",
                        title: "@JavaScriptEncoder.Default.Encode(Localizer["Label_Description"])"
                    }
                    : previewType === "answer"
                        ? {
                            collectionId: "answer-blocks",
                            title: "@JavaScriptEncoder.Default.Encode(Localizer["Label_CorrectAnswer"])"
                        }
                        : {
                            collectionId: "question-blocks",
                            title: "@JavaScriptEncoder.Default.Encode(Localizer["Label_Question"])"
                        };

            const collection =
                document.getElementById(previewConfiguration.collectionId);

            if (!collection ||
                !questionPreviewModal ||
                !questionPreviewTitle ||
                !questionPreviewContent) {
                return;
            }

            questionPreviewTitle.textContent = previewConfiguration.title;

            questionPreviewContent.replaceChildren();

            collection
                .querySelectorAll(".content-block-card")
                .forEach(card => {
                    const blockPreview =
                        createContentBlockPreview(card);

                    if (blockPreview) {
                        questionPreviewContent.appendChild(
                            blockPreview);
                    }
                });

            if (!questionPreviewContent.children.length) {
                const emptyState =
                    document.createElement("div");

                emptyState.className =
                    "question-preview-empty";

                emptyState.textContent = "—";

                questionPreviewContent.appendChild(
                    emptyState);
            }

            questionPreviewModal.hidden = false;
            questionPreviewModal.setAttribute(
                "aria-hidden",
                "false");

            document.body.classList.add(
                "question-preview-open");

            questionPreviewModal
                .querySelector(
                    ".question-preview-close-button")
                ?.focus();
        }

        document.addEventListener("click", event => {
            const openButton = event.target.closest(
                "[data-open-question-preview]");

            if (openButton) {
                openQuestionPreview(
                    openButton.dataset.openQuestionPreview);

                return;
            }

            if (event.target.closest(
                ".question-preview-close-button")) {
                closeQuestionPreview();
                return;
            }

            if (event.target === questionPreviewModal) {
                closeQuestionPreview();
            }
        });

        window.addEventListener("keyup", event => {
            if (event.key !== "Escape") {
                return;
            }

            if (questionPreviewModal &&
                !questionPreviewModal.hidden) {
                closeQuestionPreview();
            }
        }, true);

        document.querySelectorAll('.type-tabs').forEach(tabGroup => {
            tabGroup.querySelectorAll('.type-tab').forEach(button => {
                button.addEventListener('click', () => {
                    const target = tabGroup.dataset.target;

                    tabGroup
                        .querySelectorAll('.type-tab')
                        .forEach(x => x.classList.remove('active'));

                    button.classList.add('active');

                    document
                        .querySelectorAll(`[data-editor^="${target}-"]`)
                        .forEach(x => x.classList.remove('active'));

                    document
                        .querySelector(`[data-editor="${target}-${button.dataset.type}"]`)
                        ?.classList.add('active');
                });
            });
        });

        document.addEventListener('DOMContentLoaded', () => {
            const message = document.getElementById('success-message');

            if (!message) {
                return;
            }

            window.setTimeout(() => {
                message.classList.add('success-message-hidden');

                window.setTimeout(() => {
                    message.remove();
                }, 300);
            }, 2500);
        });

        async function addContentBlock(section, blockType) {
            const list = section.querySelector('.content-block-list');
            const fieldPrefix = section.dataset.blockCollection;
            const index = list.querySelectorAll('.content-block-card').length;

            const url =
                `${window.location.pathname}` +
                `?handler=ContentBlock` +
                `&fieldPrefix=${encodeURIComponent(fieldPrefix)}` +
                `&blockType=${encodeURIComponent(blockType)}` +
                `&index=${index}`;

            const response = await fetch(url);

            if (!response.ok) {
                alert('Не вдалося додати блок.');
                return;
            }

            const html = await response.text();

            list.insertAdjacentHTML('beforeend', html);
            updateContentBlockIndexes(section);

            const newCard = list.lastElementChild;

            if (newCard) {
                updateImageBlockPreview(newCard);
            }

            clearCollectionValidationError(fieldPrefix);
        }

        function clearCollectionValidationError(fieldPrefix) {
            const validationMessage = document.querySelector(
                `[data-valmsg-for="${fieldPrefix}"]`
            );

            if (!validationMessage) {
                return;
            }

            validationMessage.textContent = '';
            validationMessage.classList.remove('field-validation-error');
            validationMessage.classList.add('field-validation-valid');
        }

        document.querySelectorAll('.content-block-section').forEach(section => {
            const addButton =
                section.querySelector('.content-block-add-button');

            const typeMenu =
                section.querySelector('.content-block-type-menu');

            if (!addButton || !typeMenu) {
                return;
            }

            addButton.addEventListener('click', () => {
                typeMenu.hidden = !typeMenu.hidden;
            });

            typeMenu
                .querySelectorAll('.content-block-type-option')
                .forEach(option => {
                    option.addEventListener('click', async () => {
                        await addContentBlock(
                            section,
                            option.dataset.blockType);

                        typeMenu.hidden = true;
                    });
                });
        });

        function updateContentBlockIndexes(section) {
            const fieldPrefix = section.dataset.blockCollection;
            const idPrefix = fieldPrefix.replaceAll('.', '_');

            const escapedFieldPrefix = fieldPrefix.replace(
                /[.*+?^${}()|[\]\\]/g,
                '\\$&'
            );

            const escapedIdPrefix = idPrefix.replace(
                /[.*+?^${}()|[\]\\]/g,
                '\\$&'
            );

            const namePattern = new RegExp(
                `${escapedFieldPrefix}\\[\\d+\\]`,
                'g'
            );

            const idPattern = new RegExp(
                `${escapedIdPrefix}_\\d+__`,
                'g'
            );

            const cards = section.querySelectorAll('.content-block-card');

            cards.forEach((card, index) => {
                card.querySelectorAll('[name]').forEach(element => {
                    element.name = element.name.replace(
                        namePattern,
                        `${fieldPrefix}[${index}]`
                    );
                });

                card.querySelectorAll('[id]').forEach(element => {
                    element.id = element.id.replace(
                        idPattern,
                        `${idPrefix}_${index}__`
                    );
                });

                card.querySelectorAll('label[for]').forEach(label => {
                    label.htmlFor = label.htmlFor.replace(
                        idPattern,
                        `${idPrefix}_${index}__`
                    );
                });

                const sortOrderInput = card.querySelector(
                    `input[name="${fieldPrefix}[${index}].SortOrder"]`
                );

                if (sortOrderInput) {
                    sortOrderInput.value = index;
                }
            });
        }

        document.addEventListener('click', event => {
            const removeButton = event.target.closest(
                '.content-block-remove-button'
            );

            if (!removeButton) {
                return;
            }

            const card = removeButton.closest('.content-block-card');
            const section = removeButton.closest('.content-block-section');

            if (!card || !section) {
                return;
            }

            const blockEditor = card.querySelector(
                ".image-block-editor, .audio-block-editor");

            if (blockEditor) {
                revokeTemporaryFileUrl(blockEditor);
            }

            card.remove();
            updateContentBlockIndexes(section);
        });

        let draggedContentBlock = null;

        document.addEventListener('dragstart', event => {
            const dragHandle = event.target.closest(
                '.content-block-drag-handle'
            );

            if (!dragHandle) {
                return;
            }

            const card = dragHandle.closest('.content-block-card');

            if (!card) {
                return;
            }

            draggedContentBlock = card;
            card.classList.add('content-block-dragging');

            event.dataTransfer.effectAllowed = 'move';
            event.dataTransfer.setData('text/plain', '');
        });

        document.addEventListener('dragend', event => {
            const dragHandle = event.target.closest(
                '.content-block-drag-handle'
            );

            if (!dragHandle || !draggedContentBlock) {
                return;
            }

            const section = draggedContentBlock.closest(
                '.content-block-section'
            );

            draggedContentBlock.classList.remove(
                'content-block-dragging'
            );

            clearContentBlockDropIndicators();

            if (section) {
                updateContentBlockIndexes(section);
            }

            draggedContentBlock = null;
        });

        document.addEventListener('dragover', event => {
            if (!draggedContentBlock) {
                return;
            }

            const targetCard = event.target.closest(
                '.content-block-card'
            );

            if (!targetCard || targetCard === draggedContentBlock) {
                return;
            }

            const sourceSection = draggedContentBlock.closest(
                '.content-block-section'
            );

            const targetSection = targetCard.closest(
                '.content-block-section'
            );

            // Не дозволяємо переносити блоки між питанням і відповіддю.
            if (sourceSection !== targetSection) {
                return;
            }

            event.preventDefault();
            event.dataTransfer.dropEffect = 'move';

            clearContentBlockDropIndicators();

            const targetRectangle = targetCard.getBoundingClientRect();
            const targetMiddle =
                targetRectangle.top + targetRectangle.height / 2;

            if (event.clientY < targetMiddle) {
                targetCard.classList.add('content-block-drop-before');
            } else {
                targetCard.classList.add('content-block-drop-after');
            }
        });

        document.addEventListener('drop', event => {
            if (!draggedContentBlock) {
                return;
            }

            const targetCard = event.target.closest(
                '.content-block-card'
            );

            if (!targetCard || targetCard === draggedContentBlock) {
                return;
            }

            const sourceSection = draggedContentBlock.closest(
                '.content-block-section'
            );

            const targetSection = targetCard.closest(
                '.content-block-section'
            );

            if (sourceSection !== targetSection) {
                return;
            }

            event.preventDefault();

            const targetRectangle = targetCard.getBoundingClientRect();
            const targetMiddle =
                targetRectangle.top + targetRectangle.height / 2;

            if (event.clientY < targetMiddle) {
                targetCard.before(draggedContentBlock);
            } else {
                targetCard.after(draggedContentBlock);
            }

            clearContentBlockDropIndicators();
            updateContentBlockIndexes(sourceSection);
        });

        function clearContentBlockDropIndicators() {
            document
                .querySelectorAll(
                    '.content-block-drop-before, .content-block-drop-after'
                )
                .forEach(card => {
                    card.classList.remove(
                        'content-block-drop-before',
                        'content-block-drop-after'
                    );
                });
        }

        document.addEventListener('dragover', event => {
            if (!draggedContentBlock) {
                return;
            }

            const list = event.target.closest('.content-block-list');

            if (!list) {
                return;
            }

            const sourceSection = draggedContentBlock.closest(
                '.content-block-section'
            );

            const targetSection = list.closest(
                '.content-block-section'
            );

            if (sourceSection !== targetSection) {
                return;
            }

            event.preventDefault();
        });

        document.addEventListener('drop', event => {
            if (!draggedContentBlock) {
                return;
            }

            const list = event.target.closest('.content-block-list');

            if (!list) {
                return;
            }

            const targetCard = event.target.closest(
                '.content-block-card'
            );

            // Перенесення відносно картки вже обробляється іншим handler.
            if (targetCard) {
                return;
            }

            const sourceSection = draggedContentBlock.closest(
                '.content-block-section'
            );

            const targetSection = list.closest(
                '.content-block-section'
            );

            if (sourceSection !== targetSection) {
                return;
            }

            event.preventDefault();

            list.appendChild(draggedContentBlock);
            updateContentBlockIndexes(sourceSection);
        });

        function updateImageBlockPreview(card) {
            const urlInput = card.querySelector('.image-block-url');
            const topCaptionInput = card.querySelector(
                '.image-block-top-caption'
            );
            const bottomCaptionInput = card.querySelector(
                '.image-block-bottom-caption'
            );

            const preview = card.querySelector('.image-block-preview');
            const previewImage = card.querySelector(
                '.image-block-preview-image'
            );
            const previewTopCaption = card.querySelector(
                '.image-block-preview-top-caption'
            );
            const previewBottomCaption = card.querySelector(
                '.image-block-preview-bottom-caption'
            );
            const previewError = card.querySelector(
                '.image-block-preview-error'
            );

            if (!urlInput ||
                !preview ||
                !previewImage ||
                !previewTopCaption ||
                !previewBottomCaption ||
                !previewError) {
                return;
            }

            const imageUrl = urlInput.value.trim();
            const topCaption = topCaptionInput?.value.trim() ?? '';
            const bottomCaption = bottomCaptionInput?.value.trim() ?? '';

            previewTopCaption.textContent = topCaption;
            previewBottomCaption.textContent = bottomCaption;

            previewTopCaption.hidden = topCaption.length === 0;
            previewBottomCaption.hidden = bottomCaption.length === 0;

            if (imageUrl.length === 0) {
                preview.hidden = true;
                previewImage.removeAttribute('src');
                previewError.hidden = true;
                return;
            }

            preview.hidden = false;
            previewError.hidden = true;
            previewImage.hidden = false;

            if (previewImage.src !== imageUrl) {
                previewImage.src = imageUrl;
            }
        }

        document.addEventListener('input', event => {
            const card = event.target.closest('.content-block-card');

            if (!card) {
                return;
            }

            if (event.target.matches(
                '.image-block-url, ' +
                '.image-block-top-caption, ' +
                '.image-block-bottom-caption'
            )) {
                updateImageBlockPreview(card);
            }
        });

        document.addEventListener('load', event => {
            if (!event.target.matches('.image-block-preview-image')) {
                return;
            }

            const preview = event.target.closest('.image-block-preview');
            const previewError = preview?.querySelector(
                '.image-block-preview-error'
            );

            event.target.hidden = false;

            if (previewError) {
                previewError.hidden = true;
            }
        }, true);

        document.addEventListener('error', event => {
            if (!event.target.matches('.image-block-preview-image')) {
                return;
            }

            const preview = event.target.closest('.image-block-preview');
            const previewError = preview?.querySelector(
                '.image-block-preview-error'
            );

            event.target.hidden = true;

            if (previewError) {
                previewError.hidden = false;
            }
        }, true);

        document
            .querySelectorAll('.content-block-card')
            .forEach(card => {
                updateImageBlockPreview(card);
            });

        function revokeTemporaryFileUrl(blockEditor) {
            const preview = blockEditor.querySelector(
                ".unified-file-preview");

            const objectUrl = preview?.dataset.objectUrl;

            if (objectUrl) {
                URL.revokeObjectURL(objectUrl);
                delete preview.dataset.objectUrl;
            }
        }

        function clearPreviewMedia(blockEditor) {
            const image = blockEditor.querySelector(
                ".unified-image-preview-element");

            const audio = blockEditor.querySelector(
                ".unified-audio-preview-element");

            if (image) {
                image.removeAttribute("src");
                image.alt = "";
            }

            if (audio) {
                audio.pause();
                audio.removeAttribute("src");
                audio.load();
            }
        }

        function setCancelFileChangeVisible(
            blockEditor,
            isVisible) {
            const cancelButton = blockEditor.querySelector(
                ".cancel-file-change-button");

            if (!cancelButton) {
                return;
            }

            cancelButton.style.setProperty(
                "display",
                isVisible ? "inline-flex" : "none",
                "important");

            cancelButton.style.width = "fit-content";
            cancelButton.style.alignSelf = "flex-start";
        }

        function restoreOriginalFilePreview(blockEditor) {
            revokeTemporaryFileUrl(blockEditor);

            const preview = blockEditor.querySelector(
                ".unified-file-preview");

            const image = blockEditor.querySelector(
                ".unified-image-preview-element");

            const audio = blockEditor.querySelector(
                ".unified-audio-preview-element");

            const fileLabel = blockEditor.querySelector(
                ".file-preview-label");

            const fileName = blockEditor.querySelector(
                ".file-preview-name");

            const removeButton = blockEditor.querySelector(
                ".remove-stored-file-button");

            if (!preview) {
                return;
            }

            const hasOriginal =
                preview.dataset.hasOriginal === "true";

            if (!hasOriginal) {
                clearPreviewMedia(blockEditor);
                preview.hidden = true;

                if (removeButton) {
                    removeButton.hidden = true;
                }

                setCancelFileChangeVisible(
                    blockEditor,
                    false);

                return;
            }

            const originalSrc =
                preview.dataset.originalSrc ?? "";

            const originalName =
                preview.dataset.originalName ?? "";

            const originalLabel =
                preview.dataset.originalLabel ?? "";

            if (image) {
                image.src = originalSrc;
                image.alt = originalName;
            }

            if (audio) {
                audio.src = originalSrc;
                audio.load();
            }

            if (fileLabel) {
                fileLabel.textContent = originalLabel;
            }

            if (fileName) {
                fileName.textContent = originalName;
            }

            preview.hidden = false;

            if (removeButton) {
                removeButton.hidden = false;
            }

            setCancelFileChangeVisible(
                blockEditor,
                false);
        }

        function cancelFileReplacement(blockEditor) {
            const uploadedFileInput = blockEditor.querySelector(
                ".uploaded-file-input");

            const removeFileInput = blockEditor.querySelector(
                ".remove-file-value");

            if (uploadedFileInput) {
                uploadedFileInput.value = "";
            }

            if (removeFileInput) {
                removeFileInput.value = "false";
            }

            restoreOriginalFilePreview(blockEditor);
        }

        document.addEventListener("click", function (event) {
            const cancelButton = event.target.closest(
                ".cancel-file-change-button");

            if (!cancelButton) {
                return;
            }

            const blockEditor = cancelButton.closest(
                ".image-block-editor, .audio-block-editor");

            if (!blockEditor) {
                return;
            }

            cancelFileReplacement(blockEditor);
        });

        document.addEventListener("click", function (event) {
            const removeButton = event.target.closest(
                ".remove-stored-file-button");

            if (!removeButton) {
                return;
            }

            const blockEditor = removeButton.closest(
                ".image-block-editor, .audio-block-editor");

            if (!blockEditor) {
                return;
            }

            const removeFileInput = blockEditor.querySelector(
                ".remove-file-value");

            const uploadedFileInput = blockEditor.querySelector(
                ".uploaded-file-input");

            const preview = blockEditor.querySelector(
                ".unified-file-preview");

            if (removeFileInput) {
                removeFileInput.value = "true";
            }

            if (uploadedFileInput) {
                uploadedFileInput.value = "";
            }

            revokeTemporaryFileUrl(blockEditor);
            clearPreviewMedia(blockEditor);

            if (preview) {
                preview.hidden = true;
            }

            removeButton.hidden = true;

            setCancelFileChangeVisible(
                blockEditor,
                true);
        });

        document.addEventListener("change", function (event) {
            if (!event.target.matches(".uploaded-file-input")) {
                return;
            }

            const blockEditor = event.target.closest(
                ".image-block-editor, .audio-block-editor");

            if (!blockEditor) {
                return;
            }

            const selectedFile = event.target.files?.[0];

            if (!selectedFile) {
                cancelFileReplacement(blockEditor);
                return;
            }

            const removeFileInput = blockEditor.querySelector(
                ".remove-file-value");

            const preview = blockEditor.querySelector(
                ".unified-file-preview");

            const image = blockEditor.querySelector(
                ".unified-image-preview-element");

            const audio = blockEditor.querySelector(
                ".unified-audio-preview-element");

            const fileLabel = blockEditor.querySelector(
                ".file-preview-label");

            const fileName = blockEditor.querySelector(
                ".file-preview-name");

            const removeButton = blockEditor.querySelector(
                ".remove-stored-file-button");

            if (!preview) {
                return;
            }

            revokeTemporaryFileUrl(blockEditor);

            const objectUrl = URL.createObjectURL(selectedFile);
            preview.dataset.objectUrl = objectUrl;

            if (removeFileInput) {
                removeFileInput.value = "false";
            }

            if (image) {
                image.src = objectUrl;
                image.alt = selectedFile.name;
            }

            if (audio) {
                audio.src = objectUrl;
                audio.load();
            }

            if (fileLabel) {
                fileLabel.textContent =
                    preview.dataset.pendingLabel ?? "";
            }

            if (fileName) {
                fileName.textContent = selectedFile.name;
            }

            preview.hidden = false;

            if (removeButton) {
                removeButton.hidden = true;
            }

            setCancelFileChangeVisible(
                blockEditor,
                true);
        });

        window.addEventListener("beforeunload", function () {
            document
                .querySelectorAll(
                    ".image-block-editor, .audio-block-editor")
                .forEach(blockEditor => {
                    revokeTemporaryFileUrl(blockEditor);
                });
        });
    </script>
}
