@page "{id:int}"
@model BadWolfQuiz.Web.Pages.Admin.Quizzes.QuestionEditorModel
@{
    ViewData["Title"] = Localizer["Title_QuestionEditor"];

    var questionBlockCollection =
        new BadWolfQuiz.Web.Pages.Admin.Quizzes.ContentBlockCollectionViewModel
        {
            CollectionId = "question-blocks",
            Title = Localizer["Label_QuestionBlocks"].Value,
            FieldPrefix = "Input.QuestionBlocks",
            Blocks = Model.Input.QuestionBlocks
        };

    var answerBlockCollection =
        new BadWolfQuiz.Web.Pages.Admin.Quizzes.ContentBlockCollectionViewModel
        {
            CollectionId = "answer-blocks",
            Title = Localizer["Label_AnswerBlocks"].Value,
            FieldPrefix = "Input.AnswerBlocks",
            Blocks = Model.Input.AnswerBlocks
        };
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div id="success-message" class="alert alert-success" role="status">
        @successMessage
    </div>
}

<form method="post" class="question-editor" enctype="multipart/form-data"
      data-ajax-question-editor
      data-save-error="@Localizer["Error_Unexpected"]">
    <input type="hidden" asp-for="Input.Id" />
    <input type="hidden" asp-for="Input.QuizId" />
    <input type="hidden" asp-for="Input.RoundId" />
    <input type="hidden"
           asp-for="Input.AllPlayerMode"
           data-all-player-mode />

    <section class="content-panel question-type-setting">
        <label asp-for="Input.PresentationType">@Localizer["Label_QuestionType"]</label>
        <select asp-for="Input.PresentationType">
            <option value="0">@Localizer["QuestionType_Standard"]</option>
            <option value="1">@Localizer["QuestionType_FourClues"]</option>
            <option value="2">@Localizer["QuestionType_AllPlayerText"]</option>
            <option value="3">@Localizer["QuestionType_AllPlayerMultipleChoice"]</option>
        </select>
        <small id="four-clues-help" class="all-player-editor-help" hidden>@Localizer["FourClues_EditorHint"]</small>
    </section>

    <h2>@Localizer["Label_Question"]</h2>

    <partial name="Shared/_ContentBlockCollection"
             model="questionBlockCollection" />

    <span asp-validation-for="Input.QuestionBlocks"
          class="text-danger"></span>

    <h2>@Localizer["Label_CorrectAnswer"]</h2>

    <partial name="Shared/_ContentBlockCollection"
             model="answerBlockCollection" />

    <span asp-validation-for="Input.AnswerBlocks"
          class="text-danger"></span>

    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

    <section class="content-panel question-settings">
        <label class="checkbox-row wager-question-setting">
            <input asp-for="Input.IsSpecial" />
            <span>
                <strong>@Localizer["Label_SpecialQuestion"]</strong>
                <small>@Localizer["Hint_WagerQuestion"]</small>
            </span>
        </label>

        <label class="checkbox-row wager-question-setting">
            <input asp-for="Input.ExcludeFromRandomWagerSelection" />
            <span>
                <strong>@Localizer["Label_ExcludeFromRandomWagerSelection"]</strong>
                <small>@Localizer["Hint_ExcludeFromRandomWagerSelection"]</small>
            </span>
        </label>

        <div id="buzz-mode-setting">
            <label asp-for="Input.BuzzModeOverride">
                @Localizer["Label_BuzzMode"]
            </label>

            <select asp-for="Input.BuzzModeOverride">
                <option value="0">@Localizer["BuzzMode_UseRoundDefault"]</option>
                <option value="1">@Localizer["BuzzMode_Manual"]</option>
                <option value="2">@Localizer["BuzzMode_Immediately"]</option>
                <option value="3">@Localizer["BuzzMode_AfterMedia"]</option>
                <option value="4">@Localizer["BuzzMode_AfterDelay"]</option>
                <option value="5">@Localizer["BuzzMode_Disabled"]</option>
            </select>
        </div>
    </section>

    <div class="editor-actions">
        <a id="question-editor-back-link"
           class="button button-secondary"
           asp-page="Editor"
           asp-route-id="@Model.Input.QuizId"
           asp-route-selectedRoundId="@Model.Input.RoundId">@Localizer["Button_Back"]</a>
        <button class="button button-secondary"
                type="button"
                data-open-question-preview="question">
            @Localizer["Button_Preview"] — @Localizer["Label_Question"]
        </button>

        <button class="button button-secondary"
                type="button"
                data-open-question-preview="answer">
            @Localizer["Button_Preview"] — @Localizer["Label_CorrectAnswer"]
        </button>
        <span class="alert ajax-save-status" role="status"
              data-question-save-status hidden></span>
        <button class="button button-primary" type="submit">@Localizer["Button_Save"]</button>
        @if (Model.NextQuestionId.HasValue)
        {
            <a class="button button-secondary"
               asp-page="QuestionEditor"
               asp-route-id="@Model.NextQuestionId.Value">
                @Localizer["Button_NextQuestion"]
            </a>
        }
    </div>
</form>

<partial name="Shared/_QuestionPreviewModal" />

@section Scripts {
    <script src="~/js/image-clipboard-upload.js" asp-append-version="true"></script>
    <script>
        (() => {
            const form = document.querySelector("[data-ajax-question-editor]");
            const status = document.querySelector("[data-question-save-status]");
            let statusTimeout;
            if (!form || !status) {
                return;
            }

            const setStatus = (message, success) => {
                status.textContent = message;
                status.hidden = false;
                status.classList.toggle("alert-success", success);
                status.classList.toggle("alert-error", !success);
            };

            const applyBlockIds = (prefix, blocks) => {
                for (const block of blocks ?? []) {
                    const sortOrder = [...form.querySelectorAll(
                        `input[name^="${prefix}"][name$=".SortOrder"]`)]
                        .find(input => Number(input.value) === block.sortOrder);
                    const card = sortOrder?.closest(".content-block-card");
                    const id = card?.querySelector(`input[name^="${prefix}"][name$=".Id"]`);
                    if (id) {
                        id.value = block.id;
                    }
                }
            };

            form.addEventListener("submit", async event => {
                event.preventDefault();
                const submitter = event.submitter;
                submitter?.setAttribute("disabled", "disabled");
                clearTimeout(statusTimeout);
                status.hidden = true;

                try {
                    const response = await fetch(form.action, {
                        method: "POST",
                        body: new FormData(form),
                        headers: { "X-Requested-With": "XMLHttpRequest" }
                    });

                    const result = await response.json();
                    if (!response.ok || !result.success) {
                        setStatus(result.message || form.dataset.saveError, false);
                        return;
                    }

                    applyBlockIds("Input.QuestionBlocks", result.questionBlocks);
                    applyBlockIds("Input.AnswerBlocks", result.answerBlocks);
                    setStatus(result.message, true);
                    statusTimeout = setTimeout(() => {
                        status.hidden = true;
                    }, 3000);
                } catch {
                    setStatus(form.dataset.saveError, false);
                } finally {
                    submitter?.removeAttribute("disabled");
                }
            });
        })();
    </script>
}
