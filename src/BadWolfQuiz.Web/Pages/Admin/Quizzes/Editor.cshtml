@page "{id:int}"
@model BadWolfQuiz.Web.Pages.Admin.Quizzes.EditorModel
@functions {
    private static bool HasBlockContent(ContentBlockBase block) =>
        block.BlockType switch
        {
            ContentBlockType.Text =>
                !string.IsNullOrWhiteSpace(block.TextContent),
            ContentBlockType.Image or ContentBlockType.Audio =>
                block.FileData is { Length: > 0 } ||
                !string.IsNullOrWhiteSpace(block.MediaPath) ||
                !string.IsNullOrWhiteSpace(block.ExternalUrl),
            ContentBlockType.Video or ContentBlockType.YouTube =>
                !string.IsNullOrWhiteSpace(block.ExternalUrl) ||
                !string.IsNullOrWhiteSpace(block.MediaPath),
            _ => false
        };
}
@{
    ViewData["Title"] = Model.Quiz.Title;

    var rounds = Model.Quiz.Rounds
        .OrderBy(x => x.SortOrder)
        .ToList();

    var round = rounds.Single(x => x.Id == Model.SelectedRoundId);

    var roundRows = round.Rows
        .OrderBy(x => x.RowIndex)
        .ToList();

    var categories = round.Categories
        .OrderBy(x => x.SortOrder)
        .ToList();

    var eligibleRandomWagerQuestionCount = categories
        .SelectMany(category => category.Questions)
        .Count(question => !question.ExcludeFromRandomWagerSelection);

    var rowsWithQuestionContent = categories
        .SelectMany(category => category.Questions)
        .Where(question =>
            question.QuestionBlocks.Any(HasBlockContent) ||
            question.AnswerBlocks.Any(HasBlockContent))
        .Select(question => question.RowIndex)
        .Distinct()
        .OrderBy(rowIndex => rowIndex)
        .ToList();

    var filledCategoryPositions = categories
        .Select((category, index) => new
        {
            Position = index + 1,
            HasContent = category.Questions.Any(question =>
                question.QuestionBlocks.Any(HasBlockContent) ||
                question.AnswerBlocks.Any(HasBlockContent))
        })
        .Where(item => item.HasContent)
        .Select(item => item.Position)
        .ToList();
}

@if (TempData["SuccessMessage"] is string successMessage)
{
    <div id="success-message"
         class="alert alert-success"
         role="status">
        @successMessage
    </div>
}

@if (TempData["ErrorMessage"] is string errorMessage)
{
    <div class="alert alert-error"
         role="alert">
        @errorMessage
    </div>
}

<div class="editor-toolbar">
    <div>
        <p class="eyebrow">@Localizer["Title_QuizEditor"]</p>
        <h1>@Model.Quiz.Title</h1>
    </div>

    <div class="round-navigation">
        <div class="round-tabs" id="roundTabs">
            @foreach (var item in rounds)
            {
                <div class="round-tab round-tab-item @(item.Id == Model.SelectedRoundId ? "active" : null)"
                     data-round-id="@item.Id">

                    <span class="round-drag-handle"
                          title="Drag to reorder"
                          aria-hidden="true">
                        ⋮⋮
                    </span>

                    <a asp-page="Editor"
                       asp-route-id="@Model.Quiz.Id"
                       asp-route-selectedRoundId="@item.Id"
                       class="round-tab-link">
                        @item.Title
                    </a>
                </div>
            }

            <button type="button"
                    class="round-tab round-add-button button button-secondary"
                    onclick="openAddRoundDialog()">
                + @Localizer["QuizEditor_AddRound"]
            </button>
        </div>

        <div class="round-actions">
            <a class="button button-secondary round-action-button"
               asp-page="FinalQuestionEditor"
               asp-route-id="@Model.Quiz.Id">
                @Localizer["Button_EditFinalQuestion"]
            </a>

            @if (Model.Quiz.FinalQuestionBlocks.Any(HasBlockContent) ||
                Model.Quiz.FinalAnswerBlocks.Any(HasBlockContent))
            {
                <button type="button"
                        class="button button-danger-outline round-action-button"
                        onclick="openDeleteFinalQuestionDialog()">
                    @Localizer["Button_DeleteFinalQuestion"]
                </button>
            }

            <button type="button"
                    class="button button-secondary round-action-button"
                    onclick="openRenameRoundDialog()">
                @Localizer["QuizEditor_RenameRound"]
            </button>

            @if (rounds.Count > 1)
            {
                <button type="button"
                        class="button button-danger-outline round-action-button"
                        onclick="openDeleteRoundDialog()">
                    @Localizer["QuizEditor_DeleteRound"]
                </button>
            }
        </div>
    </div>
</div>

<form method="post"
      asp-page-handler="SaveRoundRows"
      class="quiz-board-form"
      data-save-error="@Localizer["Error_Unexpected"]">
    <input asp-for="RoundRows.QuizId"
           type="hidden"
           value="@Model.Quiz.Id" />

    <input asp-for="RoundRows.RoundId"
           type="hidden"
           value="@round.Id" />

    <section class="content-panel round-wager-settings">
        <div id="round-category-count-setting">
            <label asp-for="RoundRows.CategoryCount">
                @Localizer["QuizEditor_CategoryCount"]
            </label>
            <select asp-for="RoundRows.CategoryCount"
                    data-initial-count="@categories.Count"
                    data-filled-items="@string.Join(",", filledCategoryPositions)"
                    data-delete-confirmation="@Localizer["QuizEditor_CategoryCountDeleteConfirmation"]">
                @for (var categoryCount = Model.MinimumCategoryCount;
                      categoryCount <= Model.MaximumCategoryCount;
                      categoryCount++)
                {
                    <option value="@categoryCount">@categoryCount</option>
                }
            </select>
            <small>
                @Localizer["QuizEditor_CategoryCountDescription",
                    Model.MinimumCategoryCount,
                    Model.MaximumCategoryCount]
            </small>
        </div>

        <div id="round-question-count-setting">
            <label asp-for="RoundRows.QuestionCount">
                @Localizer["QuizEditor_QuestionCount"]
            </label>
            <select asp-for="RoundRows.QuestionCount"
                    data-initial-count="@roundRows.Count"
                    data-filled-items="@string.Join(",", rowsWithQuestionContent)"
                    data-delete-confirmation="@Localizer["QuizEditor_QuestionCountDeleteConfirmation"]">
                @for (var questionCount = Model.MinimumQuestionCount;
                      questionCount <= Model.MaximumQuestionCount;
                      questionCount++)
                {
                    <option value="@questionCount">@questionCount</option>
                }
            </select>
            <small>
                @Localizer["QuizEditor_QuestionCountDescription",
                    Model.MinimumQuestionCount,
                    Model.MaximumQuestionCount]
            </small>
        </div>

        <label class="checkbox-row">
            <input asp-for="RoundRows.UseRandomWagerQuestions" />
            <span>
                <strong>@Localizer["QuizEditor_UseRandomWagerQuestions"]</strong>
                <small>@Localizer["QuizEditor_RandomWagerDescription"]</small>
            </span>
        </label>

        <div id="random-wager-count-setting">
            <label asp-for="RoundRows.RandomWagerQuestionCount">
                @Localizer["QuizEditor_RandomWagerQuestionCount"]
            </label>
            <input asp-for="RoundRows.RandomWagerQuestionCount"
                   type="number"
                   min="0"
                   max="@eligibleRandomWagerQuestionCount" />
            <small>
                @Localizer["QuizEditor_EligibleRandomWagerQuestions",
                    eligibleRandomWagerQuestionCount]
            </small>
        </div>
    </section>

    <div class="quiz-board-scroll">
        <div class="quiz-board" style="--row-count:@roundRows.Count;">
            <div class="quiz-board-points-column">
                <div class="quiz-board-corner" aria-hidden="true"></div>

                @for (var rowIndex = 0; rowIndex < roundRows.Count; rowIndex++)
                {
                    <div class="question-points-cell">
                        <input asp-for="RoundRows.Rows[rowIndex].RowIndex"
                               type="hidden"
                               value="@roundRows[rowIndex].RowIndex" />

                        <label asp-for="RoundRows.Rows[rowIndex].Points"
                               class="visually-hidden">
                            @Localizer["QuizEditor_RowNumber", roundRows[rowIndex].RowIndex]
                        </label>

                        <input asp-for="RoundRows.Rows[rowIndex].Points"
                               class="question-points-input"
                               type="number"
                               min="0"
                               step="100"
                               value="@roundRows[rowIndex].Points" />
                    </div>
                }
            </div>

            <div class="quiz-board-categories" id="categoryColumns">
                @foreach (var category in categories)
                {
                    <div id="category-@category.Id"
                         class="quiz-board-category-column"
                         data-category-id="@category.Id">
                        <div class="category-cell">
                            <span class="category-drag-handle"
                                  title="Drag to reorder"
                                  aria-hidden="true">⋮⋮</span>

                            <span class="category-title">@category.Title</span>

                            <div class="category-actions">
                                <button type="button"
                                        class="js-category-rename button button-secondary icon-button"
                                        data-category-id="@category.Id"
                                        data-category-title="@category.Title">
                                    ✏️
                                </button>

                                @if (Model.Quiz.Rounds.Count > 1)
                                {
                                    <button type="button"
                                            class="js-category-exchange button button-secondary icon-button"
                                            data-category-id="@category.Id"
                                            data-category-title="@category.Title"
                                            data-round-id="@round.Id">
                                        ⇅
                                    </button>
                                }
                            </div>
                        </div>

                        @foreach (var roundRow in roundRows)
                        {
                            var question = category.Questions
                                .SingleOrDefault(x => x.RowIndex == roundRow.RowIndex);

                            if (question is null)
                            {
                                <div class="question-cell"></div>
                                continue;
                            }

                            var orderedQuestionBlocks = question.QuestionBlocks
                                .OrderBy(x => x.SortOrder)
                                .ToList();
                            var hasQuestion = orderedQuestionBlocks.Any(HasBlockContent);
                            var hasAnswer = question.AnswerBlocks.Any(HasBlockContent);
                            var previewBlock = orderedQuestionBlocks
                                .FirstOrDefault(HasBlockContent);
                            string? previewImageUrl = null;

                            if (previewBlock?.BlockType == ContentBlockType.Image)
                            {
                                previewImageUrl = previewBlock.FileData is { Length: > 0 }
                                    ? Url.Page(
                                        "QuestionEditor",
                                        "QuestionBlockFile",
                                        new { id = previewBlock.Id })
                                    : previewBlock.MediaPath;
                            }

                            <div class="question-cell-slot"
                                 draggable="true"
                                 data-question-id="@question.Id"
                                 data-question-title="@category.Title — @roundRow.Points"
                                 title="@Localizer["QuizEditor_DragQuestion"]">
                                <a class="question-cell @(hasQuestion ? "filled" : null) @(question.IsSpecial ? "wager-question" : null)"
                                   asp-page="QuestionEditor"
                                   asp-route-id="@question.Id">
                                    @if (question.IsSpecial)
                                    {
                                        <span class="question-wager-badge">
                                            @Localizer["Label_WagerQuestion"]
                                        </span>
                                    }
                                    else if (question.PresentationType == BadWolfQuiz.Game.Definitions.QuestionPresentationType.FourClues)
                                    {
                                        <span class="question-wager-badge">
                                            @Localizer["QuestionType_FourClues"]
                                        </span>
                                    }

                                    <span class="question-editor-preview">
                                        @if (!string.IsNullOrWhiteSpace(previewImageUrl))
                                        {
                                            <img src="@previewImageUrl"
                                                 alt="@Localizer["Label_Question"]" />
                                        }
                                        else if (previewBlock?.BlockType == ContentBlockType.Text)
                                        {
                                            <span class="question-editor-preview-text">
                                                @previewBlock.TextContent
                                            </span>
                                        }
                                        else if (previewBlock is not null)
                                        {
                                            <span class="question-editor-preview-media"
                                                  aria-hidden="true">
                                                @(previewBlock.BlockType switch
                                                {
                                                    ContentBlockType.Audio => "♪",
                                                    ContentBlockType.Video => "▶",
                                                    ContentBlockType.YouTube => "▶",
                                                    _ => "◆"
                                                })
                                            </span>
                                            <span class="question-editor-preview-type">
                                                @Localizer[$"Content_{previewBlock.BlockType}"]
                                            </span>
                                        }
                                    </span>

                                    <span class="question-completion"
                                          aria-label="@Localizer["Label_Question"] @(hasQuestion ? "✓" : "—"), @Localizer["Label_CorrectAnswer"] @(hasAnswer ? "✓" : "—")">
                                        <span class="question-completion-item @(hasQuestion ? "complete" : null)"
                                              title="@Localizer["Label_Question"]">
                                            Q @(hasQuestion ? "✓" : "—")
                                        </span>
                                        <span class="question-completion-item @(hasAnswer ? "complete" : null)"
                                              title="@Localizer["Label_CorrectAnswer"]">
                                            A @(hasAnswer ? "✓" : "—")
                                        </span>
                                    </span>

                                    @if (hasQuestion && hasAnswer)
                                    {
                                        <small class="visually-hidden">@Localizer["Status_Ready"]</small>
                                    }
                                </a>

                                <div class="question-card-actions">
                                    @if (rounds.Count > 1)
                                    {
                                        <button type="button"
                                                class="js-question-exchange button button-secondary icon-button"
                                                draggable="false"
                                                data-question-id="@question.Id"
                                                data-question-title="@category.Title — @roundRow.Points"
                                                data-round-id="@round.Id"
                                                title="@Localizer["QuizEditor_MoveQuestionToRound"]"
                                                aria-label="@Localizer["QuizEditor_MoveQuestionToRound"]">
                                            ⇅
                                        </button>
                                    }
                                    @if (hasQuestion || hasAnswer)
                                    {
                                        <button type="button"
                                                class="js-question-delete button button-danger icon-button"
                                                draggable="false"
                                                data-question-id="@question.Id"
                                                data-question-title="@category.Title — @roundRow.Points"
                                                title="@Localizer["Dialog_DeleteQuestion_Title"]"
                                                aria-label="@Localizer["Dialog_DeleteQuestion_Title"]">
                                            🗑
                                        </button>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="quiz-board-actions form-actions">
        <a id="quiz-editor-my-quizzes"
           class="button button-secondary"
           asp-page="Index">
            @Localizer["Title_MyQuizzes"]
        </a>
        <div class="quiz-board-primary-actions">
            <span class="alert ajax-save-status" role="status"
                  data-quiz-save-status hidden></span>
            <button type="submit"
                    class="button button-primary"
                    data-ajax-save-round>
                @Localizer["Button_Save"]
            </button>
            <button type="submit"
                    name="play"
                    value="true"
                    class="button button-primary">
                @Localizer["Button_CreateGame"]
            </button>
        </div>
    </div>
</form>

<dialog id="add-round-dialog" class="app-dialog">
    <div class="dialog-card">
        <div class="dialog-heading">
            <h2>@Localizer["QuizEditor_NewRound"]</h2>

            <button type="button"
                    class="dialog-close"
                    onclick="closeAddRoundDialog()">
                ×
            </button>
        </div>

        <form method="post" asp-page-handler="AddRound">
            <input asp-for="AddRound.QuizId"
                   type="hidden"
                   value="@Model.Quiz.Id" />

            <label asp-for="AddRound.Title">
                @Localizer["QuizEditor_RoundTitle"]
            </label>

            <input asp-for="AddRound.Title"
                   id="add-round-title"
                   maxlength="100" />

            <div class="dialog-actions form-actions">
                <button type="button"
                        class="button button-secondary"
                        onclick="closeAddRoundDialog()">
                    @Localizer["Button_Cancel"]
                </button>

                <button type="submit"
                        class="button button-primary">
                    @Localizer["QuizEditor_AddRound"]
                </button>
            </div>
        </form>
    </div>
</dialog>

<dialog id="delete-question-dialog" class="app-dialog">
    <div class="dialog-card dialog-card-danger">
        <div class="dialog-heading">
            <h2>@Localizer["Dialog_DeleteQuestion_Title"]</h2>
            <button type="button"
                    class="dialog-close"
                    data-close-delete-question
                    aria-label="@Localizer["Button_Cancel"]">
                ×
            </button>
        </div>

        <p class="dialog-warning">
            @Localizer["Dialog_DeleteQuestion_Text"]
        </p>
        <div class="dialog-target" data-delete-question-title></div>

        <form method="post"
              asp-page-handler="DeleteQuestion"
              data-delete-question-form>
            <input asp-for="DeleteQuestion.QuizId"
                   type="hidden"
                   value="@Model.Quiz.Id" />
            <input asp-for="DeleteQuestion.QuestionId"
                   id="delete-question-id"
                   type="hidden" />

            <div class="dialog-actions form-actions">
                <button type="button"
                        class="button button-secondary"
                        data-close-delete-question>
                    @Localizer["Button_Cancel"]
                </button>
                <button type="submit" class="button button-danger">
                    @Localizer["Button_Delete"]
                </button>
            </div>
        </form>
    </div>
</dialog>

<dialog id="delete-final-question-dialog" class="app-dialog">
    <div class="dialog-card dialog-card-danger">
        <div class="dialog-heading">
            <h2>@Localizer["Dialog_DeleteFinalQuestion_Title"]</h2>
            <button type="button"
                    class="dialog-close"
                    onclick="closeDeleteFinalQuestionDialog()"
                    aria-label="@Localizer["Button_Cancel"]">
                ×
            </button>
        </div>

        <p class="dialog-warning">
            @Localizer["Dialog_DeleteFinalQuestion_Text"]
        </p>

        <form method="post" asp-page-handler="DeleteFinalQuestion">
            <input asp-for="DeleteFinalQuestion.QuizId"
                   type="hidden"
                   value="@Model.Quiz.Id" />
            <input asp-for="DeleteFinalQuestion.RoundId"
                   type="hidden"
                   value="@round.Id" />

            <div class="dialog-actions form-actions">
                <button type="button"
                        class="button button-secondary"
                        onclick="closeDeleteFinalQuestionDialog()">
                    @Localizer["Button_Cancel"]
                </button>
                <button type="submit" class="button button-danger">
                    @Localizer["Button_Delete"]
                </button>
            </div>
        </form>
    </div>
</dialog>

<dialog id="rename-round-dialog" class="app-dialog">
    <div class="dialog-card">
        <div class="dialog-heading">
            <h2>@Localizer["QuizEditor_RenameRound"]</h2>

            <button type="button"
                    class="dialog-close"
                    onclick="closeRenameRoundDialog()">
                ×
            </button>
        </div>

        <form method="post" asp-page-handler="RenameRound">
            <input asp-for="RenameRound.QuizId"
                   type="hidden"
                   value="@Model.Quiz.Id" />

            <input asp-for="RenameRound.RoundId"
                   type="hidden"
                   value="@round.Id" />

            <label asp-for="RenameRound.Title">
                @Localizer["QuizEditor_RoundTitle"]
            </label>

            <input asp-for="RenameRound.Title"
                   id="rename-round-title"
                   value="@round.Title"
                   maxlength="100"
                   required />

            <div class="dialog-actions form-actions">
                <button type="button"
                        class="button button-secondary"
                        onclick="closeRenameRoundDialog()">
                    @Localizer["Button_Cancel"]
                </button>

                <button type="submit"
                        class="button button-primary">
                    @Localizer["Button_Save"]
                </button>
            </div>
        </form>
    </div>
</dialog>

<dialog id="rename-category-dialog" class="app-dialog">
    <div class="dialog-card">
        <div class="dialog-heading">
            <h2>@Localizer["QuizEditor_RenameCategory"]</h2>

            <button type="button"
                    class="dialog-close"
                    onclick="closeRenameCategoryDialog()">
                ×
            </button>
