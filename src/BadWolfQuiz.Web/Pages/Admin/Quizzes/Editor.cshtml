        <form method="post" asp-page-handler="RenameCategory">
            <input asp-for="RenameCategory.QuizId"
                   type="hidden"
                   value="@Model.Quiz.Id" />

            <input asp-for="RenameCategory.CategoryId"
                   id="rename-category-id"
                   type="hidden" />

            <label asp-for="RenameCategory.Title">
                @Localizer["QuizEditor_CategoryTitle"]
            </label>

            <input asp-for="RenameCategory.Title"
                   id="rename-category-title"
                   maxlength="100"
                   required />

            <div class="dialog-actions form-actions">
                <button type="button"
                        class="button button-secondary"
                        onclick="closeRenameCategoryDialog()">
                    @Localizer["Button_Cancel"]
                </button>

                <button type="submit"
                        class="button button-primary">
                    @Localizer["Button_Save"]
                </button>
            </div>
        </form>
    </div>
</dialog>

<dialog id="exchange-category-dialog" class="app-dialog">
    <div class="dialog-card">
        <div class="dialog-heading">
            <h2>@Localizer["QuizEditor_ExchangeCategory"]</h2>

            <button type="button"
                    class="dialog-close"
                    onclick="closeExchangeCategoryDialog()">
                ×
            </button>
        </div>

        <form method="post"
              asp-page-handler="ExchangeCategories">

            <input asp-for="ExchangeCategories.QuizId"
                   type="hidden"
                   value="@Model.Quiz.Id" />

            <input asp-for="ExchangeCategories.SourceCategoryId"
                   id="exchange-category-source-id"
                   type="hidden" />

            <p class="dialog-warning">
                @Localizer["QuizEditor_SelectedCategory"]
            </p>

            <div id="exchange-category-source-title"
                 class="dialog-target">
            </div>

            <div style="margin-top: 20px;">
                <label for="exchange-category-target-round">
                    @Localizer["QuizEditor_TargetRound"]
                </label>

                <select id="exchange-category-target-round"
                        onchange="refreshExchangeTargetCategories()">
                </select>
            </div>

            <div style="margin-top: 16px;">
                <label for="exchange-category-target-category">
                    @Localizer["QuizEditor_TargetCategory"]
                </label>

                <select asp-for="ExchangeCategories.TargetCategoryId"
                        id="exchange-category-target-category"
                        onchange="updateExchangeButtonState()"
                        required>
                </select>
            </div>

            <p id="exchange-category-empty-message"
               class="dialog-warning"
               style="display: none; margin-top: 16px;">
                There is no category available for exchange.
            </p>

            <div class="dialog-actions form-actions">
                <button type="button"
                        class="button button-secondary"
                        onclick="closeExchangeCategoryDialog()">
                    @Localizer["Button_Cancel"]
                </button>

                <button id="exchange-category-submit-button"
                        type="submit"
                        class="button button-primary"
                        disabled>
                    @Localizer["QuizEditor_Exchange"]
                </button>
            </div>
        </form>
    </div>
</dialog>

<dialog id="exchange-question-dialog" class="app-dialog">
    <div class="dialog-card">
        <div class="dialog-heading">
            <h2>@Localizer["QuizEditor_ExchangeQuestion"]</h2>

            <button type="button"
                    class="dialog-close"
                    onclick="closeExchangeQuestionDialog()">
                ×
            </button>
        </div>

        <form method="post" asp-page-handler="ExchangeQuestions">
            <input asp-for="ExchangeQuestions.QuizId"
                   type="hidden"
                   value="@Model.Quiz.Id" />

            <input asp-for="ExchangeQuestions.SourceQuestionId"
                   id="exchange-question-source-id"
                   type="hidden" />

            <p class="dialog-warning">
                @Localizer["QuizEditor_SelectedQuestion"]
            </p>

            <div id="exchange-question-source-title"
                 class="dialog-target">
            </div>

            <div style="margin-top: 20px;">
                <label for="exchange-question-target-round">
                    @Localizer["QuizEditor_TargetRound"]
                </label>

                <select id="exchange-question-target-round"
                        onchange="refreshExchangeTargetQuestions()">
                </select>
            </div>

            <div style="margin-top: 16px;">
                <label for="exchange-question-target-question">
                    @Localizer["QuizEditor_TargetQuestion"]
                </label>

                <select asp-for="ExchangeQuestions.TargetQuestionId"
                        id="exchange-question-target-question"
                        onchange="updateExchangeQuestionButtonState()"
                        required>
                </select>
            </div>

            <p id="exchange-question-empty-message"
               class="dialog-warning"
               style="display: none; margin-top: 16px;">
                @Localizer["QuizEditor_NoQuestionForExchange"]
            </p>

            <div class="dialog-actions form-actions">
                <button type="button"
                        class="button button-secondary"
                        onclick="closeExchangeQuestionDialog()">
                    @Localizer["Button_Cancel"]
                </button>

                <button id="exchange-question-submit-button"
                        type="submit"
                        class="button button-primary"
                        disabled>
                    @Localizer["QuizEditor_Exchange"]
                </button>
            </div>
        </form>
    </div>
</dialog>

@if (rounds.Count > 1)
{
    <dialog id="delete-round-dialog" class="app-dialog">
        <div class="dialog-card dialog-card-danger">
            <div class="dialog-heading">
                <h2>@Localizer["QuizEditor_DeleteRound"]</h2>

                <button type="button"
                        class="dialog-close"
                        onclick="closeDeleteRoundDialog()">
                    ×
                </button>
            </div>

            <p class="dialog-warning">
                @Localizer["QuizEditor_DeleteRoundWarning"]
            </p>

            <div class="dialog-target">
                @round.Title
            </div>

            <form method="post" asp-page-handler="DeleteRound">
                <input asp-for="DeleteRound.QuizId"
                       type="hidden"
                       value="@Model.Quiz.Id" />

                <input asp-for="DeleteRound.RoundId"
                       type="hidden"
                       value="@round.Id" />

                <div class="dialog-actions form-actions">
                    <button type="button"
                            class="button button-secondary"
                            onclick="closeDeleteRoundDialog()">
                        @Localizer["Button_Cancel"]
                    </button>

                    <button type="submit"
                            class="button button-danger">
                        @Localizer["Button_Delete"]
                    </button>
                </div>
            </form>
        </div>
    </dialog>
}

<dialog id="count-reduction-dialog" class="app-dialog">
    <div class="dialog-card dialog-card-danger">
        <div class="dialog-heading">
            <h2>@Localizer["QuizEditor_CountReductionTitle"]</h2>
            <button type="button"
                    class="dialog-close"
                    onclick="cancelCountReduction()"
                    aria-label="@Localizer["Button_Cancel"]">
                ×
            </button>
        </div>

        <p class="dialog-warning" data-count-reduction-message></p>

        <div class="dialog-actions form-actions">
            <button type="button"
                    class="button button-secondary"
                    onclick="cancelCountReduction()">
                @Localizer["Button_Cancel"]
            </button>
            <button type="button"
                    class="button button-danger"
                    onclick="confirmCountReduction()">
                @Localizer["Button_Delete"]
            </button>
        </div>
    </div>
</dialog>

@section Scripts
{
    <script>
        const randomWagerCheckbox =
            document.getElementById("RoundRows_UseRandomWagerQuestions");

        const questionCountSelect =
            document.getElementById("RoundRows_QuestionCount");

        const categoryCountSelect =
            document.getElementById("RoundRows_CategoryCount");

        const quizBoardForm = document.querySelector(".quiz-board-form");

        const quizSaveStatus = document.querySelector("[data-quiz-save-status]");
        let quizSaveStatusTimeout;

        const showQuizSaveStatus = (message, success) => {
            clearTimeout(quizSaveStatusTimeout);
            quizSaveStatus.textContent = message;
            quizSaveStatus.classList.toggle("alert-success", success);
            quizSaveStatus.classList.toggle("alert-error", !success);
            quizSaveStatus.hidden = false;

            if (success) {
                quizSaveStatusTimeout = setTimeout(() => {
                    quizSaveStatus.hidden = true;
                }, 4000);
            }
        };

        quizBoardForm?.addEventListener("submit", async event => {
            const submitter = event.submitter;
            if (!submitter?.matches("[data-ajax-save-round]")) {
                return;
            }

            event.preventDefault();
            submitter.disabled = true;
            clearTimeout(quizSaveStatusTimeout);
            quizSaveStatus.hidden = true;

            try {
                const response = await fetch(quizBoardForm.action, {
                    method: "POST",
                    body: new FormData(quizBoardForm),
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                const result = await response.json();
                if (!response.ok || !result.success) {
                    throw new Error(result.error || quizBoardForm.dataset.saveError);
                }

                showQuizSaveStatus(result.message, true);
            } catch (error) {
                showQuizSaveStatus(
                    error.message || quizBoardForm.dataset.saveError,
                    false);
            } finally {
                submitter.disabled = false;
            }
        });

        const deleteQuestionDialog =
            document.getElementById("delete-question-dialog");
        const deleteQuestionForm = document.querySelector(
            "[data-delete-question-form]");
        let pendingDeleteQuestionButton = null;

        document.querySelectorAll(".js-question-delete").forEach(button => {
            button.addEventListener("click", () => {
                pendingDeleteQuestionButton = button;
                document.getElementById("delete-question-id").value =
                    button.dataset.questionId;
                deleteQuestionDialog.querySelector(
                    "[data-delete-question-title]").textContent =
                    button.dataset.questionTitle;
                deleteQuestionDialog.showModal();
            });
        });

        deleteQuestionForm?.addEventListener("submit", async event => {
            event.preventDefault();
            const submitter = event.submitter;
            submitter.disabled = true;

            try {
                const response = await fetch(deleteQuestionForm.action, {
                    method: "POST",
                    body: new FormData(deleteQuestionForm),
                    headers: { "X-Requested-With": "XMLHttpRequest" }
                });
                const result = await response.json();
                if (!response.ok || !result.success) {
                    throw new Error(
                        result.error || quizBoardForm.dataset.saveError);
                }

                const slot = pendingDeleteQuestionButton?.closest(
                    ".question-cell-slot");
                const questionCard = slot?.querySelector(".question-cell");
                questionCard?.classList.remove("filled");
                const preview = questionCard?.querySelector(
                    ".question-editor-preview");
                if (preview) {
                    preview.replaceChildren();
                }
                questionCard?.querySelectorAll(
                    ".question-completion-item").forEach(item => {
                        item.classList.remove("complete");
                        item.textContent = `${item.textContent.trim()[0]} —`;
                    });
                questionCard?.querySelector(".visually-hidden")?.remove();
                pendingDeleteQuestionButton?.remove();
                pendingDeleteQuestionButton = null;
                deleteQuestionDialog.close();
                showQuizSaveStatus(result.message, true);
            } catch (error) {
                deleteQuestionDialog.close();
                showQuizSaveStatus(
                    error.message || quizBoardForm.dataset.saveError,
                    false);
            } finally {
                submitter.disabled = false;
            }
        });

        document.querySelectorAll("[data-close-delete-question]")
            .forEach(button => {
                button.addEventListener("click", () =>
                    deleteQuestionDialog.close());
            });

        const countReductionDialog =
            document.getElementById("count-reduction-dialog");

        let pendingCountSelect = null;

        const cancelCountReduction = () => {
            if (pendingCountSelect) {
                pendingCountSelect.value =
                    pendingCountSelect.dataset.initialCount;
            }
            pendingCountSelect = null;
            countReductionDialog?.close();
        };

        const confirmCountReduction = () => {
            pendingCountSelect = null;
            countReductionDialog?.close();
            quizBoardForm?.requestSubmit();
        };

        const saveCountChange = select => {
            const initialCount = Number(
                select.dataset.initialCount);
            const nextCount = Number(select.value);
            const filledItems = (select.dataset.filledItems ?? "")
                .split(",")
                .filter(Boolean)
                .map(Number);
            const deletesFilledQuestion =
                nextCount < initialCount &&
                filledItems.some(position => position > nextCount);

            if (deletesFilledQuestion) {
                pendingCountSelect = select;
                const message = countReductionDialog?.querySelector(
                    "[data-count-reduction-message]");
                if (message) {
                    message.textContent = select.dataset.deleteConfirmation;
                }
                countReductionDialog?.showModal();
                return;
            }

            quizBoardForm?.requestSubmit();
        };

        questionCountSelect?.addEventListener(
            "change",
            () => saveCountChange(questionCountSelect));
        categoryCountSelect?.addEventListener(
            "change",
            () => saveCountChange(categoryCountSelect));

        countReductionDialog?.addEventListener("cancel", event => {
            event.preventDefault();
            cancelCountReduction();
        });

        const randomWagerCountSetting =
            document.getElementById("random-wager-count-setting");

        function updateRandomWagerSettings() {
            if (randomWagerCountSetting) {
                randomWagerCountSetting.hidden =
                    !(randomWagerCheckbox?.checked ?? false);
            }
        }

        randomWagerCheckbox?.addEventListener(
            "change",
            updateRandomWagerSettings);

        updateRandomWagerSettings();

        const exchangeCategoryRounds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            rounds.Select(roundItem => new
            {
                id = roundItem.Id,
                title = roundItem.Title,
                categories = roundItem.Categories
                    .OrderBy(categoryItem => categoryItem.SortOrder)
                    .Select(categoryItem => new
                    {
                        id = categoryItem.Id,
                        title = categoryItem.Title
                    })
            })));

        const exchangeQuestionRounds = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(
            rounds.Select(roundItem => new
            {
                id = roundItem.Id,
                title = roundItem.Title,
                questions = roundItem.Categories
                    .OrderBy(categoryItem => categoryItem.SortOrder)
                    .SelectMany(categoryItem => categoryItem.Questions
                        .OrderBy(questionItem => questionItem.RowIndex)
                        .Select(questionItem => new
                        {
                            id = questionItem.Id,
                            category = categoryItem.Title,
                            points = roundItem.Rows
                                .Single(rowItem =>
                                    rowItem.RowIndex == questionItem.RowIndex)
                                .Points
                        }))
            })));

        function openExchangeCategoryDialog(categoryId, categoryTitle, sourceRoundId) {
            const dialog = document.getElementById("exchange-category-dialog");
            const sourceIdInput = document.getElementById("exchange-category-source-id");
            const sourceTitle = document.getElementById("exchange-category-source-title");
            const targetRoundSelect = document.getElementById("exchange-category-target-round");

            sourceIdInput.value = categoryId;
            sourceTitle.textContent = categoryTitle;
            targetRoundSelect.innerHTML = "";

            const availableRounds = exchangeCategoryRounds.filter(
                roundItem => roundItem.id !== sourceRoundId &&
                             roundItem.categories.length > 0
            );

            for (const roundItem of availableRounds) {
                const option = document.createElement("option");
                option.value = roundItem.id.toString();
                option.textContent = roundItem.title;
                targetRoundSelect.appendChild(option);
            }

            refreshExchangeTargetCategories();
            dialog.showModal();
        }

        function refreshExchangeTargetCategories() {
            const targetRoundSelect = document.getElementById("exchange-category-target-round");
            const targetCategorySelect = document.getElementById("exchange-category-target-category");
            const emptyMessage = document.getElementById("exchange-category-empty-message");

            targetCategorySelect.innerHTML = "";

            const selectedRoundId = Number(targetRoundSelect.value);
            const selectedRound = exchangeCategoryRounds.find(
                roundItem => roundItem.id === selectedRoundId
            );

            if (selectedRound) {
                for (const categoryItem of selectedRound.categories) {
                    const option = document.createElement("option");
                    option.value = categoryItem.id.toString();
                    option.textContent = categoryItem.title;
                    targetCategorySelect.appendChild(option);
                }
            }

            const hasAvailableTarget =
                targetRoundSelect.options.length > 0 &&
                targetCategorySelect.options.length > 0;

            targetRoundSelect.disabled = targetRoundSelect.options.length === 0;
            targetCategorySelect.disabled = !hasAvailableTarget;
            emptyMessage.style.display = hasAvailableTarget ? "none" : "block";

            updateExchangeButtonState();
        }

        function updateExchangeButtonState() {
            const targetRoundSelect = document.getElementById("exchange-category-target-round");
            const targetCategorySelect = document.getElementById("exchange-category-target-category");
            const submitButton = document.getElementById("exchange-category-submit-button");

            submitButton.disabled =
                !targetRoundSelect.value ||
                !targetCategorySelect.value;
        }

        function closeExchangeCategoryDialog() {
            document.getElementById("exchange-category-dialog").close();
        }

        function openExchangeQuestionDialog(questionId, questionTitle, sourceRoundId) {
            const dialog = document.getElementById("exchange-question-dialog");
            const sourceIdInput = document.getElementById("exchange-question-source-id");
            const sourceTitle = document.getElementById("exchange-question-source-title");
            const targetRoundSelect = document.getElementById("exchange-question-target-round");

            sourceIdInput.value = questionId;
            sourceTitle.textContent = questionTitle;
            targetRoundSelect.innerHTML = "";

            const availableRounds = exchangeQuestionRounds.filter(
                roundItem => roundItem.id !== sourceRoundId &&
                             roundItem.questions.length > 0
            );

            for (const roundItem of availableRounds) {
                const option = document.createElement("option");
                option.value = roundItem.id.toString();
                option.textContent = roundItem.title;
                targetRoundSelect.appendChild(option);
            }

            refreshExchangeTargetQuestions();
            dialog.showModal();
        }

        function refreshExchangeTargetQuestions() {
            const targetRoundSelect = document.getElementById("exchange-question-target-round");
            const targetQuestionSelect = document.getElementById("exchange-question-target-question");
            const emptyMessage = document.getElementById("exchange-question-empty-message");

            targetQuestionSelect.innerHTML = "";

            const selectedRoundId = Number(targetRoundSelect.value);
            const selectedRound = exchangeQuestionRounds.find(
                roundItem => roundItem.id === selectedRoundId
            );

            if (selectedRound) {
                for (const questionItem of selectedRound.questions) {
                    const option = document.createElement("option");
                    option.value = questionItem.id.toString();
                    option.textContent =
                        `${questionItem.category} — ${questionItem.points}`;
                    targetQuestionSelect.appendChild(option);
                }
            }

            const hasAvailableTarget =
                targetRoundSelect.options.length > 0 &&
                targetQuestionSelect.options.length > 0;

            targetRoundSelect.disabled = targetRoundSelect.options.length === 0;
            targetQuestionSelect.disabled = !hasAvailableTarget;
            emptyMessage.style.display = hasAvailableTarget ? "none" : "block";

            updateExchangeQuestionButtonState();
        }

        function updateExchangeQuestionButtonState() {
            const targetRoundSelect = document.getElementById("exchange-question-target-round");
            const targetQuestionSelect = document.getElementById("exchange-question-target-question");
            const submitButton = document.getElementById("exchange-question-submit-button");

            submitButton.disabled =
                !targetRoundSelect.value ||
                !targetQuestionSelect.value;
        }

        function closeExchangeQuestionDialog() {
            document.getElementById("exchange-question-dialog").close();
        }

        function openAddRoundDialog() {
            const dialog = document.getElementById("add-round-dialog");
            const input = document.getElementById("add-round-title");

            input.value = "";
            dialog.showModal();

            requestAnimationFrame(() => {
                input.focus();
                input.select();
            });
        }

        function closeAddRoundDialog() {
            document.getElementById("add-round-dialog").close();
        }

        function openRenameRoundDialog() {
            const dialog = document.getElementById("rename-round-dialog");
            const input = document.getElementById("rename-round-title");

            dialog.showModal();

            requestAnimationFrame(() => {
                input.focus();
                input.select();
            });
        }

        function closeRenameRoundDialog() {
            document.getElementById("rename-round-dialog").close();
        }

        function openDeleteRoundDialog() {
            document.getElementById("delete-round-dialog").showModal();
        }

        function closeDeleteRoundDialog() {
            document.getElementById("delete-round-dialog").close();
        }

        function openDeleteFinalQuestionDialog() {
            document.getElementById("delete-final-question-dialog").showModal();
        }

        function closeDeleteFinalQuestionDialog() {
            document.getElementById("delete-final-question-dialog").close();
        }

        const successMessage = document.getElementById("success-message");

        if (successMessage) {
            setTimeout(() => {
                successMessage.classList.add("success-message-hidden");

                setTimeout(() => successMessage.remove(), 300);
            }, 3500);
        }
    </script>

    <script src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.6/Sortable.min.js"></script>

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const roundTabs = document.getElementById("roundTabs");
            const categoryColumns = document.getElementById("categoryColumns");

            const getAntiforgeryToken = function () {
                return document.querySelector(
                    'input[name="__RequestVerificationToken"]'
                );
            };

            let draggedQuestionSlot = null;

            document.querySelectorAll(".question-exchange-button").forEach(button => {
                const slot = button.closest(".question-cell-slot");

                button.addEventListener("pointerdown", () => {
                    slot.draggable = false;
                });

                for (const eventName of ["pointerup", "pointercancel", "mouseleave"]) {
                    button.addEventListener(eventName, () => {
                        slot.draggable = true;
                    });
                }
            });

            document.querySelectorAll(".question-cell-slot").forEach(slot => {
                slot.addEventListener("dragstart", event => {
                    if (event.target.closest(".question-exchange-button")) {
                        event.preventDefault();
                        return;
                    }

                    draggedQuestionSlot = slot;
                    slot.classList.add("question-cell-dragging");
                    event.dataTransfer.effectAllowed = "move";
                    event.dataTransfer.setData(
                        "text/plain",
                        slot.dataset.questionId
                    );
                });

                slot.addEventListener("dragover", event => {
                    if (!draggedQuestionSlot ||
                        draggedQuestionSlot === slot) {
                        return;
                    }

                    event.preventDefault();
                    event.dataTransfer.dropEffect = "move";
                    slot.classList.add("question-cell-drop-target");
                });

                slot.addEventListener("dragleave", () => {
                    slot.classList.remove("question-cell-drop-target");
                });

                slot.addEventListener("drop", async event => {
                    event.preventDefault();
                    slot.classList.remove("question-cell-drop-target");

                    if (!draggedQuestionSlot ||
                        draggedQuestionSlot === slot) {
                        return;
                    }

                    await exchangeQuestions(
                        Number(draggedQuestionSlot.dataset.questionId),
                        Number(slot.dataset.questionId),
                        getAntiforgeryToken()
                    );
                });

                slot.addEventListener("dragend", () => {
                    document.querySelectorAll(
                        ".question-cell-dragging, .question-cell-drop-target"
                    ).forEach(element => element.classList.remove(
                        "question-cell-dragging",
                        "question-cell-drop-target"
                    ));

                    draggedQuestionSlot = null;
                });
            });

            if (typeof Sortable === "undefined") {
                return;
            }

            if (roundTabs) {
                new Sortable(roundTabs, {
                    animation: 180,
                    draggable: ".round-tab-item",
                    handle: ".round-drag-handle",
                    ghostClass: "round-tab-ghost",
                    chosenClass: "round-tab-chosen",
                    dragClass: "round-tab-dragging",

                    onEnd: async function (event) {
                        if (event.oldIndex === event.newIndex) {
                            return;
                        }

                        const roundIds = Array.from(
                            roundTabs.querySelectorAll(".round-tab-item")
                        ).map(element => Number(element.dataset.roundId));

                        const formData = new FormData();
                        formData.append("ReorderRounds.QuizId", "@Model.Quiz.Id");

                        for (const roundId of roundIds) {
                            formData.append("ReorderRounds.RoundIds", roundId.toString());
                        }

                        const antiforgeryToken = getAntiforgeryToken();

                        if (antiforgeryToken) {
                            formData.append(
                                "__RequestVerificationToken",
                                antiforgeryToken.value
                            );
                        }

                        try {
                            const response = await fetch("?handler=ReorderRounds", {
                                method: "POST",
                                body: formData
                            });

                            if (!response.ok) {
                                const responseText = await response.text();
                                throw new Error(
                                    `Round reordering failed. Status: ${response.status}. ${responseText}`
                                );
                            }
                        }
                        catch (error) {
                            console.error("Round reorder error:", error);
                            alert(error.message);
                            window.location.reload();
                        }
                    }
                });
            }

            if (categoryColumns) {
                new Sortable(categoryColumns, {
                    animation: 180,
                    draggable: ".quiz-board-category-column",
                    handle: ".category-drag-handle",
                    ghostClass: "category-column-ghost",
                    chosenClass: "category-column-chosen",
                    dragClass: "category-column-dragging",

                    onEnd: async function (event) {
                        if (event.oldIndex === event.newIndex) {
                            return;
                        }

                        const categoryIds = Array.from(
                            categoryColumns.querySelectorAll(".quiz-board-category-column")
                        ).map(element => Number(element.dataset.categoryId));

                        const formData = new FormData();
                        formData.append("ReorderCategories.QuizId", "@Model.Quiz.Id");
                        formData.append("ReorderCategories.RoundId", "@round.Id");

                        for (const categoryId of categoryIds) {
                            formData.append(
                                "ReorderCategories.CategoryIds",
                                categoryId.toString()
                            );
                        }

                        const antiforgeryToken = getAntiforgeryToken();

                        if (antiforgeryToken) {
                            formData.append(
                                "__RequestVerificationToken",
                                antiforgeryToken.value
                            );
                        }

                        try {
                            const response = await fetch("?handler=ReorderCategories", {
                                method: "POST",
                                body: formData
                            });

                            if (!response.ok) {
                                const responseText = await response.text();
                                throw new Error(
                                    `Category reordering failed. Status: ${response.status}. ${responseText}`
                                );
                            }
                        }
                        catch (error) {
                            console.error("Category reorder error:", error);
                            alert(error.message);
                            window.location.reload();
                        }
                    }
                });
            }
        });

        async function exchangeQuestions(sourceQuestionId, targetQuestionId, antiforgeryToken) {
            const formData = new FormData();
            formData.append("ExchangeQuestions.QuizId", "@Model.Quiz.Id");
            formData.append(
                "ExchangeQuestions.SourceQuestionId",
                sourceQuestionId.toString()
            );
            formData.append(
                "ExchangeQuestions.TargetQuestionId",
                targetQuestionId.toString()
            );

            if (antiforgeryToken) {
                formData.append(
                    "__RequestVerificationToken",
                    antiforgeryToken.value
                );
            }

            try {
                const response = await fetch("?handler=ExchangeQuestions", {
                    method: "POST",
                    body: formData
                });

                if (!response.ok) {
                    const responseText = await response.text();
                    throw new Error(
                        `Question exchange failed. Status: ${response.status}. ${responseText}`
                    );
                }

                window.location.reload();
            }
            catch (error) {
                console.error("Question exchange error:", error);
                alert(error.message);
                window.location.reload();
            }
        }

        document.addEventListener("click", function (event) {
            const button = event.target.closest(".js-category-exchange");

            if (!button) {
                return;
            }

            event.preventDefault();
            event.stopPropagation();

            openExchangeCategoryDialog(
                Number(button.dataset.categoryId),
                button.dataset.categoryTitle,
                Number(button.dataset.roundId)
            );
        });

        document.addEventListener("keydown", function (event) {
            if (event.key !== "Escape" || event.defaultPrevented ||
                document.querySelector("dialog[open]")) {
                return;
            }

            const myQuizzesLink = document.getElementById("quiz-editor-my-quizzes");
            if (myQuizzesLink) {
                event.preventDefault();
                window.location.assign(myQuizzesLink.href);
            }
        });

        document.addEventListener("click", function (event) {
            const button = event.target.closest(".js-question-exchange");

            if (!button) {
                return;
            }

            event.preventDefault();
            event.stopPropagation();

            openExchangeQuestionDialog(
                Number(button.dataset.questionId),
                button.dataset.questionTitle,
                Number(button.dataset.roundId)
            );
        });

        document.querySelectorAll('.js-category-rename').forEach(button => {
            button.addEventListener('click', () => {
                const categoryId = button.dataset.categoryId;
                const categoryTitle = button.dataset.categoryTitle;

                openRenameCategoryDialog(categoryId, categoryTitle);
            });
        });

        function openRenameCategoryDialog(categoryId, categoryTitle) {
            document.getElementById("rename-category-id").value = categoryId;

            const input = document.getElementById("rename-category-title");
            input.value = categoryTitle;

            const dialog = document.getElementById("rename-category-dialog");
            dialog.showModal();

            requestAnimationFrame(() => {
                input.focus();
                input.select();
            });
        }

        function closeRenameCategoryDialog() {
            const dialog = document.getElementById("rename-category-dialog");

            if (dialog?.open) {
                dialog.close();
            }
        }
    </script>
}
