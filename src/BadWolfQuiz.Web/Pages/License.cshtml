@page
@inject IWebHostEnvironment HostEnvironment
@{
    ViewData["Title"] = "License / Ліцензія";

    var publishedLicensePath = System.IO.Path.Combine(HostEnvironment.ContentRootPath, "LICENSE");
    var sourceLicensePath = System.IO.Path.GetFullPath(
        System.IO.Path.Combine(HostEnvironment.ContentRootPath, "..", "..", "LICENSE"));
    var licensePath = System.IO.File.Exists(publishedLicensePath)
        ? publishedLicensePath
        : sourceLicensePath;
    var licenseText = System.IO.File.Exists(licensePath)
        ? System.IO.File.ReadAllText(licensePath)
        : "The license file is unavailable in this deployment. / Файл ліцензії недоступний у цьому розгортанні.";
}

@section Styles {
    <link rel="stylesheet" href="~/css/public-account-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/legal-pages.css" asp-append-version="true" />
}

<div class="portal-page license-page">
    <section class="portal-hero" aria-labelledby="license-title">
        <div class="portal-hero-copy">
            <p class="portal-kicker">BAD WOLF QUIZ / SOURCE LICENSE</p>
            <h1 id="license-title">License / Ліцензія</h1>
            <div class="portal-hero-description license-hero-description">
                <p>BadWolfQuiz is source-available under the MIT License, Commons Clause License Condition v1.0, and BadWolfQuiz-specific use restrictions.</p>
                <p>Вихідний код BadWolfQuiz доступний на умовах MIT License, Commons Clause License Condition v1.0 та додаткових обмежень використання BadWolfQuiz.</p>
            </div>
        </div>
        <div class="portal-hero-mark" aria-hidden="true">
            <span>BAD WOLF QUIZ</span>
            <strong>LICENSE</strong>
            <b>USE</b>
            <small>SOURCE / ACCESS / TERMS</small>
        </div>
    </section>

    <main class="portal-content">
        <div class="license-summary-grid">
            <section class="portal-card license-summary-card">
                <div class="portal-section-title">
                    <span>01</span>
                    <h2>BadWolfQuiz itself / Сам BadWolfQuiz</h2>
                </div>
                <div class="license-summary-copy">
                    <p>Paid access, subscriptions, paid tiers, paid features, and paid BadWolfQuiz hosting/SaaS are prohibited without separate written permission from the Licensor.</p>
                    <p>Платний доступ, підписки, платні рівні, платні функції та платний хостинг/SaaS самого BadWolfQuiz заборонені без окремого письмового дозволу Ліцензіара.</p>
                </div>
            </section>

            <section class="portal-card license-summary-card">
                <div class="portal-section-title">
                    <span>02</span>
                    <h2>External monetization / Зовнішня монетизація</h2>
                </div>
                <div class="license-summary-copy">
                    <p>Monetized streams, videos, sponsored broadcasts, productions, competitions, and events may use BadWolfQuiz as a tool when users are not paying for BadWolfQuiz access or functionality.</p>
                    <p>Монетизовані стріми, відео, спонсорські трансляції, продакшени, змагання та події можуть використовувати BadWolfQuiz як інструмент, якщо користувачі не платять за доступ до BadWolfQuiz або його функцій.</p>
                </div>
            </section>

            <section class="portal-card license-summary-card">
                <div class="portal-section-title">
                    <span>03</span>
                    <h2>Premium features / Преміум-функції</h2>
                </div>
                <div class="license-summary-copy">
                    <p>Premium or privileged features may be granted free of charge for contributions, achievements, recognition, testing, community participation, or similar non-monetary reasons.</p>
                    <p>Преміум- або привілейовані функції можуть надаватися безкоштовно за внесок у проєкт, досягнення, визнання, тестування, участь у спільноті чи з інших немонетарних причин.</p>
                </div>
            </section>

            <section class="portal-card license-summary-card license-summary-card-critical">
                <div class="portal-section-title">
                    <span>04</span>
                    <h2>Russia-related use / Використання, пов’язане з РФ</h2>
                </div>
                <div class="license-summary-copy">
                    <p>Use is prohibited for Russian persons and entities, Russia-affiliated projects, anyone knowingly cooperating with or materially supporting them, activities directed toward a Russian audience, and the promotion or distribution of Russian content. This prohibition overrides conflicting permissions elsewhere in the license and contains no exception mechanism under this license.</p>
                    <p>Використання заборонене російським особам і структурам, пов’язаним із РФ проєктам, усім, хто свідомо співпрацює з ними або надає їм істотну підтримку, діяльності, спрямованій на російську аудиторію, а також для просування чи поширення російського контенту. Ця заборона має пріоритет над суперечливими дозволами в інших частинах ліцензії та не містить механізму винятків у межах цієї ліцензії.</p>
                </div>
            </section>
        </div>

        <section class="portal-card license-terms-card">
            <div class="license-terms-toolbar">
                <div>
                    <div class="portal-section-title">
                        <span>05</span>
                        <h2>Full license terms / Повний текст ліцензії</h2>
                    </div>
                    <p>The text below is loaded directly from the repository LICENSE file used by this deployment.</p>
                </div>
                <a class="button button-secondary"
                   href="https://github.com/VitoMilanese/BadWolfQuiz/blob/main/LICENSE"
                   target="_blank"
                   rel="noopener noreferrer">
                    LICENSE on GitHub
                </a>
            </div>

            <pre class="license-text">@licenseText</pre>
        </section>
    </main>
</div>
