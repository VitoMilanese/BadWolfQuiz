@page
@model BadWolfQuiz.Web.Pages.Account.LoginModel
@{
    ViewData["Title"] = Localizer["Account_HostSignIn"];
}
<section class="auth-card content-panel">
    <p class="eyebrow">BAD WOLF QUIZ</p>
    <h1>@Localizer["Account_HostSignIn"]</h1>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <label asp-for="Input.Email">@Localizer["Account_Email"]</label>
        <input asp-for="Input.Email" autocomplete="email" />
        <span asp-validation-for="Input.Email"></span>
        <label asp-for="Input.Password">@Localizer["Account_Password"]</label>
        <input asp-for="Input.Password" autocomplete="current-password" />
        <span asp-validation-for="Input.Password"></span>
        <label class="checkbox-row"><input asp-for="Input.RememberMe" /> @Localizer["Account_RememberMe"]</label>
        <button class="button button-primary" type="submit">@Localizer["Account_SignIn"]</button>
    </form>
    <p><a asp-page="ForgotPassword">@Localizer["Account_ForgotPassword"]</a></p>
    <p>@Localizer["Account_NoAccount"] <a asp-page="Register" asp-route-returnUrl="@Model.ReturnUrl">@Localizer["Account_Register"]</a>.</p>
</section>
