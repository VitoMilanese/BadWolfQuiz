@page
@model BadWolfQuiz.Web.Pages.Account.ResetPasswordModel
@{ ViewData["Title"] = Localizer["Account_ResetPassword"]; }
<section class="auth-card content-panel">
    <h1>@Localizer["Account_ResetPassword"]</h1>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <input asp-for="Input.Email" type="hidden" />
        <input asp-for="Input.Token" type="hidden" />
        <label asp-for="Input.Password">@Localizer["Account_NewPassword"]</label>
        <input asp-for="Input.Password" autocomplete="new-password" />
        <span asp-validation-for="Input.Password"></span>
        <label asp-for="Input.ConfirmPassword">@Localizer["Account_ConfirmPassword"]</label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword"></span>
        <button class="button button-primary" type="submit">@Localizer["Account_ResetPassword"]</button>
    </form>
</section>
