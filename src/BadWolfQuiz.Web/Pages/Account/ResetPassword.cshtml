@page
@model BadWolfQuiz.Web.Pages.Account.ResetPasswordModel
@inject IStringLocalizer<PublicAccountPagesResource> PublicAccountLocalizer
@{ ViewData["Title"] = Localizer["Account_ResetPassword"]; }

@section Styles {
    <link rel="stylesheet" href="~/css/public-account-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/password-recovery-pages.css" asp-append-version="true" />
}

<div class="portal-page auth-page password-recovery-page">
    <section class="portal-hero" aria-labelledby="reset-password-title">
        <div class="portal-hero-copy">
            <p class="portal-kicker">@PublicAccountLocalizer["ForgotKicker"]</p>
            <h1 id="reset-password-title">@Localizer["Account_ResetPassword"]</h1>
            <p class="portal-hero-description">@PublicAccountLocalizer["ChangeMetaDescription"]</p>
        </div>
        <div class="portal-hero-mark" aria-hidden="true">
            <span>@PublicAccountLocalizer["RecoveryChannel"]</span>
            <strong>@PublicAccountLocalizer["ForgotMarkPrimary"]</strong>
            <b>@PublicAccountLocalizer["ForgotMarkAccent"]</b>
            <small>@PublicAccountLocalizer["ForgotMarkFooter"]</small>
        </div>
    </section>

    <main class="portal-content">
        <div class="auth-layout">
            <section class="portal-card auth-form-card">
                <div class="portal-section-title"><span>01</span><h2>@Localizer["Account_ResetPassword"]</h2></div>
                <form method="post" class="auth-form">
                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                    <input asp-for="Input.Email" type="hidden" />
                    <input asp-for="Input.Token" type="hidden" />
                    <label class="auth-field" asp-for="Input.Password">
                        <span>@Localizer["Account_NewPassword"]</span>
                        <input asp-for="Input.Password" autocomplete="new-password" />
                        <span asp-validation-for="Input.Password"></span>
                    </label>
                    <label class="auth-field" asp-for="Input.ConfirmPassword">
                        <span>@Localizer["Account_ConfirmPassword"]</span>
                        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword"></span>
                    </label>
                    <button class="button button-primary" type="submit">@Localizer["Account_ResetPassword"]</button>
                </form>
            </section>

            <aside class="portal-card auth-meta-card">
                <div>
                    <h2>@PublicAccountLocalizer["ForgotMetaTitle"]</h2>
                    <p>@PublicAccountLocalizer["ChangeMetaDescription"]</p>
                </div>
                <div class="auth-meta-links">
                    <a class="auth-link" asp-page="Login">@Localizer["Account_SignIn"]</a>
                </div>
            </aside>
        </div>
    </main>
</div>
