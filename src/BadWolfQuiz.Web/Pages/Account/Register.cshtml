@page
@model BadWolfQuiz.Web.Pages.Account.RegisterModel
@inject IStringLocalizer<PublicAccountPagesResource> PublicAccountLocalizer
@{
    ViewData["Title"] = Localizer["Account_RegisterHost"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/public-account-pages.css" asp-append-version="true" />
}

<div class="portal-page auth-page">
    <section class="portal-hero" aria-labelledby="register-title">
        <div class="portal-hero-copy">
            <p class="portal-kicker">@PublicAccountLocalizer["RegisterKicker"]</p>
            <h1 id="register-title">@Localizer["Account_RegisterHost"]</h1>
        </div>
        <div class="portal-hero-mark" aria-hidden="true">
            <span>@PublicAccountLocalizer["HostConsole"]</span>
            <strong>@PublicAccountLocalizer["RegisterMarkPrimary"]</strong>
            <b>@PublicAccountLocalizer["RegisterMarkAccent"]</b>
            <small>@PublicAccountLocalizer["RegisterMarkFooter"]</small>
        </div>
    </section>

    <main class="portal-content">
        <div class="auth-layout">
            <section class="portal-card auth-form-card">
                <div class="portal-section-title"><span>01</span><h2>@Localizer["Account_RegisterHost"]</h2></div>
                <form method="post" class="auth-form">
                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                    <label class="auth-field" asp-for="Input.HostName">
                        <span>@Localizer["Account_HostName"]</span>
                        <input asp-for="Input.HostName" autocomplete="organization" maxlength="80" />
                        <small>@Localizer["Account_HostNameHint"]</small>
                        <span asp-validation-for="Input.HostName"></span>
                    </label>
                    <label class="auth-field" asp-for="Input.Email">
                        <span>@Localizer["Account_Email"]</span>
                        <input asp-for="Input.Email" autocomplete="email" />
                        <span asp-validation-for="Input.Email"></span>
                    </label>
                    <label class="auth-field" asp-for="Input.Password">
                        <span>@Localizer["Account_Password"]</span>
                        <input asp-for="Input.Password" autocomplete="new-password" />
                        <span asp-validation-for="Input.Password"></span>
                    </label>
                    <label class="auth-field" asp-for="Input.ConfirmPassword">
                        <span>@Localizer["Account_ConfirmPassword"]</span>
                        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword"></span>
                    </label>
                    <button class="button button-primary" type="submit">@Localizer["Account_Register"]</button>
                </form>
            </section>

            <aside class="portal-card auth-meta-card">
                <div>
                    <h2>@PublicAccountLocalizer["RegisterMetaTitle"]</h2>
                    <p>@PublicAccountLocalizer["RegisterMetaDescription"]</p>
                </div>
                <div class="auth-meta-links">
                    <p>@Localizer["Account_AlreadyRegistered"] <a class="auth-link" asp-page="Login" asp-route-returnUrl="@Model.ReturnUrl">@Localizer["Account_SignIn"]</a>.</p>
                </div>
            </aside>
        </div>
    </main>
</div>
