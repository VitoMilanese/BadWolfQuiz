@page
@model BadWolfQuiz.Web.Pages.Account.ForgotPasswordModel
@inject IStringLocalizer<PublicAccountPagesResource> PublicAccountLocalizer
@{ ViewData["Title"] = Localizer["Account_ForgotPassword"]; }

@section Styles {
    <link rel="stylesheet" href="~/css/public-account-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/account-hero-word-fix.css" asp-append-version="true" />
}

<div class="portal-page auth-page">
    <section class="portal-hero" aria-labelledby="forgot-title">
        <div class="portal-hero-copy">
            <p class="portal-kicker">@PublicAccountLocalizer["ForgotKicker"]</p>
            <h1 id="forgot-title">@Localizer["Account_ForgotPassword"]</h1>
            <p class="portal-hero-description">@Localizer["Account_ForgotPasswordDescription"]</p>
        </div>
        <div class="portal-hero-mark" aria-hidden="true">
            <span>@PublicAccountLocalizer["RecoveryChannel"]</span>
            <strong>@PublicAccountLocalizer["ForgotMarkPrimary"]</strong>
            <b>@PublicAccountLocalizer["ForgotMarkAccent"]</b>
            <small>@PublicAccountLocalizer["ForgotMarkFooter"]</small>
        </div>
    </section>

    <main class="portal-content">
        <div class="auth-layout">
            <section class="portal-card auth-form-card">
                <div class="portal-section-title"><span>01</span><h2>@Localizer["Account_ForgotPassword"]</h2></div>
                <form method="post" class="auth-form">
                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                    <label class="auth-field" asp-for="Input.Email">
                        <span>@Localizer["Account_Email"]</span>
                        <input asp-for="Input.Email" autocomplete="email" />
                        <span asp-validation-for="Input.Email"></span>
                    </label>
                    <button class="button button-primary" type="submit">@Localizer["Account_SendResetLink"]</button>
                </form>
            </section>

            <aside class="portal-card auth-meta-card">
                <div>
                    <h2>@PublicAccountLocalizer["ForgotMetaTitle"]</h2>
                    <p>@Localizer["Account_ForgotPasswordDescription"]</p>
                </div>
                <div class="auth-meta-links">
                    <a class="auth-link" asp-page="Login">@Localizer["Account_SignIn"]</a>
                </div>
            </aside>
        </div>
    </main>
</div>
