@page
@model BadWolfQuiz.Web.Pages.Account.ChangePasswordModel
@inject IStringLocalizer<PublicAccountPagesResource> PublicAccountLocalizer
@{ ViewData["Title"] = Localizer["Account_ChangePassword"]; }

@section Styles {
    <link rel="stylesheet" href="~/css/public-account-pages.css" asp-append-version="true" />
}

<div class="portal-page auth-page">
    <section class="portal-hero" aria-labelledby="change-password-title">
        <div class="portal-hero-copy">
            <p class="portal-kicker">@PublicAccountLocalizer["ChangeKicker"]</p>
            <h1 id="change-password-title">@Localizer["Account_ChangePassword"]</h1>
        </div>
        <div class="portal-hero-mark" aria-hidden="true">
            <span>@PublicAccountLocalizer["HostSecurity"]</span>
            <strong>@PublicAccountLocalizer["ChangeMarkPrimary"]</strong>
            <b>@PublicAccountLocalizer["ChangeMarkAccent"]</b>
            <small>@PublicAccountLocalizer["ChangeMarkFooter"]</small>
        </div>
    </section>

    <main class="portal-content">
        <div class="auth-layout">
            <section class="portal-card auth-form-card">
                <div class="portal-section-title"><span>01</span><h2>@Localizer["Account_ChangePassword"]</h2></div>
                <form method="post" class="auth-form">
                    <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
                    <label class="auth-field" asp-for="Input.CurrentPassword">
                        <span>@Localizer["Account_CurrentPassword"]</span>
                        <input asp-for="Input.CurrentPassword" autocomplete="current-password" />
                        <span asp-validation-for="Input.CurrentPassword"></span>
                    </label>
                    <label class="auth-field" asp-for="Input.NewPassword">
                        <span>@Localizer["Account_NewPassword"]</span>
                        <input asp-for="Input.NewPassword" autocomplete="new-password" />
                        <span asp-validation-for="Input.NewPassword"></span>
                    </label>
                    <label class="auth-field" asp-for="Input.ConfirmPassword">
                        <span>@Localizer["Account_ConfirmPassword"]</span>
                        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
                        <span asp-validation-for="Input.ConfirmPassword"></span>
                    </label>
                    <button class="button button-primary" type="submit">@Localizer["Account_ChangePassword"]</button>
                </form>
            </section>

            <aside class="portal-card auth-meta-card">
                <div>
                    <h2>@PublicAccountLocalizer["ChangeMetaTitle"]</h2>
                    <p>@PublicAccountLocalizer["ChangeMetaDescription"]</p>
                </div>
            </aside>
        </div>
    </main>
</div>
