@page
@model BadWolfQuiz.Web.Pages.Account.ChangePasswordModel
@{ ViewData["Title"] = Localizer["Account_ChangePassword"]; }
<section class="auth-card content-panel">
    <h1>@Localizer["Account_ChangePassword"]</h1>
    <form method="post">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>
        <label asp-for="Input.CurrentPassword">@Localizer["Account_CurrentPassword"]</label>
        <input asp-for="Input.CurrentPassword" autocomplete="current-password" />
        <span asp-validation-for="Input.CurrentPassword"></span>
        <label asp-for="Input.NewPassword">@Localizer["Account_NewPassword"]</label>
        <input asp-for="Input.NewPassword" autocomplete="new-password" />
        <span asp-validation-for="Input.NewPassword"></span>
        <label asp-for="Input.ConfirmPassword">@Localizer["Account_ConfirmPassword"]</label>
        <input asp-for="Input.ConfirmPassword" autocomplete="new-password" />
        <span asp-validation-for="Input.ConfirmPassword"></span>
        <button class="button button-primary" type="submit">@Localizer["Account_ChangePassword"]</button>
    </form>
</section>
