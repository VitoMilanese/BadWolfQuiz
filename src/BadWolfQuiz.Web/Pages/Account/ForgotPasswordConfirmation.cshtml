@page
@model BadWolfQuiz.Web.Pages.Account.ForgotPasswordConfirmationModel
@inject IStringLocalizer<PublicAccountPagesResource> PublicAccountLocalizer
@{ ViewData["Title"] = Localizer["Account_CheckEmail"]; }

@section Styles {
    <link rel="stylesheet" href="~/css/public-account-pages.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/password-recovery-pages.css" asp-append-version="true" />
}

<div class="portal-page auth-page password-recovery-page">
    <section class="portal-hero" aria-labelledby="check-email-title">
        <div class="portal-hero-copy">
            <p class="portal-kicker">@PublicAccountLocalizer["ForgotKicker"]</p>
            <h1 id="check-email-title">@Localizer["Account_CheckEmail"]</h1>
            <p class="portal-hero-description">@Localizer["Account_CheckEmailDescription"]</p>
        </div>
        <div class="portal-hero-mark" aria-hidden="true">
            <span>@PublicAccountLocalizer["RecoveryChannel"]</span>
            <strong>@PublicAccountLocalizer["ForgotMarkPrimary"]</strong>
            <b>@PublicAccountLocalizer["ForgotMarkAccent"]</b>
            <small>@PublicAccountLocalizer["ForgotMarkFooter"]</small>
        </div>
    </section>

    <main class="portal-content">
        <div class="auth-layout recovery-state-layout">
            <section class="portal-card auth-form-card recovery-state-card">
                <div class="recovery-state-glyph" aria-hidden="true">✉</div>
                <div class="portal-section-title"><span>01</span><h2>@Localizer["Account_CheckEmail"]</h2></div>
                <p class="recovery-state-copy">@Localizer["Account_CheckEmailDescription"]</p>
            </section>

            <aside class="portal-card auth-meta-card recovery-action-card">
                <div>
                    <h2>@PublicAccountLocalizer["ForgotMetaTitle"]</h2>
                    <p>@PublicAccountLocalizer["LoginMetaDescription"]</p>
                </div>
                <div class="auth-meta-links">
                    <a class="auth-link" asp-page="Login">@Localizer["Account_SignIn"]</a>
                </div>
            </aside>
        </div>
    </main>
</div>
