@page "/quiz-description/{id:int}/{token}"
@model BadWolfQuiz.Web.Pages.QuizDescriptionModel
@inject Microsoft.Extensions.Localization.IStringLocalizer<BadWolfQuiz.Web.Localization.QuizDescriptionResource> QuizDescriptionLocalizer
@{
    var socialDescription = string.IsNullOrWhiteSpace(Model.Quiz.Description)
        ? QuizDescriptionLocalizer["SocialFallback", Model.Quiz.Title].Value
        : Model.Quiz.Description!;

    ViewData["Title"] = Model.Quiz.Title;
    ViewData[BadWolfQuiz.Web.TagHelpers.SeoHeadTagHelper.SocialTitleViewDataKey] = Model.Quiz.Title;
    ViewData[BadWolfQuiz.Web.TagHelpers.SeoHeadTagHelper.SocialDescriptionViewDataKey] = socialDescription;
    ViewData[BadWolfQuiz.Web.TagHelpers.SeoHeadTagHelper.SocialImageViewDataKey] = Model.Quiz.PreviewPath;
    ViewData[BadWolfQuiz.Web.TagHelpers.SeoHeadTagHelper.SocialUrlViewDataKey] = Model.Quiz.Path;
}

@section Styles {
    <link rel="stylesheet" href="~/css/quiz-description.css" asp-append-version="true" />
}

<div class="quiz-announcement-page">
    <section class="quiz-announcement-hero" aria-labelledby="quiz-announcement-title">
        <div class="quiz-announcement-heading">
            <p class="quiz-announcement-kicker">@QuizDescriptionLocalizer["Eyebrow"]</p>
            <h1 id="quiz-announcement-title">@Model.Quiz.Title</h1>

            @if (Model.Quiz.AverageRating is { } average)
            {
                <div class="quiz-announcement-rating"
                     aria-label="@Localizer["QuizRating_AccessibleSummary", average, Model.Quiz.RatingCount]">
                    <span aria-hidden="true">★</span>
                    <strong>@average.ToString("0.0")</strong>
                    <span>@Localizer["QuizRating_Count", Model.Quiz.RatingCount]</span>
                </div>
            }
        </div>

        <div class="quiz-announcement-hero-art" aria-hidden="true">
            <span class="quiz-announcement-orbit"></span>
            <span class="quiz-announcement-slash"></span>
            <strong>QUIZ</strong>
            <small>BAD WOLF</small>
        </div>
    </section>

    <main class="quiz-announcement-content">
        <article class="quiz-announcement-card">
            <aside class="quiz-announcement-rail" aria-hidden="true">
                <span>BAD WOLF / QUIZ</span>
                <div>
                    <strong>SHARE</strong>
                    <small>ANNOUNCEMENT</small>
                </div>
            </aside>

            <div class="quiz-announcement-copy">
                <span class="quiz-announcement-copy-label" aria-hidden="true">@QuizDescriptionLocalizer["Eyebrow"]</span>

                @if (!string.IsNullOrWhiteSpace(Model.Quiz.Description))
                {
                    <p class="quiz-description-copy">@Model.Quiz.Description</p>
                }
                else
                {
                    <p class="quiz-description-empty">@QuizDescriptionLocalizer["NoDescription"]</p>
                }
            </div>
        </article>
    </main>
</div>
