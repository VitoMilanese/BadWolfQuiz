@page
@model BadWolfQuiz.Web.Pages.QuestionModel
@using BadWolfQuiz.Web.Localization
@using BadWolfQuiz.Web.Models
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Question_Title"];

    var orderedMessages = Model.UserQuestion.Messages
        .OrderBy(x => x.CreatedAtUtc)
        .ThenBy(x => x.Id)
        .ToArray();

    var lastMessage = orderedMessages.LastOrDefault();
    var awaitingDeveloper = lastMessage?.AuthorType == UserQuestionAuthorType.User;
    var canReply = lastMessage?.AuthorType == UserQuestionAuthorType.Developer;
}

@section Styles {
    <link rel="stylesheet" href="~/css/questions.css" asp-append-version="true" />
}

<div class="support-page support-conversation-page">
    <section class="support-hero support-hero-conversation" aria-labelledby="support-conversation-title">
        <div class="support-hero-copy">
            <p class="support-kicker">
                <span>BAD WOLF</span>
                <span aria-hidden="true">/ LIVE THREAD</span>
            </p>
            <h1 id="support-conversation-title">@Localizer["Question_Title"]</h1>

            @if (!string.IsNullOrWhiteSpace(Model.UserQuestion.SenderName))
            {
                <p class="support-conversation-sender">
                    <span>@Localizer["Question_Name"]</span>
                    <strong>@Model.UserQuestion.SenderName</strong>
                </p>
            }

            <div class="support-hero-actions">
                <a class="button button-secondary" asp-page="/MyQuestions">
                    @Localizer["MyQuestions_Title"]
                </a>
                <a class="button button-secondary" asp-page="/AskQuestion">
                    @Localizer["AskQuestion_Title"]
                </a>
            </div>
        </div>

        <div class="support-conversation-state @(awaitingDeveloper ? "is-waiting" : canReply ? "is-replyable" : string.Empty)">
            <span aria-hidden="true">THREAD STATUS</span>
            <strong>@orderedMessages.Length.ToString("00")</strong>
            @if (awaitingDeveloper)
            {
                <small>@Localizer["Question_AwaitingAnswer"]</small>
            }
            else if (canReply)
            {
                <small>@Localizer["Question_ContinueConversation"]</small>
            }
            else
            {
                <small>@Localizer["Question_Status"]</small>
            }
        </div>
    </section>

    <main class="support-content support-conversation-content">
        <section class="support-thread-panel">
            <header class="support-section-heading support-thread-heading">
                <div>
                    <span aria-hidden="true">BAD WOLF / CONVERSATION</span>
                    <h2>@Localizer["Question_Title"]</h2>
                </div>
                <strong aria-hidden="true">@orderedMessages.Length.ToString("00")</strong>
            </header>

            <div class="support-message-list">
                @for (var index = 0; index < orderedMessages.Length; index++)
                {
                    var message = orderedMessages[index];
                    var isUserMessage = message.AuthorType == UserQuestionAuthorType.User;

                    <article class="support-chat-message @(isUserMessage ? "is-user" : "is-developer")">
                        <div class="support-chat-rail" aria-hidden="true">
                            <span>@(index + 1 < 10 ? $"0{index + 1}" : (index + 1).ToString())</span>
                            <i></i>
                        </div>

                        <div class="support-chat-bubble">
                            <header class="support-chat-meta">
                                <strong>
                                    @(isUserMessage
                                        ? Localizer["Question_You"].Value
                                        : Localizer["Question_Developer"].Value)
                                </strong>
                                <time datetime="@message.CreatedAtUtc.ToString("O")">
                                    @message.CreatedAtUtc.ToLocalTime().ToString("g")
                                </time>
                            </header>
                            <p>@message.Text</p>
                        </div>
                    </article>
                }
            </div>

            @if (awaitingDeveloper)
            {
                <div class="support-awaiting-status" role="status">
                    <span aria-hidden="true">WAIT</span>
                    <div>
                        <strong>@Localizer["Question_Status"]</strong>
                        <p>@Localizer["Question_AwaitingAnswer"]</p>
                    </div>
                </div>
            }

            @if (canReply)
            {
                <section class="support-reply-panel">
                    <header class="support-reply-heading">
                        <span aria-hidden="true">REPLY / SIGNAL</span>
                        <h2>@Localizer["Question_ContinueConversation"]</h2>
                    </header>

                    <div asp-validation-summary="ModelOnly" class="message message-error support-validation"></div>

                    <form method="post" asp-page-handler="Reply" class="support-reply-form">
                        <input type="hidden"
                               name="token"
                               value="@Model.UserQuestion.PublicToken" />

                        <label class="support-field" for="message">
                            <span>@Localizer["Question_ContinueConversation"]</span>
                            <textarea id="message"
                                      name="message"
                                      rows="5"
                                      maxlength="5000"
                                      required></textarea>
                        </label>

                        <div class="support-reply-actions">
                            <button type="submit" class="button button-primary">
                                @Localizer["Button_Send"]
                            </button>
                        </div>
                    </form>
                </section>
            }
        </section>
    </main>
</div>
