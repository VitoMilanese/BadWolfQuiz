@page
@model BadWolfQuiz.Web.Pages.QuestionModel
@using BadWolfQuiz.Web.Localization
@using Microsoft.Extensions.Localization
@inject IStringLocalizer<SharedResource> Localizer
@{
    ViewData["Title"] = Localizer["Question_Title"];
}
@using BadWolfQuiz.Web.Models

<section class="page-section question-conversation-page">
    <div class="question-conversation-heading">
        <h1>@Localizer["Question_Title"]</h1>

        @if (!string.IsNullOrWhiteSpace(Model.UserQuestion.SenderName))
        {
            <p class="question-conversation-meta">
                <strong>@Localizer["Question_Name"]:</strong>
                <span>@Model.UserQuestion.SenderName</span>
            </p>
        }
    </div>

    <div class="question-conversation">
        <div class="question-messages">
            @foreach (var message in Model.UserQuestion.Messages
                .OrderBy(x => x.CreatedAtUtc)
                .ThenBy(x => x.Id))
            {
                var isUserMessage = message.AuthorType == UserQuestionAuthorType.User;

                <article class="question-message @(isUserMessage ? "question-message-user" : "question-message-developer")">
                    <div class="question-message-author">
                        @(isUserMessage
                            ? Localizer["Question_You"].Value
                            : Localizer["Question_Developer"].Value)
                    </div>
                    <p class="question-message-body">@message.Text</p>
                </article>
            }
        </div>

        @{
            var lastMessage = Model.UserQuestion.Messages
                .OrderBy(x => x.CreatedAtUtc)
                .ThenBy(x => x.Id)
                .LastOrDefault();

            var awaitingDeveloper =
                lastMessage?.AuthorType == UserQuestionAuthorType.User;

            var canReply =
                lastMessage?.AuthorType == UserQuestionAuthorType.Developer;
        }

        @if (awaitingDeveloper)
        {
            <div class="question-status" role="status">
                <strong>@Localizer["Question_Status"]:</strong>
                <span>@Localizer["Question_AwaitingAnswer"]</span>
            </div>
        }

        @if (canReply)
        {
            <div class="question-reply-panel">
                <div asp-validation-summary="ModelOnly"></div>

                <form method="post" asp-page-handler="Reply" class="question-reply-form">
                    <input type="hidden"
                           name="token"
                           value="@Model.UserQuestion.PublicToken" />

                    <label for="message">
                        @Localizer["Question_ContinueConversation"]
                    </label>

                    <textarea id="message"
                              name="message"
                              rows="5"
                              maxlength="5000"
                              required></textarea>

                    <div class="form-actions">
                        <button type="submit" class="button button-primary">
                            @Localizer["Button_Send"]
                        </button>
                    </div>
                </form>
            </div>
        }
    </div>
</section>
