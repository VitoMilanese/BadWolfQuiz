@page "{code?}"
@model BadWolfQuiz.Web.Pages.Join.IndexModel
@{
    ViewData["Title"] = Localizer["Button_Join"];
    ViewData["SocialThemeId"] = Model.SocialThemeId;
    ViewData["SocialThemeColors"] = Model.SocialThemeColors;
}

@section Styles {
    <link rel="stylesheet" href="~/css/join.css" asp-append-version="true" />
}

<div class="join-entry-page">
    <main class="join-entry-stage" aria-labelledby="join-entry-title">
        <section class="join-entry-copy">
            <p class="join-entry-kicker">
                <span>BAD WOLF</span>
                <span aria-hidden="true">/ GAME ACCESS</span>
            </p>

            <h1 id="join-entry-title">@Localizer["Title_JoinGame"]</h1>
            <p class="join-entry-lead">@Localizer["Join_Eyebrow"]</p>

            <div class="join-entry-signal" aria-hidden="true">
                <div class="join-entry-signal-rings">
                    <span></span>
                    <span></span>
                    <span></span>
                </div>
                <div class="join-entry-signal-mark">
                    <small>LIVE</small>
                    <strong>JOIN</strong>
                    <i></i>
                </div>
            </div>
        </section>

        <section class="join-entry-card" aria-label="@Localizer["Title_JoinGame"]">
            <header class="join-entry-card-header" aria-hidden="true">
                <span>PLAYER CHECK-IN</span>
                <strong>01</strong>
            </header>

            <form id="join-game-form"
                  method="post"
                  class="join-entry-form"
                  data-game-instance-id="@Model.GameInstanceId">
                <div asp-validation-summary="ModelOnly" class="validation-summary join-entry-summary"></div>

                @if (string.IsNullOrWhiteSpace(Model.Input.GameCode))
                {
                    <section class="join-entry-step join-entry-step-code">
                        <div class="join-entry-step-heading">
                            <span aria-hidden="true">01</span>
                            <div>
                                <small aria-hidden="true">MATCH CODE</small>
                                <strong>@Localizer["Label_GameCode"]</strong>
                            </div>
                        </div>

                        <label class="join-entry-field-label" asp-for="Input.GameCode">
                            @Localizer["Label_GameCode"]
                        </label>
                        <input class="join-entry-input join-entry-code-input"
                               asp-for="Input.GameCode"
                               maxlength="6"
                               autocomplete="off"
                               autocapitalize="characters"
                               placeholder="@Localizer["Placeholder_GameCode"]" />
                        <span class="join-entry-validation" asp-validation-for="Input.GameCode"></span>
                    </section>
                }
                else
                {
                    <input asp-for="Input.GameCode" type="hidden" />
                    <section class="join-entry-step join-entry-step-code is-selected">
                        <div class="join-entry-step-heading">
                            <span aria-hidden="true">01</span>
                            <div>
                                <small aria-hidden="true">MATCH LOCKED</small>
                                <strong>@Localizer["Label_GameCode"]</strong>
                            </div>
                        </div>

                        <div class="join-selected-game">
                            <strong>@Model.Input.GameCode</strong>
                            <p>@Localizer["Join_SelectedGame", Model.Input.GameCode]</p>
                        </div>
                        <span class="join-entry-validation" asp-validation-for="Input.GameCode"></span>
                    </section>
                }

                <section class="join-entry-step join-entry-step-player">
                    <div class="join-entry-step-heading">
                        <span aria-hidden="true">02</span>
                        <div>
                            <small aria-hidden="true">PLAYER IDENTITY</small>
                            <strong>@Localizer["Label_PlayerName"]</strong>
                        </div>
                    </div>

                    <label class="join-entry-field-label" asp-for="Input.PlayerName">
                        @Localizer["Label_PlayerName"]
                    </label>
                    <input class="join-entry-input"
                           asp-for="Input.PlayerName"
                           maxlength="60"
                           autocomplete="nickname"
                           placeholder="@Localizer["Placeholder_PlayerName"]" />
                    <span class="join-entry-validation" asp-validation-for="Input.PlayerName"></span>
                </section>

                <input asp-for="Input.AvatarId" type="hidden" />
                <input asp-for="Input.ClientDayOfMonth" type="hidden" />

                <button class="button button-primary join-entry-submit" type="submit">
                    <span>@Localizer["Button_Join"]</span>
                    <span class="join-entry-submit-arrow" aria-hidden="true">→</span>
                </button>
            </form>

            <footer class="join-entry-card-footer" aria-hidden="true">
                <span>BADWOLF.BUZZ</span>
                <i></i>
                <span>LIVE QUIZ SYSTEM</span>
            </footer>
        </section>
    </main>
</div>

@section Scripts {
    <script>
        (() => {
            const form = document.getElementById("join-game-form");
            const codeInput = document.getElementById("Input_GameCode");
            const nameInput = document.getElementById("Input_PlayerName");
            const avatarInput = document.getElementById("Input_AvatarId");
            const dayInput = document.getElementById("Input_ClientDayOfMonth");
            const submitButton = form?.querySelector('button[type="submit"]');
            let joinSubmissionInProgress = false;

            const normalizeName = value =>
                value?.trim().toLocaleLowerCase() || "";

            const resolveDayDisplayName = (value, day) => {
                const name = value?.trim() || "";
                if (!name || day < 1 || day > 31) {
                    return name;
                }

                const dayText = String(day);
                const prefixes = day < 10
                    ? [dayText.padStart(2, "0"), dayText]
                    : [dayText];

                for (const prefix of prefixes) {
                    if (!name.startsWith(prefix)) {
                        continue;
                    }

                    const nextCharacter = name.charAt(prefix.length);
                    if (nextCharacter && /[0-9]/.test(nextCharacter)) {
                        continue;
                    }

                    const displayName = name.slice(prefix.length).trimStart();
                    if (displayName) {
                        return displayName;
                    }
                }

                return name;
            };

            const playerStorageNameKey = (gameCode, playerName) =>
                `badwolfquiz:${gameCode}:player-storage-name:${playerName}`;

            const rememberPlayerStorageName = (gameCode, day) => {
                const originalName = normalizeName(nameInput?.value);
                if (!gameCode || !originalName) {
                    return;
                }

                const displayName = normalizeName(
                    resolveDayDisplayName(nameInput?.value, day));
                if (displayName && displayName !== originalName) {
                    localStorage.setItem(
                        playerStorageNameKey(gameCode, originalName),
                        displayName);
                }
            };

            const restoreAvatar = () => {
                const originalName = normalizeName(nameInput?.value);
                if (!originalName) {
                    avatarInput.value = "";
                    return;
                }

                const gameCode = codeInput?.value.trim().toUpperCase() || "";
                const storedName = gameCode
                    ? localStorage.getItem(
                        playerStorageNameKey(gameCode, originalName))
                    : null;
                const preferenceName = storedName || originalName;
                avatarInput.value =
                    localStorage.getItem(`badwolfquiz:avatar:${preferenceName}`) ||
                    localStorage.getItem(`badwolfquiz:avatar:${originalName}`) ||
                    "";
            };

            const lockJoinSubmission = () => {
                joinSubmissionInProgress = true;
                if (submitButton instanceof HTMLButtonElement) {
                    submitButton.disabled = true;
                }
            };

            if (dayInput) {
                dayInput.value = String(new Date().getDate());
            }

            nameInput?.addEventListener("change", restoreAvatar);

            form?.addEventListener("submit", event => {
                if (joinSubmissionInProgress) {
                    event.preventDefault();
                    return;
                }

                const gameCode = codeInput?.value.trim().toUpperCase();
                const currentDay = new Date().getDate();
                if (dayInput) {
                    dayInput.value = String(currentDay);
                }

                if (gameCode) {
                    rememberPlayerStorageName(gameCode, currentDay);
                }
                restoreAvatar();

                if (!gameCode) {
                    return;
                }

                localStorage.removeItem(
                    `badwolfquiz:${gameCode}:current-player`);
                lockJoinSubmission();
            });
        })();
    </script>
}
