@page "{code?}"
@model BadWolfQuiz.Web.Pages.Join.IndexModel
@{
    ViewData["Title"] = Localizer["Button_Join"];
}

<div class="form-card narrow">
    <p class="eyebrow">@Localizer["Join_Eyebrow"]</p>
    <h1>@Localizer["Title_JoinGame"]</h1>

    <form method="post" class="stack-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        <label asp-for="Input.GameCode">@Localizer["Label_GameCode"]</label>
        <input asp-for="Input.GameCode"
               maxlength="6"
               autocomplete="off"
               autocapitalize="characters"
               placeholder="@Localizer["Placeholder_GameCode"]" />
        <span asp-validation-for="Input.GameCode"></span>

        <label asp-for="Input.PlayerName">@Localizer["Label_PlayerName"]</label>
        <input asp-for="Input.PlayerName"
               maxlength="60"
               autocomplete="nickname"
               placeholder="@Localizer["Placeholder_PlayerName"]" />
        <span asp-validation-for="Input.PlayerName"></span>

        <button class="button button-primary" type="submit">
            @Localizer["Button_Join"]
        </button>
    </form>
</div>
