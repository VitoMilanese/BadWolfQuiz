@page "{code?}"
@model BadWolfQuiz.Web.Pages.Join.IndexModel
@{
    ViewData["Title"] = Localizer["Button_Join"];
}

<div class="form-card narrow">
    <p class="eyebrow">@Localizer["Join_Eyebrow"]</p>
    <h1>@Localizer["Title_JoinGame"]</h1>

    <form id="join-game-form" method="post" class="stack-form">
        <div asp-validation-summary="ModelOnly" class="validation-summary"></div>

        @if (string.IsNullOrWhiteSpace(Model.Input.GameCode))
        {
            <label asp-for="Input.GameCode">@Localizer["Label_GameCode"]</label>
            <input asp-for="Input.GameCode"
                   maxlength="6"
                   autocomplete="off"
                   autocapitalize="characters"
                   placeholder="@Localizer["Placeholder_GameCode"]" />
            <span asp-validation-for="Input.GameCode"></span>
        }
        else
        {
            <input asp-for="Input.GameCode" type="hidden" />
            <p class="join-selected-game">@Localizer["Join_SelectedGame", Model.Input.GameCode]</p>
            <span asp-validation-for="Input.GameCode"></span>
        }

        <label asp-for="Input.PlayerName">@Localizer["Label_PlayerName"]</label>
        <input asp-for="Input.PlayerName"
               maxlength="60"
               autocomplete="nickname"
               placeholder="@Localizer["Placeholder_PlayerName"]" />
        <span asp-validation-for="Input.PlayerName"></span>
        <input asp-for="Input.AvatarId" type="hidden" />

        <button class="button button-primary" type="submit">
            @Localizer["Button_Join"]
        </button>
    </form>
</div>


@section Scripts {
    <script>
        (() => {
            const form = document.getElementById("join-game-form");
            const codeInput = document.getElementById("Input_GameCode");
            const nameInput = document.getElementById("Input_PlayerName");
            const avatarInput = document.getElementById("Input_AvatarId");

            const restoreAvatar = () => {
                const normalizedName = nameInput?.value.trim().toLocaleLowerCase();
                avatarInput.value = normalizedName
                    ? localStorage.getItem(`badwolfquiz:avatar:${normalizedName}`) || ""
                    : "";
            };

            nameInput?.addEventListener("change", restoreAvatar);

            form?.addEventListener("submit", event => {
                restoreAvatar();
                const gameCode = codeInput?.value.trim().toUpperCase();

                if (!gameCode) {
                    return;
                }

                const storedIdentity = localStorage.getItem(
                    `badwolfquiz:${gameCode}:current-player`);

                if (!storedIdentity) {
                    return;
                }

                try {
                    const identity = JSON.parse(storedIdentity);

                    if (identity.accessToken && identity.playerId && identity.path) {
                        event.preventDefault();
                        window.location.assign(identity.path);
                    }
                } catch {
                    localStorage.removeItem(
                        `badwolfquiz:${gameCode}:current-player`);
                }
            });
        })();
    </script>
}
