@inject BadWolfQuiz.Web.Services.AvatarCatalog AvatarCatalog
@using System.Text.Json
@{
    var avatarCategories = AvatarCatalog.GetCategories();
}

<dialog class="avatar-picker" data-avatar-picker>
    <div class="avatar-picker-card">
        <header class="dialog-heading">
            <h2>@Localizer["AvatarPicker_Title"]</h2>
            <button class="dialog-close" type="button" data-avatar-close aria-label="@Localizer["Button_Close"]">×</button>
        </header>

        <section data-avatar-category-step>
            <div class="avatar-gender-grid">
                @foreach (var category in avatarCategories)
                {
                    var categoryLabel = category.Id switch
                    {
                        "F" => Localizer["AvatarPicker_Female"].Value,
                        "M" => Localizer["AvatarPicker_Male"].Value,
                        "I" => Localizer["AvatarPicker_Individual"].Value,
                        _ => category.Id
                    };

                    <button type="button"
                            data-avatar-category="@category.Id"
                            data-avatar-ids="@JsonSerializer.Serialize(category.AvatarIds)"
                            aria-label="@categoryLabel">
                        <img src="/avatars/@category.IconFileName" alt="" />
                    </button>
                }
            </div>
        </section>

        <section data-avatar-list-step hidden>
            <div class="avatar-picker-toolbar">
                <button class="button button-secondary" type="button" data-avatar-back>← @Localizer["Button_Back"]</button>
            </div>
            <div class="avatar-option-grid" data-avatar-options></div>
        </section>
    </div>
</dialog>
