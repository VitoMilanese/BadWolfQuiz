@using System.Globalization
@using BadWolfQuiz.Web.Services
@using QRCoder
@inject GameSettingsStore SettingsStore
@inject GameSessionRegistry GameSessions
@inject CurrentHost CurrentHost
@inject UserQuestionHistoryService UserQuestionHistory
@inject IConfiguration Configuration
@inject Microsoft.Extensions.Options.IOptions<SiteDefaultsOptions> SiteDefaults
@inject IStringLocalizer<ProductVersionResource> ProductVersionLocalizer
@inject IStringLocalizer<PlayerAchievementHistoryResource> AchievementHistoryLocalizer
@inject IStringLocalizer<AchievementResource> AchievementLocalizer
@inject IStringLocalizer<HostCustomAchievementEditorResource> CustomAchievementLocalizer
@inject IStringLocalizer<WordRingsResource> WordRingsLocalizer

@{
    var currentCulture = CultureInfo.CurrentUICulture.Name;

    var currentFlag = currentCulture switch
    {
        "uk" => "🇺🇦",
        "ru" => "🇷🇺",
        "it" => "🇮🇹",
        _ => "🇬🇧"
    };

    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var discordInviteUrl = Configuration["Discord:InviteUrl"];
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var hasUserQuestionHistory = UserQuestionHistory.HasAny(Context.Request);
    var isMasterHost = isAuthenticated &&
        !string.IsNullOrWhiteSpace(Configuration["MasterHostId"]) &&
        string.Equals(
            CurrentHost.Id,
            Configuration["MasterHostId"]?.Trim(),
            StringComparison.Ordinal);
    var settings = ViewData["GameThemeSettings"] as BadWolfQuiz.Game.Runtime.GameSessionSettings
        ?? (isAuthenticated && CurrentHost.Id is { } hostId
            ? await SettingsStore.LoadAsync(hostId, Context.RequestAborted)
            : null);
    var siteThemeId = SiteThemeCatalog.Normalize(
        settings?.SiteThemeId ?? SiteDefaults.Value.ThemeId);
    var customThemeStyle = siteThemeId == "custom"
        ? SiteThemeCatalog.BuildCssVariables(settings?.CustomThemeColors)
        : null;
    var headerBrandLogoUrl = ViewData["HeaderBrandLogoUrl"] as string;
    var hasBrandLogo = !string.IsNullOrWhiteSpace(headerBrandLogoUrl) ||
        (isAuthenticated &&
         settings?.BrandLogoData is not null &&
         !string.IsNullOrWhiteSpace(settings.BrandLogoContentType));
    var hidePortalFooter = ViewData["HidePortalFooter"] is true;
    var isEmbeddedDiscordSettings = ViewData["EmbeddedDiscordSettings"] is true;
    var productVersion = ProductVersionInfo.Current;
    var simulateYouTubeAntiBot = Configuration.GetValue<bool>("SimulateYouTubeAntiBot");
    var isSettingsPage = isAuthenticated &&
        string.Equals(
            Context.Request.Path.Value,
            "/Admin/Settings",
            StringComparison.OrdinalIgnoreCase);

    GameSessionRegistration? finalQuestionGame = null;
    if (isAuthenticated &&
        Context.Request.Path.StartsWithSegments("/Admin/Games/Lobby") &&
        Guid.TryParse(Context.Request.RouteValues["id"]?.ToString(), out var gameId))
    {
        finalQuestionGame = GameSessions.FindOwned(
            new BadWolfQuiz.Game.Runtime.GameSessionId(gameId),
            CurrentHost.RequiredId);
    }

    var showLimitedGameTools = finalQuestionGame is not null &&
        ((finalQuestionGame.Session.FinalQuestion is not null &&
          finalQuestionGame.Session.Status is
              BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalWagering or
              BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalAnswering or
              BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalJudging) ||
         (finalQuestionGame.Session.Status == BadWolfQuiz.Game.Runtime.GameSessionStatus.Running &&
          finalQuestionGame.Session.IsCurrentRoundComplete));

    var showGameHeaderQr = finalQuestionGame is not null &&
        finalQuestionGame.Session.Status is
            BadWolfQuiz.Game.Runtime.GameSessionStatus.Running or
            BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalWagering or
            BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalAnswering or
            BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalJudging;

    string? gameHeaderQrDarkDataUri = null;
    string? gameHeaderQrLightDataUri = null;
    if (showGameHeaderQr)
    {
        var qrPayload = Configuration["Game:HeaderQrPayload"];
        if (string.IsNullOrWhiteSpace(qrPayload))
        {
            qrPayload = "Чупа";
        }

        using var qrGenerator = new QRCodeGenerator();
        using var qrData = qrGenerator.CreateQrCode(qrPayload, QRCodeGenerator.ECCLevel.Q);
        using var qrCode = new PngByteQRCode(qrData);
        gameHeaderQrDarkDataUri = $"data:image/png;base64,{Convert.ToBase64String(qrCode.GetGraphic(4, new byte[] { 0, 0, 0, 255 }, new byte[] { 0, 0, 0, 0 }))}";
        gameHeaderQrLightDataUri = $"data:image/png;base64,{Convert.ToBase64String(qrCode.GetGraphic(4, new byte[] { 255, 255, 255, 255 }, new byte[] { 0, 0, 0, 0 }))}";
    }
}

<!DOCTYPE html>
<html lang="@currentCulture" data-theme="@siteThemeId" style="@customThemeStyle">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BAD WOLF QUIZ</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/busy-indicators.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/buzzer-race-live.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/player-admission-menu.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/header-side-menu.css" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)
    <style>
        .host-game-board.final-question-host {
            width: calc(100vw - 32px);
            max-width: none;
            margin-left: calc(50% - 50vw + 16px);
            margin-right: calc(50% - 50vw + 16px);
        }

        .game-header-context .board-action-menu .action-menu-item[data-open-join-code] {
            display: none;
        }

        .game-header-square-button[hidden] {
            display: none;
        }

        .game-header-square-button {
            display: inline-flex;
            flex: 0 0 44px;
            align-items: center;
            justify-content: center;
            box-sizing: border-box;
            width: 44px;
            min-width: 44px;
            max-width: 44px;
            height: 44px;
            min-height: 44px;
            max-height: 44px;
            padding: 0;
            overflow: hidden;
        }

        .game-header-join-qr {
            background: var(--panel);
        }

        .game-header-join-qr img {
            display: block;
            width: 100%;
            height: 100%;
            object-fit: fill;
            image-rendering: pixelated;
        }

    </style>
    @if (!hidePortalFooter && !isEmbeddedDiscordSettings)
    {
        <link rel="stylesheet" href="~/css/sticky-footer.css" asp-append-version="true" />
    }
</head>
<body class="@(hidePortalFooter ? "gameplay-layout" : "portal-layout") @(isEmbeddedDiscordSettings ? "embedded-discord-settings" : null)">
    @if (!isEmbeddedDiscordSettings)
    {
    <header class="topbar">
        <a class="brand"
           asp-page="/Index"
           title="@ProductVersionLocalizer["LogoTooltip", productVersion.Version]">
            @if (hasBrandLogo)
            {
                <img class="brand-logo"
                     src="@(headerBrandLogoUrl ?? Url.Page("/Admin/Settings/Index", "BrandLogo"))"
                     alt="BAD WOLF QUIZ" />
            }
            else
            {
                <text>BAD WOLF <span>QUIZ</span></text>
            }
        </a>

        <div class="topbar-page-context">
            @await RenderSectionAsync("HeaderContext", required: false)
            @if (showLimitedGameTools && finalQuestionGame is not null)
            {
                <button class="button button-secondary host-tools-trigger limited-game-tools"
                        type="button"
                        data-open-host-tools-dialog>
                    @Localizer["Menu_Tools"]
                </button>

                <dialog id="host-tools-dialog"
                        class="app-dialog host-tools-dialog"
                        data-host-tools-dialog
                        aria-labelledby="host-tools-dialog-title">
                    <div class="dialog-card host-tools-dialog-card">
                        <div class="dialog-heading">
                            <div class="host-tools-dialog-title">
                                <span class="host-tools-kicker">BAD WOLF QUIZ</span>
                                <h2 id="host-tools-dialog-title">@Localizer["Menu_Tools"]</h2>
                            </div>
                            <button class="dialog-close"
                                    type="button"
                                    data-close-host-tools-dialog
                                    aria-label="@Localizer["Button_Close"]">×</button>
                        </div>

                        <div class="host-tools-dialog-actions">
                            <a class="host-tools-action"
                               asp-page="/Admin/Games/AnswerHistory"
                               asp-route-id="@finalQuestionGame.Session.Id.Value"
                               data-host-tools-dialog-dismiss>
                                <span class="host-tools-action-icon" aria-hidden="true">≡</span>
                                <span class="host-tools-action-label">@Localizer["AnswerHistory_Open"]</span>
                            </a>

                            <a class="host-tools-action"
                               asp-page="/Admin/Games/AnswerKey"
                               asp-route-id="@finalQuestionGame.Session.Id.Value"
                               target="_blank"
                               rel="noopener"
                               data-host-tools-dialog-dismiss>
                                <span class="host-tools-action-icon" aria-hidden="true">✓</span>
                                <span class="host-tools-action-label">@Localizer["AnswerKey_Open"]</span>
                            </a>

                            <button class="host-tools-action"
                                    type="button"
                                    data-host-tools-dialog-dismiss
                                    data-open-blocked-players>
                                <span class="host-tools-action-icon" aria-hidden="true">⊘</span>
                                <span class="host-tools-action-label">@Localizer["GameBoard_ManageBlockedPlayers"]</span>
                            </button>

                            <a class="host-tools-action"
                               asp-page="/Admin/Games/PlayerAchievements"
                               asp-route-id="@finalQuestionGame.Session.Id.Value"
                               data-host-tools-dialog-dismiss
                               data-achievement-history-open
                               onclick="if(window.BadWolfBusy){window.BadWolfBusy.navigate(this.href);return false;}">
                                <span class="host-tools-action-icon" aria-hidden="true">★</span>
                                <span class="host-tools-action-label">@AchievementHistoryLocalizer["History_Open"]</span>
                            </a>

                            <button class="host-tools-action host-tools-action-wide"
                                    type="button"
                                    data-host-tools-dialog-dismiss
                                    data-open-game-settings>
                                <span class="host-tools-action-icon" aria-hidden="true">⚙</span>
                                <span class="host-tools-action-label">@Localizer["GameSettings_LobbyTitle"]</span>
                            </button>
            </div>
        </div>
    </dialog>
    }

    <main class="page-shell">
        @RenderBody()
    </main>

    @if (isAuthenticated && !isEmbeddedDiscordSettings)
    {
        <dialog class="app-dialog discord-settings-dialog"
                data-discord-settings-dialog
                aria-labelledby="discord-settings-dialog-title">
            <div class="dialog-card discord-settings-dialog-card">
                <div class="dialog-heading">
                    <h2 id="discord-settings-dialog-title">@Localizer["Discord_SettingsTitle"]</h2>
                    <button class="dialog-close"
                            type="button"
                            data-close-discord-settings
                            aria-label="@Localizer["Button_Close"]">×</button>
                </div>
                <iframe class="discord-settings-frame"
                        data-discord-settings-frame
                        data-src="@Url.Page("/Admin/Settings/Discord", new { embedded = true })"
                        title="@Localizer["Discord_SettingsTitle"]"></iframe>
            </div>
        </dialog>
    }

    @if (!hidePortalFooter && !isEmbeddedDiscordSettings)
    {
        @await Component.InvokeAsync("PortalFooter")
    }

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/header-side-menu.js" asp-append-version="true"></script>
    <script src="~/js/gameplay-escape-shortcuts.js" asp-append-version="true"></script>
    <script src="~/js/busy-indicators.js" asp-append-version="true"></script>
    <script src="~/js/all-player-question.js" asp-append-version="true"></script>
    <script src="~/js/quick-timer-controls.js" asp-append-version="true"></script>
    <script src="~/js/youtube-auto-expand.js" asp-append-version="true"></script>
    <script src="~/js/youtube-antibot-fallback.js"
            asp-append-version="true"
            data-simulate-youtube-anti-bot="@(simulateYouTubeAntiBot ? "true" : "false")"></script>
    <script src="~/js/media-autoplay.js" asp-append-version="true"></script>
    <script src="~/js/portal-footer.js" asp-append-version="true"></script>
    <script src="~/js/discord-settings-dialog.js" asp-append-version="true"></script>
    <script src="~/js/player-admission-menu.js" asp-append-version="true"></script>
    <script src="~/js/quiz-description-editor-links.js"
            asp-append-version="true"
            data-edit-label="@Localizer["Button_Edit"]"
            data-round-label="@Localizer["Label_Round"]"
            data-category-label="@Localizer["Label_Category"]"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>