@using System.Globalization
@using BadWolfQuiz.Web.Services
@inject GameSettingsStore SettingsStore
@inject GameSessionRegistry GameSessions
@inject CurrentHost CurrentHost
@inject UserQuestionHistoryService UserQuestionHistory
@inject IConfiguration Configuration
@inject Microsoft.Extensions.Options.IOptions<SiteDefaultsOptions> SiteDefaults
@inject IStringLocalizer<ProductVersionResource> ProductVersionLocalizer

@{
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;

    var currentFlag = currentCulture switch
    {
        "uk" => "🇺🇦",
        "it" => "🇮🇹",
        _ => "🇬🇧"
    };

    var returnUrl = Context.Request.Path + Context.Request.QueryString;
    var discordInviteUrl = Configuration["Discord:InviteUrl"];
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var hasUserQuestionHistory = UserQuestionHistory.HasAny(Context.Request);
    var isMasterHost = isAuthenticated &&
        !string.IsNullOrWhiteSpace(Configuration["MasterHostId"]) &&
        string.Equals(
            CurrentHost.Id,
            Configuration["MasterHostId"]?.Trim(),
            StringComparison.Ordinal);
    var settings = ViewData["GameThemeSettings"] as BadWolfQuiz.Game.Runtime.GameSessionSettings
        ?? (isAuthenticated && CurrentHost.Id is { } hostId
            ? await SettingsStore.LoadAsync(hostId, Context.RequestAborted)
            : null);
    var siteThemeId = SiteThemeCatalog.Normalize(
        settings?.SiteThemeId ?? SiteDefaults.Value.ThemeId);
    var customThemeStyle = siteThemeId == "custom"
        ? SiteThemeCatalog.BuildCssVariables(settings?.CustomThemeColors)
        : null;
    var hasBrandLogo = isAuthenticated &&
        settings?.BrandLogoData is not null &&
        !string.IsNullOrWhiteSpace(settings.BrandLogoContentType);
    var hidePortalFooter = ViewData["HidePortalFooter"] is true;
    var isEmbeddedDiscordSettings = ViewData["EmbeddedDiscordSettings"] is true;
    var productVersion = ProductVersionInfo.Current;
    var isSettingsPage = isAuthenticated &&
        string.Equals(
            Context.Request.Path.Value,
            "/Admin/Settings",
            StringComparison.OrdinalIgnoreCase);

    GameSessionRegistration? finalQuestionGame = null;
    if (isAuthenticated &&
        Context.Request.Path.StartsWithSegments("/Admin/Games/Lobby") &&
        Guid.TryParse(Context.Request.RouteValues["id"]?.ToString(), out var gameId))
    {
        finalQuestionGame = GameSessions.FindOwned(
            new BadWolfQuiz.Game.Runtime.GameSessionId(gameId),
            CurrentHost.RequiredId);
    }

    var showFinalQuestionTools =
        finalQuestionGame?.Session.Status == BadWolfQuiz.Game.Runtime.GameSessionStatus.Running &&
        finalQuestionGame.Session.FinalQuestion is not null;
}

<!DOCTYPE html>
<html lang="@currentCulture" data-theme="@siteThemeId" style="@customThemeStyle">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - BAD WOLF QUIZ</title>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/css/player-admission-menu.css" asp-append-version="true" />
    @if (!hidePortalFooter && !isEmbeddedDiscordSettings)
    {
        <link rel="stylesheet" href="~/css/sticky-footer.css" asp-append-version="true" />
    }
</head>
<body class="@(hidePortalFooter ? "gameplay-layout" : "portal-layout") @(isEmbeddedDiscordSettings ? "embedded-discord-settings" : null)">
    @if (!isEmbeddedDiscordSettings)
    {
    <header class="topbar">
        <a class="brand"
           asp-page="/Index"
           title="@ProductVersionLocalizer["LogoTooltip", productVersion.Version]">
            @if (hasBrandLogo)
            {
                <img class="brand-logo"
                     src="@Url.Page("/Admin/Settings/Index", "BrandLogo")"
                     alt="BAD WOLF QUIZ" />
            }
            else
            {
                <text>BAD WOLF <span>QUIZ</span></text>
            }
        </a>

        <div class="topbar-page-context">
            @await RenderSectionAsync("HeaderContext", required: false)
            @if (showFinalQuestionTools && finalQuestionGame is not null)
            {
                <details class="action-menu board-action-menu">
                    <summary class="button button-secondary action-menu-trigger">
                        @Localizer["Menu_Tools"]
                    </summary>
                    <div class="action-menu-popover">
                        <a class="action-menu-item"
                           asp-page="/Admin/Games/AnswerHistory"
                           asp-route-id="@finalQuestionGame.Session.Id.Value">
                            @Localizer["AnswerHistory_Open"]
                        </a>

                        <a class="action-menu-item"
                           asp-page="/Admin/Games/AnswerKey"
                           asp-route-id="@finalQuestionGame.Session.Id.Value"
                           target="_blank"
                           rel="noopener">
                            @Localizer["AnswerKey_Open"]
                        </a>

                        <button class="action-menu-item"
                                type="button"
                                data-open-join-code>
                            @Localizer["GameBoard_ShowJoinCode"]
                        </button>

                        <button class="action-menu-item"
                                type="button"
                                data-open-blocked-players>
                            @Localizer["GameBoard_ManageBlockedPlayers"]
                        </button>

                        <button class="action-menu-item"
                                type="button"
                                data-open-game-settings>
                            @Localizer["GameSettings_LobbyTitle"]
                        </button>
                    </div>
                </details>
            }
            @if (isSettingsPage)
            {
                <small>@ProductVersionLocalizer["VersionLabel"]: @productVersion.Version</small>
            }
        </div>

        <details class="action-menu header-action-menu">
            <summary class="button button-secondary action-menu-trigger">
                <span aria-hidden="true">☰</span>
                <span>@Localizer["Menu_Title"]</span>
            </summary>
            <div class="action-menu-popover" role="navigation" aria-label="@Localizer["Menu_Title"]">
                @if (isAuthenticated)
                {
                    <a class="action-menu-item" asp-page="/Admin/Quizzes/Index">@Localizer["Menu_Quizzes"]</a>
                }

                <a class="action-menu-item" asp-page="/PublicQuizzes">@Localizer["Menu_PublicQuizzes"]</a>
                @if (!string.IsNullOrWhiteSpace(discordInviteUrl))
                {
                    <a class="action-menu-item" href="@discordInviteUrl" target="_blank" rel="noopener noreferrer">
                        @Localizer["Menu_PlayWithUs"]
                    </a>
                }
                <a class="action-menu-item" asp-page="/Join/Index">@Localizer["Menu_Join"]</a>

                @if (isAuthenticated)
                {
                    <a class="action-menu-item" asp-page="/Admin/Games/History">@Localizer["Menu_GameHistory"]</a>
                    <a class="action-menu-item" asp-page="/Admin/Games/Statistics">@Localizer["Menu_PlayerStatistics"]</a>
                    @if (isMasterHost)
                    {
                        <a class="action-menu-item" asp-page="/Admin/MasterGames">@Localizer["Menu_ActiveGames"]</a>
                    }
                }

                <a class="action-menu-item" asp-page="/AskQuestion">@Localizer["Menu_AskQuestion"]</a>
                @if (hasUserQuestionHistory)
                {
                    <a class="action-menu-item" asp-page="/MyQuestions">@Localizer["Menu_MyQuestions"]</a>
                }
                @if (isMasterHost)
                {
                    <a class="action-menu-item" asp-page="/Admin/QuestionInbox">
                        @Localizer["Menu_QuestionInbox"]
                    </a>
                }
                <a class="action-menu-item" asp-page="/Faq">@Localizer["Menu_FAQ"]</a>

                @if (isAuthenticated)
                {
                    <a class="action-menu-item" asp-page="/Admin/Settings/Index">@Localizer["Menu_Settings"]</a>
                    <a class="action-menu-item" asp-page="/Account/ChangePassword">@Localizer["Menu_ChangePassword"]</a>
                }
                <a class="action-menu-item" asp-page="/About">@ProductVersionLocalizer["MenuAbout"]</a>

                <div class="action-menu-separator"></div>
                @if (isAuthenticated)
                {
                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit" class="action-menu-item">@Localizer["Menu_SignOut"]</button>
                    </form>
                }
                else
                {
                    <a class="action-menu-item" asp-page="/Account/Login">@Localizer["Menu_HostSignIn"]</a>
                }
            </div>
        </details>

        <div class="language-selector">
            <button id="languageButton"
                    class="language-button"
                    type="button"
                    aria-label="Language"
                    aria-expanded="false">
                @currentFlag
            </button>

            <div id="languageMenu" class="language-menu">
                <a asp-page="/SetLanguage"
                   asp-route-culture="uk"
                   asp-route-returnUrl="@returnUrl"
                   class="@(currentCulture == "uk" ? "active" : null)">
                    🇺🇦 Українська
                </a>
                <a asp-page="/SetLanguage"
                   asp-route-culture="en"
                   asp-route-returnUrl="@returnUrl"
                   class="@(currentCulture == "en" ? "active" : null)">
                    🇬🇧 English
                </a>
                <a asp-page="/SetLanguage"
                   asp-route-culture="it"
                   asp-route-returnUrl="@returnUrl"
                   class="@(currentCulture == "it" ? "active" : null)">
                    🇮🇹 Italiano
                </a>
            </div>
        </div>
    </header>
    }

    <main class="page-shell">
        @RenderBody()
    </main>

    @if (isAuthenticated && !isEmbeddedDiscordSettings)
    {
        <dialog class="app-dialog discord-settings-dialog"
                data-discord-settings-dialog
                aria-labelledby="discord-settings-dialog-title">
            <div class="dialog-card discord-settings-dialog-card">
                <div class="dialog-heading">
                    <h2 id="discord-settings-dialog-title">@Localizer["Discord_SettingsTitle"]</h2>
                    <button class="dialog-close"
                            type="button"
                            data-close-discord-settings
                            aria-label="@Localizer["Button_Close"]">×</button>
                </div>
                <iframe class="discord-settings-frame"
                        data-discord-settings-frame
                        data-src="@Url.Page("/Admin/Settings/Discord", new { embedded = true })"
                        title="@Localizer["Discord_SettingsTitle"]"></iframe>
            </div>
        </dialog>
    }

    @if (!hidePortalFooter && !isEmbeddedDiscordSettings)
    {
        @await Component.InvokeAsync("PortalFooter")
    }

    <script src="https://cdnjs.cloudflare.com/ajax/libs/microsoft-signalr/8.0.7/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/youtube-auto-expand.js" asp-append-version="true"></script>
    <script src="~/js/portal-footer.js" asp-append-version="true"></script>
    <script src="~/js/discord-settings-dialog.js" asp-append-version="true"></script>
    <script src="~/js/player-admission-menu.js" asp-append-version="true"></script>
    <script src="~/js/quiz-description-editor-links.js"
            asp-append-version="true"
            data-edit-label="@Localizer["Button_Edit"]"
            data-round-label="@Localizer["Label_Round"]"
            data-category-label="@Localizer["Label_Category"]"></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
