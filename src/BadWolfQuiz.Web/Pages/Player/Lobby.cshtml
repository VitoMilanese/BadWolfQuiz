@page "{code}/{playerId:guid}"
@model BadWolfQuiz.Web.Pages.Player.LobbyModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = Model.Game.Session.Quiz.Title;
    ViewData["HidePortalFooter"] = true;
    var currentCulture = CultureInfo.CurrentUICulture.TwoLetterISOLanguageName;
    var returnUrl = Request.Path + Request.QueryString;
    var discordInviteUrl = Configuration["Discord:InviteUrl"];
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}

<div class="form-card narrow player-lobby"
     data-game-code="@Model.Game.PublicCode"
     data-game-instance-id="@Model.Game.ClientInstanceId"
     data-player-id="@Model.CurrentPlayer.Id.Value"
     data-player-name="@Model.CurrentPlayer.Name"
     data-avatar-id="@Model.CurrentPlayer.AvatarId"
     data-webcam-url="@Model.CurrentPlayer.WebcamUrl"
     data-access-token="@Model.AccessToken"
     data-buzzer-open-label="@Localizer["PlayerGame_BuzzerOpen"]"
     data-buzzer-claimed-label="@Localizer["PlayerGame_BuzzerClaimed"]"
     data-buzzer-claimed-by-you-label="@Localizer["PlayerGame_BuzzerClaimedByYou"]"
     data-buzzer-already-answered-label="@Localizer["PlayerGame_BuzzerAlreadyAnswered"]"
     data-buzzer-closed-label="@Localizer["PlayerGame_BuzzerClosed"]"
     data-buzz-rejected-label="@Localizer["PlayerGame_BuzzRejected"]"
     data-final-action-rejected-label="@Localizer["FinalQuestion_ActionRejected"]"
     data-removed-from-game-label="@Localizer["PlayerGame_RemovedFromGame"]"
     data-player-image-invalid-label="@Localizer["PlayerImage_Invalid"]"
     data-player-webcam-url-invalid-label="@Localizer["PlayerWebcam_InvalidUrl"]"
     data-final-status="@Model.Game.Session.Status.ToString().ToLowerInvariant()">
    <p class="eyebrow">@Localizer["Message_WaitingHost"]</p>
    <h1>@Model.Game.Session.Quiz.Title</h1>

    <p>
        <strong>@Localizer["Label_PlayerName"]:</strong>
        @Model.CurrentPlayer.Name
    </p>

    <details class="player-media-settings player-menu-settings">
        <summary>@Localizer["PlayerMenu_Title"]</summary>
        <div class="player-media-settings-content">
            <nav class="player-menu-links" aria-label="@Localizer["PlayerMenu_Title"]">
                @if (isAuthenticated)
                {
                    <a class="button button-secondary" asp-page="/Admin/Quizzes/Index">@Localizer["Menu_Quizzes"]</a>
                    <a class="button button-secondary" asp-page="/Admin/Games/History">@Localizer["Menu_GameHistory"]</a>
                    <a class="button button-secondary" asp-page="/Admin/Games/Statistics">@Localizer["Menu_PlayerStatistics"]</a>
                    <a class="button button-secondary" asp-page="/Admin/Settings/Index">@Localizer["Menu_Settings"]</a>
                    <a class="button button-secondary" asp-page="/Account/ChangePassword">@Localizer["Account_ChangePassword"]</a>
                }

                <a class="button button-secondary" asp-page="/Join/Index">@Localizer["Button_Join"]</a>
                @if (!string.IsNullOrWhiteSpace(discordInviteUrl))
                {
                    <a class="button button-secondary"
                       href="@discordInviteUrl"
                       target="_blank"
                       rel="noopener noreferrer">@Localizer["Menu_PlayWithUs"]</a>
                }
                <a class="button button-secondary" asp-page="/Faq">@Localizer["Menu_FAQ"]</a>
                <a class="button button-secondary" asp-page="/AskQuestion">@Localizer["Menu_AskQuestion"]</a>

                @if (isAuthenticated)
                {
                    <form method="post" asp-page="/Account/Logout">
                        <button type="submit" class="button button-secondary">@Localizer["Account_SignOut"]</button>
                    </form>
                }
                else
                {
                    <a class="button button-secondary" asp-page="/Account/Login">@Localizer["Account_HostSignIn"]</a>
                }
            </nav>

            <div class="player-language-settings">
                <strong>@Localizer["Language_Label"]</strong>
                <div class="player-language-options">
                    <a class="button button-secondary @(currentCulture == "uk" ? "is-selected" : null)"
                       asp-page="/SetLanguage"
                       asp-route-culture="uk"
                       asp-route-returnUrl="@returnUrl">🇺🇦 Українська</a>
                    <a class="button button-secondary @(currentCulture == "en" ? "is-selected" : null)"
                       asp-page="/SetLanguage"
                       asp-route-culture="en"
                       asp-route-returnUrl="@returnUrl">🇬🇧 English</a>
                    <a class="button button-secondary @(currentCulture == "ru" ? "is-selected" : null)"
                       asp-page="/SetLanguage"
                       asp-route-culture="ru"
                       asp-route-returnUrl="@returnUrl">🇷🇺 Кацапська</a>
                    <a class="button button-secondary @(currentCulture == "it" ? "is-selected" : null)"
                       asp-page="/SetLanguage"
                       asp-route-culture="it"
                       asp-route-returnUrl="@returnUrl">🇮🇹 Italiano</a>
                </div>
            </div>
        </div>
    </details>

    <details class="player-media-settings">
        <summary>@Localizer["PlayerMedia_Settings"]</summary>
        <div class="player-media-settings-content">
        <div class="player-avatar-control">
        <img class="player-avatar-current"
             data-current-player-avatar
             src="@(!string.IsNullOrWhiteSpace(Model.CurrentPlayer.AvatarId) ? $"/avatars/{Model.CurrentPlayer.AvatarId}" : null)"
             alt=""
             hidden="@(string.IsNullOrWhiteSpace(Model.CurrentPlayer.AvatarId) ? "hidden" : null)" />
        <video class="player-avatar-current player-webcam-preview"
               data-player-webcam-preview
               autoplay
               muted
               playsinline
               hidden></video>
        <iframe class="player-avatar-current player-webcam-url-preview"
                data-player-webcam-url-preview
                title="@Model.CurrentPlayer.Name"
                allow="autoplay; fullscreen; picture-in-picture"
                sandbox="allow-scripts allow-same-origin allow-forms allow-popups allow-presentation"
                referrerpolicy="no-referrer"
                allowfullscreen
                hidden></iframe>
        <div class="player-image-source-switch" role="group"
             aria-label="@Localizer["PlayerImage_Source"]">
            <button class="button button-secondary"
                    type="button"
                    data-use-player-avatar>
                @Localizer["PlayerImage_Avatar"]
            </button>
            <button class="button button-secondary"
                    type="button"
                    data-use-player-image>
                @Localizer["PlayerImage_Picture"]
            </button>
            <button class="button button-secondary"
                    type="button"
                    data-use-player-webcam-url>
                @Localizer["PlayerWebcam_Url"]
            </button>
        </div>
        <div class="player-image-actions">
            <button class="button button-secondary" type="button" data-open-avatar-picker>
                @Localizer["AvatarPicker_ChooseOrChange"]
            </button>
            <button class="button button-secondary"
                    type="button"
                    data-upload-player-image>
                @Localizer["PlayerImage_UploadOrChange"]
            </button>
            <input type="file"
                   accept="image/png,image/jpeg,image/webp"
                   data-player-image-input
                   hidden />
        </div>
        <div class="player-webcam-url-field">
            <label for="player-webcam-url">@Localizer["PlayerWebcam_Url"]</label>
            <div class="player-webcam-url-row">
                <input id="player-webcam-url"
                       type="url"
                       maxlength="2048"
                       placeholder="https://vdo.ninja/?view=..."
                       data-player-webcam-url />
                <button class="button button-secondary"
                        type="button"
                        data-activate-player-webcam-url>
                    @Localizer["PlayerWebcam_UseUrl"]
                </button>
            </div>
            <small class="form-hint">
                @Localizer["HostCard_WebcamUrlHintPrefix"]
                <a href="https://vdo.ninja/" target="_blank" rel="noopener noreferrer">vdo.ninja</a>.
            </small>
        </div>
        <button class="button button-secondary"
                type="button"
                data-toggle-player-webcam
                data-enable-label="@Localizer["PlayerWebcam_Enable"]"
                data-disable-label="@Localizer["PlayerWebcam_Disable"]"
                data-webcam-enabled="false">
            @Localizer["PlayerWebcam_Enable"]
        </button>
        </div>
        <div class="message message-error"
             data-player-webcam-error
             data-unsupported-label="@Localizer["PlayerWebcam_RequiresHttps"]"
             data-denied-label="@Localizer["PlayerWebcam_AccessFailed"]"
             hidden></div>
        </div>
    </details>

    <div id="activity-warning" class="message message-error" hidden>
        @Localizer["PlayerPresence_InactiveWarning"]
    </div>
    <div id="rejoin-warning" class="message message-error" hidden>
        @Localizer["PlayerPresence_RejoinApprovalRequired"]
    </div>

    <p class="dialog-warning">@Localizer["PlayerPresence_MonitoringNotice"]</p>

    <div id="game-timer" class="game-timer player-game-timer" hidden>
        <strong id="game-timer-value">0.0</strong>
    </div>

    @if (Model.Game.Session.Status is
        BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalWagering or
        BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalAnswering or
        BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalJudging or
        BadWolfQuiz.Game.Runtime.GameSessionStatus.Completed)
    {
        var submission = Model.Game.Session.FinalQuestion?.Submissions
            .SingleOrDefault(item => item.PlayerId == Model.CurrentPlayer.Id);

        <section id="player-final-panel"
                 class="player-final-panel"
                 data-participates="@(submission is not null ? "true" : "false")">
            <p class="eyebrow">@Localizer["FinalQuestion_Title"]</p>

            @if (submission is null)
            {
                <p>@Localizer["FinalQuestion_NotEligible"]</p>
            }
            else if (Model.Game.Session.Status == BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalWagering)
            {
                @if (submission.Wager is null)
                {
                    <form id="final-wager-form"
                          class="question-wager-form final-wager-form"
                          data-minimum="@BadWolfQuiz.Game.Runtime.FinalQuestion.MinimumWager"
                          data-maximum="@submission.MaximumWager">
                        <label class="wager-display-label">
                            <span>@Localizer["FinalQuestion_YourWager"]</span>
                            <input id="final-wager"
                                   class="wager-display"
                                   type="text"
                                   inputmode="none"
                                   readonly
                                   required />
                        </label>

                        <div class="wager-keypad"
                             aria-label="@Localizer["GameBoard_WagerKeypad"]">
                            @foreach (var digit in new[] { 1, 2, 3, 4, 5, 6, 7, 8, 9 })
                            {
                                <button type="button" data-final-wager-digit="@digit">
                                    @digit
                                </button>
                            }
                            <button type="button"
                                    data-final-wager-clear
                                    aria-label="@Localizer["GameBoard_ClearWager"]">
                                C
                            </button>
                            <button type="button" data-final-wager-digit="0">0</button>
                            <button type="button"
                                    data-final-wager-backspace
                                    aria-label="@Localizer["GameBoard_DeleteWagerDigit"]">
                                ⌫
                            </button>
                            <button class="wager-keypad-max"
                                    type="button"
                                    data-final-wager-max
                                    aria-label="@Localizer["GameBoard_MaximumWager"]">
                                MAX
                            </button>
                        </div>

                        <p class="wager-validation"
                           data-final-wager-validation
                           data-valid-label="@Localizer["GameBoard_WagerValid"]"
                           data-invalid-label="@Localizer[
                               "GameBoard_WagerOutsideLimits",
                               BadWolfQuiz.Game.Runtime.FinalQuestion.MinimumWager,
                               submission.MaximumWager]">
                            @Localizer[
                                "GameBoard_WagerOutsideLimits",
                                BadWolfQuiz.Game.Runtime.FinalQuestion.MinimumWager,
                                submission.MaximumWager]
                        </p>

                        <button class="button button-primary"
                                type="submit"
                                data-final-wager-submit
                                disabled>
                            @Localizer["FinalQuestion_ConfirmWager"]
                        </button>
                    </form>
                }
                else
                {
                    <p>@Localizer["FinalQuestion_WagerConfirmed"]</p>
                }
            }
            else if (Model.Game.Session.Status is
                BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalAnswering or
                BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalJudging)
            {
                <div class="game-content-blocks">
                    @foreach (var block in Model.Game.Session.FinalQuestion!.Definition.QuestionBlocks)
                    {
                        <article class="game-content-block">
                            @if (!string.IsNullOrWhiteSpace(block.TopCaption))
                            {
                                <p class="game-content-caption">@block.TopCaption</p>
                            }
                            @switch (block.Kind)
                            {
                                case BadWolfQuiz.Game.Definitions.ContentBlockKind.Text:
                                    <p class="game-content-text">@block.TextContent</p>
                                    break;
                                case BadWolfQuiz.Game.Definitions.ContentBlockKind.Image:
                                    <img class="game-content-image"
                                         src="@Url.Page("/Player/Lobby", "FinalContentBlock", new { code = Model.Game.PublicCode, playerId = Model.CurrentPlayer.Id.Value, sourceContentBlockId = block.SourceContentBlockId })"
                                         alt="@block.FileName" />
                                    break;
                                case BadWolfQuiz.Game.Definitions.ContentBlockKind.Audio:
                                    <audio class="game-content-audio"
                                           controls
                                           src="@Url.Page("/Player/Lobby", "FinalContentBlock", new { code = Model.Game.PublicCode, playerId = Model.CurrentPlayer.Id.Value, sourceContentBlockId = block.SourceContentBlockId })">
                                    </audio>
                                    break;
                                case BadWolfQuiz.Game.Definitions.ContentBlockKind.Video:
                                    <video class="game-content-video" controls src="@block.ExternalUrl"></video>
                                    break;
                                case BadWolfQuiz.Game.Definitions.ContentBlockKind.YouTube:
                                    <iframe class="game-content-video youtube-auto-expand"
                                            src="@BadWolfQuiz.Web.Pages.Admin.Games.LobbyModel.GetYouTubeEmbedUrl(block.ExternalUrl)"
                                            title="@Localizer["GameBoard_MediaContent"]"
                                            data-close-label="@Localizer["GameBoard_CloseVideo"]"
                                            allowfullscreen>
                                    </iframe>
                                    break;
                            }
                            @if (!string.IsNullOrWhiteSpace(block.BottomCaption))
                            {
                                <p class="game-content-caption">@block.BottomCaption</p>
                            }
                        </article>
                    }
                </div>

                @if (Model.Game.Session.Status == BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalAnswering &&
                    submission.Answer is null)
                {
                    <form id="final-answer-form" class="stack-form">
                        <label>
                            <span>@Localizer["FinalQuestion_YourAnswer"]</span>
                            <textarea id="final-answer" required></textarea>
                        </label>
                        <button class="button button-primary" type="submit">
                            @Localizer["FinalQuestion_ConfirmAnswer"]
                        </button>
                    </form>
                }
                else if (Model.Game.Session.Status == BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalAnswering)
                {
                    <p>@Localizer["FinalQuestion_AnswerConfirmed"]</p>
                }
                else
                {
                    <p>@Localizer["FinalQuestion_WaitingForJudging"]</p>
                }
            }
            else
            {
                <p>
                    @(submission.IsCorrect == true
                        ? Localizer["FinalQuestion_YourAnswerCorrect"]
                        : Localizer["FinalQuestion_YourAnswerWrong"])
                </p>

            }

            <div id="final-question-error" class="message message-error" hidden></div>
        </section>
    }
    else if (!Model.CanRateQuiz)
    {
    <section class="player-buzzer-panel">
        <button id="player-buzzer"
                class="player-buzzer"
                type="button"
                disabled>
            @Localizer["PlayerGame_Buzz"]
        </button>
        <p id="player-buzzer-status" class="dialog-warning">
            @Localizer["PlayerGame_BuzzerClosed"]
        </p>
    </section>
    }

    @if (Model.CanRateQuiz)
    {
        <section class="quiz-rating-panel">
            <h2>@Localizer["QuizRating_Title"]</h2>
            <p>@Localizer["QuizRating_Description"]</p>
            <form method="post"
                  asp-page-handler="RateQuiz"
                  class="quiz-rating-form"
                  data-auto-rating-form
                  data-rating-error-label="@Localizer["QuizRating_NotReady"]">
                <input name="code" type="hidden" value="@Model.Game.PublicCode" />
                <input name="playerId" type="hidden" value="@Model.CurrentPlayer.Id.Value" />
                <input name="accessToken" type="hidden" value="@Model.AccessToken" />
                <fieldset class="star-rating">
                    <legend>@Localizer["QuizRating_ScoreLabel"]</legend>
                    @for (var score = 5; score >= 1; score--)
                    {
                        <input id="quiz-rating-@score"
                               name="score"
                               type="radio"
                               value="@score"
                               checked="@(Model.ExistingRating == score)" />
                        <label for="quiz-rating-@score"
                               title="@Localizer["QuizRating_Stars", score]">★</label>
                    }
                </fieldset>
                <span class="quiz-rating-save-state" data-rating-save-state aria-live="polite"></span>
            </form>
        </section>
    }

</div>

<partial name="_AvatarPicker" />

<dialog id="removed-from-game-dialog"
        class="app-dialog"
        aria-labelledby="removed-from-game-dialog-title">
    <div class="dialog-card dialog-card-danger">
        <div class="dialog-heading">
            <h2 id="removed-from-game-dialog-title">
                @Localizer["PlayerGame_RemovedFromGameTitle"]
            </h2>
        </div>

        <p class="dialog-warning">@Localizer["PlayerGame_RemovedFromGame"]</p>

        <div class="form-actions dialog-actions">
            <button class="button button-primary"
                    type="button"
                    data-close-removed-from-game-dialog>
                @Localizer["Button_Close"]
            </button>
        </div>
    </div>
</dialog>

@section Scripts {
    <script src="~/js/avatar-picker.js" asp-append-version="true"></script>
    <script src="~/js/webcam-streams.js" asp-append-version="true"></script>
    <script src="https://cdn.jsdelivr.net/npm/nosleep.js@0.12.0/dist/NoSleep.min.js"></script>
    <script>
        (() => {
            let screenWakeLock = null;
            let isRequestingScreenWakeLock = false;
            let fallbackWakeLockEnabled = false;
            const fallbackWakeLock = typeof NoSleep === "function"
                ? new NoSleep()
                : null;

            const enableFallbackWakeLock = () => {
                if (fallbackWakeLockEnabled ||
                    !fallbackWakeLock) {
                    return;
                }

                try {
                    const enableResult = fallbackWakeLock.enable();
                    fallbackWakeLockEnabled = true;
                    Promise.resolve(enableResult).catch(() => {
                        fallbackWakeLockEnabled = false;
                    });
                } catch {
                    fallbackWakeLockEnabled = false;
                }
            };

            const requestScreenWakeLock = async () => {
                if (screenWakeLock ||
                    isRequestingScreenWakeLock ||
                    !("wakeLock" in navigator) ||
                    document.visibilityState !== "visible") {
                    return;
                }

                isRequestingScreenWakeLock = true;
                try {
                    screenWakeLock = await navigator.wakeLock.request("screen");
                    screenWakeLock.addEventListener("release", () => {
                        screenWakeLock = null;
                        window.setTimeout(requestScreenWakeLock, 250);
                    }, { once: true });
                } catch {
                    screenWakeLock = null;
                } finally {
                    isRequestingScreenWakeLock = false;
                }
            };

            document.addEventListener("visibilitychange", () => {
                if (document.visibilityState === "visible") {
                    void requestScreenWakeLock();
                }
            });
            const keepScreenAwakeAfterInteraction = () => {
                void requestScreenWakeLock();
                enableFallbackWakeLock();
            };
            document.addEventListener(
                "pointerdown",
                keepScreenAwakeAfterInteraction,
                { passive: true });
            document.addEventListener(
                "touchstart",
                keepScreenAwakeAfterInteraction,
                { passive: true });
            window.setInterval(() => void requestScreenWakeLock(), 15000);
            void requestScreenWakeLock();
        })();
    </script>
    <script>
        (() => {
            const lobby = document.querySelector(".player-lobby");
            const warning = document.getElementById("activity-warning");
            const rejoinWarning = document.getElementById("rejoin-warning");
            const buzzerButton = document.getElementById("player-buzzer");
            const buzzerStatus = document.getElementById("player-buzzer-status");
            const timerPanel = document.getElementById("game-timer");
            const timerValue = document.getElementById("game-timer-value");
            const finalWagerForm = document.getElementById("final-wager-form");
            const finalAnswerForm = document.getElementById("final-answer-form");
            const finalError = document.getElementById("final-question-error");
            let buzzerQuestionId = null;
            let hasReceivedInitialFinalState = false;

            if (!lobby || !warning || typeof signalR === "undefined") {
                return;
            }

            const gameCode = lobby.dataset.gameCode;
            const gameInstanceId = lobby.dataset.gameInstanceId;
            const normalizedPlayerName =
                lobby.dataset.playerName.trim().toLocaleLowerCase();
            const avatarPreferenceKey = `badwolfquiz:avatar:${normalizedPlayerName}`;
            const imagePreferenceKey = `badwolfquiz:image:${normalizedPlayerName}`;
            const imageSourcePreferenceKey =
                `badwolfquiz:image-source:${normalizedPlayerName}`;
            if (lobby.dataset.avatarId) {
                localStorage.setItem(avatarPreferenceKey, lobby.dataset.avatarId);
            }
            const removedFromGameDialog =
                document.getElementById("removed-from-game-dialog");
            const removedFromGameRedirect = () => {
                window.location.assign(`/Join?code=${encodeURIComponent(gameCode)}`);
            };

            document.querySelector("[data-close-removed-from-game-dialog]")
                ?.addEventListener("click", () => removedFromGameDialog?.close());
            removedFromGameDialog?.addEventListener("close", removedFromGameRedirect);
            const playerId = lobby.dataset.playerId;
            const storageKey = `badwolfquiz:${gameCode}:player:${playerId}`;
            const currentPlayerStorageKey =
                `badwolfquiz:${gameCode}:current-player`;
            const transitionStorageKey = `${storageKey}:transition`;
            const bootstrapToken = lobby.dataset.accessToken;

            const clearStoredPlayerAccess = () => {
                localStorage.removeItem(storageKey);
                localStorage.removeItem(currentPlayerStorageKey);
                localStorage.removeItem(transitionStorageKey);
            };

            if (bootstrapToken) {
                localStorage.setItem(storageKey, bootstrapToken);
                history.replaceState({}, document.title, window.location.pathname);
            }

            const accessToken = bootstrapToken || localStorage.getItem(storageKey);

            if (accessToken) {
                localStorage.setItem(
                    currentPlayerStorageKey,
                    JSON.stringify({
                        playerId,
                        accessToken,
                        gameInstanceId,
                        path: window.location.pathname
                    }));
            }

            if (!accessToken) {
                warning.hidden = false;
                return;
            }

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/game")
                .withAutomaticReconnect()
                .build();
            const currentAvatar = document.querySelector("[data-current-player-avatar]");
            const avatarSourceButton = document.querySelector("[data-use-player-avatar]");
            const imageSourceButton = document.querySelector("[data-use-player-image]");
            const webcamUrlSourceButton = document.querySelector(
                "[data-use-player-webcam-url]");
            const uploadImageButton = document.querySelector("[data-upload-player-image]");
            const imageInput = document.querySelector("[data-player-image-input]");
            const webcamUrlInput = document.querySelector("[data-player-webcam-url]");
            const webcamUrlPreview = document.querySelector(
                "[data-player-webcam-url-preview]");
            const activateWebcamUrlButton = document.querySelector(
                "[data-activate-player-webcam-url]");
            let storedAvatarId = lobby.dataset.avatarId ||
                localStorage.getItem(avatarPreferenceKey) || "";
            let storedImageDataUrl = localStorage.getItem(imagePreferenceKey) || "";
            const webcamUrlPreferenceKey =
                `badwolfquiz:webcam-url:${normalizedPlayerName}`;
            let storedWebcamUrl = lobby.dataset.webcamUrl ||
                localStorage.getItem(webcamUrlPreferenceKey) || "";
            let selectedImageSource =
                localStorage.getItem(imageSourcePreferenceKey) ||
                (storedWebcamUrl ? "webcam-url" :
                    storedImageDataUrl ? "image" : "avatar");
            const webcamButton = document.querySelector(
                "[data-toggle-player-webcam]");
            const webcam = window.BadWolfWebcam.createPlayer({
                connection,
                gameCode,
                preview: document.querySelector("[data-player-webcam-preview]"),
                avatar: document.querySelector("[data-current-player-avatar]"),
                button: webcamButton,
                error: document.querySelector("[data-player-webcam-error]"),
                enableLabel: webcamButton?.dataset.enableLabel,
                disableLabel: webcamButton?.dataset.disableLabel
            });
            const avatarDialog = document.querySelector("[data-avatar-picker]");
            let pendingAvatarId;
            let pendingImageDataUrl;
            let pendingWebcamUrl;

            const setSourceButtonState = () => {
                avatarSourceButton.disabled = !storedAvatarId;
                imageSourceButton.disabled = !storedImageDataUrl;
                webcamUrlSourceButton.disabled = !storedWebcamUrl;
                const updateButton = (button, isSelected) => {
                    button.classList.toggle("button-primary", isSelected);
                    button.classList.toggle("button-secondary", !isSelected);
                    button.setAttribute("aria-pressed", isSelected.toString());
                };
                updateButton(
                    avatarSourceButton,
                    selectedImageSource === "avatar"
                );
                updateButton(
                    imageSourceButton,
                    selectedImageSource === "image"
                );
                updateButton(
                    webcamUrlSourceButton,
                    selectedImageSource === "webcam-url"
                );
            };

            const showSelectedPlayerImage = () => {
                const source = selectedImageSource === "image"
                    ? storedImageDataUrl
                    : selectedImageSource === "avatar" && storedAvatarId
                        ? `/avatars/${storedAvatarId}` : "";

                if (selectedImageSource === "webcam-url" && storedWebcamUrl) {
                    webcamUrlPreview.src = withMutedWebcamAudio(storedWebcamUrl);
                    webcamUrlPreview.hidden = false;
                } else {
                    webcamUrlPreview.removeAttribute("src");
                    webcamUrlPreview.hidden = true;
                }

                if (source) {
                    currentAvatar.src = source;
                    currentAvatar.hidden = false;
                } else {
                    currentAvatar.removeAttribute("src");
                    currentAvatar.hidden = true;
                }

                setSourceButtonState();
            };

            const withMutedWebcamAudio = value => {
                const url = new URL(value);
                url.searchParams.set("deafen", "1");
                url.searchParams.set("noaudio", "");
                if (url.hash.length > 1) {
                    const fragment = new URLSearchParams(url.hash.slice(1));
                    fragment.set("deafen", "1");
                    fragment.set("noaudio", "");
                    url.hash = fragment.toString();
                }
                return url.toString();
            };

            const activateAvatar = async () => {
                if (!storedAvatarId) {
                    return;
                }

                await webcam.disable();
                selectedImageSource = "avatar";
                localStorage.setItem(imageSourcePreferenceKey, selectedImageSource);
                showSelectedPlayerImage();
                pendingAvatarId = storedAvatarId;

                if (connection.state === signalR.HubConnectionState.Connected) {
                    await connection.invoke("SetPlayerAvatar", storedAvatarId);
                    pendingAvatarId = undefined;
                }
            };

            const activateUploadedImage = async () => {
                if (!storedImageDataUrl) {
                    return;
                }

                await webcam.disable();
                selectedImageSource = "image";
                localStorage.setItem(imageSourcePreferenceKey, selectedImageSource);
                showSelectedPlayerImage();
                pendingImageDataUrl = storedImageDataUrl;

                if (connection.state === signalR.HubConnectionState.Connected) {
                    await connection.invoke(
                        "SetPlayerUploadedImage",
                        storedImageDataUrl
                    );
                    pendingImageDataUrl = undefined;
                }
            };

            const isValidWebcamUrl = value => {
                try {
                    const url = new URL(value);
                    return url.protocol === "https:" &&
                        !url.username && !url.password;
                } catch {
                    return false;
                }
            };

            const activateWebcamUrl = async () => {
                const value = webcamUrlInput.value.trim();
                if (!isValidWebcamUrl(value)) {
                    alert(lobby.dataset.playerWebcamUrlInvalidLabel);
                    return;
                }

                await webcam.disable();
                storedWebcamUrl = value;
                selectedImageSource = "webcam-url";
                localStorage.setItem(webcamUrlPreferenceKey, storedWebcamUrl);
                localStorage.setItem(imageSourcePreferenceKey, selectedImageSource);
                showSelectedPlayerImage();
                pendingWebcamUrl = storedWebcamUrl;

                if (connection.state === signalR.HubConnectionState.Connected) {
                    await connection.invoke("SetPlayerWebcamUrl", storedWebcamUrl);
                    pendingWebcamUrl = undefined;
                }
            };

            const resizePlayerImage = file => new Promise((resolve, reject) => {
                const image = new Image();
                const objectUrl = URL.createObjectURL(file);

                image.onload = () => {
                    URL.revokeObjectURL(objectUrl);
                    let maxSide = 640;
                    let dataUrl = "";

                    while (maxSide >= 240) {
                        const scale = Math.min(1, maxSide / Math.max(
                            image.naturalWidth,
                            image.naturalHeight
                        ));
                        const canvas = document.createElement("canvas");
                        canvas.width = Math.max(1, Math.round(image.naturalWidth * scale));
                        canvas.height = Math.max(1, Math.round(image.naturalHeight * scale));
                        canvas.getContext("2d").drawImage(
                            image,
                            0,
                            0,
                            canvas.width,
                            canvas.height
                        );
                        dataUrl = canvas.toDataURL("image/webp", .82);

                        if (dataUrl.length <= 200000) {
                            resolve(dataUrl);
                            return;
                        }

                        maxSide -= 80;
                    }

                    reject(new Error(lobby.dataset.playerImageInvalidLabel));
                };

                image.onerror = () => {
                    URL.revokeObjectURL(objectUrl);
                    reject(new Error(lobby.dataset.playerImageInvalidLabel));
                };

                image.src = objectUrl;
            });

            avatarSourceButton?.addEventListener("click", () => {
                activateAvatar().catch(console.error);
            });
            imageSourceButton?.addEventListener("click", () => {
                activateUploadedImage().catch(console.error);
            });
            webcamUrlSourceButton?.addEventListener("click", () => {
                webcamUrlInput.value = storedWebcamUrl;
                activateWebcamUrl().catch(console.error);
            });
            activateWebcamUrlButton?.addEventListener("click", () => {
                activateWebcamUrl().catch(console.error);
            });
            webcamButton?.addEventListener("click", () => {
                selectedImageSource = storedImageDataUrl ? "image" : "avatar";
                localStorage.setItem(imageSourcePreferenceKey, selectedImageSource);
                webcamUrlPreview.removeAttribute("src");
                webcamUrlPreview.hidden = true;
                setSourceButtonState();
            });
            uploadImageButton?.addEventListener("click", () => imageInput?.click());
            imageInput?.addEventListener("change", async () => {
                const file = imageInput.files?.[0];
                imageInput.value = "";

                if (!file || !["image/jpeg", "image/png", "image/webp"].includes(file.type)) {
                    alert(lobby.dataset.playerImageInvalidLabel);
                    return;
                }

                try {
                    storedImageDataUrl = await resizePlayerImage(file);
                    localStorage.setItem(imagePreferenceKey, storedImageDataUrl);
                    await activateUploadedImage();
                }
                catch (error) {
                    console.error(error);
                    alert(error.message || lobby.dataset.playerImageInvalidLabel);
                }
            });

            avatarDialog?.addEventListener("avatarselected", event => {
                const avatarId = event.detail.avatarId;
                storedAvatarId = avatarId;
                lobby.dataset.avatarId = avatarId;
                localStorage.setItem(avatarPreferenceKey, avatarId);
                activateAvatar()
                    .then(() => currentAvatar.src = event.detail.avatarUrl)
                    .catch(console.error);
            });

            if (selectedImageSource === "image" && !storedImageDataUrl) {
                selectedImageSource = "avatar";
            }
            if (selectedImageSource === "avatar" && !storedAvatarId && storedImageDataUrl) {
                selectedImageSource = "image";
            }
            if (selectedImageSource === "webcam-url" && !storedWebcamUrl) {
                selectedImageSource = storedImageDataUrl ? "image" : "avatar";
            }
            localStorage.setItem(imageSourcePreferenceKey, selectedImageSource);
            webcamUrlInput.value = storedWebcamUrl;
            showSelectedPlayerImage();
            if (selectedImageSource === "webcam-url") {
                pendingWebcamUrl = storedWebcamUrl;
            } else if (selectedImageSource === "image") {
                pendingImageDataUrl = storedImageDataUrl;
            } else if (storedAvatarId) {
                pendingAvatarId = storedAvatarId;
            }

            const isPageActive = () =>
                document.visibilityState === "visible" && document.hasFocus();

            const updateWarning = () => {
                warning.hidden = isPageActive();
            };

            const joinPlayerSession = async () => {
                const transitionToken =
                    sessionStorage.getItem(transitionStorageKey);

                await connection.invoke(
                    "JoinPlayerSession",
                    gameCode,
                    accessToken,
                    isPageActive(),
                    transitionToken);

                if (transitionToken) {
                    sessionStorage.removeItem(transitionStorageKey);
                }
            };

            let transitionReloadStarted = false;
            const reloadForGameTransition = async () => {
                if (transitionReloadStarted) {
                    return;
                }

                transitionReloadStarted = true;
                const transitionToken = await connection.invoke(
                    "PreparePlayerTransition");

                if (!transitionToken) {
                    transitionReloadStarted = false;
                    return;
                }

                sessionStorage.setItem(
                    transitionStorageKey,
                    transitionToken);
                window.location.reload();
            };

            connection.on("TimerStateChanged", update => {
                if (!timerPanel || !timerValue) {
                    return;
                }

                timerPanel.hidden = !update.isVisible;
                timerPanel.classList.toggle(
                    "answer-timer",
                    update.mode === "answer");
                timerValue.textContent =
                    Math.ceil(update.remainingMilliseconds / 1000);
            });

            connection.on("BuzzerStateChanged", update => {
                const hasAlreadyAnswered =
                    update.ineligiblePlayerIds?.includes(playerId) ?? false;
                const isOpen = update.status === "open";
                const canBuzz = isOpen && !hasAlreadyAnswered;
                buzzerQuestionId = canBuzz
                    ? update.sourceQuestionId
                    : null;
                lobby.classList.toggle("is-page-buzzer-active", canBuzz);

                if (buzzerButton) {
                    buzzerButton.disabled = !canBuzz;
                    buzzerButton.classList.toggle("player-buzzer-open", canBuzz);
                }

                if (buzzerStatus) {
                    const isClaimedByCurrentPlayer =
                        update.status === "claimed" &&
                        update.answeringPlayerId === playerId;

                    buzzerStatus.textContent = hasAlreadyAnswered
                        ? lobby.dataset.buzzerAlreadyAnsweredLabel
                        : isOpen
                            ? lobby.dataset.buzzerOpenLabel
                            : isClaimedByCurrentPlayer
                                ? lobby.dataset.buzzerClaimedByYouLabel
                                : update.status === "claimed"
                                    ? lobby.dataset.buzzerClaimedLabel
                                    : lobby.dataset.buzzerClosedLabel;
                }
            });

            const applySiteTheme = update => {
                if (!update?.siteThemeId) {
                    return;
                }

                const root = document.documentElement;
                root.dataset.theme = update.siteThemeId;
                root.style.cssText = update.customThemeStyle || "";
            };

            connection.on("SiteThemeChanged", applySiteTheme);

            connection.on("GameStatusChanged", update => {
                const finalStatuses = [
                    "finalwagering",
                    "finalanswering",
                    "finaljudging",
                    "completed"
                ];

                if (lobby.dataset.finalStatus !== update.status &&
                    finalStatuses.includes(update.status)) {
                    reloadForGameTransition().catch(console.error);
                }
            });

            connection.on("QuizCompleted", () => {
                reloadForGameTransition().catch(console.error);
            });

            connection.on("FinalQuestionStateChanged", () => {
                if (!hasReceivedInitialFinalState) {
                    hasReceivedInitialFinalState = true;
                    return;
                }

                reloadForGameTransition().catch(console.error);
            });

            connection.on("FinalQuestionProgressChanged", () => {
                reloadForGameTransition().catch(console.error);
            });

            connection.on("FinalQuestionActionRejected", update => {
                if (finalError) {
                    finalError.textContent =
                        lobby.dataset.finalActionRejectedLabel || update.message;
                    finalError.hidden = false;
                }
            });

            finalWagerForm?.addEventListener("submit", event => {
                event.preventDefault();
                const input = document.getElementById("final-wager");
                const amount = Number(input?.value);
                const minimum = Number(finalWagerForm.dataset.minimum);
                const maximum = Number(finalWagerForm.dataset.maximum);

                if (!Number.isInteger(amount) ||
                    amount < minimum ||
                    amount > maximum) {
                    return;
                }

                finalWagerForm.querySelector("button").disabled = true;
                connection.invoke("SubmitFinalWager", amount)
                    .catch(console.error);
            });

            if (finalWagerForm) {
                const display = document.getElementById("final-wager");
                const validation = finalWagerForm.querySelector(
                    "[data-final-wager-validation]");
                const submit = finalWagerForm.querySelector(
                    "[data-final-wager-submit]");
                const minimum = Number(finalWagerForm.dataset.minimum);
                const maximum = Number(finalWagerForm.dataset.maximum);

                const refreshFinalWager = () => {
                    const amount = Number(display.value);
                    const isValid = display.value !== "" &&
                        amount >= minimum &&
                        amount <= maximum;

                    submit.disabled = !isValid;
                    validation.textContent = isValid
                        ? validation.dataset.validLabel
                        : validation.dataset.invalidLabel;
                    validation.classList.toggle("wager-valid", isValid);
                };

                finalWagerForm
                    .querySelectorAll("[data-final-wager-digit]")
                    .forEach(button => {
                        button.addEventListener("click", () => {
                            const nextValue = (
                                display.value +
                                button.dataset.finalWagerDigit)
                                .replace(/^0+(?=\d)/, "");

                            display.value = Math.min(
                                Number(nextValue),
                                maximum).toString();
                            refreshFinalWager();
                        });
                    });

                finalWagerForm
                    .querySelector("[data-final-wager-max]")
                    ?.addEventListener("click", () => {
                        display.value = maximum.toString();
                        refreshFinalWager();
                    });

                finalWagerForm
                    .querySelector("[data-final-wager-clear]")
                    ?.addEventListener("click", () => {
                        display.value = "";
                        refreshFinalWager();
                    });

                finalWagerForm
                    .querySelector("[data-final-wager-backspace]")
                    ?.addEventListener("click", () => {
                        display.value = display.value.slice(0, -1);
                        refreshFinalWager();
                    });

                refreshFinalWager();
            }

            finalAnswerForm?.addEventListener("submit", event => {
                event.preventDefault();
                const input = document.getElementById("final-answer");
                const answer = input?.value.trim();

                if (!answer) {
                    return;
                }

                finalAnswerForm.querySelector("button").disabled = true;
                connection.invoke("SubmitFinalAnswer", answer)
                    .catch(console.error);
            });


            const tryBuzz = () => {
                if (buzzerQuestionId === null ||
                    connection.state !== signalR.HubConnectionState.Connected) {
                    return;
                }

                const sourceQuestionId = buzzerQuestionId;
                buzzerQuestionId = null;
                lobby.classList.remove("is-page-buzzer-active");
                buzzerButton.disabled = true;
                buzzerButton.classList.remove("player-buzzer-open");
                connection.invoke("Buzz", sourceQuestionId).catch(console.error);
            };

            buzzerButton?.addEventListener("click", tryBuzz);

            document.addEventListener("click", event => {
                if (buzzerQuestionId === null ||
                    event.target.closest(
                        "button, a, input, textarea, select, summary, details, dialog")) {
                    return;
                }

                tryBuzz();
            });

            connection.on("BuzzRejected", () => {
                if (buzzerStatus) {
                    buzzerStatus.textContent = lobby.dataset.buzzRejectedLabel;
                }
            });

            connection.on("PlayerAccessRejected", () => {
                clearStoredPlayerAccess();
                removedFromGameRedirect();
            });

            connection.on("RejoinApprovalRequired", () => {
                rejoinWarning.hidden = false;
            });

            connection.on("RejoinApproved", () => {
                rejoinWarning.hidden = true;
                updateWarning();
            });

            connection.on("RemovedFromGame", () => {
                clearStoredPlayerAccess();
                if (removedFromGameDialog) {
                    removedFromGameDialog.showModal();
                    return;
                }

                removedFromGameRedirect();
            });

            connection.onreconnected(async () => {
                await joinPlayerSession();
                await webcam.reconnect();
            });

            document.addEventListener("visibilitychange", () => {
                updateWarning();

                if (connection.state === signalR.HubConnectionState.Connected) {
                    const active = isPageActive();
                    connection.invoke("SetPlayerVisibility", active).catch(console.error);
                    webcam.setActive(active).catch(console.error);
                }
            });

            window.addEventListener("focus", () => {
                updateWarning();

                if (connection.state === signalR.HubConnectionState.Connected) {
                    connection.invoke("SetPlayerVisibility", true).catch(console.error);
                    webcam.setActive(true).catch(console.error);
                }
            });

            window.addEventListener("blur", () => {
                updateWarning();

                if (connection.state === signalR.HubConnectionState.Connected) {
                    connection.invoke("SetPlayerVisibility", false).catch(console.error);
                    webcam.setActive(false).catch(console.error);
                }
            });

            updateWarning();
            connection.start().then(async () => {
                await joinPlayerSession();
                await webcam.reconnect();
                if (pendingAvatarId) {
                    await connection.invoke("SetPlayerAvatar", pendingAvatarId);
                    pendingAvatarId = undefined;
                }
                if (pendingImageDataUrl) {
                    await connection.invoke(
                        "SetPlayerUploadedImage",
                        pendingImageDataUrl
                    );
                    pendingImageDataUrl = undefined;
                }
                if (pendingWebcamUrl) {
                    await connection.invoke("SetPlayerWebcamUrl", pendingWebcamUrl);
                    pendingWebcamUrl = undefined;
                }
                if (!storedAvatarId && !storedImageDataUrl && !storedWebcamUrl) {
                    document.querySelector("[data-open-avatar-picker]")?.click();
                }
            }).catch(() => {
                warning.hidden = false;
            });
        })();
    </script>
}
