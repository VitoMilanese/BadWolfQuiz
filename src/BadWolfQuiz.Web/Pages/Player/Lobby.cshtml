@page "{code}/{playerId:guid}"
@model BadWolfQuiz.Web.Pages.Player.LobbyModel
@{
    ViewData["Title"] = Model.Game.Session.Quiz.Title;
}

<div class="form-card narrow player-lobby"
     data-game-code="@Model.Game.PublicCode"
     data-player-id="@Model.CurrentPlayer.Id.Value"
     data-access-token="@Model.AccessToken"
     data-buzzer-open-label="@Localizer["PlayerGame_BuzzerOpen"]"
     data-buzzer-claimed-label="@Localizer["PlayerGame_BuzzerClaimed"]"
     data-buzzer-claimed-by-you-label="@Localizer["PlayerGame_BuzzerClaimedByYou"]"
     data-buzzer-already-answered-label="@Localizer["PlayerGame_BuzzerAlreadyAnswered"]"
     data-buzzer-closed-label="@Localizer["PlayerGame_BuzzerClosed"]"
     data-buzz-rejected-label="@Localizer["PlayerGame_BuzzRejected"]"
     data-final-action-rejected-label="@Localizer["FinalQuestion_ActionRejected"]"
     data-removed-from-game-label="@Localizer["PlayerGame_RemovedFromGame"]"
     data-final-status="@Model.Game.Session.Status.ToString().ToLowerInvariant()">
    <p class="eyebrow">@Localizer["Message_WaitingHost"]</p>
    <h1>@Model.Game.Session.Quiz.Title</h1>

    <div class="game-code-panel compact">
        <span>@Localizer["Label_GameCode"]</span>
        <strong>@Model.Game.PublicCode</strong>
    </div>

    <p>
        <strong>@Localizer["Label_PlayerName"]:</strong>
        @Model.CurrentPlayer.Name
    </p>

    <div id="activity-warning" class="message message-error" hidden>
        @Localizer["PlayerPresence_InactiveWarning"]
    </div>
    <div id="rejoin-warning" class="message message-error" hidden>
        @Localizer["PlayerPresence_RejoinApprovalRequired"]
    </div>

    <p class="dialog-warning">@Localizer["PlayerPresence_MonitoringNotice"]</p>

    <div id="game-timer" class="game-timer player-game-timer" hidden>
        <strong id="game-timer-value">0.0</strong>
    </div>

    @if (Model.Game.Session.Status is
        BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalWagering or
        BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalAnswering or
        BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalJudging or
        BadWolfQuiz.Game.Runtime.GameSessionStatus.Completed)
    {
        var submission = Model.Game.Session.FinalQuestion?.Submissions
            .SingleOrDefault(item => item.PlayerId == Model.CurrentPlayer.Id);

        <section id="player-final-panel"
                 class="player-final-panel"
                 data-participates="@(submission is not null ? "true" : "false")">
            <p class="eyebrow">@Localizer["FinalQuestion_Title"]</p>

            @if (submission is null)
            {
                <p>@Localizer["FinalQuestion_NotEligible"]</p>
            }
            else if (Model.Game.Session.Status == BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalWagering)
            {
                @if (submission.Wager is null)
                {
                    <form id="final-wager-form"
                          class="question-wager-form final-wager-form"
                          data-minimum="@BadWolfQuiz.Game.Runtime.FinalQuestion.MinimumWager"
                          data-maximum="@submission.MaximumWager">
                        <label class="wager-display-label">
                            <span>@Localizer["FinalQuestion_YourWager"]</span>
                            <input id="final-wager"
                                   class="wager-display"
                                   type="text"
                                   inputmode="none"
                                   readonly
                                   required />
                        </label>

                        <div class="wager-keypad"
                             aria-label="@Localizer["GameBoard_WagerKeypad"]">
                            @foreach (var digit in new[] { 1, 2, 3, 4, 5, 6, 7, 8, 9 })
                            {
                                <button type="button" data-final-wager-digit="@digit">
                                    @digit
                                </button>
                            }
                            <button type="button"
                                    data-final-wager-clear
                                    aria-label="@Localizer["GameBoard_ClearWager"]">
                                C
                            </button>
                            <button type="button" data-final-wager-digit="0">0</button>
                            <button type="button"
                                    data-final-wager-backspace
                                    aria-label="@Localizer["GameBoard_DeleteWagerDigit"]">
                                ⌫
                            </button>
                            <button class="wager-keypad-max"
                                    type="button"
                                    data-final-wager-max
                                    aria-label="@Localizer["GameBoard_MaximumWager"]">
                                MAX
                            </button>
                        </div>

                        <p class="wager-validation"
                           data-final-wager-validation
                           data-valid-label="@Localizer["GameBoard_WagerValid"]"
                           data-invalid-label="@Localizer[
                               "GameBoard_WagerOutsideLimits",
                               BadWolfQuiz.Game.Runtime.FinalQuestion.MinimumWager,
                               submission.MaximumWager]">
                            @Localizer[
                                "GameBoard_WagerOutsideLimits",
                                BadWolfQuiz.Game.Runtime.FinalQuestion.MinimumWager,
                                submission.MaximumWager]
                        </p>

                        <button class="button button-primary"
                                type="submit"
                                data-final-wager-submit
                                disabled>
                            @Localizer["FinalQuestion_ConfirmWager"]
                        </button>
                    </form>
                }
                else
                {
                    <p>@Localizer["FinalQuestion_WagerConfirmed"]</p>
                }
            }
            else if (Model.Game.Session.Status is
                BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalAnswering or
                BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalJudging)
            {
                <div class="game-content-blocks">
                    @foreach (var block in Model.Game.Session.FinalQuestion!.Definition.QuestionBlocks)
                    {
                        <article class="game-content-block">
                            @if (!string.IsNullOrWhiteSpace(block.TopCaption))
                            {
                                <p class="game-content-caption">@block.TopCaption</p>
                            }
                            @switch (block.Kind)
                            {
                                case BadWolfQuiz.Game.Definitions.ContentBlockKind.Text:
                                    <p class="game-content-text">@block.TextContent</p>
                                    break;
                                case BadWolfQuiz.Game.Definitions.ContentBlockKind.Image:
                                    <img class="game-content-image"
                                         src="@Url.Page("/Player/Lobby", "FinalContentBlock", new { code = Model.Game.PublicCode, playerId = Model.CurrentPlayer.Id.Value, sourceContentBlockId = block.SourceContentBlockId })"
                                         alt="@block.FileName" />
                                    break;
                                case BadWolfQuiz.Game.Definitions.ContentBlockKind.Audio:
                                    <audio class="game-content-audio"
                                           controls
                                           src="@Url.Page("/Player/Lobby", "FinalContentBlock", new { code = Model.Game.PublicCode, playerId = Model.CurrentPlayer.Id.Value, sourceContentBlockId = block.SourceContentBlockId })">
                                    </audio>
                                    break;
                                case BadWolfQuiz.Game.Definitions.ContentBlockKind.Video:
                                    <video class="game-content-video" controls src="@block.ExternalUrl"></video>
                                    break;
                                case BadWolfQuiz.Game.Definitions.ContentBlockKind.YouTube:
                                    <iframe class="game-content-video"
                                            src="@BadWolfQuiz.Web.Pages.Admin.Games.LobbyModel.GetYouTubeEmbedUrl(block.ExternalUrl)"
                                            title="@Localizer["GameBoard_MediaContent"]"
                                            allowfullscreen>
                                    </iframe>
                                    break;
                            }
                            @if (!string.IsNullOrWhiteSpace(block.BottomCaption))
                            {
                                <p class="game-content-caption">@block.BottomCaption</p>
                            }
                        </article>
                    }
                </div>

                @if (Model.Game.Session.Status == BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalAnswering &&
                    submission.Answer is null)
                {
                    <form id="final-answer-form" class="stack-form">
                        <label>
                            <span>@Localizer["FinalQuestion_YourAnswer"]</span>
                            <textarea id="final-answer" required></textarea>
                        </label>
                        <button class="button button-primary" type="submit">
                            @Localizer["FinalQuestion_ConfirmAnswer"]
                        </button>
                    </form>
                }
                else if (Model.Game.Session.Status == BadWolfQuiz.Game.Runtime.GameSessionStatus.FinalAnswering)
                {
                    <p>@Localizer["FinalQuestion_AnswerConfirmed"]</p>
                }
                else
                {
                    <p>@Localizer["FinalQuestion_WaitingForJudging"]</p>
                }
            }
            else
            {
                <p>
                    @(submission.IsCorrect == true
                        ? Localizer["FinalQuestion_YourAnswerCorrect"]
                        : Localizer["FinalQuestion_YourAnswerWrong"])
                </p>
            }

            <div id="final-question-error" class="message message-error" hidden></div>
        </section>
    }
    else
    {
    <section class="player-buzzer-panel">
        <button id="player-buzzer"
                class="player-buzzer"
                type="button"
                disabled>
            @Localizer["PlayerGame_Buzz"]
        </button>
        <p id="player-buzzer-status" class="dialog-warning">
            @Localizer["PlayerGame_BuzzerClosed"]
        </p>
    </section>
    }

    <h2>@Localizer["Label_Players"] (@Model.Players.Count)</h2>
    <ul id="player-score-list" class="player-list">
        @foreach (var player in Model.Players)
        {
            <li class="@(player.Id == Model.CurrentPlayer.Id ? "current-player" : null)"
                data-player-id="@player.Id.Value">
                <strong>@player.Name</strong>
                <span>@player.Score</span>
            </li>
        }
    </ul>

    <p class="dialog-warning">@Localizer["Message_WaitingHost"]</p>
</div>

@section Scripts {
    <script>
        (() => {
            const lobby = document.querySelector(".player-lobby");
            const warning = document.getElementById("activity-warning");
            const rejoinWarning = document.getElementById("rejoin-warning");
            const playerScoreList = document.getElementById("player-score-list");
            const buzzerButton = document.getElementById("player-buzzer");
            const buzzerStatus = document.getElementById("player-buzzer-status");
            const timerPanel = document.getElementById("game-timer");
            const timerValue = document.getElementById("game-timer-value");
            const finalWagerForm = document.getElementById("final-wager-form");
            const finalAnswerForm = document.getElementById("final-answer-form");
            const finalError = document.getElementById("final-question-error");
            let buzzerQuestionId = null;
            let hasReceivedInitialFinalState = false;

            if (!lobby || !warning || typeof signalR === "undefined") {
                return;
            }

            const gameCode = lobby.dataset.gameCode;
            const playerId = lobby.dataset.playerId;
            const storageKey = `badwolfquiz:${gameCode}:player:${playerId}`;
            const transitionStorageKey = `${storageKey}:transition`;
            const bootstrapToken = lobby.dataset.accessToken;

            if (bootstrapToken) {
                localStorage.setItem(storageKey, bootstrapToken);
                history.replaceState({}, document.title, window.location.pathname);
            }

            const accessToken = bootstrapToken || localStorage.getItem(storageKey);

            if (accessToken) {
                localStorage.setItem(
                    `badwolfquiz:${gameCode}:current-player`,
                    JSON.stringify({
                        playerId,
                        accessToken,
                        path: window.location.pathname
                    }));
            }

            if (!accessToken) {
                warning.hidden = false;
                return;
            }

            const connection = new signalR.HubConnectionBuilder()
                .withUrl("/hubs/game")
                .withAutomaticReconnect()
                .build();

            const isPageActive = () =>
                document.visibilityState === "visible" && document.hasFocus();

            const updateWarning = () => {
                warning.hidden = isPageActive();
            };

            const joinPlayerSession = async () => {
                const transitionToken =
                    sessionStorage.getItem(transitionStorageKey);

                await connection.invoke(
                    "JoinPlayerSession",
                    gameCode,
                    accessToken,
                    isPageActive(),
                    transitionToken);

                if (transitionToken) {
                    sessionStorage.removeItem(transitionStorageKey);
                }
            };

            let transitionReloadStarted = false;
            const reloadForGameTransition = async () => {
                if (transitionReloadStarted) {
                    return;
                }

                transitionReloadStarted = true;
                const transitionToken = await connection.invoke(
                    "PreparePlayerTransition");

                if (!transitionToken) {
                    transitionReloadStarted = false;
                    return;
                }

                sessionStorage.setItem(
                    transitionStorageKey,
                    transitionToken);
                window.location.reload();
            };

            connection.on("TimerStateChanged", update => {
                if (!timerPanel || !timerValue) {
                    return;
                }

                timerPanel.hidden = !update.isVisible;
                timerPanel.classList.toggle(
                    "answer-timer",
                    update.mode === "answer");
                timerValue.textContent =
                    (update.remainingMilliseconds / 1000).toFixed(1);
            });

            connection.on("BuzzerStateChanged", update => {
                const hasAlreadyAnswered =
                    update.ineligiblePlayerIds?.includes(playerId) ?? false;
                const isOpen = update.status === "open";
                const canBuzz = isOpen && !hasAlreadyAnswered;
                buzzerQuestionId = canBuzz
                    ? update.sourceQuestionId
                    : null;

                if (buzzerButton) {
                    buzzerButton.disabled = !canBuzz;
                    buzzerButton.classList.toggle("player-buzzer-open", canBuzz);
                }

                if (buzzerStatus) {
                    const isClaimedByCurrentPlayer =
                        update.status === "claimed" &&
                        update.answeringPlayerId === playerId;

                    buzzerStatus.textContent = hasAlreadyAnswered
                        ? lobby.dataset.buzzerAlreadyAnsweredLabel
                        : isOpen
                            ? lobby.dataset.buzzerOpenLabel
                            : isClaimedByCurrentPlayer
                                ? lobby.dataset.buzzerClaimedByYouLabel
                                : update.status === "claimed"
                                    ? lobby.dataset.buzzerClaimedLabel
                                    : lobby.dataset.buzzerClosedLabel;
                }
            });

            connection.on("GameStatusChanged", update => {
                const finalStatuses = [
                    "finalwagering",
                    "finalanswering",
                    "finaljudging",
                    "completed"
                ];

                if (lobby.dataset.finalStatus !== update.status &&
                    finalStatuses.includes(update.status)) {
                    reloadForGameTransition().catch(console.error);
                }
            });

            connection.on("FinalQuestionStateChanged", () => {
                if (!hasReceivedInitialFinalState) {
                    hasReceivedInitialFinalState = true;
                    return;
                }

                reloadForGameTransition().catch(console.error);
            });

            connection.on("FinalQuestionActionRejected", update => {
                if (finalError) {
                    finalError.textContent =
                        lobby.dataset.finalActionRejectedLabel || update.message;
                    finalError.hidden = false;
                }
            });

            finalWagerForm?.addEventListener("submit", event => {
                event.preventDefault();
                const input = document.getElementById("final-wager");
                const amount = Number(input?.value);
                const minimum = Number(finalWagerForm.dataset.minimum);
                const maximum = Number(finalWagerForm.dataset.maximum);

                if (!Number.isInteger(amount) ||
                    amount < minimum ||
                    amount > maximum) {
                    return;
                }

                finalWagerForm.querySelector("button").disabled = true;
                connection.invoke("SubmitFinalWager", amount)
                    .catch(console.error);
            });

            if (finalWagerForm) {
                const display = document.getElementById("final-wager");
                const validation = finalWagerForm.querySelector(
                    "[data-final-wager-validation]");
                const submit = finalWagerForm.querySelector(
                    "[data-final-wager-submit]");
                const minimum = Number(finalWagerForm.dataset.minimum);
                const maximum = Number(finalWagerForm.dataset.maximum);

                const refreshFinalWager = () => {
                    const amount = Number(display.value);
                    const isValid = display.value !== "" &&
                        amount >= minimum &&
                        amount <= maximum;

                    submit.disabled = !isValid;
                    validation.textContent = isValid
                        ? validation.dataset.validLabel
                        : validation.dataset.invalidLabel;
                    validation.classList.toggle("wager-valid", isValid);
                };

                finalWagerForm
                    .querySelectorAll("[data-final-wager-digit]")
                    .forEach(button => {
                        button.addEventListener("click", () => {
                            const nextValue = (
                                display.value +
                                button.dataset.finalWagerDigit)
                                .replace(/^0+(?=\d)/, "");

                            display.value = Math.min(
                                Number(nextValue),
                                maximum).toString();
                            refreshFinalWager();
                        });
                    });

                finalWagerForm
                    .querySelector("[data-final-wager-max]")
                    ?.addEventListener("click", () => {
                        display.value = maximum.toString();
                        refreshFinalWager();
                    });

                finalWagerForm
                    .querySelector("[data-final-wager-clear]")
                    ?.addEventListener("click", () => {
                        display.value = "";
                        refreshFinalWager();
                    });

                finalWagerForm
                    .querySelector("[data-final-wager-backspace]")
                    ?.addEventListener("click", () => {
                        display.value = display.value.slice(0, -1);
                        refreshFinalWager();
                    });

                refreshFinalWager();
            }

            finalAnswerForm?.addEventListener("submit", event => {
                event.preventDefault();
                const input = document.getElementById("final-answer");
                const answer = input?.value.trim();

                if (!answer) {
                    return;
                }

                finalAnswerForm.querySelector("button").disabled = true;
                connection.invoke("SubmitFinalAnswer", answer)
                    .catch(console.error);
            });

            buzzerButton?.addEventListener("click", () => {
                if (buzzerQuestionId === null ||
                    connection.state !== signalR.HubConnectionState.Connected) {
                    return;
                }

                const sourceQuestionId = buzzerQuestionId;
                buzzerQuestionId = null;
                buzzerButton.disabled = true;
                buzzerButton.classList.remove("player-buzzer-open");
                connection.invoke("Buzz", sourceQuestionId).catch(console.error);
            });

            connection.on("BuzzRejected", () => {
                if (buzzerStatus) {
                    buzzerStatus.textContent = lobby.dataset.buzzRejectedLabel;
                }
            });

            connection.on("PlayersChanged", update => {
                if (!playerScoreList) {
                    return;
                }

                playerScoreList.replaceChildren();

                for (const player of update.players) {
                    const item = document.createElement("li");
                    item.dataset.playerId = player.id;
                    item.className = player.id === playerId
                        ? "current-player"
                        : "";

                    const name = document.createElement("strong");
                    name.textContent = player.name;

                    const score = document.createElement("span");
                    score.textContent = player.score.toString();

                    item.append(name, score);
                    playerScoreList.append(item);
                }
            });

            connection.on("PlayerAccessRejected", () => {
                warning.hidden = false;
            });

            connection.on("RejoinApprovalRequired", () => {
                rejoinWarning.hidden = false;
            });

            connection.on("RejoinApproved", () => {
                rejoinWarning.hidden = true;
                updateWarning();
            });

            connection.on("RemovedFromGame", () => {
                window.alert(lobby.dataset.removedFromGameLabel);
                window.location.assign(`/Join?code=${encodeURIComponent(gameCode)}`);
            });

            connection.onreconnected(joinPlayerSession);

            document.addEventListener("visibilitychange", () => {
                updateWarning();

                if (connection.state === signalR.HubConnectionState.Connected) {
                    connection.invoke("SetPlayerVisibility", isPageActive()).catch(console.error);
                }
            });

            window.addEventListener("focus", () => {
                updateWarning();

                if (connection.state === signalR.HubConnectionState.Connected) {
                    connection.invoke("SetPlayerVisibility", true).catch(console.error);
                }
            });

            window.addEventListener("blur", () => {
                updateWarning();

                if (connection.state === signalR.HubConnectionState.Connected) {
                    connection.invoke("SetPlayerVisibility", false).catch(console.error);
                }
            });

            updateWarning();
            connection.start().then(joinPlayerSession).catch(() => {
                warning.hidden = false;
            });
        })();
    </script>
}
