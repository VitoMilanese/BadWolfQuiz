@page
@model NotFoundModel
@inject IStringLocalizer<NotFoundResource> NotFoundLocalizer
@{
    ViewData["Title"] = NotFoundLocalizer["Title"];
}

@section Styles {
    <link rel="stylesheet" href="~/css/public-account-pages.css" asp-append-version="true" />
}

<div class="portal-page not-found-page">
    <section class="portal-hero not-found-hero" aria-labelledby="not-found-title">
        <div class="portal-hero-copy">
            <p class="portal-kicker">BAD WOLF QUIZ / 404</p>
            <h1 id="not-found-title">@NotFoundLocalizer["Heading"]</h1>
            <p class="portal-hero-description">@NotFoundLocalizer["Description"]</p>
            <div class="not-found-actions">
                <a class="button button-primary" href="@Url.Content("~/")">
                    @NotFoundLocalizer["BackHome"]
                </a>
            </div>
        </div>

        <div class="portal-hero-mark not-found-mark" aria-hidden="true">
            <span>BAD WOLF QUIZ</span>
            <strong>404</strong>
            <small>@NotFoundLocalizer["Title"]</small>
        </div>
    </section>
</div>
